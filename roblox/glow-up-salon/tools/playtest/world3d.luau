local function cam(name)
	local m = W.game:GetService("Workspace").GlowUpWorld.Cameras[name].CFrame
	return { m.x, m.y, m.z, m.m[1], m.m[2], m.m[3], m.m[4], m.m[5], m.m[6], m.m[7], m.m[8], m.m[9] }
end
local function world(name, camName, camCF)
	local w = W.dumpWorld()
	w.camera = camCF or cam(camName)
	print("@@WORLD " .. name .. " " .. W.json(w))
end

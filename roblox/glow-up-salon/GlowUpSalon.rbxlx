	end
	featherWings(m, 1.55, 0.0, rgb(235, 240, 255), 1.2)
end

function BUILDERS.pet_turtle(m: Model)
	local green, shell = rgb(120, 210, 140), rgb(60, 160, 170)
	for _, x in { -0.42, 0.42 } do
		for _, z in { -0.42, 0.42 } do
			ball(m, "Flipper", Vector3.new(0.35, 0.2, 0.45), Vector3.new(x, 0.22, z), green)
		end
	end
	ball(m, "Shell", Vector3.new(1.3, 0.8, 1.45), Vector3.new(0, 0.62, 0.05), shell)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		ball(m, "ShellSpot", Vector3.new(0.3, 0.12, 0.3), Vector3.new(math.cos(a) * 0.35, 0.98, 0.05 + math.sin(a) * 0.38), rgb(255, 210, 120))
	end
	ball(m, "Head", Vector3.new(0.6, 0.55, 0.6), Vector3.new(0, 0.7, -0.85), green)
	eyes(m, Vector3.new(0, 0.82, -1.1), 0.17, 0.13)
	-- a little stream of bubbles
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Texture = "rbxassetid://6711256324"
	bubbles.Color = ColorSequence.new(rgb(200, 240, 255))
	bubbles.Transparency = NumberSequence.new(0.3, 1)
	bubbles.Size = NumberSequence.new(0.12, 0.25)
	bubbles.Lifetime = NumberRange.new(1, 1.6)
	bubbles.Speed = NumberRange.new(1, 2)
	bubbles.SpreadAngle = Vector2.new(15, 15)
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.Rate = 3
	bubbles.Parent = m:FindFirstChild("Head")
end

-- A fresh pet model, or nil for "no pet".
function Pets.build(petId: string?): Model?
	local builder = petId and BUILDERS[petId]
	if not builder then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "Pet"
	builder(model)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root
	return model
end

-- Trots `pet` beside `owner` (any model with a HumanoidRootPart), a little hop in each step.
-- Call every frame; dt is the frame time.
function Pets.follow(pet: Model, owner: Model, dt: number, side: number?)
	local root = owner:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) or not pet.PrimaryPart then
		return
	end
	local humanoid = owner:FindFirstChildOfClass("Humanoid")
	local feet = root.Position.Y - (if humanoid then humanoid.HipHeight + root.Size.Y / 2 else 3)
	local spot = root.CFrame * CFrame.new((side or 1) * 2.6, 0, 0.6)
	local goal = Vector3.new(spot.Position.X, feet, spot.Position.Z)
	local current = pet:GetPivot()
	local pos = current.Position:Lerp(goal, 1 - math.exp(-dt * 6))
	local moving = (goal - current.Position).Magnitude > 0.2
	local hop = if moving then math.abs(math.sin(os.clock() * 10)) * 0.35 else math.abs(math.sin(os.clock() * 2)) * 0.06
	local facing = root.CFrame.LookVector
	pet:PivotTo(CFrame.lookAt(Vector3.new(pos.X, feet + hop, pos.Z), Vector3.new(pos.X, feet + hop, pos.Z) + Vector3.new(facing.X, 0, facing.Z)))
end

return Pets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Progress</string>
          <string name="Source"><![CDATA[-- Stylist levels: stars earned in shows add up. Each level needs a few more stars than the last,
-- so there's always something to work toward.

local Progress = {}

local TITLES = {
	{ level = 1, title = "Newbie Stylist" },
	{ level = 3, title = "Rising Star" },
	{ level = 5, title = "Pro Stylist" },
	{ level = 8, title = "Glam Queen" },
	{ level = 12, title = "Superstar Stylist" },
	{ level = 20, title = "Legendary Stylist" },
}

-- Total stars needed to reach a level: Lv2 = 6, Lv3 = 14, Lv5 = 36, Lv10 = 126, Lv20 = 456
function Progress.starsFor(level: number): number
	return (level - 1) * (level + 4)
end

function Progress.level(totalStars: number): number
	local level = 1
	while Progress.starsFor(level + 1) <= (totalStars or 0) do
		level += 1
	end
	return level
end

function Progress.title(level: number): string
	local title = TITLES[1].title
	for _, t in TITLES do
		if level >= t.level then
			title = t.title
		end
	end
	return title
end

-- 0..1 progress toward the next level
function Progress.fraction(totalStars: number): number
	local level = Progress.level(totalStars)
	local from, to = Progress.starsFor(level), Progress.starsFor(level + 1)
	return ((totalStars or 0) - from) / (to - from)
end

return Progress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- All the messages the server and players send each other.
-- The server creates them; players wait for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"State", -- server -> all: round phase, timer, theme
	"AssignClient", -- server -> player: your new customer for this round
	"UpdateLook", -- player -> server: (lookKey, itemId)
	"WashProgress", -- player -> server: (clean 0..1, rinsed)
	"Done", -- player -> server: (isDone)
	"Showcase", -- server -> all: who is on the runway now
	"Vote", -- player -> server: (targetUserId, stars)
	"Results", -- server -> all: fashion show results
	"Profile", -- server -> player: coins, unlocked items, passes
	"Notify", -- server -> player: a little message
	"React", -- player -> server: cheer emoji during the fashion show
	"Reaction", -- server -> all: someone cheered (emoji, cheers so far, cheer goal)
	"Celebrate", -- server -> player: daily gift, level up
	"SetBots", -- player -> server: turn the Style Bots (pretend friends) on or off
	"Collected", -- server -> player: you grabbed a lobby star (coins)
}

local FUNCTIONS = {
	"Hello", -- player -> server: returns everything a newly joined player needs
	"BuyItem", -- player -> server: unlock an item with coins
}

local Remotes = {}

local folder: Instance
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
	end
	for _, name in FUNCTIONS do
		local f = Instance.new("RemoteFunction")
		f.Name = name
		f.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in EVENTS do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end
for _, name in FUNCTIONS do
	Remotes[name] = folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Scoring</string>
          <string name="Source"><![CDATA[-- The judges! Gives a look 1-5 stars, says what they liked (or what to fix next time),
-- and finds an award for every look.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)

local Scoring = {}

export type Wish = { key: string, tag: string, text: string }

export type Entry = {
	look: { [string]: string },
	clean: number,
	rinsed: boolean,
	client: any, -- the client (for their wishes)
}

local MAKEUP_KEYS = { "eyeshadow", "lashes", "blush", "lipstick" }
-- Things that can match the theme. 4 matches = full theme points.
local THEME_SLOTS = {
	"hairStyle", "hairColor", "eyeshadow", "blush", "lipstick", "outfit", "garment", "accessory", "gems",
	"costumeBack", "costumeFace", "costumeWaist", "costumeShoulder", "pet", "pose", "effect",
}
-- The fun stuff that makes a runway walk a show
local SHOW_KEYS = { "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder", "pet", "pose", "effect" }
local THEME_MATCHES_NEEDED = 4

function Scoring.roundToHalf(stars: number): number
	return math.clamp(math.floor(stars * 2 + 0.5) / 2, 1, 5)
end

-- "Pink Party 🎀" -> "Pink Party"
function Scoring.themeWord(theme: Catalog.Theme): string
	return (string.gsub(theme.name, "%s*[^%w%s']+$", ""))
end

local function slotMatches(look, key: string, theme: Catalog.Theme): boolean
	if key == "outfit" then
		if Catalog.isNone(look.outfit) then
			return false -- work overalls never match, even recolored
		end
		-- a 🎨 custom color counts for the outfit too
		return Catalog.matchesTheme(Catalog.byId[look.outfit], theme) or Catalog.matchesTheme(Catalog.byId[look.outfitColor or ""], theme)
	end
	return Catalog.matchesTheme(Catalog.byId[look[key] or ""], theme)
end

-- How many parts of the look match the theme.
function Scoring.themeMatches(look, theme: Catalog.Theme): number
	local n = 0
	for _, key in THEME_SLOTS do
		if slotMatches(look, key, theme) then
			n += 1
		end
	end
	return n
end

function Scoring.wishMet(wish: Wish, look): boolean
	local it = Catalog.byId[look[wish.key] or ""]
	if not it or Catalog.isNone(it.id) then
		return false
	end
	if wish.tag == "any" then
		return true
	elseif wish.tag == "dress" then
		return it.dress == true
	end
	return Catalog.hasTag(it, wish.tag)
end

local function wishesMet(entry: Entry): (number, number)
	local wishes = entry.client and entry.client.wishes or {}
	local met = 0
	for _, w in wishes do
		if Scoring.wishMet(w, entry.look) then
			met += 1
		end
	end
	return met, #wishes
end

-- Judge's Wishes: two things the judge asks for each round, made from the theme ("a pirate hat",
-- "something red"). Every wish can be met with free items, so nobody has to buy anything.
local WISH_SLOTS = {
	{ key = "accessory", noun = "hat or clip", emoji = "🎩", article = true },
	{ key = "costumeBack", noun = "wings or cape", emoji = "🪽" },
	{ key = "costumeFace", noun = "mask or glasses", emoji = "🕶️", article = true },
	{ key = "pet", noun = "pet", emoji = "🐾", article = true },
	{ key = "outfit", noun = "outfit", emoji = "👗", article = true },
	{ key = "hairColor", noun = "hair", emoji = "💇" },
	{ key = "lipstick", noun = "lips", emoji = "💋" },
}
local WISH_WORDS = {
	sparkle = "sparkly", rockstar = "rock star", ocean = "sea", animal = "animal", spooky = "spooky",
}

local function freeFor(it: Catalog.Item, eventId: string?): boolean
	return not it.price and not it.pass and not it.level and not it.gift and (not it.event or it.event == eventId)
end

function Scoring.themeWishes(theme: Catalog.Theme, eventId: string?, rng: Random): { Wish }
	local options = {}
	for _, slot in WISH_SLOTS do
		local category = Catalog.categoryByKey[slot.key]
		for _, tag in theme.tags do
			local possible = false
			for _, it in (category and category.items or {}) :: { Catalog.Item } do
				if not Catalog.isNone(it.id) and freeFor(it, eventId) and Catalog.hasTag(it, tag) then
					possible = true
					break
				end
			end
			if possible then
				local word = WISH_WORDS[tag] or tag
				local article = if slot.article then (if string.match(word, "^[aeiou]") then "an " else "a ") else ""
				table.insert(options, { key = slot.key, tag = tag, text = slot.emoji .. " " .. article .. word .. " " .. slot.noun })
			end
		end
	end
	-- two wishes for two different things
	local picked = {}
	while #picked < 2 and #options > 0 do
		local wish = table.remove(options, rng:NextInteger(1, #options))
		local clash = false
		for _, p in picked do
			if p.key == wish.key then
				clash = true
			end
		end
		if not clash then
			table.insert(picked, wish)
		end
	end
	return picked
end

-- The ribbon you earn this round (the real goal when you play alone): Bronze at 3 stars, Silver at
-- 4, Gold for 5 stars with every wish granted.
function Scoring.ribbon(stars: number, wishesMetCount: number, wishCount: number): string
	if stars >= 5 and wishesMetCount >= wishCount then
		return "🥇 Gold Ribbon"
	elseif stars >= 4 then
		return "🥈 Silver Ribbon"
	elseif stars >= 3 then
		return "🥉 Bronze Ribbon"
	end
	return "🎀 Runway Rosette"
end

-- Returns stars (1..5, in half steps) and a list of judge comments.
function Scoring.judge(entry: Entry, theme: Catalog.Theme): (number, { string })
	local look = entry.look
	local points = 0
	local comments = {}

	-- The show (1 point): costume pieces, a pet, a pose, an effect
	local show = 0
	for _, key in SHOW_KEYS do
		if not Catalog.isNone(look[key]) then
			show += 1
		end
	end
	points += math.min(show, 4) / 4
	if show == 0 then
		table.insert(comments, "Add a costume, a pet or a pose to WOW the crowd! 🐶💃")
	elseif show >= 4 then
		table.insert(comments, "What a show! 🔥")
	end

	-- Hair, makeup, outfit (1.75 points for doing each part)
	if Catalog.isNone(look.hairStyle) then
		table.insert(comments, "Pick a hairstyle! 💇")
	else
		points += 0.5
	end
	local applied = 0
	for _, key in MAKEUP_KEYS do
		if not Catalog.isNone(look[key]) then
			applied += 1
		end
	end
	points += 0.75 * applied / #MAKEUP_KEYS
	if applied == 0 then
		table.insert(comments, "Don't forget the makeup! 💄")
	end
	if Catalog.isNone(look.outfit) and Catalog.isNone(look.garment or "") then
		table.insert(comments, "Pick an outfit! 👗")
	else
		points += 0.5
	end

	-- Matching the theme (2.25 points): the more ⭐ items, the better
	local matches = Scoring.themeMatches(look, theme)
	points += 2.25 * math.min(matches, THEME_MATCHES_NEEDED) / THEME_MATCHES_NEEDED
	local word = Scoring.themeWord(theme)
	if matches >= THEME_MATCHES_NEEDED then
		table.insert(comments, "That's SO " .. word .. "! ⭐")
	elseif matches >= 2 then
		table.insert(comments, "Pretty! Pick more ⭐ " .. word .. " things!")
	else
		table.insert(comments, "Look for the ⭐ items to match " .. word .. "!")
	end

	-- The client's wishes (bonus)
	local met, total = wishesMet(entry)
	points += 0.25 * met
	if total > 0 and met == total then
		table.insert(comments, "You made their wishes come true! 💌")
	end

	-- Little extras (bonus)
	if not Catalog.isNone(look.gems) then
		points += 0.1
	end
	if not Catalog.isNone(look.accessory) then
		points += 0.1
	end

	local stars = Scoring.roundToHalf(points)
	if stars >= 4.5 then
		table.insert(comments, 1, "ABSOLUTELY STUNNING! 😍")
	elseif stars >= 3.5 then
		table.insert(comments, 1, "Looking great!")
	end
	return stars, comments
end

-- How the client feels about their look (used to draw their mouth).
function Scoring.mood(stars: number, clean: number): string
	if clean < 0.5 then
		return "sad"
	elseif stars < 2.5 then
		return "neutral"
	elseif stars < 4 then
		return "smile"
	end
	return "grin"
end

-- Mixes the judges' stars with the other players' votes (half and half).
function Scoring.final(judgeStars: number, votes: { number }): number
	if #votes == 0 then
		return judgeStars
	end
	local total = 0
	for _, v in votes do
		total += v
	end
	return (judgeStars + total / #votes) / 2
end

------------------------------------------------------------------------------
-- Awards: every look gets one, so every kid wins something

Scoring.AWARDS = {
	{ id = "theme", emoji = "⭐" }, -- named "Most <theme>"
	{ id = "costume", name = "Best Costume", emoji = "🎭" },
	{ id = "pet", name = "Best Buddy", emoji = "🐶" },
	{ id = "show", name = "Showstopper", emoji = "🔥" },
	{ id = "hair", name = "Best Hair", emoji = "💇" },
	{ id = "makeup", name = "Makeup Star", emoji = "💄" },
	{ id = "sparkle", name = "Sparkliest", emoji = "✨" },
	{ id = "colorful", name = "Most Colorful", emoji = "🌈" },
	{ id = "extras", name = "Cutest Extras", emoji = "🎀" },
}
Scoring.FALLBACK_AWARD = { id = "star", name = "Super Stylist", emoji = "💖" }

function Scoring.awardName(awardId: string, theme: Catalog.Theme): string
	for _, a in Scoring.AWARDS do
		if a.id == awardId then
			return a.emoji .. " " .. (a.name or ("Most " .. Scoring.themeWord(theme)))
		end
	end
	return Scoring.FALLBACK_AWARD.emoji .. " " .. Scoring.FALLBACK_AWARD.name
end

-- How strongly this look deserves each award (0 = not at all).
function Scoring.awardScores(entry: Entry, theme: Catalog.Theme): { [string]: number }
	local look = entry.look
	local function has(key)
		return not Catalog.isNone(look[key])
	end
	local sparkles, distinct = 0, 0
	for _, key in THEME_SLOTS do
		local it = Catalog.byId[look[key] or ""]
		if it and not Catalog.isNone(it.id) then
			distinct += 1
			if it.sparkle or Catalog.hasTag(it, "sparkle") then
				sparkles += 1
			end
		end
	end
	local applied = 0
	for _, key in MAKEUP_KEYS do
		if has(key) then
			applied += 1
		end
	end
	local costume = 0
	for _, key in { "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder" } do
		if has(key) then
			costume += 1
		end
	end
	return {
		theme = Scoring.themeMatches(look, theme) / THEME_MATCHES_NEEDED,
		costume = math.min(costume / 2, 1),
		pet = if has("pet") then 0.8 else 0,
		show = (if has("pose") then 0.4 else 0) + (if has("effect") then 0.4 else 0),
		hair = (if has("hairStyle") then 0.5 else 0) + (if slotMatches(look, "hairColor", theme) then 0.3 else 0) + (if has("accessory") then 0.1 else 0),
		makeup = applied / #MAKEUP_KEYS,
		sparkle = math.min(sparkles / 3, 1),
		colorful = distinct / #THEME_SLOTS,
		extras = (if has("accessory") then 0.5 else 0) + (if has("gems") then 0.4 else 0),
	}
end

return Scoring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Stations</string>
          <string name="Source"><![CDATA[-- The Dressing Hall: walk up to a station and its menu opens. One list drives both the 3D world
-- (WorldBuilder builds a glowing pad, sign and props for each) and the menus (Makeover opens the
-- matching tab when you stand on a pad).

local Stations = {}

export type Station = {
	id: string,
	tab: string, -- the Makeover tab this station opens
	name: string,
	icon: string,
	pad: Vector3, -- center of the glowing pad on the floor
	facing: Vector3, -- the way you face while standing on it (the camera looks back at you)
	color: Color3,
}

local rgb = Color3.fromRGB

-- Five stations along the mirrors at the back of the salon, and the Pet Park by the door.
Stations.list = {
	{ id = "hair", tab = "Hair", name = "Hair Chair", icon = "💇", pad = Vector3.new(-26, 0.2, 55), facing = Vector3.new(0, 0, -1), color = rgb(255, 120, 190) },
	{ id = "face", tab = "Face", name = "Makeup Vanity", icon = "💄", pad = Vector3.new(-13, 0.2, 55), facing = Vector3.new(0, 0, -1), color = rgb(255, 90, 120) },
	{ id = "outfit", tab = "Outfit", name = "Clothes Rack", icon = "👗", pad = Vector3.new(0, 0.2, 55), facing = Vector3.new(0, 0, -1), color = rgb(90, 160, 255) },
	{ id = "costume", tab = "Costume", name = "Costume Closet", icon = "🦸", pad = Vector3.new(13, 0.2, 55), facing = Vector3.new(0, 0, -1), color = rgb(150, 90, 220) },
	{ id = "show", tab = "Show", name = "Pose Stage", icon = "💃", pad = Vector3.new(26, 0.2, 55), facing = Vector3.new(0, 0, -1), color = rgb(245, 200, 70) },
	{ id = "pet", tab = "Pet", name = "Pet Park", icon = "🐶", pad = Vector3.new(24, 0.2, 39), facing = Vector3.new(-1, 0, 0), color = rgb(90, 200, 120) },
} :: { Station }

Stations.PAD_RADIUS = 4.5

Stations.byTab = {} :: { [string]: Station }
for _, s in Stations.list do
	Stations.byTab[s.tab] = s
end

-- The station whose pad this position is standing on, if any.
function Stations.at(position: Vector3): Station?
	for _, s in Stations.list do
		local d = Vector3.new(position.X - s.pad.X, 0, position.Z - s.pad.Z)
		if d.Magnitude <= Stations.PAD_RADIUS then
			return s
		end
	end
	return nil
end

return Stations
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[-- Style Bots: pretend friends for when you play alone (or with just one friend). They're clearly
-- robots (🤖 on their name tags, never passed off as real players). Between rounds they dance on
-- the dance floor; during the makeover they walk from station to station and put their look
-- together piece by piece; then they sit in the audience, walk the runway, strike a pose, and vote
-- (kindly) on real players' looks. They always place below the real kids. Turn them on or off from the lobby card.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Clients = require(ReplicatedStorage.Shared.Clients)
local Config = require(ReplicatedStorage.Shared.Config)
local Pets = require(ReplicatedStorage.Shared.Pets)
local Stations = require(ReplicatedStorage.Shared.Stations)

local BotService = {}

export type Bot = {
	bot: true,
	userId: number, -- negative, so it never matches a real player
	name: string,
	client: Clients.Client,
	look: { [string]: string },
	clean: number,
	rinsed: boolean,
	votes: { [number]: number },
	model: Model?,
	pet: Model?,
	skill: number, -- 0..1: how closely they follow the theme (so real players can win too)
	walkTrack: AnimationTrack?,
	makeoverToken: {}?, -- the current dress-up routine (nil = stop)
	danceTrack: AnimationTrack?,
	busy: boolean, -- walking the runway or on the podium (the wander loop leaves them alone)
}

local NAMES = { "Kiki", "Zara", "Jojo", "Amani", "Coco", "Nala", "Rosie", "Imani", "Bibi", "Lulu" }
local WALK_ANIMATION = "rbxassetid://507777826"
local rng = Random.new()
local bots: { Bot } = {}
local world = nil
local themeOf: () -> Catalog.Theme = nil :: any

-- The keys a bot styles at each station, in the order they visit them.
local STATION_KEYS = {
	Hair = { "hairStyle", "hairColor" },
	Face = { "eyeshadow", "lashes", "blush", "lipstick", "gems" },
	Outfit = { "garment", "outfit", "outfitColor", "outfitPattern" },
	Costume = { "accessory", "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder" },
	Pet = { "pet" },
	Show = { "pose", "effect" },
}
-- How likely a bot is to bother with a key at all (so not every bot wears everything)
local KEY_CHANCE = {
	gems = 0.35, lashes = 0.6, outfitColor = 0.35, outfitPattern = 0.35,
	costumeBack = 0.6, costumeFace = 0.35, costumeWaist = 0.3, costumeShoulder = 0.35, accessory = 0.55,
	pet = 0.6, effect = 0.6, garment = 0.75,
}

-- A free (no coins, no pass, no level) item for this key, picking theme matches by skill.
local function pickItem(key: string, theme: Catalog.Theme, skill: number): string?
	local category = Catalog.categoryByKey[key]
	if not category then
		return nil
	end
	local matches, others = {}, {}
	for _, it in category.items do
		local free = not it.hidden and not it.gift and not it.pass and not it.level and it.price <= 0 and not it.event
		if free and not Catalog.isNone(it.id) then
			if Catalog.matchesTheme(it, theme) then
				table.insert(matches, it.id)
			else
				table.insert(others, it.id)
			end
		end
	end
	local pool = if #matches > 0 and rng:NextNumber() < skill then matches else others
	if #pool == 0 then
		pool = matches
	end
	return if #pool > 0 then pool[rng:NextInteger(1, #pool)] else nil
end

local function dress(bot: Bot)
	if bot.model and bot.model.Parent then
		Avatar.dress(bot.model, bot.client, bot.look, { clean = 1, mood = "smile", brushed = true })
	end
	-- the pet trots after them
	local petId = bot.look.pet
	if not bot.pet or bot.pet:GetAttribute("PetId") ~= petId then
		if bot.pet then
			bot.pet:Destroy()
			bot.pet = nil
		end
		local pet = if bot.model and bot.model.Parent then Pets.build(petId) else nil
		if pet and bot.model then
			pet:SetAttribute("PetId", petId)
			pet.Name = bot.name .. "'s Pet"
			pet:PivotTo(bot.model:GetPivot() * CFrame.new(2.6, -3, 0.6))
			pet.Parent = world.folder
			bot.pet = pet
		end
	end
end

local function nameTag(model: Model, text: string)
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromScale(6, 1)
	tag.StudsOffset = Vector3.new(0, 3.2, 0)
	tag.LightInfluence = 0
	tag.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(106, 63, 181)
	label.TextStrokeColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = tag
	tag.Parent = head
end

local function newBot(index: number): Bot?
	-- skin tones lean deep (most Style Bots are Black girls, like the players this was made for)
	local skinIndex = rng:NextInteger(if rng:NextNumber() < 0.75 then 5 else 1, #Catalog.SkinTones)
	local name = NAMES[(index - 1) % #NAMES + 1]
	-- the robot rides along in the name, so the runway card, results and podium all show it's a bot
	local client = Clients.forPlayer(name .. " 🤖", skinIndex)
	local model = Avatar.new(client)
	if not model then
		return nil
	end
	local bot: Bot = {
		bot = true,
		userId = -index,
		name = name,
		client = client,
		look = Catalog.defaultLook(),
		clean = 1,
		rinsed = true,
		votes = {},
		model = model,
		pet = nil,
		skill = rng:NextNumber(0.45, 0.85),
		walkTrack = nil,
		danceTrack = nil,
		busy = false,
	}
	model.Name = name .. " (Style Bot)"
	-- start with their own hair, so they don't all look alike between rounds
	bot.look.hairStyle = pickItem("hairStyle", themeOf(), 0) or bot.look.hairStyle
	bot.look.hairColor = pickItem("hairColor", themeOf(), 0.3) or bot.look.hairColor
	local spot = Stations.byTab.Show.pad + Vector3.new(rng:NextNumber(-20, -10), 0, rng:NextNumber(-12, -6))
	Avatar.place(model, spot, Vector3.new(0, 0, -1))
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = false
	model.Parent = world.folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	nameTag(model, name .. " 🤖")
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.WalkSpeed = 10
	-- walk animation while moving, idle while standing
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		-- the same catwalk strut the players have (or the plain walk until it has loaded)
		local loadedId: string? = nil
		local function walkTrack(): AnimationTrack?
			local assets = Avatar.assets(0)
			local strut = assets and assets:GetAttribute("CatwalkWalk")
			local id = if type(strut) == "string" then strut else WALK_ANIMATION
			if id ~= loadedId then
				local anim = Instance.new("Animation")
				anim.AnimationId = id
				local ok, track = pcall(function()
					return animator:LoadAnimation(anim)
				end)
				if ok and track then
					if bot.walkTrack then
						bot.walkTrack:Stop(0)
					end
					bot.walkTrack = track
					loadedId = id
				end
			end
			return bot.walkTrack
		end
		walkTrack()
		humanoid.Running:Connect(function(speed)
			local track = walkTrack()
			if not track then
				return
			end
			if speed > 0.5 and not track.IsPlaying then
				track:Play(0.2)
			elseif speed <= 0.5 and track.IsPlaying then
				track:Stop(0.2)
			end
		end)
	end
	Avatar.idle(model)
	dress(bot)
	return bot
end

local function walkTo(bot: Bot, target: Vector3, timeout: number)
	local model = bot.model
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	local root = model and model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then
		return
	end
	if humanoid.SeatPart or humanoid:GetState() == Enum.HumanoidStateType.Seated then
		Avatar.unseat(model)
		task.wait(0.1)
	end
	humanoid:MoveTo(target)
	local started = os.clock()
	while os.clock() - started < timeout and model.Parent do
		local here = Vector3.new(root.Position.X, 0, root.Position.Z)
		if (here - Vector3.new(target.X, 0, target.Z)).Magnitude < 2 then
			break
		end
		task.wait(0.2)
	end
end

------------------------------------------------------------------------------

function BotService.init(builtWorld, theme: () -> Catalog.Theme)
	world = builtWorld
	themeOf = theme
end

-- Makes sure there are `count` Style Bots (adds or removes some).
local ensuring = false
function BotService.ensure(count: number)
	if ensuring or not Avatar.assets(0) then
		return -- (still filling in, or the bodies haven't loaded yet: the next round adds them)
	end
	ensuring = true
	while #bots > count do
		BotService.remove(bots[#bots])
	end
	local index = 1
	while #bots < count and index <= 20 do
		local used = false
		for _, b in bots do
			if b.userId == -index then
				used = true
			end
		end
		if not used then
			local bot = newBot(index)
			if not bot then
				break
			end
			table.insert(bots, bot)
		end
		index += 1
	end
	ensuring = false
end

function BotService.remove(bot: Bot)
	local i = table.find(bots, bot)
	if i then
		table.remove(bots, i)
	end
	bot.makeoverToken = nil -- stops its dress-up routine
	if bot.pet then
		bot.pet:Destroy()
		bot.pet = nil
	end
	if bot.model then
		bot.model:Destroy()
		bot.model = nil
	end
end

function BotService.list(): { Bot }
	return bots
end

function BotService.byUserId(userId: number): Bot?
	for _, b in bots do
		if b.userId == userId then
			return b
		end
	end
	return nil
end

-- Between rounds: everyone off to the dance floor.
function BotService.hangOut()
	local floor = world.folder:FindFirstChild("DanceFloor", true)
	local center = floor and floor:GetAttribute("Center")
	for i, bot in bots do
		bot.busy = false
		bot.makeoverToken = nil
		bot.votes = {}
		task.spawn(function()
			if typeof(center) == "Vector3" then
				local a = i / math.max(#bots, 1) * math.pi * 2
				walkTo(bot, center + Vector3.new(math.cos(a) * 3, 0, math.sin(a) * 3), 8)
				if bot.model then
					local track = Avatar.pose(bot.model, if i % 2 == 0 then "pose_dance2" else "pose_dance")
					if track then
						track.Looped = true
						bot.danceTrack = track
					end
				end
			end
		end)
	end
end

-- Is a real player standing on this station's pad?
local function playerOn(station: Stations.Station): boolean
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local d = Vector3.new(root.Position.X - station.pad.X, 0, root.Position.Z - station.pad.Z)
			if d.Magnitude <= Stations.PAD_RADIUS + 1 then
				return true
			end
		end
	end
	return false
end

-- The makeover: each bot starts fresh, then walks station to station building the look.
function BotService.startMakeover(endsIn: number)
	local theme = themeOf()
	for _, bot in bots do
		if bot.danceTrack then
			bot.danceTrack:Stop(0.3)
			bot.danceTrack = nil
		end
		bot.look = Catalog.defaultLook()
		bot.look.hairStyle = pickItem("hairStyle", theme, 0) or bot.look.hairStyle
		bot.votes = {}
		bot.busy = false
		dress(bot)
		local token = {}
		bot.makeoverToken = token
		local function alive(): boolean
			return bot.makeoverToken == token and not bot.busy and bot.model ~= nil and bot.model.Parent ~= nil
		end
		task.spawn(function()
			local order = { "Hair", "Face", "Outfit", "Costume", "Pet", "Show" }
			-- not everyone goes in the same order
			if rng:NextNumber() < 0.5 then
				order = { "Outfit", "Hair", "Costume", "Face", "Show", "Pet" }
			end
			local perStation = math.max(4, (endsIn - 20) / #order)
			for _, tab in order do
				if not alive() then
					return
				end
				local station = Stations.byTab[tab]
				local offset = Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
				-- a real kid is styling here: wait a bit, then style from beside the pad instead
				local waited = 0
				while playerOn(station) and waited < 8 and alive() do
					task.wait(1)
					waited += 1
				end
				if playerOn(station) then
					offset = Vector3.new(if rng:NextNumber() < 0.5 then -6 else 6, 0, 2)
				end
				if not alive() then
					return
				end
				walkTo(bot, station.pad + offset, 12)
				task.wait(rng:NextNumber(1.5, 3))
				for _, key in STATION_KEYS[tab] do
					if not alive() then
						return
					end
					if rng:NextNumber() < (KEY_CHANCE[key] or 1) then
						local id = pickItem(key, theme, bot.skill)
						if id then
							bot.look[key] = id
							dress(bot)
							task.wait(rng:NextNumber(0.6, 1.4))
						end
					end
				end
				if alive() and bot.model and not Catalog.isNone(bot.look.pose) and tab == "Show" then
					Avatar.pose(bot.model, bot.look.pose)
				end
				-- the rest of this station's time, checking in so the show can call them away
				local rest = os.clock() + math.max(0, perStation - 6)
				local aside = false
				while os.clock() < rest and alive() do
					-- a kid walked up to this station: make room
					if not aside and playerOn(station) then
						aside = true
						walkTo(bot, station.pad + Vector3.new(if rng:NextNumber() < 0.5 then -6 else 6, 0, 2), 4)
					end
					task.wait(0.5)
				end
			end
		end)
	end
end

-- The bot walks the runway, strikes a pose, and then waits at the end.
function BotService.walkRunway(bot: Bot)
	local model = bot.model
	if not model then
		return
	end
	bot.busy = true
	bot.makeoverToken = nil
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	Avatar.unseat(model)
	task.wait(0.1)
	Avatar.place(model, world.runwayStart, Vector3.new(0, 0, 1))
	if bot.pet then
		bot.pet:PivotTo(CFrame.new(world.runwayStart + Vector3.new(2.6, 0, 0)))
	end
	model:SetAttribute("Walking", true) -- the runway camera follows them
	local walkTime = Config.SHOWCASE_SECONDS_PER_LOOK * 0.6
	humanoid.WalkSpeed = (world.runwayEnd - world.runwayStart).Magnitude / walkTime
	walkTo(bot, world.runwayEnd, walkTime + 1.5)
	humanoid.WalkSpeed = 10
	if root.Parent then
		BotService.twirl(root)
		Avatar.pose(model, if Catalog.isNone(bot.look.pose) then "pose_wave" else bot.look.pose)
	end
	task.delay(Config.SHOWCASE_SECONDS_PER_LOOK - walkTime - 0.5, function()
		if model.Parent then
			model:SetAttribute("Walking", nil)
		end
	end)
end

-- A twirl at the end of the runway (one full turn, ending face to the crowd).
function BotService.twirl(root: BasePart)
	local pos = root.Position
	for i = 1, 16 do
		root.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.pi + i / 16 * math.pi * 2, 0)
		task.wait(0.05)
	end
	root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
end

-- Bots are kind judges: every real look gets 4 or 5 hearts from them.
function BotService.voteFor(entry)
	for _, bot in bots do
		task.delay(rng:NextNumber(1.5, 5), function()
			if entry.votes then
				entry.votes[bot.userId] = if rng:NextNumber() < 0.6 then 5 else 4
			end
		end)
	end
end

-- Pets trot after their bots (called every frame with the others).
function BotService.followPets(dt: number)
	for _, bot in bots do
		if bot.pet and bot.pet.Parent and bot.model then
			Pets.follow(bot.pet, bot.model, dt)
		end
	end
end

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Saves each player's coins, unlocked items and Super Soaps between visits.

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = {}

export type Profile = {
	coins: number,
	owned: { [string]: boolean },
	stats: { shows: number, wins: number, bestStars: number, totalStars: number },
	lastDay: number, -- last day a daily gift was given (days since 1970)
	streak: number, -- days played in total (the gift calendar never resets)
	giftsGiven: number, -- day-7 accessories collected
	friends: { [string]: { visits: number, skin: number, eyes: number } }, -- regular clients
	lookbook: { any }, -- saved finished looks, newest first
	week: number, -- which week the weekly goal counts (weeks since 1970)
	weekShows: number,
	weekClaimed: boolean,
	weeklyGiven: number, -- weekly prizes collected
	lookbookChanged: boolean?, -- not saved: send the Look Book with the next push
	lookbookSent: boolean?, -- not saved: the player has the Look Book already
	receipts: { string },
	passes: { [string]: boolean }, -- not saved; checked with Roblox every visit
	canSave: boolean, -- false if loading failed, so we never overwrite good data with an empty profile
}

local profiles: { [Player]: Profile } = {}

-- While a server has a player's data open it stamps it with its JobId, so a second server
-- (e.g. the player quickly hopped servers) waits instead of loading old coins.
local LOCK_SECONDS = Config.AUTOSAVE_SECONDS + 60

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[GlowUp] Saving is off (turn on 'Enable Studio Access to API Services' to test it):", result)
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function newProfile(saved): Profile
	saved = saved or {}
	local stats = saved.stats or {}
	return {
		coins = tonumber(saved.coins) or Config.STARTING_COINS,
		owned = saved.owned or {},
		stats = {
			shows = stats.shows or 0,
			wins = stats.wins or 0,
			bestStars = stats.bestStars or 0,
			totalStars = stats.totalStars or 0,
		},
		lastDay = tonumber(saved.lastDay) or 0,
		streak = tonumber(saved.streak) or 0,
		giftsGiven = tonumber(saved.giftsGiven) or 0,
		friends = saved.friends or {},
		lookbook = saved.lookbook or {},
		week = tonumber(saved.week) or 0,
		weekShows = tonumber(saved.weekShows) or 0,
		weekClaimed = saved.weekClaimed == true,
		weeklyGiven = tonumber(saved.weeklyGiven) or 0,
		receipts = saved.receipts or {},
		passes = {},
		canSave = true,
	}
end

local function checkPasses(player: Player, profile: Profile)
	for name, id in Config.GamePasses do
		if RunService:IsStudio() and Config.STUDIO_OWNS_ALL_PASSES then
			profile.passes[name] = true
		elseif id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			profile.passes[name] = ok and owns == true
		end
	end
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

-- Waits (a little) for a player's data to finish loading.
function DataService.waitFor(player: Player): Profile?
	local deadline = os.clock() + 15
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Sends the player's latest coins/unlocks to their screen.
function DataService.push(player: Player)
	local p = profiles[player]
	if p then
		Remotes.Profile:FireClient(player, {
			coins = p.coins,
			owned = p.owned,
			passes = p.passes,
			totalStars = p.stats.totalStars,
			calendarDay = p.streak,
			-- the Look Book is only sent when it changed (it's the biggest part)
			lookbook = if p.lookbookChanged or not p.lookbookSent then p.lookbook else nil,
			weekShows = if p.week == DataService.weekNumber() then p.weekShows else 0,
			weekClaimed = p.week == DataService.weekNumber() and p.weekClaimed,
			weeklyNext = Catalog.WeeklyItems[p.weeklyGiven + 1],
		})
		p.lookbookChanged = false
		p.lookbookSent = true
	end
end

function DataService.addCoins(player: Player, amount: number)
	local p = profiles[player]
	if amount ~= amount or math.abs(amount) == math.huge then
		return
	end
	if p then
		p.coins = math.max(0, p.coins + math.floor(amount))
		DataService.push(player)
	end
end

-- True when coins and unlocks are really being saved (false in Studio without API access).
function DataService.savingEnabled(): boolean
	return store ~= nil
end

local function lockedByOtherServer(old): boolean
	return old ~= nil and old.session ~= nil and old.session ~= game.JobId and os.time() - (old.lockTime or 0) < LOCK_SECONDS
end

-- Saves a player's data. `release` clears this server's lock (when the player leaves).
function DataService.save(player: Player, release: boolean?): boolean
	local p = profiles[player]
	if not p or not p.canSave or not store then
		return false
	end
	for attempt = 1, 3 do
		local wrote = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOtherServer(old) then
					return nil -- another server has newer data; don't overwrite it
				end
				wrote = true
				-- Built here (not before the loop) so a retry always saves the newest values
				return {
					coins = p.coins,
					owned = p.owned,
							stats = p.stats,
					receipts = p.receipts,
					lastDay = p.lastDay,
					streak = p.streak,
					giftsGiven = p.giftsGiven,
					friends = p.friends,
					lookbook = p.lookbook,
					week = p.week,
					weekShows = p.weekShows,
					weekClaimed = p.weekClaimed,
					weeklyGiven = p.weeklyGiven,
					session = if release then nil else game.JobId,
					lockTime = os.time(),
				}
			end)
		end)
		if ok then
			if not wrote then
				warn("[GlowUp] Not saving " .. player.Name .. ": their data is open on another server")
			end
			return wrote
		end
		warn("[GlowUp] Save failed (try " .. attempt .. "):", err)
		task.wait(attempt)
	end
	return false
end

-- Days and weeks change at 05:00 UTC (midnight in New York, 9pm in Los Angeles) so most kids
-- in the US get a new day in the morning. Weeks start on Monday.
local DAY_OFFSET = 5 * 3600
function DataService.dayNumber(): number
	return (os.time() - DAY_OFFSET) // 86400
end
function DataService.weekNumber(): number
	return (os.time() - DAY_OFFSET + 3 * 86400) // 604800
end

-- The daily gift calendar: a prize for each new day played. Missing a day just pauses it.
local function giveDailyGift(player: Player, profile: Profile)
	local today = DataService.dayNumber()
	if profile.lastDay >= today then
		return
	end
	profile.lastDay = today
	profile.streak += 1
	local day = (profile.streak - 1) % 7 + 1
	local info = { kind = "daily", day = day, coins = 0, item = nil :: string? }
	if day < 7 then
		info.coins = Config.CALENDAR_COINS[day]
	else
		local giftId = Catalog.GiftItems[profile.giftsGiven + 1]
		if giftId then
			profile.giftsGiven += 1
			profile.owned[giftId] = true
			info.item = Catalog.byId[giftId].name
		else
			info.coins = Config.CALENDAR_DAY7_COINS
		end
	end
	profile.coins += info.coins
	task.delay(3, function()
		if player.Parent then
			Remotes.Celebrate:FireClient(player, info)
			DataService.push(player)
		end
	end)
end

-- Called at the start of each round for players who stayed past midnight.
function DataService.checkDaily(player: Player)
	local profile = profiles[player]
	if profile then
		giveDailyGift(player, profile)
	end
end

local function load(player: Player)
	local saved = nil
	local loaded = store == nil -- no store (e.g. Studio without API access): play with a fresh profile
	if store then
		for attempt = 1, 8 do
			local claimed = false
			local ok, result = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					-- After ~20 seconds of waiting, take over a lock that was never released
					if lockedByOtherServer(old) and attempt < 8 then
						saved = old
						return nil
					end
					claimed = true
					saved = old
					local new = old or {}
					new.session = game.JobId
					new.lockTime = os.time()
					return new
				end)
			end)
			if ok and claimed then
				loaded = true
				break
			end
			if not ok and RunService:IsStudio() then
				-- Usually "Enable Studio Access to API Services" is off. Play without saving.
				warn("[GlowUp] Saving is off in Studio:", result)
				store = nil
				loaded = true
				saved = nil
				break
			end
			if not ok then
				warn("[GlowUp] Load failed (try " .. attempt .. "):", result)
			end
			task.wait(3)
		end
	end
	if not player.Parent then
		return
	end

	local profile = newProfile(saved)
	profile.canSave = loaded and store ~= nil
	if not loaded then
		Remotes.Notify:FireClient(player, "Couldn't load your saved coins. Progress this visit won't be saved.")
	end
	checkPasses(player, profile)
	giveDailyGift(player, profile)
	profiles[player] = profile
	DataService.push(player)
end

function DataService.init()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player, true)
		profiles[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Starts the game on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local RoundService = require(script.Parent.RoundService)
local ShopService = require(script.Parent.ShopService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local world = WorldBuilder.build()
task.spawn(Avatar.preload) -- the clients' bodies and hair, for the makeover, runway and podium

DataService.init()
ShopService.init()
RoundService.init(world)

Remotes.Hello.OnServerInvoke = function(player: Player)
	local snapshot = RoundService.snapshot(player)
	DataService.push(player)
	return snapshot
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- Runs the game loop that everyone in the server plays together:
--   Intermission -> Makeover (5 minutes) -> Fashion Show -> Results -> repeat

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Clients = require(ReplicatedStorage.Shared.Clients)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Progress = require(ReplicatedStorage.Shared.Progress)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Pets = require(ReplicatedStorage.Shared.Pets)
local RunService = game:GetService("RunService")
local Scoring = require(ReplicatedStorage.Shared.Scoring)

local BotService = require(script.Parent.BotService)
local DataService = require(script.Parent.DataService)
local StarHunt = require(script.Parent.StarHunt)
local WorldBuilder = require(script.Parent.WorldBuilder)

local RoundService = {}

type Entry = {
	player: Player,
	client: Clients.Client,
	look: { [string]: string },
	clean: number,
	rinsed: boolean,
	done: boolean,
	votes: { [number]: number }, -- voter UserId -> stars
	assignedAt: number,
	pet: Model?, -- their pet, trotting after them during the round
}

local world: WorldBuilder.World
local rng = Random.new()

local state = {
	phase = "Waiting",
	endsAt = 0,
	themeId = Catalog.Themes[1].id,
	eventId = nil :: string?,
	bots = true, -- Style Bots fill in when there are only a few real players
}
local entries: { [number]: Entry } = {} -- by UserId
local showcase = nil -- payload of the look currently on the runway
local results = nil -- payload of the last results
local spawnedModels: { Model } = {}
local resultsFor, sendResults, strikePose -- defined below
local decorated = false

local WALK_ANIMATION = "rbxassetid://507777826" -- Roblox's default R15 walk
local REACTIONS = { ["😍"] = true, ["👏"] = true, ["🔥"] = true, ["✨"] = true, ["💖"] = true }
local lastReaction: { [Player]: number } = {}
local lastCheer: { [Player]: number } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function setState(phase: string, seconds: number)
	state.seq = (state.seq or 0) + 1
	state.phase = phase
	state.endsAt = now() + seconds
	Remotes.State:FireAllClients(state)
end

local function theme(): Catalog.Theme
	return Catalog.themeById[state.themeId]
end

local function entryPayload(entry: Entry)
	return {
		client = entry.client,
		look = entry.look,
		clean = entry.clean,
		rinsed = entry.rinsed,
		done = entry.done,
	}
end

local function hasPass(player: Player, pass: string): boolean
	local profile = DataService.get(player)
	return profile ~= nil and profile.passes[pass] == true
end

------------------------------------------------------------------------------
-- Makeover

-- Puts the entry's look on the player's real character (everyone sees it), and keeps their pet.
local function dressCharacter(entry: Entry)
	local character = entry.player.Character
	if not character or not character.Parent then
		return
	end
	-- always a happy face: a smile, and a big grin once the look is really good
	local stars = Scoring.judge(entry, theme())
	Avatar.dress(character, entry.client, entry.look, { clean = 1, mood = if stars >= 4 then "grin" else "smile", brushed = true })
	local petId = entry.look.pet
	if not entry.pet or entry.pet:GetAttribute("PetId") ~= petId then
		if entry.pet then
			entry.pet:Destroy()
			entry.pet = nil
		end
		local pet = Pets.build(petId)
		local root = character:FindFirstChild("HumanoidRootPart")
		if pet and root and root:IsA("BasePart") then
			pet:SetAttribute("PetId", petId)
			pet.Name = entry.player.Name .. "'s Pet"
			pet:PivotTo(root.CFrame * CFrame.new(2.6, -3, 0.6))
			pet.Parent = world.folder
			entry.pet = pet
		end
	end
end

-- Gets the character ready for the round (own body and skin, classic head, own hair and clothes
-- off) and puts the look on. Also used when someone respawns in the middle of a round.
local function prepareCharacter(entry: Entry)
	local character = entry.player.Character
	if not character then
		return
	end
	local skin = Avatar.prepareCharacter(character)
	if skin then
		entry.client.skin = skin
		local index = tonumber(string.match(Catalog.closestSkin(skin), "%d+"))
		entry.client.skinIndex = index or entry.client.skinIndex
	end
	dressCharacter(entry)
end

-- Each player dresses up themselves, in their own avatar.
local function assignClient(player: Player)
	local entry: Entry = {
		player = player,
		client = Clients.forPlayer(player.DisplayName, 7),
		look = Catalog.defaultLook(),
		clean = 1, -- no washing: you come in fresh
		rinsed = true,
		done = false,
		votes = {},
		assignedAt = now(),
	}
	entry.client.wishes = Scoring.themeWishes(theme(), state.eventId, rng)
	entries[player.UserId] = entry
	-- their real skin goes in the payload, so the menus' little faces match them
	prepareCharacter(entry)
	Remotes.AssignClient:FireClient(player, entryPayload(entry))
end

local function activeEntry(player: Player): Entry?
	if state.phase ~= "Makeover" then
		return nil
	end
	return entries[player.UserId]
end

local function allDone(): boolean
	local any = false
	for _, entry in entries do
		if entry.player.Parent then
			any = true
			if not entry.done then
				return false
			end
		end
	end
	return any
end

local function onUpdateLook(player: Player, key: unknown, itemId: unknown)
	local entry = activeEntry(player)
	if not entry or type(key) ~= "string" or type(itemId) ~= "string" then
		return
	end
	local it = Catalog.byId[itemId]
	if not it or it.category ~= key then
		return
	end
	if not Catalog.isUnlocked(it, DataService.get(player), state.eventId) then
		Remotes.Notify:FireClient(player, "Unlock " .. it.name .. " in the shop first!")
		return
	end
	entry.look[key] = itemId
	if not entry.redressQueued then
		entry.redressQueued = true
		task.delay(0.15, function()
			entry.redressQueued = false
			if entries[player.UserId] == entry and state.phase == "Makeover" then
				dressCharacter(entry)
			end
		end)
	end
	-- Holiday items you used during the event are yours to keep afterwards
	if it.event then
		local profile = DataService.get(player)
		if profile and not profile.owned[it.id] then
			profile.owned[it.id] = true
		end
	end
end

local function onWashProgress(player: Player, clean: unknown, rinsed: unknown)
	local entry = activeEntry(player)
	if not entry or type(clean) ~= "number" or clean ~= clean then
		return
	end
	-- Nobody can really wash a face in under 4 seconds, so don't trust faster claims
	local possible = (now() - entry.assignedAt) / 4
	entry.clean = math.max(entry.clean, math.min(math.clamp(clean, 0, 1), possible))
	entry.rinsed = rinsed == true
end

local function onDone(player: Player, isDone: unknown)
	local entry = activeEntry(player)
	if entry then
		entry.done = isDone == true
	end
end

------------------------------------------------------------------------------
-- Runway models

local function buildBlockModel(skin: Color3, top: Color3, bottom: Color3): Model
	local model = Instance.new("Model")
	local function block(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.CanCollide = false
		p.CFrame = CFrame.new(offset)
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), top)
	root.Transparency = 1
	local parts = {
		block("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), top),
		block("LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), bottom),
		block("RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), bottom),
		block("LeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), skin),
		block("RightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), skin),
		block("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), skin),
	}
	for _, p in parts do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
	end
	model.PrimaryPart = root
	return model
end

local function rootHeight(model: Model): number
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return 3
end

-- Makes the 3D client wearing the look the stylist designed: a real Roblox character with
-- their hair, makeup face, outfit and accessory.
local function buildClientModel(entry: Entry): Model
	local stars = Scoring.judge(entry, theme())
	local model = Avatar.new(entry.client)
	if model then
		-- everyone sees the client washed and happy; the judges' tips stay private
		Avatar.dress(model, entry.client, entry.look, {
			clean = 1,
			mood = if stars >= 4 then "grin" else "smile",
			brushed = entry.look.hairStyle ~= "hair_messy",
		})
	else
		local outfit = Catalog.byId[entry.look.outfit]
		local top = if outfit and outfit.color then outfit.color else Color3.new(0.5, 0.5, 0.5)
		model = buildBlockModel(entry.client.skin, top, outfit and outfit.accent or top)
	end
	model.Name = entry.client.name
	model:SetAttribute("Pet", entry.look.pet) -- each screen walks the pet alongside (Showcase)

	-- a little trail of stars behind every look, and the player's name over their head
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local tag = Instance.new("BillboardGui")
		tag.Name = "NameTag"
		tag.Size = UDim2.fromScale(6, 1)
		tag.StudsOffset = Vector3.new(0, 3.2, 0)
		tag.LightInfluence = 0
		tag.MaxDistance = 120
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.Text = entry.client.name
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(176, 18, 91)
		label.TextStrokeColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.Parent = tag
		tag.Parent = head
	end
	if root then
		local trail = Instance.new("ParticleEmitter")
		trail.Name = "StarTrail"
		trail.Texture = Config.Textures.Star
		trail.Rate = 8
		trail.Lifetime = NumberRange.new(1, 1.6)
		trail.Speed = NumberRange.new(1, 2)
		trail.SpreadAngle = Vector2.new(180, 180)
		trail.Size = NumberSequence.new(0.5, 0)
		trail.LightEmission = 0.6
		trail.Color = ColorSequence.new(theme().color, Color3.new(1, 1, 1))
		trail.Parent = root
	end

	if root and hasPass(entry.player, "RunwayStar") then
		Instance.new("Sparkles").Parent = root
	end

	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
		end
	end
	model.Parent = world.folder
	table.insert(spawnedModels, model)
	return model
end


local function placeModel(model: Model, groundPosition: Vector3, facing: Vector3): BasePart
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	local pos = groundPosition + Vector3.new(0, rootHeight(model), 0)
	root.CFrame = CFrame.lookAt(pos, pos + facing)
	return root
end

local function playWalk(model: Model): AnimationTrack?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = WALK_ANIMATION
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track:Play()
		return track
	end
	return nil
end

local function clearModels()
	for _, m in spawnedModels do
		m:Destroy()
	end
	table.clear(spawnedModels)
end

-- Asks a player's screen to play a pose on their own character (it replicates to everyone).
function strikePose(character: Model, poseId: string?)
	if poseId and not Catalog.isNone(poseId) then
		character:SetAttribute("Pose", poseId .. "|" .. tostring(os.clock()))
	end
end

-- Everyone not on the runway sits in the audience seats along it.
local function seatAudience(except: Player?, exceptModel: Model?)
	local seats = {}
	for _, d in world.folder.Runway:GetChildren() do
		if d:IsA("Seat") and d.Name == "AudienceSeat" and not d.Occupant then
			table.insert(seats, d)
		end
	end
	for _, player in Players:GetPlayers() do
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if player ~= except and humanoid and not humanoid.SeatPart and #seats > 0 then
			local seat = table.remove(seats, 1)
			player.Character:PivotTo(seat.CFrame + Vector3.new(0, 3, 0))
			seat:Sit(humanoid)
		end
	end
	for _, bot in BotService.list() do
		local humanoid = bot.model and bot.model:FindFirstChildOfClass("Humanoid")
		if bot.model and bot.model ~= exceptModel and humanoid and not humanoid.SeatPart and #seats > 0 then
			local seat = table.remove(seats, 1)
			bot.busy = true
			bot.model:PivotTo(seat.CFrame + Vector3.new(0, 3, 0))
			seat:Sit(humanoid)
		end
	end
end

-- How many Style Bots this round needs.
local function wantedBots(): number
	if not state.bots then
		return 0
	end
	return math.max(0, Config.BOTS_FILL_TO - #Players:GetPlayers())
end

local unseat = Avatar.unseat

-- The player's own character walks the runway (their pet trots along), then strikes their pose.
-- If they have no character (just left), a stand-in model walks instead.
local function walkRunway(entry: Entry)
	local character = entry.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (character and humanoid and root and root:IsA("BasePart")) then
		local model = buildClientModel(entry)
		model:SetAttribute("Walking", true)
		local r = placeModel(model, world.runwayStart, Vector3.new(0, 0, 1))
		local walk = playWalk(model)
		local walkTime = Config.SHOWCASE_SECONDS_PER_LOOK * 0.6
		local target = world.runwayEnd + Vector3.new(0, rootHeight(model), 0)
		model:SetAttribute("WalkFrom", r.Position)
		model:SetAttribute("WalkTo", target)
		model:SetAttribute("WalkStart", now())
		model:SetAttribute("WalkTime", walkTime)
		task.wait(walkTime)
		if walk then
			walk:Stop()
		end
		Avatar.pose(model, entry.look.pose)
		return
	end

	unseat(character)
	task.wait(0.1)
	local height = humanoid.HipHeight + root.Size.Y / 2
	local start = world.runwayStart + Vector3.new(0, height, 0)
	character:PivotTo(CFrame.lookAt(start, start + Vector3.new(0, 0, 1)))
	if entry.pet then
		entry.pet:PivotTo(CFrame.new(world.runwayStart + Vector3.new(2.6, 0, 0)))
	end
	character:SetAttribute("Walking", true) -- the runway camera follows them
	if hasPass(entry.player, "RunwayStar") then
		for _, emitter in world.confetti do
			emitter:Emit(80)
		end
		local sparkles = Instance.new("Sparkles")
		sparkles.Name = "RunwayStar"
		sparkles.Parent = root
		task.delay(Config.SHOWCASE_SECONDS_PER_LOOK, function()
			sparkles:Destroy()
		end)
	end

	-- A player's own device moves their character, so the walk and the pose are asked for with
	-- attributes, and their screen does them (see Main.client)
	local walkTime = Config.SHOWCASE_SECONDS_PER_LOOK * 0.6
	character:SetAttribute("RunwaySpeed", (world.runwayEnd - world.runwayStart).Magnitude / walkTime)
	character:SetAttribute("WalkTarget", world.runwayEnd)
	local started = os.clock()
	while os.clock() - started < walkTime + 1.5 and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(world.runwayEnd.X, 0, world.runwayEnd.Z)).Magnitude > 1.5 do
		task.wait(0.1)
	end
	character:SetAttribute("WalkTarget", nil) -- their screen faces them to the crowd and twirls
	task.wait(0.9)
	strikePose(character, entry.look.pose)
	task.delay(Config.SHOWCASE_SECONDS_PER_LOOK - walkTime - 0.5, function()
		if character.Parent then
			character:SetAttribute("Walking", nil)
		end
	end)
end

-- Pets trot after their owners all round long.
local function followPets(dt: number)
	for _, entry in entries do
		local character = entry.player.Character
		if entry.pet and entry.pet.Parent and character then
			Pets.follow(entry.pet, character, dt)
		end
	end
end

-- After the show everyone gets their own look back.
local function restoreEveryone()
	for _, entry in entries do
		if entry.pet then
			entry.pet:Destroy()
			entry.pet = nil
		end
		if entry.player.Parent then
			task.spawn(function()
				pcall(function()
					entry.player:LoadCharacter()
				end)
			end)
		end
	end
end

------------------------------------------------------------------------------
-- Voting

local function onVote(player: Player, targetUserId: unknown, stars: unknown)
	if state.phase ~= "Showcase" or not showcase or showcase.userId ~= targetUserId then
		return
	end
	-- Votes are kind: only 3, 4 or 5 stars (this also rejects NaN, which would break scores and coins)
	if player.UserId == targetUserId or type(stars) ~= "number" or not (stars >= 3 and stars <= 5) or stars % 1 ~= 0 then
		return
	end
	local entry: any = entries[targetUserId :: number] or BotService.byUserId(targetUserId :: number)
	if not entry then
		return
	end
	local firstVote = entry.votes[player.UserId] == nil
	entry.votes[player.UserId] = stars
	if firstVote then
		DataService.addCoins(player, Config.COINS_PER_VOTE)
	end
end

-- The crowd went wild for this walk: fireworks over the runway, and coins if it's a real player.
local function crowdGoesWild(walk)
	WorldBuilder.fireworks()
	local player = Players:GetPlayerByUserId(walk.userId)
	if player then
		DataService.addCoins(player, Config.COINS_CROWD_FAVORITE)
		Remotes.Notify:FireClient(player, "🎆 The crowd went WILD for you! +" .. Config.COINS_CROWD_FAVORITE .. " 💰")
	end
end

-- One cheer from the audience (a player or a Style Bot). Each walk has a cheer meter; filling it
-- sets off the fireworks.
local function cheer(emoji: string, fromUserId: number?)
	local walk = showcase
	if state.phase == "Showcase" and walk and not walk.wild and fromUserId ~= walk.userId then
		walk.cheers = (walk.cheers or 0) + 1
		if walk.cheers >= (walk.goal or Config.CHEER_GOAL) then
			walk.wild = true
			crowdGoesWild(walk)
		end
		Remotes.Reaction:FireAllClients(emoji, walk.cheers, walk.goal or Config.CHEER_GOAL)
	else
		Remotes.Reaction:FireAllClients(emoji)
	end
end

-- Style Bots in the audience cheer a few times during each walk (not their own).
local BOT_CHEERS = { "😍", "👏", "🔥", "✨", "💖" }
local function botsCheer(walk)
	local watching = #Players:GetPlayers() + #BotService.list() - 1
	walk.goal = math.clamp(3 * watching, 4, Config.CHEER_GOAL)
	for _, bot in BotService.list() do
		if bot.userId ~= walk.userId then
			for _ = 1, rng:NextInteger(2, 4) do
				task.delay(rng:NextNumber(1, Config.SHOWCASE_SECONDS_PER_LOOK - 1), function()
					if showcase == walk then
						cheer(BOT_CHEERS[rng:NextInteger(1, #BOT_CHEERS)], bot.userId)
					end
				end)
			end
		end
	end
end

local function onReact(player: Player, emoji: unknown)
	if state.phase ~= "Showcase" and state.phase ~= "Results" then
		return
	end
	if type(emoji) ~= "string" or not REACTIONS[emoji] then
		return
	end
	local t = os.clock()
	if lastReaction[player] and t - lastReaction[player] < 0.35 then
		return
	end
	lastReaction[player] = t
	cheer(emoji, player.UserId)
	-- the cheering player's avatar cheers in the audience too (at most every few seconds)
	if player.Character and (not lastCheer[player] or t - lastCheer[player] > 2.5) then
		lastCheer[player] = t
		strikePose(player.Character, "pose_cheer")
	end
end

------------------------------------------------------------------------------
-- Results

local function scoreAll()
	local rows = {}
	local count = 0
	for _, bot in BotService.list() do
		count += 1
		local judgeStars, comments = Scoring.judge(bot, theme())
		local votes = {}
		for _, v in bot.votes do
			table.insert(votes, v)
		end
		local final = Scoring.final(judgeStars, votes)
		table.insert(rows, {
			userId = bot.userId,
			bot = true,
			stylist = bot.name .. " 🤖",
			client = bot.client,
			look = bot.look,
			clean = 1,
			judgeStars = judgeStars,
			voteCount = #votes,
			score = final,
			stars = Scoring.roundToHalf(final),
			comments = comments,
			coins = 0,
			spotless = true,
		})
	end
	for userId, entry in entries do
		if entry.player.Parent then
			count += 1
			local judgeStars, comments = Scoring.judge(entry, theme())
			local votes = {}
			for _, v in entry.votes do
				table.insert(votes, v)
			end
			local final = Scoring.final(judgeStars, votes)
			table.insert(rows, {
				userId = userId,
				stylist = entry.player.DisplayName,
				client = entry.client,
				look = entry.look,
				clean = entry.clean,
				judgeStars = judgeStars,
				voteCount = #votes,
				score = final,
				stars = Scoring.roundToHalf(final),
				comments = comments,
				coins = 0,
				spotless = entry.clean >= 0.98 and entry.rinsed,
			})
		end
	end
	-- Style Bots are there to keep a kid company, not to beat her: every bot lands below the
	-- lowest real player (half a star under, at least), so a kid playing alone always wins.
	local lowestReal = math.huge
	for _, row in rows do
		if not row.bot then
			lowestReal = math.min(lowestReal, row.score)
		end
	end
	if lowestReal < math.huge then
		for _, row in rows do
			if row.bot and row.score > lowestReal - 0.5 then
				row.score = math.max(0.5, lowestReal - 0.5 - rng:NextNumber(0, 0.4))
				row.stars = Scoring.roundToHalf(row.score)
			end
		end
	end
	table.sort(rows, function(a, b)
		if (a.bot == true) ~= (b.bot == true) then
			return not a.bot
		end
		return a.score > b.score
	end)

	-- Everyone gets a different award (best scorers pick first)
	local taken = {}
	for _, row in rows do
		local entry: any = entries[row.userId] or BotService.byUserId(row.userId)
		local scores = Scoring.awardScores(entry, theme())
		local best, bestScore = nil, 0.2
		for _, award in Scoring.AWARDS do
			local score = scores[award.id] or 0
			if not taken[award.id] and score > bestScore then
				best, bestScore = award.id, score
			end
		end
		if best then
			taken[best] = true
		end
		row.award = Scoring.awardName(best or Scoring.FALLBACK_AWARD.id, theme())
	end

	local realPlayers = 0
	for _, row in rows do
		if not row.bot then
			realPlayers += 1
		end
	end
	for rank, row in rows do
		row.rank = rank
		if row.bot then
			continue -- Style Bots don't earn coins or save anything
		end
		local player = entries[row.userId].player
		local wishes = entries[row.userId].client.wishes or {}
		local granted = 0
		for _, w in wishes do
			if Scoring.wishMet(w, entries[row.userId].look) then
				granted += 1
			end
		end
		row.ribbon = Scoring.ribbon(row.stars, granted, #wishes)
		local coins = Config.COINS_PARTICIPATION + math.floor(row.score * Config.COINS_PER_STAR)
		if row.spotless then
			coins += Config.COINS_SPOTLESS_BONUS
		end
		-- coins for each wish the client got
		for _, w in entries[row.userId].client.wishes do
			if Scoring.wishMet(w, entries[row.userId].look) then
				coins += Config.COINS_PER_WISH
			end
		end
		if realPlayers >= 2 and Config.COINS_PLACEMENT[rank] then
			coins += Config.COINS_PLACEMENT[rank]
		end
		-- playing with a friend pays a little more
		for _, other in Players:GetPlayers() do
			if other ~= player then
				local ok, friends = pcall(function()
					return player:IsFriendsWith(other.UserId)
				end)
				if ok and friends then
					coins = math.floor(coins * (1 + Config.FRIEND_BONUS))
					row.friendBonus = true
					break
				end
			end
		end
		if hasPass(player, "DoubleCoins") then
			coins *= 2
		end
		row.coins = coins
		DataService.addCoins(player, coins)

		local profile = DataService.get(player)
		if profile then
			local oldLevel = Progress.level(profile.stats.totalStars)
			profile.stats.shows += 1
			profile.stats.totalStars += row.stars
			profile.stats.bestStars = math.max(profile.stats.bestStars, row.stars)
			if rank == 1 and realPlayers >= 2 then
				profile.stats.wins += 1
			end
			local newLevel = Progress.level(profile.stats.totalStars)
			row.level = newLevel

			local entry = entries[row.userId]
			local client = entry.client

			-- Idle players (nothing changed) don't fill the Look Book or the weekly goal
			local default = Catalog.defaultLook()
			local touched = false
			for k, v in entry.look do
				if default[k] ~= v then
					touched = true
				end
			end

			-- Weekly goal: play a few shows this week for a prize
			local week = DataService.weekNumber()
			if profile.week ~= week then
				profile.week, profile.weekShows, profile.weekClaimed = week, 0, false
			end
			if touched then
				profile.weekShows += 1
			end
			if profile.weekShows >= Config.WEEKLY_GOAL_SHOWS and not profile.weekClaimed then
				profile.weekClaimed = true
				local prizeId = Catalog.WeeklyItems[profile.weeklyGiven + 1]
				local info = { kind = "weekly", coins = 0, item = nil :: string? }
				if prizeId then
					profile.weeklyGiven += 1
					profile.owned[prizeId] = true
					info.item = Catalog.byId[prizeId].name
				else
					info.coins = Config.WEEKLY_GOAL_COINS
					profile.coins += info.coins
				end
				task.delay(8, function()
					if player.Parent then
						Remotes.Celebrate:FireClient(player, info)
					end
				end)
			end

			-- Save the look in the Look Book (newest first)
			table.insert(profile.lookbook, if touched then 1 else #profile.lookbook + 1, {
				name = client.name,
				skin = client.skinIndex,
				eyes = client.eyesIndex,
				look = table.clone(entry.look),
				theme = state.themeId,
				stars = row.stars,
				award = row.award,
			})
			if not touched then
				table.remove(profile.lookbook) -- don't keep untouched looks
			end
			while #profile.lookbook > Config.LOOKBOOK_SIZE do
				table.remove(profile.lookbook)
			end
			profile.lookbookChanged = true
			if newLevel > oldLevel then
				task.delay(4, function()
					if player.Parent then
						Remotes.Celebrate:FireClient(player, { kind = "level", level = newLevel, title = Progress.title(newLevel) })
					end
				end)
			end
			DataService.push(player)
		end
	end
	return rows
end

-- Each player gets the results with only their OWN judge tips (the others' stay private).
function resultsFor(player: Player, all)
	local rows = {}
	for _, row in all.rows do
		local copy = table.clone(row)
		if row.userId ~= player.UserId then
			copy.comments = {}
		end
		table.insert(rows, copy)
	end
	return { themeId = all.themeId, rows = rows }
end

function sendResults()
	for _, player in Players:GetPlayers() do
		Remotes.Results:FireClient(player, resultsFor(player, results))
	end
end

------------------------------------------------------------------------------
-- Main loop

local function runRound()
	-- Intermission: everyone back in their own look
	results = nil
	showcase = nil
	restoreEveryone()
	table.clear(entries)
	while #Players:GetPlayers() < Config.MIN_PLAYERS do
		setState("Waiting", 0)
		task.wait(2)
	end
	-- A new day may have started for players who stayed in the game
	for _, player in Players:GetPlayers() do
		DataService.checkDaily(player)
	end

	-- Holiday events: switch decorations, and use the holiday theme about half the time
	local event = Events.current(now())
	local eventId = event and event.id or nil
	if eventId ~= state.eventId or not decorated then
		state.eventId = eventId
		decorated = true
		WorldBuilder.setDecor(eventId)
	end
	if event and rng:NextNumber() < Config.EVENT_THEME_CHANCE then
		state.themeId = event.theme
	else
		local everyday = {}
		for _, t in Catalog.Themes do
			if not t.event then
				table.insert(everyday, t.id)
			end
		end
		state.themeId = everyday[rng:NextInteger(1, #everyday)]
	end
	setState("Intermission", Config.INTERMISSION_SECONDS)
	StarHunt.spawn(world.folder)
	BotService.ensure(wantedBots())
	BotService.hangOut()
	task.wait(Config.INTERMISSION_SECONDS)

	-- Makeover: 5 minutes!
	StarHunt.clear()
	setState("Makeover", Config.MAKEOVER_SECONDS)
	-- getting each avatar ready takes a moment, so everyone is set up side by side
	for _, player in Players:GetPlayers() do
		task.spawn(assignClient, player)
	end
	BotService.ensure(wantedBots())
	BotService.startMakeover(Config.MAKEOVER_SECONDS)
	local hurried = false
	while now() < state.endsAt do
		task.wait(0.5)
		if allDone() then
			break
		end
		if not hurried then
			local playing, done = 0, 0
			for _, entry in entries do
				if entry.player.Parent then
					playing += 1
					if entry.done then
						done += 1
					end
				end
			end
			if playing >= 2 and done * 2 >= playing and state.endsAt - now() > Config.HURRY_SECONDS then
				hurried = true
				setState("Makeover", Config.HURRY_SECONDS)
				for _, entry in entries do
					if entry.player.Parent and not entry.done then
						Remotes.Notify:FireClient(entry.player, "⏰ Hurry! Your friends are ready. " .. Config.HURRY_SECONDS .. " seconds left!")
					end
				end
			end
		end
	end

	-- Fashion show
	local order: { any } = {}
	for _, entry in entries do
		table.insert(order, entry)
	end
	for _, bot in BotService.list() do
		table.insert(order, bot)
	end
	rng:Shuffle(order)
	local function present(e): boolean
		return if e.bot then e.model ~= nil and e.model.Parent ~= nil else e.player.Parent ~= nil
	end
	local index = 0
	for _, entry in order do
		if entry.bot and present(entry) then
			index += 1
			local total = 0
			for _, e in order do
				if present(e) then
					total += 1
				end
			end
			showcase = {
				userId = entry.userId,
				stylist = entry.name .. " 🤖",
				vip = false,
				level = 1,
				client = entry.client,
				look = entry.look,
				clean = 1,
				index = index,
				total = math.max(total, index),
			}
			setState("Showcase", Config.SHOWCASE_SECONDS_PER_LOOK)
			Remotes.Showcase:FireAllClients(showcase)
			botsCheer(showcase)
			seatAudience(nil, entry.model)
			local started = os.clock()
			BotService.walkRunway(entry)
			task.wait(math.max(0, Config.SHOWCASE_SECONDS_PER_LOOK - (os.clock() - started)))
		elseif not entry.bot and present(entry) then
			index += 1
			local total = 0
			for _, e in order do
				if present(e) then
					total += 1
				end
			end
			showcase = {
				userId = entry.player.UserId,
				stylist = entry.player.DisplayName,
				vip = hasPass(entry.player, "VIP"),
				level = Progress.level((DataService.get(entry.player) or { stats = { totalStars = 0 } }).stats.totalStars),
				client = entry.client,
				look = entry.look,
				clean = 1, -- shown tidy on the big screen
				index = index,
				total = math.max(total, index),
			}
			setState("Showcase", Config.SHOWCASE_SECONDS_PER_LOOK)
			Remotes.Showcase:FireAllClients(showcase)
			botsCheer(showcase)
			seatAudience(entry.player)
			BotService.voteFor(entry)
			local started = os.clock()
			walkRunway(entry)
			task.wait(math.max(0, Config.SHOWCASE_SECONDS_PER_LOOK - (os.clock() - started)))
			clearModels()
		end
	end
	showcase = nil

	-- Results
	local rows = scoreAll()
	if #rows > 0 then
		for _, player in Players:GetPlayers() do
			Remotes.Notify:FireClient(player, "🥁 And the winners are...")
		end
		task.wait(1.6)
		results = { themeId = state.themeId, rows = rows }
		sendResults()
		WorldBuilder.fireworks()
		setState("Results", Config.RESULTS_SECONDS)
		-- The top 3 stand on the podium in their looks; everyone else gathers in front
		for _, row in rows do
			local bot = if row.bot then BotService.byUserId(row.userId) else nil
			if bot and bot.model then
				Avatar.unseat(bot.model)
				bot.busy = true
				local spot = world.podium[row.rank] or (world.podium[1] + Vector3.new((row.rank - 5) * 3, -world.podium[1].Y, 9))
				Avatar.place(bot.model, spot, Vector3.new(0, 0, 1))
				if row.rank == 1 then
					Avatar.pose(bot.model, "pose_cheer")
				end
				continue
			end
			local entry = entries[row.userId]
			local character = entry and entry.player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if character and humanoid and root and root:IsA("BasePart") then
				unseat(character)
				local spot = world.podium[row.rank] or (world.podium[1] + Vector3.new((row.rank - 5) * 3, -world.podium[1].Y, 9))
				local pos = spot + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2 + 0.1, 0)
				local place = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
				character:PivotTo(place)
				-- their own device moves them (it owns the character); a fresh value each time
				character:SetAttribute("PlaceAt", nil)
				character:SetAttribute("PlaceAt", place)
				if row.rank == 1 then
					strikePose(character, "pose_cheer")
				end
			elseif entry and row.rank <= 3 then
				local model = buildClientModel(entry)
				placeModel(model, world.podium[row.rank], Vector3.new(0, 0, 1))
				Avatar.idle(model)
			end
		end
		task.wait(Config.RESULTS_SECONDS)
		clearModels()
	end
end

-- Everything a player needs when they join or their screen restarts.
function RoundService.snapshot(player: Player)
	local entry = entries[player.UserId]
	return {
		state = state,
		entry = if entry and state.phase == "Makeover" then entryPayload(entry) else nil,
		showcase = if state.phase == "Showcase" then showcase else nil,
		results = if state.phase == "Results" and results then resultsFor(player, results) else nil,
	}
end

function RoundService.init(builtWorld: WorldBuilder.World)
	world = builtWorld

	Remotes.UpdateLook.OnServerEvent:Connect(onUpdateLook)
	Remotes.WashProgress.OnServerEvent:Connect(onWashProgress)
	Remotes.Done.OnServerEvent:Connect(onDone)
	Remotes.Vote.OnServerEvent:Connect(onVote)
	Remotes.React.OnServerEvent:Connect(onReact)

	-- Late joiners still get a client if a makeover is running
	Players.PlayerAdded:Connect(function(player)
		if state.phase == "Makeover" and not entries[player.UserId] then
			DataService.waitFor(player)
			if state.phase == "Makeover" and player.Parent then
				assignClient(player)
			end
		end
	end)
	-- Respawning in the middle of a round puts the look straight back on
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			local entry = entries[player.UserId]
			if entry and (state.phase == "Makeover" or state.phase == "Showcase") then
				task.wait(0.5)
				prepareCharacter(entry)
			end
		end)
	end)
	RunService.Heartbeat:Connect(function(dt)
		followPets(dt)
		BotService.followPets(dt)
	end)
	BotService.init(world, theme)
	-- The lobby's Style Bots switch (one switch for the whole server)
	local lastBotsToggle: { [Player]: number } = {}
	local lastAnyToggle = 0
	Remotes.SetBots.OnServerEvent:Connect(function(player, on: unknown)
		if type(on) ~= "boolean" or on == state.bots then
			return
		end
		local t = os.clock()
		if t - lastAnyToggle < 1 or (lastBotsToggle[player] and t - lastBotsToggle[player] < 3) then
			return
		end
		lastAnyToggle = t
		lastBotsToggle[player] = t
		state.bots = on
		Remotes.State:FireAllClients(state)
		if state.phase == "Intermission" or state.phase == "Waiting" then
			BotService.ensure(wantedBots())
			BotService.hangOut()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastBotsToggle[player] = nil
		local entry = entries[player.UserId]
		if entry and entry.pet then
			entry.pet:Destroy()
		end
		entries[player.UserId] = nil
		lastReaction[player] = nil
		lastCheer[player] = nil
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(runRound)
			if not ok then
				warn("[GlowUp] Round error:", err)
				clearModels()
				task.wait(3)
			end
		end
	end)
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Unlocking items with coins, plus Robux Game Passes and Developer Products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

local MAX_RECEIPTS = 50

local function buyItem(player: Player, itemId: unknown): (boolean, string)
	if type(itemId) ~= "string" then
		return false, "That item doesn't exist."
	end
	local profile = DataService.get(player)
	local it = Catalog.byId[itemId]
	if not profile or not it or it.hidden or it.pass or it.price <= 0 then
		return false, "That item can't be bought with coins."
	end
	if profile.owned[it.id] then
		return true, "You already have " .. it.name .. "!"
	end
	local event = Events.current(Workspace:GetServerTimeNow())
	if not Catalog.isAvailable(it, profile, event and event.id) then
		return false, it.name .. " is only here during its holiday event."
	end
	if profile.coins < it.price then
		return false, "You need " .. (it.price - profile.coins) .. " more coins."
	end
	profile.coins -= it.price
	profile.owned[it.id] = true
	DataService.push(player)
	return true, "Unlocked " .. it.name .. "! ✨"
end

local function productName(productId: number): string?
	for name, id in Config.DevProducts do
		if id ~= 0 and id == productId then
			return name
		end
	end
	return nil
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local profile = player and DataService.get(player)
	if not player or not profile then
		-- They left or their data isn't loaded yet; Roblox will try again next time they join.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(profile.receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if not profile.canSave and DataService.savingEnabled() then
		-- Their saved data didn't load, so we couldn't keep this purchase. Roblox will retry next visit.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local name = productName(receipt.ProductId)
	if name and Config.CoinPackAmounts[name] then
		profile.coins += Config.CoinPackAmounts[name]
		Remotes.Notify:FireClient(player, "+" .. Config.CoinPackAmounts[name] .. " coins! 💰")
	else
		warn("[GlowUp] Unknown product purchased:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(profile.receipts, receipt.PurchaseId)
	while #profile.receipts > MAX_RECEIPTS do
		table.remove(profile.receipts, 1)
	end
	DataService.push(player)

	-- Only confirm the purchase once it's safely saved (or saving is off in Studio).
	if profile.canSave and not DataService.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.init()
	Remotes.BuyItem.OnServerInvoke = buyItem
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local profile = DataService.get(player)
		if not profile then
			return
		end
		for name, id in Config.GamePasses do
			if id == passId then
				profile.passes[name] = true
				Remotes.Notify:FireClient(player, "Thank you! Your Game Pass is ready to use! 💖")
			end
		end
		DataService.push(player)
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">StarHunt</string>
          <string name="Source"><![CDATA[-- Something to chase between rounds: glowing stars pop up around the rooftop during the lobby.
-- Run into one to grab it for a couple of coins (first one there gets it). They vanish when the
-- makeover starts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local StarHunt = {}

local rng = Random.new()
local folder: Folder? = nil

-- Open floor where a star can sit: the plaza between the Dressing Hall and the runway, and the
-- front of the hall (clear of the stations, the runway and the podium).
local AREAS = {
	{ minX = -40, maxX = 40, minZ = 2, maxZ = 28 },
	{ minX = -34, maxX = 34, minZ = 31, maxZ = 49 },
}

local function spot(): Vector3
	local area = AREAS[rng:NextInteger(1, #AREAS)]
	return Vector3.new(rng:NextNumber(area.minX, area.maxX), 2.4, rng:NextNumber(area.minZ, area.maxZ))
end

function StarHunt.clear()
	if folder then
		folder:Destroy()
		folder = nil
	end
end

function StarHunt.spawn(parent: Instance)
	StarHunt.clear()
	local stars = Instance.new("Folder")
	stars.Name = "StarHunt"
	folder = stars
	for _ = 1, Config.HUNT_STARS do
		local position = spot()
		local star = Instance.new("Part")
		star.Name = "HuntStar"
		star.Shape = Enum.PartType.Ball
		star.Size = Vector3.new(1.6, 1.6, 1.6)
		star.Material = Enum.Material.Neon
		star.Color = Color3.fromRGB(255, 214, 80)
		star.Transparency = 0.25
		star.Anchored = true
		star.CanCollide = false
		star.CastShadow = false
		star.Position = position
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromScale(3.2, 3.2)
		billboard.LightInfluence = 0
		billboard.Parent = star
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "⭐"
		label.TextScaled = true
		label.Parent = billboard
		local glitter = Instance.new("ParticleEmitter")
		glitter.Texture = Config.Textures.Star
		glitter.Color = ColorSequence.new(Color3.fromRGB(255, 240, 160))
		glitter.Size = NumberSequence.new(0.3, 0)
		glitter.Lifetime = NumberRange.new(0.6, 1)
		glitter.Speed = NumberRange.new(1, 2)
		glitter.SpreadAngle = Vector2.new(180, 180)
		glitter.Rate = 5
		glitter.LightEmission = 1
		glitter.Parent = star
		star.Parent = stars
		-- bob up and down so they catch the eye
		TweenService:Create(star, TweenInfo.new(0.9 + rng:NextNumber(0, 0.4), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
			Position = position + Vector3.new(0, 0.9, 0),
		}):Play()
		local taken = false
		star.Touched:Connect(function(hit)
			if taken then
				return
			end
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			local root = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not (root and root:IsA("BasePart")) or (root.Position - star.Position).Magnitude > 8 then
				return
			end
			taken = true
			local finder = player :: Player
			DataService.addCoins(finder, Config.COINS_PER_HUNT_STAR)
			Remotes.Collected:FireClient(finder, Config.COINS_PER_HUNT_STAR)
			star:Destroy()
		end)
	end
	stars.Parent = parent
end

return StarHunt
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- Builds the salon, runway, big screen, audience seats and winners' podium when the game starts.
-- Building with code means the place works straight away; you can still decorate around it in Studio.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Stations = require(ReplicatedStorage.Shared.Stations)

local WorldBuilder = {}

export type World = {
	folder: Folder,
	screen: BasePart,
	runwayStart: Vector3, -- runway floor height where clients start walking
	runwayEnd: Vector3,
	podium: { Vector3 }, -- top of 1st, 2nd, 3rd place blocks
	confetti: { ParticleEmitter },
}

local rgb = Color3.fromRGB
local PINK = rgb(255, 120, 190)
local PURPLE = rgb(150, 90, 220)
local GOLD = rgb(245, 200, 70)

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function sign(p: BasePart, face: Enum.NormalId, text: string, textColor: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = textColor
	label.Parent = gui
	gui.Parent = p
end

local function ball(parent: Instance, name: string, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): Part
	local p = part(parent, name, Vector3.new(diameter, diameter, diameter), CFrame.new(position), color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

local function plant(parent: Instance, position: Vector3)
	local pot = part(parent, "Pot", Vector3.new(2.4, 2.6, 2.6), CFrame.new(position + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 255, 255))
	pot.Shape = Enum.PartType.Cylinder
	ball(parent, "Leaves", 4, position + Vector3.new(0, 4, 0), rgb(110, 200, 120), Enum.Material.Grass)
	ball(parent, "Flower", 1, position + Vector3.new(0.8, 5.6, 0.6), rgb(255, 120, 180))
	ball(parent, "Flower", 0.9, position + Vector3.new(-1, 5.2, -0.4), rgb(255, 220, 90))
end

-- Lighting for everyday and for each holiday event
local LOOKS = {
	everyday = { clock = 14.5, tint = rgb(255, 245, 252), air = rgb(255, 214, 236), decay = rgb(200, 170, 255), strip = PINK },
	halloween = { clock = 18.4, tint = rgb(250, 230, 255), air = rgb(200, 150, 255), decay = rgb(255, 140, 60), strip = rgb(255, 130, 30) },
	thanksgiving = { clock = 16.8, tint = rgb(255, 238, 220), air = rgb(255, 210, 160), decay = rgb(230, 140, 80), strip = rgb(255, 160, 50) },
	christmas = { clock = 15.5, tint = rgb(245, 250, 255), air = rgb(225, 240, 255), decay = rgb(180, 210, 255), strip = rgb(230, 40, 50) },
}

-- Soft, glowy, pastel look for the whole game
local function setupLighting(look)
	for _, effect in Lighting:GetChildren() do
		if effect.Name == "GlowUp" then
			effect:Destroy()
		end
	end
	Lighting.ClockTime = look.clock
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GlowUp"
	bloom.Intensity = 0.45
	bloom.Size = 28
	bloom.Threshold = 1.9
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "GlowUp"
	color.Saturation = 0.15
	color.Brightness = 0.03
	color.Contrast = 0.05
	-- only a whisper of the event tint, so skin keeps its real color under the lights
	color.TintColor = look.tint:Lerp(rgb(255, 255, 255), 0.6)
	Lighting.Ambient = rgb(120, 110, 125)
	Lighting.OutdoorAmbient = rgb(150, 140, 155)
	color.Parent = Lighting
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "GlowUp"
	atmosphere.Density = 0.28
	atmosphere.Color = look.air
	atmosphere.Decay = look.decay
	atmosphere.Haze = 0.6
	atmosphere.Glare = 0
	atmosphere.Parent = Lighting
end

-- An emoji floating in the air (bats, ghosts, leaves, snowflakes)
local function floater(parent: Instance, emoji: string, position: Vector3, size: number)
	local anchor = part(parent, "Floater", Vector3.new(0.2, 0.2, 0.2), CFrame.new(position), rgb(255, 255, 255))
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(size, size)
	gui.LightInfluence = 0
	gui.MaxDistance = 300
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = emoji
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = anchor
end

local function pumpkin(parent: Instance, position: Vector3, size: number)
	local body = ball(parent, "Pumpkin", size, position + Vector3.new(0, size / 2, 0), rgb(245, 130, 30))
	local stem = part(parent, "Stem", Vector3.new(size * 0.25, size * 0.12, size * 0.12), CFrame.new(position + Vector3.new(0, size * 1.02, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(70, 130, 50))
	stem.Shape = Enum.PartType.Cylinder
	local face = Instance.new("SurfaceGui")
	face.Face = Enum.NormalId.Back
	face.LightInfluence = 0
	face.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	face.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "▲ ▲\n◡◡◡"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = rgb(60, 25, 10)
	label.Parent = face
	face.Parent = body
end

local function christmasTree(parent: Instance, position: Vector3, height: number)
	local trunk = part(parent, "Trunk", Vector3.new(height * 0.15, height * 0.12, height * 0.12), CFrame.new(position + Vector3.new(0, height * 0.075, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 70, 40))
	trunk.Shape = Enum.PartType.Cylinder
	local layers = 8
	for i = 0, layers - 1 do
		local w = height * (0.66 - i * 0.075)
		local y = height * (0.2 + i * 0.09)
		local green = if i % 2 == 0 then rgb(40, 140, 70) else rgb(55, 165, 85)
		local layer = part(parent, "Branches", Vector3.new(height * 0.1, w, w), CFrame.new(position + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)), green)
		layer.Shape = Enum.PartType.Cylinder
		local colors = { rgb(230, 40, 50), GOLD, rgb(90, 170, 255), PINK }
		for j = 0, (if i % 2 == 0 then 4 else -1) do
			local a = math.rad(j * 72 + i * 25)
			ball(parent, "Ornament", height * 0.05, position + Vector3.new(math.cos(a) * w * 0.47, y - height * 0.05, math.sin(a) * w * 0.47), colors[(i + j) % #colors + 1], Enum.Material.Neon)
		end
	end
	ball(parent, "TreeStar", height * 0.1, position + Vector3.new(0, height * 0.95, 0), GOLD, Enum.Material.Neon)
end

local function present(parent: Instance, position: Vector3, size: number, color: Color3)
	part(parent, "Present", Vector3.new(size, size * 0.8, size), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), color)
	part(parent, "Ribbon", Vector3.new(size * 1.02, size * 0.82, size * 0.18), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), rgb(255, 255, 255))
	part(parent, "Ribbon", Vector3.new(size * 0.18, size * 0.82, size * 1.02), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), rgb(255, 255, 255))
end

local function autumnTree(parent: Instance, position: Vector3)
	local trunk = part(parent, "Trunk", Vector3.new(7, 1.4, 1.4), CFrame.new(position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 70, 40))
	trunk.Shape = Enum.PartType.Cylinder
	ball(parent, "Leaves", 7, position + Vector3.new(0, 9, 0), rgb(230, 110, 30), Enum.Material.Grass)
	ball(parent, "Leaves", 5, position + Vector3.new(1.8, 10.5, 1), rgb(200, 60, 30), Enum.Material.Grass)
	ball(parent, "Leaves", 4.5, position + Vector3.new(-2, 10, -1), rgb(240, 180, 40), Enum.Material.Grass)
end

-- Spots around the salon, runway and podium where decorations go
local DECOR_SPOTS = {
	Vector3.new(-42, 0, 38), Vector3.new(42, 0, 38), Vector3.new(-42, 0, 62), Vector3.new(42, 0, 62),
	Vector3.new(-18, 0, -30), Vector3.new(18, 0, -30), Vector3.new(-22, 0, -50), Vector3.new(22, 0, -50),
	Vector3.new(-52, 0, -8), Vector3.new(-16, 0, 6), Vector3.new(10, 0, 20), Vector3.new(-10, 0, 20),
}

local built = nil

-- The salon is a rooftop party: the building's edge drops away to a glowing city, glass railings
-- run round the roof, string lights hang over the plaza, and a red carpet leads from the Dressing
-- Hall to the runway.
local function buildRooftop(parent: Instance)
	local roof = Instance.new("Folder")
	roof.Name = "Rooftop"
	roof.Parent = parent
	local minX, maxX, minZ, maxZ = -80, 80, -80, 110
	local midZ = (minZ + maxZ) / 2

	-- the building under the roof (so the floor doesn't end in thin air)
	local facade = rgb(64, 44, 92)
	part(roof, "RoofEdge", Vector3.new(maxX - minX + 2, 80, 2), CFrame.new(0, -41, minZ - 1), facade)
	part(roof, "RoofEdge", Vector3.new(maxX - minX + 2, 80, 2), CFrame.new(0, -41, maxZ + 1), facade)
	part(roof, "RoofEdge", Vector3.new(2, 80, maxZ - minZ + 2), CFrame.new(minX - 1, -41, midZ), facade)
	part(roof, "RoofEdge", Vector3.new(2, 80, maxZ - minZ + 2), CFrame.new(maxX + 1, -41, midZ), facade)

	-- glass railings with a glowing gold top rail
	local function railing(a: Vector3, b: Vector3)
		local cf = CFrame.lookAt((a + b) / 2, b)
		local length = (b - a).Magnitude
		local glass = part(roof, "RailGlass", Vector3.new(0.3, 3.4, length), cf + Vector3.new(0, 1.7, 0), rgb(200, 230, 255), Enum.Material.Glass)
		glass.Transparency = 0.6
		local rail = part(roof, "RailTop", Vector3.new(0.5, 0.4, length), cf + Vector3.new(0, 3.5, 0), GOLD, Enum.Material.Neon)
		rail.CastShadow = false
	end
	local inset = 0.5
	railing(Vector3.new(minX + inset, 0, minZ + inset), Vector3.new(maxX - inset, 0, minZ + inset))
	railing(Vector3.new(minX + inset, 0, maxZ - inset), Vector3.new(maxX - inset, 0, maxZ - inset))
	railing(Vector3.new(minX + inset, 0, minZ + inset), Vector3.new(minX + inset, 0, maxZ - inset))
	railing(Vector3.new(maxX - inset, 0, minZ + inset), Vector3.new(maxX - inset, 0, maxZ - inset))

	-- the city at night: towers all around, with rows of lit windows
	local rng = Random.new(7) -- the same city every time
	local windowColors = { rgb(255, 214, 140), rgb(255, 150, 205), rgb(150, 220, 255), rgb(205, 170, 255) }
	for i = 1, 44 do
		local a = (i / 44) * math.pi * 2 + rng:NextNumber(-0.04, 0.04)
		local distance = rng:NextNumber(135, 185)
		local x, z = math.cos(a) * distance, midZ + math.sin(a) * distance * 1.1
		local w, d = rng:NextNumber(14, 26), rng:NextNumber(14, 26)
		local top = rng:NextNumber(-30, 55)
		local bottom = -140
		local tone = rng:NextInteger(0, 18)
		part(roof, "Tower", Vector3.new(w, top - bottom, d), CFrame.new(x, (top + bottom) / 2, z), rgb(30 + tone, 24 + tone, 58 + tone)).CastShadow = false
		local glow = windowColors[rng:NextInteger(1, #windowColors)]
		for y = top - 5, math.max(top - 48, -70), -6 do
			if rng:NextNumber() < 0.7 then
				local band = part(roof, "Windows", Vector3.new(w + 0.2, 0.9, d + 0.2), CFrame.new(x, y, z), glow, Enum.Material.Neon)
				band.CastShadow = false
				band.Color = glow:Lerp(rgb(40, 30, 70), 0.25) -- (a little dimmer instead of see-through: cheaper on tablets)
			end
		end
		if top > 35 then
			-- a little red light on the tallest roofs
			ball(roof, "BeaconLight", 1.4, Vector3.new(x, top + 1, z), rgb(255, 70, 90), Enum.Material.Neon)
		end
	end

	-- string lights over the plaza between the Dressing Hall and the runway
	local bulbColors = { rgb(255, 230, 150), PINK, rgb(140, 220, 255), GOLD }
	for i, z in { 24, 12, 0 } do
		for _, x in { -46, 46 } do
			part(roof, "LightPole", Vector3.new(0.7, 19, 0.7), CFrame.new(x, 9.5, z), rgb(60, 48, 84), Enum.Material.Metal)
			ball(roof, "PoleCap", 1.2, Vector3.new(x, 19.2, z), GOLD, Enum.Material.Neon)
		end
		for k = 0, 30 do
			local t = k / 30
			local bulb = ball(roof, "Bulb", 0.55, Vector3.new(-46 + 92 * t, 18 - math.sin(t * math.pi) * 3.5, z), bulbColors[(k + i) % #bulbColors + 1], Enum.Material.Neon)
			bulb.CanCollide = false
			bulb.CastShadow = false
		end
	end

	-- a red carpet out of the Dressing Hall, with gold posts and velvet ropes (it ends behind the
	-- show camera so the posts never get in the runway shot)
	part(roof, "RedCarpet", Vector3.new(6, 0.12, 15), CFrame.new(0, 0.06, 22.5), rgb(196, 28, 78), Enum.Material.Fabric)
	for _, x in { -3.8, 3.8 } do
		local last: Vector3? = nil
		for z = 28, 16, -6 do
			local post = Vector3.new(x, 0, z)
			local pole = part(roof, "Stanchion", Vector3.new(0.35, 3, 0.35), CFrame.new(post + Vector3.new(0, 1.5, 0)), GOLD, Enum.Material.Metal)
			pole.CanCollide = false
			ball(roof, "StanchionTop", 0.7, post + Vector3.new(0, 3.1, 0), GOLD, Enum.Material.Metal).CanCollide = false
			if last then
				local a, b = last + Vector3.new(0, 2.2, 0), post + Vector3.new(0, 2.2, 0)
				local rope = part(roof, "VelvetRope", Vector3.new(0.25, 0.25, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), rgb(140, 0, 45), Enum.Material.Fabric)
				rope.CanCollide = false
			end
			last = post
		end
	end
end

-- Swaps in the decorations and lighting for a holiday event (or nil for everyday).
function WorldBuilder.setDecor(eventId: string?)
	if not built then
		return
	end
	local old = built.folder:FindFirstChild("Decor")
	if old then
		old:Destroy()
	end
	local look = LOOKS[eventId or "everyday"] or LOOKS.everyday
	setupLighting(look)
	for _, p in built.folder:GetDescendants() do
		if p:IsA("BasePart") and p.Name == "LightStrip" then
			p.Color = look.strip
			local light = p:FindFirstChildOfClass("PointLight")
			if light then
				light.Color = look.strip
			end
		end
	end
	if not eventId then
		return
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	if eventId == "halloween" then
		for i, spot in DECOR_SPOTS do
			pumpkin(decor, spot, if i % 3 == 0 then 3.2 else 2.4)
			pumpkin(decor, spot + Vector3.new(2.6, 0, 1), 1.6)
		end
		for i = 1, 10 do
			floater(decor, if i % 3 == 0 then "👻" else "🦇", Vector3.new(-16 + (i % 5) * 8, 16 + (i % 3) * 3, -50 + i * 6), 3)
		end
		for i = 1, 6 do
			local side = if i % 2 == 0 then 1 else -1
			floater(decor, "🦇", Vector3.new(side * (24 + i * 2), 13 + (i % 3) * 2.5, 52), 2.5)
		end
	elseif eventId == "thanksgiving" then
		for i, spot in DECOR_SPOTS do
			if i % 2 == 0 then
				autumnTree(decor, spot)
			else
				part(decor, "HayBale", Vector3.new(4, 2.4, 2.6), CFrame.new(spot + Vector3.new(0, 1.2, 0)), rgb(230, 200, 110), Enum.Material.Sand)
				pumpkin(decor, spot + Vector3.new(0, 2.4, 0), 1.6)
			end
			for j = 0, 4 do
				ball(decor, "Leaf", 0.9, spot + Vector3.new(3 + (j % 3) * 0.8, 0.2, -1 + j * 0.5), ({ rgb(220, 90, 30), rgb(200, 50, 30), rgb(240, 180, 40) })[j % 3 + 1])
			end
		end
		for i = 1, 12 do
			floater(decor, if i % 2 == 0 then "🍂" else "🍁", Vector3.new(-18 + (i % 6) * 7, 12 + (i % 4) * 3, -52 + i * 8), 2.2)
		end
	elseif eventId == "christmas" then
		for i, spot in DECOR_SPOTS do
			if i % 2 == 1 then
				christmasTree(decor, spot, if i <= 4 then 16 else 12)
			end
			local colors = { rgb(230, 40, 50), rgb(40, 150, 70), GOLD, PURPLE }
			present(decor, spot + Vector3.new(3, 0, 2), 1.8, colors[i % #colors + 1])
			present(decor, spot + Vector3.new(-2.5, 0, 2.5), 1.3, colors[(i + 1) % #colors + 1])
			part(decor, "Snow", Vector3.new(10, 0.25, 8), CFrame.new(spot + Vector3.new(0, 0.12, 0)), rgb(250, 252, 255), Enum.Material.Snow)
		end
		local cloud = part(decor, "SnowCloud", Vector3.new(160, 1, 190), CFrame.new(0, 60, 10), rgb(255, 255, 255))
		cloud.Transparency = 1
		cloud.CanCollide = false
		cloud.CanQuery = false
		local snow = Instance.new("ParticleEmitter")
		snow.Rate = 120
		snow.Lifetime = NumberRange.new(10, 14)
		snow.Speed = NumberRange.new(4, 7)
		snow.Size = NumberSequence.new(0.35)
		snow.EmissionDirection = Enum.NormalId.Bottom
		snow.SpreadAngle = Vector2.new(15, 15)
		snow.LightEmission = 0.3
		snow.Texture = Config.Textures.Circle
		snow.Parent = cloud
		for i = 1, 8 do
			floater(decor, "❄️", Vector3.new(-16 + (i % 4) * 10, 15 + (i % 3) * 3, -50 + i * 8), 2.4)
		end
	end
	decor.Parent = built.folder
end

local function cameraMarker(parent: Instance, name: string, from: Vector3, to: Vector3)
	local p = part(parent, name, Vector3.new(1, 1, 1), CFrame.lookAt(from, to), Color3.new(1, 1, 1))
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
end

-- The Dressing Hall: a glowing pad, a sign and a few props for each station (see Shared.Stations).
local function buildStations(salon: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Stations"
	folder.Parent = salon
	for _, s in Stations.list do
		local pad = part(folder, "Pad_" .. s.id, Vector3.new(0.3, Stations.PAD_RADIUS * 2, Stations.PAD_RADIUS * 2), CFrame.new(s.pad) * CFrame.Angles(0, 0, math.rad(90)), s.color, Enum.Material.Neon)
		pad.Shape = Enum.PartType.Cylinder
		pad.Transparency = 0.35
		pad.CanCollide = false
		pad:SetAttribute("Station", s.id)
		-- A floating sign over each pad, readable from the salon floor
		local board = part(folder, "Sign_" .. s.id, Vector3.new(9, 2.4, 0.4), CFrame.lookAt(s.pad + Vector3.new(0, 10.5, 0), s.pad + Vector3.new(0, 10.5, 0) + s.facing), rgb(255, 255, 255))
		board.CanCollide = false
		sign(board, Enum.NormalId.Front, s.icon .. " " .. s.name, s.color:Lerp(rgb(40, 20, 60), 0.35))
		local beam = Instance.new("PointLight")
		beam.Color = s.color
		beam.Range = 10
		beam.Brightness = 0.7
		beam.Parent = pad
	end

	-- Props that say what each station is for
	local hair = Stations.byTab.Hair.pad
	part(folder, "Dryer", Vector3.new(2.2, 1.6, 2.2), CFrame.new(hair + Vector3.new(0, 5.6, 4.6)), rgb(240, 240, 250), Enum.Material.Metal).Shape = Enum.PartType.Ball
	local face = Stations.byTab.Face.pad
	for i, c in { rgb(255, 60, 120), rgb(200, 30, 60), rgb(255, 140, 180) } do
		part(folder, "Lipstick", Vector3.new(0.5, 1.4, 0.5), CFrame.new(face + Vector3.new(-2 + i, 3.9, 9.3)), c)
	end
	local outfit = Stations.byTab.Outfit.pad
	part(folder, "RackBar", Vector3.new(8, 0.2, 0.2), CFrame.new(outfit + Vector3.new(0, 6.2, 8.6)), rgb(200, 200, 210), Enum.Material.Metal)
	for i, c in { rgb(255, 120, 190), rgb(90, 160, 255), rgb(245, 200, 70), rgb(130, 210, 90), rgb(170, 120, 230) } do
		part(folder, "Shirt", Vector3.new(1.2, 2.2, 0.3), CFrame.new(outfit + Vector3.new(-3.2 + i * 1.3, 4.9, 8.6)), c, Enum.Material.Fabric)
	end
	local costume = Stations.byTab.Costume.pad
	part(folder, "Trunk", Vector3.new(4, 2, 2.4), CFrame.new(costume + Vector3.new(3.5, 1, 6)), rgb(140, 80, 40), Enum.Material.Wood)
	part(folder, "Cape", Vector3.new(2.4, 3.6, 0.2), CFrame.new(costume + Vector3.new(-3.6, 3.6, 8.2)), rgb(220, 30, 50), Enum.Material.Fabric)
	local show = Stations.byTab.Show.pad
	local stage = part(folder, "PoseStage", Vector3.new(0.5, 9.5, 9.5), CFrame.new(show + Vector3.new(0, -0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), GOLD, Enum.Material.SmoothPlastic)
	stage.Shape = Enum.PartType.Cylinder
	stage.CanCollide = false
	local light = part(folder, "StageLight", Vector3.new(1.2, 1.2, 1.2), CFrame.new(show + Vector3.new(0, 13, 0)), rgb(255, 250, 230), Enum.Material.Neon)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Color = rgb(255, 240, 220)
	spot.Range = 16
	spot.Brightness = 1.6
	spot.Angle = 45
	spot.Parent = light
	local pet = Stations.byTab.Pet.pad
	local grass = part(folder, "PetGrass", Vector3.new(14, 0.15, 12), CFrame.new(pet + Vector3.new(2, -0.12, 0)), rgb(120, 200, 110), Enum.Material.Grass)
	grass.CanCollide = false
	for _, z in { -6, 6 } do
		part(folder, "Fence", Vector3.new(14, 1.4, 0.3), CFrame.new(pet + Vector3.new(2, 0.7, z)), rgb(255, 255, 255), Enum.Material.Wood)
	end
	local house = pet + Vector3.new(7, 0, 0)
	part(folder, "DogHouse", Vector3.new(3.4, 2.8, 3.4), CFrame.new(house + Vector3.new(0, 1.4, 0)), rgb(255, 176, 96), Enum.Material.WoodPlanks)
	part(folder, "DogDoor", Vector3.new(0.12, 1.8, 1.4), CFrame.new(house + Vector3.new(-1.72, 0.95, 0)), rgb(70, 36, 40))
	-- a beam turned on its edge makes the pitched roof (the lower half hides inside the walls)
	part(folder, "DogRoof", Vector3.new(4, 2.7, 2.7), CFrame.new(house + Vector3.new(0, 2.8, 0)) * CFrame.Angles(math.rad(45), 0, 0), rgb(214, 60, 96), Enum.Material.WoodPlanks)
	ball(folder, "DogBowl", 0.9, pet + Vector3.new(4.6, 0.2, 2.2), rgb(90, 160, 255))
end

-- Somewhere to hang out between rounds: step on the floor and you dance (see Main.client)
local function buildDanceFloor(salon: Instance)
	local floor = Instance.new("Folder")
	floor.Name = "DanceFloor"
	floor.Parent = salon
	local center = Vector3.new(-24, 0.25, 39)
	local colors = { PINK, PURPLE, GOLD, rgb(90, 200, 255) }
	local tiles = {}
	for ix = -2, 1 do
		for iz = -2, 1 do
			local t = part(floor, "DanceTile", Vector3.new(2.9, 0.3, 2.9), CFrame.new(center + Vector3.new(ix * 3 + 1.5, 0, iz * 3 + 1.5)), colors[(ix + iz) % 4 + 1], Enum.Material.Neon)
			t.CanCollide = false
			table.insert(tiles, t)
		end
	end
	local board = part(floor, "DanceSign", Vector3.new(9, 2.4, 0.4), CFrame.lookAt(center + Vector3.new(0, 9, 0), center + Vector3.new(1, 9, 0)), rgb(255, 255, 255))
	board.CanCollide = false
	sign(board, Enum.NormalId.Front, "🕺 Dance Floor 💃", PURPLE)
	floor:SetAttribute("Center", center)
	floor:SetAttribute("Radius", 6)
	local marker = part(floor, "DanceHere", Vector3.new(0.5, 0.5, 0.5), CFrame.new(center + Vector3.new(0, 5.5, 0)), PINK)
	marker.Transparency = 1
	marker.CanCollide = false
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(150, 54)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 90
	billboard.Parent = marker
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = rgb(190, 20, 105)
	label.TextColor3 = rgb(255, 255, 255)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "💃 Dance here!"
	label.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = label
	-- the tiles twinkle through the colors
	task.spawn(function()
		local step = 0
		while floor.Parent do
			step += 1
			for i, t in tiles do
				t.Color = colors[(i + step) % #colors + 1]
			end
			task.wait(0.6)
		end
	end)
end

-- Life in the Dressing Hall: a disco ball over the dance floor, string lights, wall lights that
-- drift through the colors, floating sparkles, balloon bunches, and a photo booth (Main.client
-- does the 3-2-1 and the flash when you step on its pad).
local function buildAtmosphere(salon: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Atmosphere"
	folder.Parent = salon
	local colors = { PINK, PURPLE, GOLD, rgb(90, 200, 255), rgb(120, 220, 140) }

	-- Disco ball with spinning colored spots over the dance floor
	local floor = salon:FindFirstChild("DanceFloor")
	local center = floor and floor:GetAttribute("Center") or Vector3.new(-24, 0, 39)
	local disco = part(folder, "DiscoBall", Vector3.new(3.4, 3.4, 3.4), CFrame.new(center + Vector3.new(0, 12, 0)), rgb(232, 232, 245), Enum.Material.Foil)
	disco.Shape = Enum.PartType.Ball
	disco.Reflectance = 0.45
	local shine = Instance.new("PointLight")
	shine.Range = 8
	shine.Brightness = 0.8
	shine.Color = rgb(255, 240, 255)
	shine.Parent = disco
	disco.CanCollide = false
	part(folder, "DiscoString", Vector3.new(0.1, 6, 0.1), CFrame.new(center + Vector3.new(0, 16.6, 0)), rgb(200, 200, 210)).CanCollide = false
	local spots = {}
	for i, c in { PINK, rgb(90, 200, 255), GOLD } do
		local s = Instance.new("SpotLight")
		s.Color = c
		s.Range = 18
		s.Brightness = 1.4
		s.Angle = 35
		s.Face = Enum.NormalId.Bottom
		local holder = part(folder, "DiscoSpot" .. i, Vector3.new(0.2, 0.2, 0.2), disco.CFrame, c)
		holder.Transparency = 1
		holder.CanCollide = false
		s.Parent = holder
		table.insert(spots, holder)
	end
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = Config.Textures.Star
	sparkle.Color = ColorSequence.new(rgb(255, 240, 255), rgb(255, 190, 230))
	sparkle.Size = NumberSequence.new(0.35, 0)
	sparkle.Lifetime = NumberRange.new(1.5, 2.5)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Rate = 6
	sparkle.LightEmission = 0.7
	sparkle.Parent = disco

	-- String lights along the top of the back wall and over the entrance
	for x = -34, 34, 2 do
		local bulb = part(folder, "Bulb", Vector3.new(0.6, 0.6, 0.6), CFrame.new(x, 20.5 - math.abs(math.sin(x / 4)) * 0.8, 69.2), colors[(x // 2) % #colors + 1], Enum.Material.Neon)
		bulb.Shape = Enum.PartType.Ball
		bulb.CanCollide = false
		bulb.CastShadow = false
	end

	-- Wall lights that drift slowly through the colors
	local wallLights = {}
	for _, x in { -30, -10, 10, 30 } do
		local lamp = part(folder, "WallLamp", Vector3.new(1.4, 1.4, 0.4), CFrame.new(x, 13, 69.4), rgb(255, 255, 255), Enum.Material.Neon)
		lamp.CanCollide = false
		local l = Instance.new("PointLight")
		l.Range = 22
		l.Brightness = 0.7
		l.Parent = lamp
		table.insert(wallLights, { lamp = lamp, light = l })
	end

	-- Sparkles floating in the air of the hall
	local air = part(folder, "HallSparkles", Vector3.new(60, 1, 30), CFrame.new(0, 16, 50), rgb(255, 255, 255))
	air.Transparency = 1
	air.CanCollide = false
	local float = Instance.new("ParticleEmitter")
	float.Texture = Config.Textures.Star
	float.Color = ColorSequence.new(rgb(255, 220, 245), rgb(220, 200, 255))
	float.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) })
	float.Lifetime = NumberRange.new(4, 7)
	float.Speed = NumberRange.new(0.5, 1.5)
	float.SpreadAngle = Vector2.new(180, 180)
	float.Rate = 10
	float.LightEmission = 0.6
	float.Shape = Enum.ParticleEmitterShape.Box
	float.Parent = air

	-- Balloon bunches beside each station
	for i, s in Stations.list do
		local base = s.pad + Vector3.new(if i % 2 == 0 then 5.5 else -5.5, 0, 2)
		for k = 0, 2 do
			local c = colors[(i + k) % #colors + 1]
			local pos = base + Vector3.new((k - 1) * 0.9, 7 + (k % 2) * 0.8, 0)
			ball(folder, "Balloon", 1.6, pos, c).Reflectance = 0.15
			part(folder, "BalloonString", Vector3.new(0.05, 6, 0.05), CFrame.new(pos - Vector3.new(0, 3.6, 0)), rgb(255, 255, 255)).CanCollide = false
		end
	end

	-- Photo booth by the entrance, facing into the hall: a frame, a backdrop and a glowing pad to stand on
	local booth = Vector3.new(8, 0.2, 36)
	local back = part(folder, "BoothBackdrop", Vector3.new(9, 9, 0.4), CFrame.new(booth + Vector3.new(0, 4.5, -3.4)) * CFrame.Angles(0, math.pi, 0), rgb(255, 235, 245))
	sign(back, Enum.NormalId.Front, "📸", PINK)
	part(folder, "BoothFrameTop", Vector3.new(9.6, 0.6, 0.6), CFrame.new(booth + Vector3.new(0, 9.2, -3.2)), GOLD, Enum.Material.Neon).CanCollide = false
	for _, x in { -4.8, 4.8 } do
		part(folder, "BoothFrameSide", Vector3.new(0.6, 9, 0.6), CFrame.new(booth + Vector3.new(x, 4.5, -3.2)), GOLD, Enum.Material.Neon)
	end
	local boothPad = part(folder, "BoothPad", Vector3.new(0.3, 5, 5), CFrame.new(booth) * CFrame.Angles(0, 0, math.rad(90)), GOLD, Enum.Material.Neon)
	boothPad.Shape = Enum.PartType.Cylinder
	boothPad.Transparency = 0.35
	boothPad.CanCollide = false
	local boothSign = part(folder, "BoothSign", Vector3.new(8, 2, 0.4), CFrame.lookAt(booth + Vector3.new(0, 10.8, -3), booth + Vector3.new(0, 10.8, 0)), rgb(190, 20, 105))
	boothSign.CanCollide = false
	sign(boothSign, Enum.NormalId.Front, "📸 Photo Booth", rgb(255, 255, 255))
	folder:SetAttribute("BoothCenter", booth)

	-- Slow motion: the disco spots sweep around and the wall lights change color
	task.spawn(function()
		local t = 0
		while folder.Parent do
			t += 0.1
			disco.CFrame = CFrame.new(disco.Position) * CFrame.Angles(0, t * 0.6, 0)
			for i, holder in spots do
				local a = t * 0.8 + i * 2.1
				holder.CFrame = CFrame.lookAt(disco.Position, center + Vector3.new(math.cos(a) * 5, 0, math.sin(a) * 5))
			end
			for i, w in wallLights do
				local c = Color3.fromHSV((t * 0.02 + i * 0.25) % 1, 0.45, 1)
				w.lamp.Color = c
				w.light.Color = c
			end
			task.wait(0.1)
		end
	end)
end

-- Fireworks over the runway when the crowd goes wild for a walk.
function WorldBuilder.fireworks()
	if not built then
		return
	end
	local colors = { PINK, GOLD, rgb(120, 220, 255), rgb(190, 130, 255), rgb(140, 255, 170) }
	local rng = Random.new()
	for i = 1, 7 do
		task.delay((i - 1) * 0.28, function()
			if not built then
				return
			end
			local burst = part(built.folder, "Firework", Vector3.new(1, 1, 1), CFrame.new(rng:NextNumber(-16, 16), rng:NextNumber(13, 21), rng:NextNumber(-46, -20)), Color3.new(1, 1, 1))
			burst.Transparency = 1
			burst.CanCollide = false
			burst.CanQuery = false
			burst.CanTouch = false
			local color = colors[rng:NextInteger(1, #colors)]
			local sparks = Instance.new("ParticleEmitter")
			sparks.Texture = Config.Textures.Star
			sparks.Color = ColorSequence.new(color, rgb(255, 255, 255))
			sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
			sparks.Lifetime = NumberRange.new(1.2, 1.8)
			sparks.Speed = NumberRange.new(16, 24)
			sparks.SpreadAngle = Vector2.new(180, 180)
			sparks.Drag = 2.5
			sparks.Acceleration = Vector3.new(0, -6, 0)
			sparks.LightEmission = 1
			sparks.Rate = 0
			sparks.Parent = burst
			local flash = Instance.new("PointLight")
			flash.Color = color
			flash.Range = 40
			flash.Brightness = 2
			flash.Parent = burst
			sparks:Emit(80)
			task.delay(0.35, function()
				flash.Enabled = false
			end)
			task.delay(2.5, function()
				burst:Destroy()
			end)
		end)
	end
end

function WorldBuilder.build(): World
	local old = Workspace:FindFirstChild("GlowUpWorld")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GlowUpWorld"

	-- Floor
	part(folder, "Floor", Vector3.new(160, 1, 190), CFrame.new(0, -0.5, 15), rgb(255, 225, 238))
	buildRooftop(folder)

	-- Salon (where everyone spawns)
	local salon = Instance.new("Folder")
	salon.Name = "Salon"
	salon.Parent = folder
	-- Checkerboard salon floor
	local tile = 5
	for ix = 0, 13 do
		for iz = 0, 7 do
			local color = if (ix + iz) % 2 == 0 then rgb(255, 255, 255) else rgb(255, 205, 228)
			part(salon, "Tile", Vector3.new(tile, 0.2, tile), CFrame.new(-32.5 + ix * tile, 0.1, 32.5 + iz * tile), color, Enum.Material.SmoothPlastic)
		end
	end
	part(salon, "BackWall", Vector3.new(72, 22, 1), CFrame.new(0, 11, 70), rgb(74, 36, 96))
	-- a pink and white striped awning over the stations
	for i = 0, 17 do
		local x = -34 + i * 4
		local stripe = part(salon, "Awning", Vector3.new(4, 0.3, 8), CFrame.new(x, 20.4, 66.2) * CFrame.Angles(math.rad(-18), 0, 0), if i % 2 == 0 then PINK else rgb(255, 255, 255), Enum.Material.Fabric)
		stripe.CastShadow = false
		local scallop = part(salon, "AwningScallop", Vector3.new(0.3, 3.6, 3.6), CFrame.new(x, 19.1, 62.4) * CFrame.Angles(0, 0, math.rad(90)), if i % 2 == 0 then PINK else rgb(255, 255, 255), Enum.Material.Fabric)
		scallop.Shape = Enum.PartType.Cylinder
		scallop.CastShadow = false
	end
	for _, x in { -34, 34 } do
		plant(salon, Vector3.new(x, 0, 66))
		plant(salon, Vector3.new(x, 0, 34))
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 42)
	spawn.Color = PINK
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = salon

	for i = -2, 2 do
		local x = i * 13
		part(salon, "Mirror", Vector3.new(6, 8, 0.4), CFrame.new(x, 6, 66), rgb(200, 230, 255), Enum.Material.Glass).Reflectance = 0.35
		part(salon, "MirrorFrame", Vector3.new(7, 9, 0.3), CFrame.new(x, 6, 66.4), PINK, Enum.Material.Neon)
		part(salon, "Counter", Vector3.new(8, 3, 2.5), CFrame.new(x, 1.5, 64.5), rgb(255, 255, 255))
		local seat = Instance.new("Seat")
		seat.Name = "SalonChair"
		seat.Anchored = true
		seat.Disabled = true -- scenery: you stand on the glowing pad in front of it
		seat.Size = Vector3.new(3, 1, 3)
		seat.CFrame = CFrame.new(x, 2, 59) * CFrame.Angles(0, math.pi, 0)
		seat.Color = PURPLE
		seat.Parent = salon
		part(salon, "ChairBack", Vector3.new(3, 3, 0.6), CFrame.new(x, 3.5, 60.3), PURPLE)
		part(salon, "ChairBase", Vector3.new(1, 1.5, 1), CFrame.new(x, 0.75, 59), rgb(200, 200, 210), Enum.Material.Metal)
	end
	local salonSign = part(salon, "SalonSign", Vector3.new(36, 6, 1), CFrame.new(0, 14.6, 67), rgb(190, 20, 105))
	sign(salonSign, Enum.NormalId.Front, "✨ 5 Minute Glow Up Salon ✨", rgb(255, 255, 255))
	part(salon, "SalonSignFrame", Vector3.new(37, 7, 0.6), CFrame.new(0, 14.6, 67.6), GOLD, Enum.Material.Neon)
	buildStations(salon)
	buildDanceFloor(salon)
	buildAtmosphere(salon)

	-- Runway
	local runway = Instance.new("Folder")
	runway.Name = "Runway"
	runway.Parent = folder
	local runwayTopY = 2
	local runwayStartZ, runwayEndZ = -50, -12
	local length = math.abs(runwayEndZ - runwayStartZ) + 6
	local midZ = (runwayStartZ + runwayEndZ) / 2
	part(runway, "Catwalk", Vector3.new(8, runwayTopY, length), CFrame.new(0, runwayTopY / 2, midZ), rgb(255, 255, 255), Enum.Material.Marble)
	part(runway, "Carpet", Vector3.new(4, 0.1, length), CFrame.new(0, runwayTopY + 0.05, midZ), rgb(255, 90, 170), Enum.Material.Fabric)
	for side = -1, 1, 2 do
		local strip = part(runway, "LightStrip", Vector3.new(0.4, 0.3, length), CFrame.new(side * 4.2, runwayTopY + 0.15, midZ), PINK, Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Color = PINK
		light.Range = 12
		light.Brightness = 0.5
		light.Parent = strip
	end

	-- Big screen behind the runway
	local screen = part(runway, "Screen", Vector3.new(44, 24, 1), CFrame.new(0, 14, -57), rgb(25, 18, 35))
	part(runway, "ScreenFrame", Vector3.new(46, 26, 0.8), CFrame.new(0, 14, -57.6), PURPLE, Enum.Material.Neon)
	for side = -1, 1, 2 do
		part(runway, "Pillar", Vector3.new(4, 28, 4), CFrame.new(side * 25, 14, -56), PURPLE)
		local cap = part(runway, "PillarLight", Vector3.new(4.4, 1, 4.4), CFrame.new(side * 25, 28.5, -56), GOLD, Enum.Material.Neon)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 60
		spot.Range = 60
		spot.Brightness = 1
		spot.Color = rgb(255, 230, 245)
		spot.Parent = cap
	end

	-- Balloon arch where clients come out
	local balloonColors = { PINK, rgb(255, 255, 255), PURPLE, GOLD, rgb(140, 210, 255) }
	for i = 0, 22 do
		local a = math.rad(i * (180 / 22))
		local pos = Vector3.new(math.cos(a) * 9, runwayTopY + math.sin(a) * 11, runwayStartZ - 1)
		ball(runway, "Balloon", 2.8, pos, balloonColors[i % #balloonColors + 1]).Reflectance = 0.15
		ball(runway, "Balloon", 2, pos + Vector3.new(0, 0, 1.6), balloonColors[(i + 2) % #balloonColors + 1]).Reflectance = 0.15
	end
	for side = -1, 1, 2 do
		plant(runway, Vector3.new(side * 18, 0, -50))
		plant(runway, Vector3.new(side * 18, 0, -12))
	end

	-- Confetti cannons for Runway Star pass holders
	local confetti = {}
	for side = -1, 1, 2 do
		local cannon = part(runway, "ConfettiCannon", Vector3.new(1.5, 1.5, 1.5), CFrame.new(side * 6, 1, runwayEndZ), GOLD, Enum.Material.Neon)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(2, 3)
		emitter.Speed = NumberRange.new(25, 40)
		emitter.SpreadAngle = Vector2.new(30, 30)
		emitter.Acceleration = Vector3.new(0, -20, 0)
		emitter.Size = NumberSequence.new(0.5)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-200, 200)
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 100, 170)),
			ColorSequenceKeypoint.new(0.33, rgb(255, 220, 80)),
			ColorSequenceKeypoint.new(0.66, rgb(100, 200, 255)),
			ColorSequenceKeypoint.new(1, rgb(180, 120, 255)),
		})
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Texture = Config.Textures.Star
		emitter.Parent = cannon
		table.insert(confetti, emitter)
	end

	-- Audience seats along both sides of the runway
	for _, x in { -9, -13, 9, 13 } do
		for z = runwayStartZ + 4, runwayEndZ - 2, 6 do
			local seat = Instance.new("Seat")
			seat.Name = "AudienceSeat"
			seat.Anchored = true
			seat.Size = Vector3.new(3, 1, 3)
			seat.CFrame = CFrame.new(x, 0.5, z) * CFrame.Angles(0, if x < 0 then -math.pi / 2 else math.pi / 2, 0)
			seat.Color = if math.abs(x) == 9 then PINK else PURPLE
			seat.Parent = runway
			local outward = if x < 0 then -1 else 1
			part(runway, "SeatBack", Vector3.new(0.5, 2.6, 3), CFrame.new(x + outward * 1.3, 1.8, z), seat.Color)
		end
	end

	-- Winners' podium, off to the side so it never blocks the runway
	local podiumFolder = Instance.new("Folder")
	podiumFolder.Name = "Podium"
	podiumFolder.Parent = folder
	local podiumX, podiumZ = -32, -8
	local blocks = {
		{ x = podiumX, h = 5, color = GOLD, label = "1" },
		{ x = podiumX - 7, h = 3.5, color = rgb(200, 205, 215), label = "2" },
		{ x = podiumX + 7, h = 2.5, color = rgb(215, 140, 80), label = "3" },
	}
	local podium = {}
	for _, b in blocks do
		local block = part(podiumFolder, "Place" .. b.label, Vector3.new(6, b.h, 6), CFrame.new(b.x, b.h / 2, podiumZ), b.color)
		sign(block, Enum.NormalId.Back, b.label, rgb(255, 255, 255))
		table.insert(podium, Vector3.new(b.x, b.h, podiumZ))
	end

	-- Where the camera goes during the show and the results
	local cameras = Instance.new("Folder")
	cameras.Name = "Cameras"
	cameras.Parent = folder
	cameraMarker(cameras, "Showcase", Vector3.new(0, 9, 14), Vector3.new(0, 6, -36))
	cameraMarker(cameras, "Results", Vector3.new(podiumX + 7, 9, podiumZ + 19), Vector3.new(podiumX + 7, 5.5, podiumZ))
	part(podiumFolder, "PodiumStage", Vector3.new(26, 0.4, 12), CFrame.new(podiumX, 0.2, podiumZ), rgb(255, 235, 245), Enum.Material.Marble)
	for i = 0, 24 do
		local a = math.rad(i * (180 / 24))
		local pos = Vector3.new(podiumX + math.cos(a) * 12, 0.5 + math.sin(a) * 11, podiumZ - 4)
		ball(podiumFolder, "Balloon", 2.6, pos, balloonColors[i % #balloonColors + 1]).Reflectance = 0.15
		ball(podiumFolder, "Balloon", 1.9, pos + Vector3.new(0, 0, 1.4), balloonColors[(i + 2) % #balloonColors + 1]).Reflectance = 0.15
	end

	folder.Parent = Workspace
	setupLighting(LOOKS.everyday)

	built = {
		folder = folder,
		screen = screen,
		runwayStart = Vector3.new(0, runwayTopY, runwayStartZ),
		runwayEnd = Vector3.new(0, runwayTopY, runwayEndZ),
		podium = podium,
		confetti = confetti,
	}
	return built
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Starts the game on each player's screen and connects it to the server.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local UI = script.Parent:WaitForChild("UI")
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Effects = require(UI.Effects)
local HUD = require(UI.HUD)
local Makeover = require(UI.Makeover)
local Results = require(UI.Results)
local Shop = require(UI.Shop)
local Showcase = require(UI.Showcase)
local Sounds = require(UI.Sounds)
local Theme = require(UI.Theme)

local gui = Instance.new("ScreenGui")
gui.Name = "GlowUpUI"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

local state = { phase = "Waiting", endsAt = 0, themeId = "", eventId = nil :: string? }
local hud, shop

-- Shared helpers every screen can use
local ctx = {
	profile = { coins = 0, owned = {}, passes = {}, totalStars = 0, lookbook = {} } :: any,
	state = function()
		return state
	end,
	toast = function(message: string, color: Color3?)
		hud:toast(message, color)
	end,
	askUnlock = function(item)
		shop:askUnlock(item)
	end,
	promptProduct = function(key: string)
		shop:askProduct(key)
	end,
	-- the server decides the event when a round starts, so use that (not this device's clock)
	eventId = function(): string?
		return state.eventId
	end,
	isModalOpen = function(): boolean
		return shop.overlay.Visible or shop.confirm.Visible
	end,
}

hud = HUD.new(gui, function()
	shop:open()
end, function()
	shop:open("Looks")
end)
shop = Shop.new(gui, ctx)
local makeover = Makeover.new(gui, ctx)
local showcase = Showcase.new(gui, ctx)
local results = Results.new(gui)

Theme.onClick = function()
	Sounds.play("Click")
end

-- While styling, touching the screen should only wash and style, not walk the character around.
local function setCharacterControls(enabled: boolean)
	pcall(function()
		local module = Players.LocalPlayer:WaitForChild("PlayerScripts"):FindFirstChild("PlayerModule")
		if module then
			local controls = (require :: any)(module):GetControls()
			if enabled then
				controls:Enable()
			else
				controls:Disable()
			end
		end
	end)
	pcall(function()
		GuiService.TouchControlsEnabled = enabled
	end)
end

local function applyState(newState)
	-- an older state (the Hello reply can land after a newer update) never overwrites a newer one
	if type(newState.seq) == "number" and type(state.seq) == "number" and newState.seq < state.seq then
		return
	end
	local oldPhase = state.phase
	state = newState
	hud:setState(state)
	-- You walk around the Dressing Hall while getting ready and between rounds; during the show and
	-- the results you sit in the audience (or stand on the podium), so your controls rest
	local canWalk = state.phase ~= "Showcase" and state.phase ~= "Results"
	if state.phase ~= oldPhase then
		setCharacterControls(canWalk)
	end
	Sounds.music(if state.phase == "Makeover" then "MakeoverMusic" elseif state.phase == "Showcase" then "RunwayMusic" else nil)

	makeover:setVisible(state.phase == "Makeover")
	if state.phase ~= "Showcase" then
		showcase:hide()
	end
	if state.phase ~= "Results" then
		results:hide()
	end
	if state.phase == "Results" then
		showcase:setCamera("Results")
	elseif state.phase ~= "Showcase" then
		showcase:setCamera(nil)
	end
	if state.phase == "Intermission" and oldPhase ~= "Intermission" then
		showcase:setScreen("✨ 5 Minute Glow Up ✨", "Next show starting soon!", nil, nil)
		showcase:clearScreenPortrait()
	end
	if state.phase == "Makeover" and oldPhase ~= "Makeover" then
		local theme = Catalog.themeById[state.themeId]
		Effects.splash(gui, "5 minutes! GO! 💨", theme and ("Theme: " .. theme.name) or nil, Theme.Colors.purple, 2.2)
	end
end

Remotes.State.OnClientEvent:Connect(applyState)

Remotes.AssignClient.OnClientEvent:Connect(function(payload)
	makeover:assign(payload)
	makeover:setVisible(state.phase == "Makeover")
end)

Remotes.Showcase.OnClientEvent:Connect(function(payload)
	showcase:show(payload)
end)

Remotes.Results.OnClientEvent:Connect(function(payload)
	results:show(payload)
	local winner = payload.rows[1]
	if winner then
		-- Shown to everyone: always the happy, washed look and an award (never low stars)
		showcase:setScreen("🏆 " .. winner.stylist .. " wins!", winner.client.name .. "  " .. (winner.award or ""), winner.client, winner.look, 1)
	end
end)

Remotes.Profile.OnClientEvent:Connect(function(profile)
	local lookbookChanged = profile.lookbook ~= nil
	if not lookbookChanged then
		profile.lookbook = ctx.profile.lookbook -- unchanged, so it wasn't sent again
	end
	ctx.profile = profile
	hud:setCoins(profile.coins)
	hud:setLevel(profile.totalStars or 0)
	hud:setWeekly(profile)
	makeover:refreshProfile()
	shop:refreshProfile(lookbookChanged)
end)

Remotes.Reaction.OnClientEvent:Connect(function(emoji, cheers, goal)
	showcase:reaction(emoji, cheers, goal)
end)

-- You grabbed one of the lobby stars
Remotes.Collected.OnClientEvent:Connect(function(coins)
	Sounds.play("Sparkle", 0.8)
	Effects.floatEmoji(gui, "⭐")
	Effects.floatEmoji(gui, "💰")
	hud:toast("⭐ You found a star! +" .. tostring(coins) .. " 💰")
end)

Remotes.Celebrate.OnClientEvent:Connect(function(info)
	if info.kind == "daily" then
		local title = if info.item then "🎁 Day 7: " .. info.item .. "!" else "🎁 Day " .. info.day .. " Gift! +" .. info.coins .. " 💰"
		-- The 7-day calendar row
		Effects.splash(gui, title, " ", Theme.Colors.goldText, 4, function(card)
			local row = Theme.new("Frame", {
				Position = UDim2.fromScale(0, 0.62),
				Size = UDim2.fromScale(1, 0.36),
				BackgroundTransparency = 1,
				ZIndex = 262,
				Parent = card,
			}, {
				Theme.new("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					Padding = UDim.new(0.015, 0),
				}),
			})
			for d = 1, 7 do
				local past, today = d < info.day, d == info.day
				Theme.new("TextLabel", {
					LayoutOrder = d,
					Size = UDim2.fromScale(0.125, 1),
					BackgroundTransparency = 0,
					BackgroundColor3 = if today then Theme.Colors.gold elseif past then Theme.Colors.green else Theme.Colors.lavender,
					TextColor3 = if today or past then Theme.Colors.white else Theme.Colors.text,
					Text = if past then "✓" elseif d == 7 then "🎁" else tostring(d),
					ZIndex = 263,
					Parent = row,
				}, { Theme.corner(10), Theme.maxText(30) })
			end
		end)
		Effects.confetti(gui, 40)
	elseif info.kind == "weekly" then
		Effects.splash(gui, "🎯 Weekly goal done!", if info.item then "You got the " .. info.item .. "! 🎁" else "+" .. info.coins .. " 💰", Theme.Colors.purple, 4)
		Effects.confetti(gui, 60)
	elseif info.kind == "friend" then
		Effects.splash(gui, "💞 " .. info.name .. " is your BEST friend!", "Visit #" .. info.visits .. "  +" .. info.coins .. " 💰", Theme.Colors.hotPink, 3.5)
		Effects.confetti(gui, 40)
	elseif info.kind == "level" then
		local unlocked = {}
		for _, category in Catalog.Categories do
			for _, it in category.items do
				if it.level == info.level then
					table.insert(unlocked, it.name)
				end
			end
		end
		local subtitle = if #unlocked > 0 then "You unlocked: " .. table.concat(unlocked, ", ") .. "! Try it on next round!" else "You're a " .. info.title .. "!"
		Effects.splash(gui, "⭐ Level " .. info.level .. "! ⭐", subtitle, Theme.Colors.purple, 4.5)
		Effects.confetti(gui, 60)
	end
end)

Remotes.Notify.OnClientEvent:Connect(function(message)
	hud:toast(message)
end)

-- Catch up on whatever is happening right now
task.spawn(function()
	local snapshot = Remotes.Hello:InvokeServer()
	if snapshot.entry then
		makeover:assign(snapshot.entry)
	end
	applyState(snapshot.state)
	if snapshot.showcase then
		showcase:show(snapshot.showcase)
	end
	if snapshot.results then
		results:show(snapshot.results)
	end
end)

-- The server asks this screen to walk your character down the runway and to strike poses (your
-- own device moves your character, so it has to happen here).
local function watchCharacter(character: Model)
	character:GetAttributeChangedSignal("WalkTarget"):Connect(function()
		local target = character:GetAttribute("WalkTarget")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if typeof(target) == "Vector3" then
				local speed = character:GetAttribute("RunwaySpeed")
				humanoid.WalkSpeed = if type(speed) == "number" then speed else 10
				humanoid:MoveTo(target)
			else
				humanoid.WalkSpeed = 16
				local root = character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					-- a twirl at the end of the runway, ending face to the crowd
					task.spawn(function()
						local pos = root.Position
						for i = 1, 16 do
							root.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.pi + i / 16 * math.pi * 2, 0)
							task.wait(0.05)
						end
						root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
					end)
				end
			end
		end
	end)
	-- The server asks us to stand somewhere (the podium): get up from the seat and go there
	character:GetAttributeChangedSignal("PlaceAt"):Connect(function()
		local place = character:GetAttribute("PlaceAt")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if typeof(place) ~= "CFrame" or not humanoid then
			return
		end
		humanoid.Sit = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		task.wait(0.05)
		character:PivotTo(place)
	end)
	character:GetAttributeChangedSignal("Pose"):Connect(function()
		local value = character:GetAttribute("Pose")
		local poseId = type(value) == "string" and string.match(value, "^[^|]+")
		if poseId then
			Avatar.pose(character, poseId)
		end
	end)
end
Players.LocalPlayer.CharacterAdded:Connect(watchCharacter)
if Players.LocalPlayer.Character then
	watchCharacter(Players.LocalPlayer.Character)
end

-- The dance floor and the photo booth live deep in the world; look them up once.
local found: { [string]: Instance } = {}
local function worldPart(name: string): Instance?
	local hit = found[name]
	if hit and hit.Parent then
		return hit
	end
	local world = workspace:FindFirstChild("GlowUpWorld")
	hit = world and world:FindFirstChild(name, true)
	if hit then
		found[name] = hit
	end
	return hit
end

-- Step onto the dance floor and you dance (everyone sees it); step off and you stop.
local danceTrack: AnimationTrack? = nil
local function updateDance()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local floor = worldPart("DanceFloor")
	local center, radius = floor and floor:GetAttribute("Center"), floor and floor:GetAttribute("Radius")
	local on = false
	if root and root:IsA("BasePart") and typeof(center) == "Vector3" and type(radius) == "number" then
		on = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude <= radius and state.phase ~= "Showcase"
	end
	if on and not danceTrack then
		local animator = character:FindFirstChildOfClass("Humanoid") and character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator")
		if animator then
			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://507771019" -- Roblox's default dance
			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if ok and track then
				track.Looped = true
				track:Play(0.3)
				danceTrack = track
			end
		end
	elseif not on and danceTrack then
		danceTrack:Stop(0.3)
		danceTrack = nil
	end
end

-- The photo booth: stand on the gold pad for a 3-2-1, a flash, your pose and a polaroid frame.
local inBooth, snapping = false, false
local BOOTH_PHASES = { Makeover = true, Intermission = true, Waiting = true }
local function snapPhoto(center: Vector3)
	snapping = true
	local phase = state.phase
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	-- the photographer stands in front of the booth, so the picture is of their face, not the back of their head
	local camera = workspace.CurrentCamera
	local lens = center + Vector3.new(0, 5, 9)
	camera.CameraType = Enum.CameraType.Scriptable
	local shot = CFrame.lookAt(lens, center + Vector3.new(0, 3.5, 0))
	camera.CFrame = shot
	local number: TextLabel? = nil
	local photo: ScreenGui? = nil
	local function finish()
		if number then
			number:Destroy()
		end
		if photo then
			photo:Destroy()
		end
		gui.Enabled = true
		if camera.CameraType == Enum.CameraType.Scriptable and camera.CFrame == shot then -- (unless the show took the camera meanwhile)
			camera.CameraType = Enum.CameraType.Custom
		end
		snapping = false
	end
	-- the round moved on (the show is starting): stop right away
	local function interrupted(): boolean
		return state.phase ~= phase
	end
	local function faceCamera()
		if root and root:IsA("BasePart") and root.Parent then
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(lens.X, root.Position.Y, lens.Z))
		end
	end
	-- a big 3-2-1 off to the side (a card in the middle would cover the kid)
	for _, n in { "3", "2", "1" } do
		faceCamera()
		local outline = Theme.stroke(Theme.Colors.hotPink, 6)
		outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		local label = Theme.new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.8, 0.45),
			Size = UDim2.fromScale(0.2, 0.3),
			Text = n,
			TextColor3 = Theme.Colors.white,
			ZIndex = 260,
			Parent = gui,
		}, { outline })
		number = label
		Theme.pop(label)
		Sounds.play("Pop", 0.5)
		task.wait(0.8)
		label:Destroy()
		number = nil
		if interrupted() then
			finish()
			return
		end
	end
	faceCamera()
	if character then
		local pose = makeover.look and makeover.look.pose
		Avatar.pose(character, if pose and not Catalog.isNone(pose) then pose else "pose_cheer")
	end
	-- the picture: just you, in a white polaroid border with a caption strip (the game's buttons step aside)
	local theme = Catalog.themeById[state.themeId]
	photo = Instance.new("ScreenGui")
	local frame = photo :: ScreenGui
	frame.Name = "GlowUpPhoto"
	frame.IgnoreGuiInset = true
	frame.DisplayOrder = 20
	frame.Parent = gui.Parent
	gui.Enabled = false
	Effects.flash(frame)
	local polaroid = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { Theme.stroke(Theme.Colors.white, 18) })
	Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 0, 76),
		BackgroundColor3 = Theme.Colors.white,
		Parent = polaroid,
	}, {
		Theme.new("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			Text = "📸 " .. Players.LocalPlayer.DisplayName .. (if theme then "  •  " .. theme.name else ""),
			TextColor3 = Theme.Colors.hotPink,
		}, { Theme.padding(12), Theme.maxText(40) }),
	})
	local started = os.clock()
	while os.clock() - started < 3 and not interrupted() do
		task.wait(0.1)
	end
	finish()
end
local function safeSnap(center: Vector3)
	local ok = pcall(snapPhoto, center)
	if not ok then
		gui.Enabled = true
		snapping = false
	end
end
local function updateBooth()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local atmosphere = worldPart("Atmosphere")
	local center = atmosphere and atmosphere:GetAttribute("BoothCenter")
	local on = false
	if root and root:IsA("BasePart") and typeof(center) == "Vector3" then
		on = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude <= 2.5
	end
	-- (not in the last few seconds of a phase: the photo would run into the show)
	local timeLeft = state.endsAt - workspace:GetServerTimeNow()
	if on and not inBooth and not snapping and BOOTH_PHASES[state.phase] and (state.phase == "Waiting" or timeLeft > 8) then
		task.spawn(safeSnap, center :: Vector3)
	end
	inBooth = on
end

RunService.RenderStepped:Connect(function()
	hud:update()
	showcase:updateWalkers()
	showcase:followWalker()
	updateDance()
	updateBooth()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="27">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Fun screen effects: confetti, floating emoji, camera flashes, sparkles and big pop-up cards.

local TweenService = game:GetService("TweenService")

local Sounds = require(script.Parent.Sounds)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Effects = {}

local CONFETTI_COLORS = { C.pink, C.gold, C.purple, Color3.fromRGB(110, 200, 255), C.green, C.white }

local function fadeAndDestroy(gui: GuiObject, delay: number, time: number)
	task.delay(delay, function()
		if not gui.Parent then
			return
		end
		local props = { BackgroundTransparency = 1 }
		if gui:IsA("TextLabel") or gui:IsA("TextButton") then
			props.TextTransparency = 1
		end
		TweenService:Create(gui, TweenInfo.new(time), props):Play()
		task.wait(time)
		gui:Destroy()
	end)
end

-- Colorful paper pieces falling from the top of the screen.
function Effects.confetti(gui: GuiObject, count: number?)
	Sounds.play("Cheer", 1)
	for _ = 1, count or 40 do
		local x = math.random()
		local size = math.random(8, 16)
		local piece = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0, -20),
			Size = UDim2.fromOffset(size, size * 0.6),
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Rotation = math.random(0, 360),
			ZIndex = 300,
			Parent = gui,
		})
		local fall = 1.8 + math.random() * 1.6
		TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(x + (math.random() - 0.5) * 0.25, 0, 1, 30),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		task.delay(fall, function()
			piece:Destroy()
		end)
	end
end

-- An emoji that floats up from the bottom of the screen and fades away.
function Effects.floatEmoji(gui: GuiObject, emoji: string)
	local x = 0.1 + math.random() * 0.8
	local label = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(x, 0, 0.6, 0),
		Size = UDim2.fromOffset(56, 56),
		Text = emoji,
		ZIndex = 30, -- (behind the cards, so they never cover a title or a button)
		Parent = gui,
	})
	TweenService:Create(label, TweenInfo.new(2.2, Enum.EasingStyle.Sine), {
		Position = UDim2.new(x + (math.random() - 0.5) * 0.1, 0, 0.15, 0),
		Rotation = math.random(-25, 25),
	}):Play()
	fadeAndDestroy(label, 1.4, 0.8)
end

-- A quick white camera flash.
function Effects.flash(gui: GuiObject)
	Sounds.play("Camera")
	local flash = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.35,
		ZIndex = 280,
		Parent = gui,
	})
	fadeAndDestroy(flash, 0, 0.3)
end

-- A little "✨" (or another emoji) that pops at a spot inside `parent` (0..1 position).
function Effects.sparkle(parent: GuiObject, x: number, y: number, emoji: string?)
	Sounds.play("Sparkle", 0.15)
	local s = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(0.14, 0.14),
		Text = emoji or "✨",
		ZIndex = 120,
		Parent = parent,
	}, { new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	Theme.pop(s)
	fadeAndDestroy(s, 0.4, 0.4)
end

local splashFreeAt = 0

-- A big card in the middle of the screen. Cards wait their turn so they never pile up.
-- `build` can add extra things to the card.
function Effects.splash(gui: GuiObject, title: string, subtitle: string?, color: Color3?, seconds: number?, build: ((Frame) -> ())?)
	local now = os.clock()
	local waitFor = math.max(0, splashFreeAt - now)
	splashFreeAt = now + waitFor + (seconds or 2.5) + 0.4
	task.delay(waitFor, function()
		local card = Effects.showSplash(gui, title, subtitle, color, seconds)
		if build then
			build(card)
		end
	end)
end

function Effects.showSplash(gui: GuiObject, title: string, subtitle: string?, color: Color3?, seconds: number?): Frame
	Sounds.play("Pop")
	local card = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.32, 0.45),
		Size = UDim2.fromScale(0.5, 0.34),
		BackgroundColor3 = C.white,
		ZIndex = 260,
		Parent = gui,
	}, {
		Theme.corner(28),
		Theme.stroke(color or C.hotPink, 6),
		Theme.padding(14),
		new("UISizeConstraint", { MinSize = Vector2.new(300, 150), MaxSize = Vector2.new(620, 300) }),
	})
	new("TextLabel", {
		Size = UDim2.fromScale(1, if subtitle then 0.58 else 1),
		Text = title,
		TextColor3 = color or C.hotPink,
		ZIndex = 261,
		Parent = card,
	}, { Theme.maxText(64) })
	if subtitle then
		new("TextLabel", {
			Position = UDim2.fromScale(0, 0.6),
			Size = UDim2.fromScale(1, 0.4),
			Text = subtitle,
			TextColor3 = C.text,
			ZIndex = 261,
			Parent = card,
		}, { Theme.maxText(30) })
	end
	Theme.pop(card)
	task.delay(seconds or 2.5, function()
		if card.Parent then
			for _, d in card:GetDescendants() do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			end
			TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.35)
			card:Destroy()
		end
	end)
	return card
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- The always-on parts of the screen: round timer, coins, shop button, pop-up messages,
-- and the "next show" card between rounds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Progress = require(ReplicatedStorage.Shared.Progress)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local HUD = {}

-- How to play, on the lobby card (phones get a row of icons instead)
local STEPS_TEXT = "⭐ Grab the glowing stars while you wait!\nThen walk onto the glowing circles:\n💇 Hair   💄 Makeup   👗 Clothes\n🦸 Costume   🐶 Pet   💃 Pose\nMatch the theme ⭐ then 📸 walk the runway!"
HUD.__index = HUD

local PHASE_LABELS = {
	Waiting = "⏳ Waiting for stylists",
	Intermission = "🌟 Next show in",
	Makeover = "💄 Makeover time!",
	Showcase = "📸 Fashion Show",
	Results = "🏆 Results",
}

function HUD.new(gui: ScreenGui, onShop: () -> (), onLookBook: () -> ())
	local self = setmetatable({}, HUD)
	self.state = { phase = "Waiting", endsAt = 0, themeId = Catalog.Themes[1].id }

	self.pill = new("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.3, 0, 0, 46),
		BackgroundColor3 = C.white,
		ZIndex = 50,
		Parent = gui,
	}, { Theme.round(), Theme.stroke(C.pink, 3), new("UISizeConstraint", { MinSize = Vector2.new(220, 0) }) })
	self.pillText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 51,
		Parent = self.pill,
	}, { Theme.maxText(26), Theme.padding(6) })

	-- Coins and shop sit in the top bar, just right of the timer
	local right = new("Frame", {
		Position = UDim2.new(0.65, 8, 0, 10),
		Size = UDim2.new(0, 206, 0, 42),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), FillDirection = Enum.FillDirection.Horizontal }) })
	local coinPill = new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(0, 100, 1, 0),
		BackgroundColor3 = C.white,
		ZIndex = 50,
		Parent = right,
	}, { Theme.round(), Theme.stroke(C.gold, 3) })
	self.coinText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "💰 0",
		ZIndex = 51,
		Parent = coinPill,
	}, { Theme.maxText(24), Theme.padding(6) })
	local shop = Theme.button({
		Text = "🛍️ Shop",
		LayoutOrder = 2,
		Size = UDim2.new(0, 110, 0, 48),
		Color = C.purple,
		ZIndex = 50,
		Parent = right,
	})
	shop.Activated:Connect(onShop)
	self.shopButton = shop

	-- Stylist level, just left of the timer
	local levelPill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.35, -8, 0, 10),
		Size = UDim2.new(0, 104, 0, 42),
		BackgroundColor3 = C.white,
		ZIndex = 50,
		Parent = gui,
	}, { Theme.round(), Theme.stroke(C.purple, 3) })
	self.levelFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.lavender,
		ZIndex = 50,
		Parent = levelPill,
	}, { Theme.round() })
	self.levelText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "⭐ Lv 1",
		ZIndex = 51,
		Parent = levelPill,
	}, { Theme.maxText(22), Theme.padding(6) })

	-- Little messages pop up near the bottom of the screen
	self.toasts = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.new(0.5, 0, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 90,
		Parent = gui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Top,
		}),
	})

	-- Between rounds
	self.lobby = new("Frame", {
		Name = "Lobby",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.new(0.5, 0, 0, 262),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, {
		Theme.corner(22),
		Theme.stroke(C.pink, 4),
		Theme.padding(14),
		new("UISizeConstraint", { MinSize = Vector2.new(320, 0) }),
	})
	-- The rows stack in their own frame, so the corner "My Looks" button isn't pulled into the list.
	local rows = new("Frame", {
		Name = "Rows",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = self.lobby,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local book = Theme.button({
		-- Sits on the card's top edge, clear of the event bar.
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 0, -6),
		Size = UDim2.new(0, 150, 0, 56),
		Text = "📖 My Looks",
		Color = C.purple,
		ZIndex = 45,
		MaxText = 20,
		Parent = self.lobby,
	})
	book.Activated:Connect(onLookBook)
	self.lookBookButton = book
	self.lobbyEvent = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.gold,
		TextColor3 = C.text,
		Text = "",
		Visible = false,
		LayoutOrder = 1,
		ZIndex = 41,
		Parent = rows,
	}, { Theme.round(), Theme.maxText(22), Theme.padding(4) })
	-- Style Bots (pretend friends who play along when you're alone): one switch for the server
	local bots = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 0, -6),
		Size = UDim2.new(0, 240, 0, 56),
		Text = "🤖 Robot friends ✓",
		Color = C.purple,
		ZIndex = 45,
		MaxText = 20,
		Parent = self.lobby,
	})
	bots.Activated:Connect(function()
		local on = not (self.state and self.state.bots ~= false)
		bots.Text = "🤖 Robot friends " .. (if on then "✓" else "✗") -- answer right away
		Remotes.SetBots:FireServer(on)
	end)
	self.botsButton = bots
	self.lobbyWeekly = new("TextLabel", {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.lavender,
		Text = "",
		ZIndex = 41,
		Parent = rows,
	}, { Theme.round(), Theme.maxText(20), Theme.padding(4) })
	self.lobbyTheme = new("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 44),
		Text = "",
		TextColor3 = C.hotPink,
		ZIndex = 41,
		Parent = rows,
	}, { Theme.maxText(40) })
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 104),
		LayoutOrder = 4,
		Name = "Steps",
		Text = STEPS_TEXT,
		TextColor3 = C.text,
		ZIndex = 41,
		Parent = rows,
	}, { Theme.maxText(20) })

	return self
end

function HUD:setState(state)
	local before = self.state
	self.state = state
	-- notes sit near the bottom while you style (clear of the speech bubble) and up top during
	-- the show and results (clear of the vote card)
	local up = state.phase == "Showcase" or state.phase == "Results"
	self.toasts.AnchorPoint = Vector2.new(0.5, if up then 0 else 1)
	self.toasts.Position = if up then UDim2.new(0.5, 0, 0, 60) else UDim2.new(0.5, 0, 1, -74)
	local stack = self.toasts:FindFirstChildOfClass("UIListLayout")
	if stack then
		stack.VerticalAlignment = if up then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Bottom
	end
	local botsOn = state.bots ~= false
	self.botsButton.Text = "🤖 Robot friends " .. (if botsOn then "✓" else "✗")
	-- everyone hears about it, since one tap changes it for the whole server
	if before and before.bots ~= nil and (before.bots ~= false) ~= botsOn then
		self:toast(if botsOn then "🤖 Robot friends are coming to play!" else "🤖 Robot friends went home. Bye bye!")
	end
	self.botsButton.BackgroundColor3 = if botsOn then C.purple else C.lavender
	self.botsButton.TextColor3 = if botsOn then C.white else C.text
	local theme = Catalog.themeById[state.themeId]
	local showLobby = state.phase == "Intermission" or state.phase == "Waiting"
	if showLobby and not self.lobby.Visible then
		Theme.pop(self.lobby)
	end
	self.lobby.Visible = showLobby
	-- On short phone screens, skip the how-to steps so the card doesn't cover everything
	local compact = self.lobby.Parent and (self.lobby.Parent :: GuiObject).AbsoluteSize.Y < 500
	local steps = (self.lobby.Rows :: any).Steps
	steps.Visible = true
	steps.Text = if compact then "⭐ Grab the glowing stars!\nNext: 💇 → 💄 → 👗 → 🦸 → 🐶 → 💃 → 📸" else STEPS_TEXT
	steps.Size = UDim2.new(1, 0, 0, if compact then 40 else 104)
	-- the card sits in a lower corner so your avatar stays in view in the middle
	self.lobby.AnchorPoint = if compact then Vector2.new(1, 1) else Vector2.new(0, 1)
	self.lobby.Position = if compact then UDim2.new(1, -10, 1, -10) else UDim2.new(0, 16, 1, -16)
	self.lobby.Size = UDim2.new(if compact then 0.46 else 0.42, 0, 0, if compact then 170 else 262)
	self.botsButton.Size = UDim2.new(0, if compact then 176 else 240, 0, if compact then 48 else 56)
	self.lookBookButton.Size = UDim2.new(0, if compact then 128 else 150, 0, if compact then 48 else 56)
	-- No shopping while the 5-minute timer runs (items can still be unlocked from the menus)
	self.shopButton.Visible = state.phase == "Intermission" or state.phase == "Waiting"
	self.lobbyTheme.Text = "Next theme: " .. (theme and theme.name or "")
	local event = state.eventId and Events.byId[state.eventId]
	self.lobbyEvent.Visible = event ~= nil
	if event then
		self.lobbyEvent.Text = event.icon .. " " .. event.name .. " event! New looks " .. event.endsText .. " " .. event.icon
	end
end

-- "🎯 Weekly goal: 2/5 shows → 🍀 Lucky Clover"
function HUD:setWeekly(profile)
	local goal = Config.WEEKLY_GOAL_SHOWS
	local done = math.min(profile.weekShows or 0, goal)
	if profile.weekClaimed then
		self.lobbyWeekly.Text = "🎯 Weekly goal done! New prize next week 🎁"
	else
		local prize = profile.weeklyNext and Catalog.byId[profile.weeklyNext]
		local prizeText = if prize then (prize.icon or "🎁") .. " " .. prize.name else Config.WEEKLY_GOAL_COINS .. " 💰"
		self.lobbyWeekly.Text = "🎯 Weekly goal: " .. done .. "/" .. goal .. " shows → " .. prizeText
	end
end

function HUD:setCoins(coins: number)
	self.coinText.Text = "💰 " .. tostring(coins)
end

function HUD:setLevel(totalStars: number)
	self.levelText.Text = "⭐ Lv " .. Progress.level(totalStars)
	self.levelFill.Size = UDim2.fromScale(Progress.fraction(totalStars), 1)
end

function HUD:toast(message: string, color: Color3?)
	local toast = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = color or C.hotPink,
		BackgroundTransparency = 0,
		TextColor3 = C.white,
		Text = message,
		ZIndex = 91,
		Parent = self.toasts,
	}, { Theme.round(), Theme.maxText(22), Theme.padding(6) })
	Theme.pop(toast)
	task.delay(3, function()
		local fade = TweenInfo.new(0.4)
		TweenService:Create(toast, fade, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		task.wait(0.45)
		toast:Destroy()
	end)
end

function HUD:secondsLeft(): number
	return self.state.endsAt - Workspace:GetServerTimeNow()
end

-- Called every frame to tick the timer.
function HUD:update()
	local phase = self.state.phase
	local left = self:secondsLeft()
	local label = PHASE_LABELS[phase] or phase
	if phase == "Waiting" or phase == "Showcase" or phase == "Results" then
		self.pillText.Text = label
	else
		self.pillText.Text = label .. "  " .. Theme.formatTime(left)
	end
	local hurry = phase == "Makeover" and left <= 30
	self.pillText.TextColor3 = if hurry then C.hotPink else C.text
	if hurry then
		local pulse = 1 + 0.04 * math.sin(os.clock() * 10)
		self.pill.Size = UDim2.new(0.3 * pulse, 0, 0, 46)
	else
		self.pill.Size = UDim2.new(0.3, 0, 0, 46)
	end
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Makeover</string>
              <string name="Source"><![CDATA[-- The Dressing Hall: walk your own avatar from station to station and style yourself for the
-- theme. Hair, face, outfit, costume pieces, a pet to walk with you, and your runway pose and
-- effect. A guide on the left shows what's done and walks you to the next station; you react as
-- you go (speech, a bigger smile, happy hearts).

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Events = require(ReplicatedStorage.Shared.Events)
local LookRenderer = require(ReplicatedStorage.Shared.LookRenderer)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Scoring = require(ReplicatedStorage.Shared.Scoring)
local Stations = require(ReplicatedStorage.Shared.Stations)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Makeover = {}
Makeover.__index = Makeover

-- The stations in the order the guide suggests them
local STEPS = { { "Hair", "💇" }, { "Face", "💄" }, { "Outfit", "👗" }, { "Costume", "🦸" }, { "Pet", "🐶" }, { "Show", "💃" } }
-- what the guide calls each station (the same word is on the station's sign)
local STEP_NAMES = { Hair = "Hair", Face = "Makeup", Outfit = "Clothes", Costume = "Costume", Pet = "Pet", Show = "Pose" }
local STEP_ICONS = {}
for _, step in STEPS do
	STEP_ICONS[step[1]] = step[2]
end
local COSTUME_KEYS = { "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder", "accessory" }
local MAKEUP_KEYS = { "eyeshadow", "lashes", "blush", "lipstick" }
local MAX_BUBBLES = 24
local DEFAULT_HAIR = Catalog.defaultLook().hairStyle
local CONFIRM_SECONDS = 8
local SEND_INTERVAL = 0.25

-- How much of your avatar fills the space next to the menu at each station (studs tall).
local FRAMING = {
	Face = { height = 3.4, focus = "face" },
	Hair = { height = 4, focus = "hair" },
	Outfit = { height = 8.6, focus = "body" },
	Costume = { height = 8.6, focus = "body" },
	Pet = { height = 9.5, focus = "body" },
	Show = { height = 8.6, focus = "body" },
}

local WASH_LINES = { "That tickles! 😆", "Scrub scrub! 🧽", "Ooh, bubbles!", "Keep going! 💪", "I can see my face again!" }
local LIKE_LINES = { "Ooh, cute! 💕", "I like it!", "So pretty! ✨", "Ooh la la!", "Wow!" }
local THEME_LINES = { "Perfect for %s! 😍", "So %s! I love it!", "That's so %s! 💖" }
local PERFUME_LINES = { "Hee hee! 🌸", "Ooh, I smell like flowers!", "Achoo! 😆", "Mmm, so fancy! 💕", "Again! Again!" }
local NONE_LINES = { "Hmm, okay!", "Plain is nice too!", "Let's try something else!" }

local function pick(list: { string }): string
	return list[math.random(1, #list)]
end

local function screenPosition(input: InputObject): Vector2
	local inset = GuiService:GetGuiInset()
	return Vector2.new(input.Position.X, input.Position.Y) + inset
end

local function themeWord(theme: Catalog.Theme): string
	-- "Pink Party 🎀" -> "Pink Party"
	return (string.gsub(theme.name, "%s*[^%w%s']+$", ""))
end

function Makeover.new(gui: ScreenGui, ctx)
	local self = setmetatable({}, Makeover)
	self.ctx = ctx
	self.client = nil
	self.look = Catalog.defaultLook()
	self.dirtHealth = {}
	self.bubbles = {}
	self.tool = "soap"
	self.tab = "Wash"
	self.subcategory = {} -- tab id -> selected category key
	self.done = false
	self.scrubbing = false
	self.lastSent = 0
	self.wasClean = false
	self.hearts = 0
	self.bestShown = false

	self.frame = new("Frame", {
		Name = "Makeover",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 1, -- the hall shows around the panels
		Active = false, -- touches outside the panels still walk you around
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	self.spin = 0

	self:buildLeft()
	self:buildRight()
	self:buildGuide()
	self.frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:layoutForScreen()
	end)
	self:connectInput()
	self:startAnimations()
	self:startStage()
	return self
end

------------------------------------------------------------------------------
-- Layout (all in scale so it fits phones, tablets and computers)

function Makeover:buildLeft()
	local left = new("Frame", {
		Position = UDim2.new(0.015, 0, 0, 62),
		Size = UDim2.new(0.43, 0, 1, -70),
		BackgroundColor3 = C.white,
		ZIndex = 11,
		Parent = self.frame,
	}, { Theme.corner(24), Theme.stroke(C.pink, 4), Theme.padding(10) })
	self.left = left

	self.portraitHolder = new("Frame", {
		Name = "PortraitHolder",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.135),
		Size = UDim2.fromScale(1, 0.66),
		BackgroundColor3 = Color3.fromRGB(255, 245, 250),
		ZIndex = 12,
		Parent = left,
	}, {
		new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		Theme.corner(24),
		Theme.gradient(Color3.fromRGB(255, 250, 253), Color3.fromRGB(255, 220, 238)),
	})
	self.bubbleLayer = new("Frame", {
		Name = "Bubbles",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 100,
		Parent = self.portraitHolder,
	})
	self.spinHint = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.97, 0.03),
		Size = UDim2.fromScale(0.4, 0.08),
		BackgroundTransparency = 0.15,
		BackgroundColor3 = C.white,
		Text = "👆 Drag to spin",
		Visible = false,
		ZIndex = 110,
		Parent = self.portraitHolder,
	}, { Theme.round(), Theme.padding(4) })
	self.nameTag = new("TextLabel", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0.03, 0.97),
		Size = UDim2.fromScale(0.42, 0.1),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.hotPink,
		TextColor3 = C.white,
		Text = "",
		ZIndex = 110,
		Parent = self.portraitHolder,
	}, { Theme.round(), Theme.padding(4) })
	-- What the client wishes for
	self.wishLabel = new("TextLabel", {
		Position = UDim2.fromScale(0.5, 0.805),
		Size = UDim2.fromScale(0.5, 0.075),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.softPink,
		TextColor3 = C.purple,
		Text = "",
		ZIndex = 12,
		Parent = left,
	}, { Theme.round(), Theme.maxText(22), Theme.padding(4) })

	-- What the client says
	self.speech = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.94, 0.115),
		BackgroundColor3 = C.white,
		Visible = false,
		ZIndex = 150,
		Parent = left,
	}, { Theme.corner(18), Theme.stroke(C.purple, 3) })
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(0.05, 0.3),
		BackgroundColor3 = C.white,
		Rotation = 45,
		ZIndex = 150,
		Parent = self.speech,
	}, { new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	self.speechText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 152,
		Parent = self.speech,
	}, { Theme.maxText(24), Theme.padding(6) })

	self.cursor = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(0, 56, 0, 56),
		Text = "🧽",
		Visible = false,
		ZIndex = 200,
		Parent = self.frame,
	})

	self.heartsLabel = new("TextLabel", {
		Position = UDim2.fromScale(0, 0.8),
		Size = UDim2.fromScale(0.49, 0.085),
		Text = "",
		ZIndex = 12,
		Parent = left,
	}, { Theme.maxText(30) })

	local checklist = new("Frame", {
		Name = "Checklist",
		Position = UDim2.fromScale(0, 0.895),
		Size = UDim2.fromScale(1, 0.105),
		BackgroundTransparency = 1,
		ZIndex = 12,
		Parent = left,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0.015, 0),
		}),
	})
	self.checks = {}
	for i, step in STEPS do
		local chip = new("TextButton", {
			LayoutOrder = i,
			Size = UDim2.fromScale(0.235, 1),
			BackgroundTransparency = 0,
			BackgroundColor3 = C.lavender,
			Text = step[2] .. " " .. step[1],
			AutoButtonColor = true,
			ZIndex = 13,
			Parent = checklist,
		}, { Theme.round(), Theme.maxText(20), Theme.padding(4) })
		chip.Activated:Connect(function()
			self:setTab(step[1])
		end)
		self.checks[step[1]] = chip
	end
end

function Makeover:buildRight()
	local right = new("Frame", {
		Position = UDim2.new(0.52, 0, 0, 62),
		Size = UDim2.new(0.465, 0, 1, -70),
		BackgroundColor3 = C.white,
		Active = true,
		Visible = false, -- opens when you step onto a station
		ZIndex = 11,
		Parent = self.frame,
	}, { Theme.corner(24), Theme.stroke(C.purple, 4), Theme.padding(10) })
	self.right = right

	self.themeBar = new("TextLabel", {
		Size = UDim2.fromScale(1, 0.075),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.softPink,
		Text = "",
		ZIndex = 12,
		Parent = right,
	}, { Theme.round(), Theme.maxText(22), Theme.padding(3) })

	-- The station decides the tab, so the tab row stays hidden (the guide does the switching)
	local tabs = new("Frame", {
		Position = UDim2.fromScale(0, 0.09),
		Size = UDim2.fromScale(1, 0.135),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 12,
		Parent = right,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0.012, 0),
		}),
	})
	self.tabButtons = {}
	self.tabStrokes = {}
	for i, tab in Catalog.Tabs do
		local b = Theme.button({
			Text = "",
			LayoutOrder = i,
			Size = UDim2.fromScale(0.155, 1),
			Color = C.lavender,
			ZIndex = 13,
			Parent = tabs,
		})
		b.Name = tab.id
		new("TextLabel", { Name = "Icon", Size = UDim2.fromScale(1, 0.62), Text = tab.icon, ZIndex = 14, Parent = b }, { Theme.maxText(40) })
		new("TextLabel", {
			Name = "Label",
			Position = UDim2.fromScale(0, 0.6),
			Size = UDim2.fromScale(1, 0.38),
			Text = tab.label,
			ZIndex = 14,
			Parent = b,
		}, { Theme.maxText(20) })
		self.tabStrokes[tab.id] = Theme.new("UIStroke", {
			Color = C.gold,
			Thickness = 4,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = b,
		})
		b.Activated:Connect(function()
			self:setTab(tab.id)
		end)
		self.tabButtons[tab.id] = b
	end

	-- Sub-categories: big enough for small fingers, and they wrap onto a second row so none hide off the edge
	self.chips = new("Frame", {
		Position = UDim2.new(0, 0, 0.075, 6),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		ZIndex = 12,
		Parent = right,
	})
	self.chipLayout = new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -3, 0, 56),
		CellPadding = UDim2.fromOffset(6, 6),
		Parent = self.chips,
	})

	self.grid = new("ScrollingFrame", {
		Position = UDim2.fromScale(0, 0.33),
		Size = UDim2.fromScale(1, 0.52),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.pink,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 12,
		Parent = right,
	}, { Theme.padding(4) })
	self.gridLayout = new("UIGridLayout", {
		CellSize = UDim2.fromOffset(100, 112),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.grid,
	})
	self.grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if self.frame.Visible and self.tab ~= "Wash" then
			self:renderGrid()
		end
	end)

	self:buildWashPanel(right)

	-- Messy hair has to be brushed before picking a style
	self.brushHint = new("TextLabel", {
		Position = UDim2.fromScale(0, 0.24),
		Size = UDim2.fromScale(1, 0.61),
		Text = "🖌️\nBrush out the tangles!\nRub the messy hair",
		TextColor3 = C.purple,
		Visible = false,
		ZIndex = 20,
		Parent = right,
	}, { Theme.maxText(40), Theme.padding(20) })

	self.doneButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(0.6, 0.12),
		Text = "I'm Done! ✨",
		Color = C.hotPink,
		ZIndex = 13,
		MaxText = 32,
		Parent = right,
	})
	self.doneButton.Visible = false -- the guide has the Done button
	self.doneStroke = Theme.new("UIStroke", {
		Color = C.gold,
		Thickness = 4,
		Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = self.doneButton,
	})
	self.doneButton.Activated:Connect(function()
		self:setDone(not self.done)
	end)

	self.waiting = new("Frame", {
		Position = UDim2.fromScale(0, 0.09),
		Size = UDim2.fromScale(1, 0.77),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 30,
		Parent = right,
	}, { Theme.corner(18), Theme.padding(16) })
	new("TextLabel", {
		Size = UDim2.fromScale(1, 0.5),
		Text = "Looking fabulous! 💅\nWaiting for the other stylists...",
		TextColor3 = C.purple,
		ZIndex = 31,
		Parent = self.waiting,
	}, { Theme.maxText(34) })
	-- Something fun to do while waiting
	local perfume = Theme.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromScale(0.7, 0.3),
		Text = "🌸 Spritz perfume!",
		Color = C.pink,
		ZIndex = 32,
		MaxText = 34,
		Parent = self.waiting,
	})
	perfume.Activated:Connect(function()
		for _ = 1, 4 do
			Effects.sparkle(self.bubbleLayer, 0.25 + math.random() * 0.5, 0.15 + math.random() * 0.5, if math.random() < 0.5 then "🌸" else "💕")
		end
		self:say(pick(PERFUME_LINES), 1.5)
	end)
end

-- The guide down the left: your happy hearts, a button for each station (green with a check when
-- it's done, glowing when it's next; tap one to walk there) and the I'm Done button.
function Makeover:buildGuide()
	self.left.Visible = false -- the old portrait card isn't used in the Dressing Hall
	local guide = new("Frame", {
		Name = "Guide",
		Position = UDim2.new(0, 10, 0, 62),
		Size = UDim2.new(0, 176, 0, 300),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.08,
		Active = true,
		ZIndex = 11,
		Parent = self.frame,
	}, { Theme.corner(20), Theme.stroke(C.pink, 3), Theme.padding(6) })
	self.guide = guide
	self.heartsLabel.Parent = guide
	self.heartsLabel.Position = UDim2.new(0, 0, 0, 0)
	self.heartsLabel.Size = UDim2.new(1, 0, 0, 26)
	self.heartsLabel.ZIndex = 12
	self.heartsLabel.BackgroundTransparency = 0
	self.heartsLabel.BackgroundColor3 = C.lavender
	Theme.round().Parent = self.heartsLabel

	local grid = new("Frame", {
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, 0, 0, 198),
		BackgroundTransparency = 1,
		ZIndex = 12,
		Parent = guide,
	}, {
		new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 62), CellPadding = UDim2.fromOffset(6, 6) }),
	})
	self.checks = {}
	self.tabStrokes = {}
	for i, step in STEPS do
		local station = Stations.byTab[step[1]]
		local b = Theme.button({
			Text = "",
			LayoutOrder = i,
			Color = C.lavender,
			ZIndex = 13,
			Parent = grid,
		})
		b.Name = "Go" .. step[1]
		new("TextLabel", { Name = "Icon", Size = UDim2.fromScale(1, 0.6), Text = step[2], ZIndex = 14, Parent = b }, { Theme.maxText(30) })
		new("TextLabel", {
			Name = "Label",
			Position = UDim2.fromScale(0, 0.58),
			Size = UDim2.fromScale(1, 0.4),
			Text = STEP_NAMES[step[1]],
			TextColor3 = C.text,
			ZIndex = 14,
			Parent = b,
		}, { new("UITextSizeConstraint", { MaxTextSize = 19, MinTextSize = 16 }) })
		self.tabStrokes[step[1]] = Theme.new("UIStroke", {
			Color = C.gold,
			Thickness = 4,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = b,
		})
		b.Activated:Connect(function()
			if station then
				self:walkTo(station)
			end
		end)
		self.checks[step[1]] = b
	end

	local done = Theme.button({
		Position = UDim2.new(0, 0, 1, -60),
		Size = UDim2.new(1, 0, 0, 60),
		Text = "I'm Done! ✨",
		Color = C.hotPink,
		ZIndex = 13,
		MaxText = 24,
		Parent = guide,
	})
	done.Activated:Connect(function()
		if not self.done and (self:stepsDoneCount() < 3 or UserInputService.TouchEnabled) then
			local t = os.clock()
			if not self.confirmDoneAt or t - self.confirmDoneAt > CONFIRM_SECONDS then
				self.confirmDoneAt = t
				self:styleDone()
				Theme.pop(done)
				if self:stepsDoneCount() < 3 then
					self:say("There's still time to style! 💖", 3)
				end
				task.delay(CONFIRM_SECONDS, function()
					if self.confirmDoneAt == t then
						self.confirmDoneAt = nil
						self:styleDone()
					end
				end)
				return
			end
		end
		self.confirmDoneAt = nil
		self:setDone(not self.done)
	end)
	self.doneButton = done
	self.doneStroke = Theme.new("UIStroke", {
		Color = C.gold,
		Thickness = 4,
		Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = done,
	})

	-- The judge's two wishes for this round, along the bottom beside the guide
	self.wishLabel.Parent = self.frame
	self.wishLabel.AnchorPoint = Vector2.new(0, 1)
	self.wishLabel.Position = UDim2.new(0, 196, 1, -12)
	self.wishLabel.Size = UDim2.new(0.5, -206, 0, 50)
	self.wishLabel.BackgroundColor3 = C.white
	self.wishLabel.TextColor3 = C.purple
	Theme.stroke(C.hotPink, 3).Parent = self.wishLabel

	-- What you say pops up at the top of the hall
	self.speech.Parent = self.frame
	self.speech.AnchorPoint = Vector2.new(0, 0)
	self.speech.Position = UDim2.new(0, 196, 0, 66)
	self.speech.Size = UDim2.new(0.3, 0, 0, 58)
end

function Makeover:buildWashPanel(parent: GuiObject)
	local panel = new("Frame", {
		Position = UDim2.fromScale(0, 0.24),
		Size = UDim2.fromScale(1, 0.61),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 12,
		Parent = parent,
	})
	self.washPanel = panel

	self.washHint = new("TextLabel", {
		Size = UDim2.fromScale(1, 0.2),
		Text = "",
		ZIndex = 13,
		Parent = panel,
	}, { Theme.maxText(34) })

	self.toolButtons = {}
	for i, tool in { { id = "soap", icon = "🧽", label = "Soap" }, { id = "rinse", icon = "🚿", label = "Rinse" } } do
		local b = Theme.button({
			Text = "",
			Position = UDim2.fromScale(if i == 1 then 0.06 else 0.53, 0.23),
			Size = UDim2.fromScale(0.41, 0.4),
			Color = C.lavender,
			ZIndex = 14,
			Parent = panel,
		})
		new("TextLabel", { Size = UDim2.fromScale(1, 0.65), Text = tool.icon, ZIndex = 15, Parent = b }, { Theme.maxText(64) })
		new("TextLabel", { Name = "Label", Position = UDim2.fromScale(0, 0.62), Size = UDim2.fromScale(1, 0.34), Text = tool.label, ZIndex = 15, Parent = b }, { Theme.maxText(30) })
		b.Activated:Connect(function()
			self.tool = tool.id
			self:refreshWash()
		end)
		self.toolButtons[tool.id] = b
	end

	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromScale(0.88, 0.13),
		BackgroundColor3 = C.lavender,
		ZIndex = 13,
		Parent = panel,
	}, { Theme.round() })
	self.cleanFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.green,
		ZIndex = 14,
		Parent = bar,
	}, { Theme.round() })
	self.cleanText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 15,
		Parent = bar,
	}, { Theme.maxText(22), Theme.padding(3) })

end

------------------------------------------------------------------------------
-- Animations: blinking eyes and the glowing "do this next" hint

function Makeover:startAnimations()
	task.spawn(function()
		while true do
			task.wait(2.5 + math.random() * 2.5)
			if self.frame.Visible and self.portraitRoot then
				local eyes = {}
				for _, d in self.portraitRoot:GetChildren() do
					if d.Name == "Eye" then
						table.insert(eyes, { frame = d, size = d.Size })
						d.Size = UDim2.new(d.Size.X.Scale, 0, d.Size.Y.Scale * 0.15, 0)
					end
				end
				task.wait(0.13)
				for _, e in eyes do
					if e.frame.Parent then
						e.frame.Size = e.size
					end
				end
			end
		end
	end)

	-- A big bouncing 👇 over the next station's pad, so a first-timer knows to walk there
	local marker = new("Part", {
		Name = "NextStationMarker",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(1, 1, 1),
		Parent = Workspace,
	})
	local billboard = new("BillboardGui", {
		Size = UDim2.fromOffset(130, 130),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Enabled = false,
		Parent = marker,
	})
	new("TextLabel", { Size = UDim2.fromScale(1, 0.68), Text = "👇", Parent = billboard }, { Theme.maxText(80) })
	new("TextLabel", {
		Position = UDim2.fromScale(0, 0.66),
		Size = UDim2.fromScale(1, 0.32),
		Text = "Walk here!",
		TextColor3 = C.white,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.hotPink,
		Parent = billboard,
	}, { Theme.round(), Theme.maxText(24), Theme.padding(2) })

	RunService.RenderStepped:Connect(function()
		local nextStation = if self.frame.Visible and not self.station and not self.done then Stations.byTab[self.nextStep or ""] else nil
		billboard.Enabled = nextStation ~= nil
		if nextStation then
			marker.Position = nextStation.pad + Vector3.new(0, 7.5 + math.sin(os.clock() * 4) * 0.6, 0)
		end
		if not self.frame.Visible then
			return
		end
		local glow = 0.15 + 0.35 * (0.5 + 0.5 * math.sin(os.clock() * 6))
		for id, stroke in self.tabStrokes do
			local isNext = id == self.nextStep and id ~= self.tab
			stroke.Color = if isNext then C.gold else C.purple
			stroke.Thickness = if isNext then 4 else 2
			stroke.Transparency = if isNext then glow else 0
		end
		self.doneStroke.Transparency = if self.nextStep == "Done" and not self.done then glow else 1
	end)
end

------------------------------------------------------------------------------
-- State

function Makeover:assign(payload)
	self.client = payload.client
	self.look = payload.look
	self.done = payload.done == true
	self.dirtHealth = {}
	local n = #self.client.dirt
	local cleaned = math.floor((payload.clean or 0) * n + 0.5)
	for i = 1, n do
		self.dirtHealth[i] = if i <= cleaned then 0 else 1
	end
	self:clearBubbles()
	self.wasClean = false
	self.bestShown = false
	self.hearts = 0
	self.pickedHair = false
	self.walkTarget = nil
	self.tool = "soap"
	self.tab = "Hair"
	self.brushed = self.look.hairStyle ~= "hair_messy"
	self.tangle = if self.brushed then 0 else 1
	self.nameTag.Text = "💖 " .. self.client.name
	self:setDone(self.done, true)
	self.spin = 0
	self:renderPortrait()
	self:setTab("Hair")
	local theme = self:theme()
	self:say(if theme then "Let's get ready for " .. theme.name .. "! ✨" else "Let's get ready for the show! ✨", 4)
	local wishes = self.client.wishes or {}
	if #wishes > 0 then
		local client = self.client
		task.delay(4.2, function()
			if self.client == client then
				local texts = {}
				for _, w in wishes do
					table.insert(texts, w.text)
				end
				self:say("💌 The judge wishes for " .. table.concat(texts, " and ") .. "!", 4)
			end
		end)
	end
end

-- On short screens (phones), hide the checklist so the client's face can be bigger.
-- On short screens (phones) the guide's buttons get a little shorter so it all fits.
function Makeover:layoutForScreen()
	if not self.guide then
		return
	end
	local compact = self.frame.AbsoluteSize.Y > 0 and self.frame.AbsoluteSize.Y < 500
	self.compact = compact
	local grid = self.guide:FindFirstChildOfClass("Frame")
	local layout = grid and grid:FindFirstChildOfClass("UIGridLayout")
	if compact then
		-- a strip along the top: six station icons and Done in one row, nothing near the thumbstick
		local cell, gap, doneWidth = 46, 4, 84
		local gridWidth = cell * 6 + gap * 5
		if grid and layout then
			layout.CellSize = UDim2.fromOffset(cell, cell)
			layout.CellPadding = UDim2.fromOffset(gap, gap)
			grid.Position = UDim2.new(0, 0, 0, 0)
			grid.Size = UDim2.new(0, gridWidth, 0, cell)
		end
		self.heartsLabel.Visible = false
		self.doneButton.Position = UDim2.new(0, gridWidth + 6, 0, 0)
		self.doneButton.Size = UDim2.new(0, doneWidth, 0, cell)
		self.guide.Position = UDim2.new(0, 10, 0, 56)
		self.guide.Size = UDim2.new(0, gridWidth + 6 + doneWidth + 12, 0, cell + 12)
		-- the station menu takes the full height on the right, beside the strip
		self.right.Position = UDim2.new(0, gridWidth + doneWidth + 34, 0, 56)
		self.right.Size = UDim2.new(1, -(gridWidth + doneWidth + 42), 1, -62)
		self.speech.Position = UDim2.new(0, 10, 0, 56 + cell + 18)
		self.wishLabel.Position = UDim2.new(0, 10, 1, -10)
		self.wishLabel.Size = UDim2.new(0.5, -20, 0, 40)
	else
		local cell = 62
		if grid and layout then
			layout.CellSize = UDim2.new(0.5, -4, 0, cell)
			layout.CellPadding = UDim2.fromOffset(6, 6)
			grid.Position = UDim2.new(0, 0, 0, 30)
			grid.Size = UDim2.new(1, 0, 0, cell * 3 + 12)
		end
		self.heartsLabel.Visible = true
		self.doneButton.Position = UDim2.new(0, 0, 1, -60)
		self.doneButton.Size = UDim2.new(1, 0, 0, 60)
		self.guide.Position = UDim2.new(0, 10, 0, 62)
		self.guide.Size = UDim2.new(0, 176, 0, 30 + cell * 3 + 12 + 6 + 60 + 12)
		self.right.Position = UDim2.new(0.52, 0, 0, 62)
		self.right.Size = UDim2.new(0.465, 0, 1, -70)
		self.speech.Size = UDim2.new(0.3, 0, 0, 58)
		self.speech.Position = UDim2.new(0, 196, 0, 66)
		self.wishLabel.Position = UDim2.new(0, 196, 1, -12)
		self.wishLabel.Size = UDim2.new(0.5, -206, 0, 50)
	end
	if self.look then
		self:refreshChecklist() -- (icons only, or icons and names)
	end
end

function Makeover:setVisible(visible: boolean)
	local wasVisible = self.frame.Visible
	self.frame.Visible = visible and self.client ~= nil
	if self.frame.Visible then
		self:layoutForScreen()
	end
	if not self.frame.Visible then
		self.cursor.Visible = false
		self.scrubbing = false
		if self.station then
			self:closeStation()
		end
	end
	if self.frame.Visible and not wasVisible then
		self:refreshTheme()
		self:setTab(self.tab)
		local character = self:character()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local camera = Workspace.CurrentCamera
		if root and root:IsA("BasePart") and camera then
			local hall = Vector3.new(0, 3, 55)
			local flat = Vector3.new(hall.X - root.Position.X, 0, hall.Z - root.Position.Z)
			if flat.Magnitude > 1 then
				local dir = flat.Unit
				camera.CFrame = CFrame.lookAt(root.Position - dir * 14 + Vector3.new(0, 7, 0), root.Position + dir * 12)
			end
		end
	end
end

function Makeover:refreshTheme()
	local theme = self:theme()
	if theme then
		local station = self.station
		self.themeBar.Text = (if station then station.icon .. " " .. station.name .. "  •  " else "")
			.. "Theme: " .. theme.name .. "   ⭐ = matches!"
		self.themeBar.BackgroundColor3 = theme.color:Lerp(C.white, 0.75)
	end
end

function Makeover:theme(): Catalog.Theme?
	return Catalog.themeById[self.ctx.state().themeId]
end

function Makeover:say(text: string, seconds: number?)
	self.speechText.Text = text
	self.speech.Visible = true
	Sounds.play("Pop", 0.5)
	Theme.pop(self.speech)
	self.sayId = (self.sayId or 0) + 1
	local id = self.sayId
	task.delay(seconds or 3, function()
		if self.sayId == id then
			self.speech.Visible = false
		end
	end)
end

function Makeover:setDone(done: boolean, silent: boolean?)
	self.done = done
	self.waiting.Visible = done
	self:styleDone()
	if not silent then
		Remotes.Done:FireServer(done)
		if done then
			-- ready for the runway! a burst of confetti and a cheer
			Effects.confetti(self.frame, 40)
			Sounds.play("Cheer", 0.6)
			self:say("I'm runway ready! 💃", 2.5)
		end
	end
end

function Makeover:cleanAmount(): number
	local n = #self.dirtHealth
	if n == 0 then
		return 1
	end
	local left = 0
	for _, h in self.dirtHealth do
		left += h
	end
	return 1 - left / n
end

function Makeover:isWashed(): boolean
	return self:cleanAmount() >= 0.98 and #self.bubbles == 0
end

-- How the judges would score the look right now (shown as happy hearts).
function Makeover:previewStars(): number
	local theme = self:theme()
	if not theme then
		return 1
	end
	local stars = Scoring.judge({ look = self.look, clean = self:cleanAmount(), rinsed = #self.bubbles == 0, client = self.client }, theme)
	return stars
end

function Makeover:renderPortrait()
	if not self.client then
		return
	end
	local stars = self:previewStars()
	if self.tab == "Nails" then
		self.portraitRoot = LookRenderer.renderHand(self.portraitHolder, self.client, self.look)
	else
		self.portraitRoot = LookRenderer.render(self.portraitHolder, self.client, self.look, {
			dirtHealth = self.dirtHealth,
			mood = Scoring.mood(stars, self:cleanAmount()),
			brushed = self.brushed,
			tangle = self.tangle,
		})
	end
	self.dirtFrames = {}
	for i = 1, #self.client.dirt do
		self.dirtFrames[i] = self.portraitRoot:FindFirstChild("Dirt" .. i)
	end
	local full = math.floor(stars)
	self.heartsLabel.Text = "😊" .. string.rep("💖", full) .. string.rep("🤍", 5 - full)
	if full > self.hearts and self.hearts > 0 then
		Theme.pop(self.heartsLabel)
	end
	self.hearts = full
	self:refreshWishes()
	self:refreshChecklist()
end

function Makeover:wishesMet(): number
	local met = 0
	for _, w in self.client.wishes or {} do
		if Scoring.wishMet(w, self.look) then
			met += 1
		end
	end
	return met
end

function Makeover:refreshWishes()
	local parts = {}
	for _, w in self.client.wishes or {} do
		table.insert(parts, (if Scoring.wishMet(w, self.look) then "✅" else "") .. w.text)
	end
	self.wishLabel.Visible = #parts > 0
	self.wishLabel.Text = "💌 Judge wishes:  " .. table.concat(parts, "   ")
end

function Makeover:needsBrush(): boolean
	return self.look.hairStyle == "hair_messy" and not self.brushed
end

-- Which rubbing tool is in use right now ("wash", "brush" or nil)
function Makeover:rubMode(): string?
	if self.tab == "Wash" then
		return "wash"
	elseif self.tab == "Hair" and self:needsBrush() then
		return "brush"
	end
	return nil
end

function Makeover:brush(pos: Vector2, moved: number)
	local root = self.portraitRoot
	if not root then
		return
	end
	local size = root.AbsoluteSize.X
	local rel = (pos - root.AbsolutePosition) / math.max(size, 1)
	if rel.X < 0.15 or rel.X > 0.85 or rel.Y < 0 or rel.Y > 0.45 then
		return
	end
	self.tangle = math.max(0, self.tangle - moved / (size * 1.6))
	for _, t in root:GetChildren() do
		if t.Name == "Tuft" and t:IsA("GuiObject") then
			t.BackgroundTransparency = 1 - self.tangle
		end
	end
	Sounds.play("Scrub", 0.35)
	if math.random() < 0.08 then
		Effects.sparkle(self.bubbleLayer, rel.X, rel.Y, "💨")
	end
	if self.tangle <= 0 then
		self.brushed = true
		self.scrubbing = false
		Effects.sparkle(self.bubbleLayer, 0.5, 0.2)
		self:say("Ahh, no more tangles! Now pick a hairstyle! 💇", 3)
		self:renderPortrait()
		self:setTab("Hair")
	end
end

function Makeover:stepsDone()
	local makeupCount = 0
	for _, key in MAKEUP_KEYS do
		if not Catalog.isNone(self.look[key]) then
			makeupCount += 1
		end
	end
	local costume = false
	for _, key in COSTUME_KEYS do
		if not Catalog.isNone(self.look[key]) then
			costume = true
		end
	end
	return {
		Hair = self.pickedHair == true or (not Catalog.isNone(self.look.hairStyle) and self.look.hairStyle ~= DEFAULT_HAIR),
		Face = makeupCount >= 2,
		Outfit = not Catalog.isNone(self.look.outfit),
		Costume = costume,
		Pet = not Catalog.isNone(self.look.pet),
		Show = not Catalog.isNone(self.look.pose) or not Catalog.isNone(self.look.effect),
	}
end

function Makeover:stepsDoneCount(): number
	local n = 0
	for _, ok in self:stepsDone() do
		if ok then
			n += 1
		end
	end
	return n
end

-- "I'm Done!" stays quiet (lavender) until three stations are done, then turns hot pink.
function Makeover:styleDone()
	local ready = self.done or self:stepsDoneCount() >= 3
	local asking = not self.done and self.confirmDoneAt ~= nil
	if asking then
		self.doneButton.Text = "Sure? Tap again ✨"
		self.doneButton.BackgroundColor3 = C.hotPink
		self.doneButton.TextColor3 = C.white
		return
	end
	self.doneButton.Text = if self.done then "Keep Styling ✏️" else "I'm Done! ✨"
	self.doneButton.BackgroundColor3 = if self.done then C.purple elseif ready then C.hotPink else C.lavender
	self.doneButton.TextColor3 = if self.done or ready then C.white else C.text
end

function Makeover:refreshChecklist()
	local done = self:stepsDone()
	self.nextStep = "Done"
	for _, step in STEPS do
		if not done[step[1]] then
			self.nextStep = step[1]
			break
		end
	end
	for step, chip in self.checks do
		local isNext = step == self.nextStep
		chip.BackgroundColor3 = if done[step] then C.green elseif isNext then C.hotPink else C.lavender
		local icon = chip:FindFirstChild("Icon")
		if icon and icon:IsA("TextLabel") then
			icon.Size = if self.compact then UDim2.fromScale(1, 1) else UDim2.fromScale(1, 0.6)
			icon.Text = STEP_ICONS[step] .. (if self.compact and done[step] then "✓" else "")
		end
		local name = chip:FindFirstChild("Label")
		if name and name:IsA("TextLabel") then
			name.Visible = not self.compact
		end
		-- a check mark (done) or a pointing finger (next) too, so it isn't shown by color alone
		local label = chip:FindFirstChild("Label")
		if label and label:IsA("TextLabel") then
			label.Text = (if isNext then "👉" else "") .. STEP_NAMES[step] .. (if done[step] then " ✓" else "")
			label.TextColor3 = if done[step] or isNext then C.white else C.text
		end
	end
	self:styleDone()
end

function Makeover:setTab(tabId: string)
	local wasNails = self.tab == "Nails"
	self.tab = tabId
	self.bubbleLayer.Visible = tabId ~= "Nails" -- soap bubbles belong on the face, not the hand
	if (tabId == "Nails") ~= wasNails and self.client then
		self:renderPortrait() -- switch between the face and the hand
	end
	self.cursor.Visible = false
	for id, b in self.tabButtons do
		local active = id == tabId
		b.BackgroundColor3 = if active then C.pink else C.lavender
		b.Label.TextColor3 = if active then C.white else C.text
	end
	local isWash = tabId == "Wash"
	local brushing = tabId == "Hair" and self:needsBrush()
	self.washPanel.Visible = isWash
	self.brushHint.Visible = brushing
	self.grid.Visible = not isWash and not brushing
	self.chips.Visible = not isWash and not brushing
	if brushing then
		return
	end

	if isWash then
		self:refreshWash()
		return
	end

	local categories = {}
	for _, category in Catalog.Categories do
		if category.tab == tabId then
			table.insert(categories, category)
		end
	end
	if not self.subcategory[tabId] then
		self.subcategory[tabId] = categories[1].key
	end

	for _, child in self.chips:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	self.chips.Visible = #categories > 1
	-- up to 3 chips fit on one row; more wrap onto a second row
	local cols = if #categories <= 3 then math.max(#categories, 1) else math.ceil(#categories / 2)
	local rows = math.ceil(#categories / cols)
	local chipHeight = if self.compact then 44 else 56
	local chipsHeight = rows * chipHeight + (rows - 1) * 6
	self.chipLayout.CellSize = UDim2.new(1 / cols, -6 * (cols - 1) / cols, 0, chipHeight)
	self.chips.Size = UDim2.new(1, 0, 0, chipsHeight)
	-- Without sub-category chips, the grid moves up to use their space
	local below = if #categories > 1 then chipsHeight + 10 else 6
	self.grid.Position = UDim2.new(0, 0, 0.075, below)
	self.grid.Size = UDim2.new(1, 0, 0.925, -below)
	for i, category in categories do
		local active = self.subcategory[tabId] == category.key
		local chip = Theme.button({
			LayoutOrder = i,
			Size = UDim2.new(0, 124, 0, 56),
			Color = if active then C.purple else C.lavender,
			TextColor3 = if active then C.white else C.text,
			-- the chosen one is marked with a dot too, not just its color
			Text = (if active then "● " else "") .. category.label,
			ZIndex = 13,
			MaxText = 22,
			Parent = self.chips,
		})
		if not active then
			Theme.stroke(C.purple, 2).Parent = chip
		end
		chip.Activated:Connect(function()
			self.subcategory[tabId] = category.key
			self:setTab(tabId)
		end)
	end
	self:renderGrid()
end

------------------------------------------------------------------------------
-- Item grid

function Makeover:layoutGrid()
	local width = self.grid.AbsoluteSize.X - 8 - self.grid.ScrollBarThickness - 2
	local cols = if width >= 600 then 5 elseif width >= 470 then 4 else 3
	local gap = 8
	local cell = math.max(40, math.floor((width - gap * (cols - 1)) / cols))
	self.gridLayout.CellSize = UDim2.fromOffset(cell, math.floor(cell * 1.08))
	self.gridLayout.CellPadding = UDim2.fromOffset(gap, gap)
end

function Makeover:renderGrid()
	if self.tab == "Wash" or not self.client then
		return
	end
	local key = self.subcategory[self.tab]
	local category = Catalog.categoryByKey[key or ""]
	if not category or (self.tab == "Hair" and self:needsBrush()) then
		return -- still brushing out the tangles; the grid is hidden
	end
	self:layoutGrid()
	local theme = self:theme()
	for _, child in self.grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local order = 0
	self.cards = {}
	local eventId = self.ctx.eventId()
	for _, it in category.items do
		if not Catalog.isAvailable(it, self.ctx.profile, eventId) then
			continue
		end
		order += 1
		local selected = self.look[key] == it.id
		local unlocked = Catalog.isUnlocked(it, self.ctx.profile, eventId)

		local card = new("TextButton", {
			-- what you can wear that fits the theme first, then everything else you can wear,
			-- then locked items, and "None" last
			LayoutOrder = if Catalog.isNone(it.id)
				then 9999
				elseif not unlocked then order + 4000
				elseif theme and Catalog.matchesTheme(it, theme) then order
				else order + 2000,
			Text = "",
			BackgroundTransparency = 0,
			BackgroundColor3 = if selected then C.softPink else C.white,
			AutoButtonColor = true,
			ZIndex = 13,
			Parent = self.grid,
		}, {
			Theme.corner(16),
		})
		local stroke = Theme.stroke(if selected then C.hotPink else C.lavender, if selected then 4 else 2)
		stroke.Parent = card

		local preview = new("Frame", {
			Position = UDim2.fromScale(0.05, 0.04),
			Size = UDim2.fromScale(0.9, 0.72),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 14,
			Parent = card,
		})
		-- avatar-shop items (hair, costume pieces, hats) show a picture of the real thing
		if category.preview == "portrait" and not it.asset then
			local previewLook = table.clone(self.look)
			previewLook[key] = it.id
			if key == "outfit" or key == "outfitPattern" then
				-- outfits show head to toe, so the whole dress or pattern is visible
				LookRenderer.renderBody(preview, self.client, previewLook, { clean = 1, mood = "smile" })
			else
				local zoom = if key == "hairStyle" or key == "accessory" then 1.1 else 1.45
				LookRenderer.render(preview, self.client, previewLook, { headOnly = true, clean = 1, mood = "smile", zoom = zoom })
			end
		elseif it.asset then
			new("ImageLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Image = "rbxthumb://type=Asset&id=" .. it.asset .. "&w=150&h=150",
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 15,
				Parent = preview,
			})
		elseif category.preview == "icon" and it.icon then
			new("TextLabel", { Size = UDim2.fromScale(1, 1), Text = it.icon, TextColor3 = C.hotPink, ZIndex = 15, Parent = preview }, { Theme.maxText(56) })
		elseif it.color then
			local dot = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.8, 0.8),
				ZIndex = 15,
				Parent = preview,
			}, { new("UIAspectRatioConstraint", { AspectRatio = 1 }), Theme.round(), Theme.stroke(C.white, 3) })
			LookRenderer.paint(dot, it)
		else
			new("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "⚪", ZIndex = 15, Parent = preview }, { Theme.maxText(48) })
		end

		new("TextLabel", {
			Position = UDim2.fromScale(0.04, 0.77),
			Size = UDim2.fromScale(0.92, 0.2),
			Text = if Catalog.isNone(it.id) then "None" else it.name,
			ZIndex = 15,
			Parent = card,
		}, { Theme.maxText(18) })

		if theme and Catalog.matchesTheme(it, theme) then
			new("TextLabel", {
				Position = UDim2.new(0, 3, 0, 3),
				Size = UDim2.fromScale(0.24, 0.22),
				Text = "⭐",
				ZIndex = 18,
				Parent = card,
			})
		end
		-- 💌 when this item would make one of the client's wishes come true
		for _, w in self.client.wishes or {} do
			if w.key == key and not Scoring.wishMet(w, self.look) and Scoring.wishMet(w, { [key] = it.id }) then
				new("TextLabel", {
					Position = UDim2.new(0.24, 3, 0, 3),
					Size = UDim2.fromScale(0.24, 0.22),
					Text = "💌",
					ZIndex = 18,
					Parent = card,
				})
				break
			end
		end
		if it.event or it.gift then
			new("TextLabel", {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 3, 0.76, 0),
				Size = UDim2.fromScale(0.22, 0.2),
				Text = if it.gift then "🎁" else (Events.byId[it.event] and Events.byId[it.event].icon or "✨"),
				ZIndex = 18,
				Parent = card,
			})
		end

		if not unlocked then
			new("Frame", {
				Size = UDim2.fromScale(1, 0.76),
				BackgroundColor3 = C.white,
				BackgroundTransparency = 0.6,
				ZIndex = 16,
				Parent = card,
			}, { Theme.corner(16) })
			new("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -3, 0, 3),
				Size = UDim2.fromScale(0.62, 0.18),
				BackgroundTransparency = 0,
				BackgroundColor3 = if it.pass then C.gold elseif it.level then C.green else C.purple,
				TextColor3 = if it.pass then C.text else C.white,
				Text = "🔒 " .. (if it.pass == "VIP" then "VIP" elseif it.pass then "Pack" elseif it.level then "Lv " .. it.level else "💰" .. it.price),
				ZIndex = 17,
				Parent = card,
			}, { Theme.round(), Theme.padding(2) })
		else
			local check = new("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -3, 0, 3),
				Size = UDim2.fromScale(0.22, 0.2),
				BackgroundTransparency = 0,
				BackgroundColor3 = C.hotPink,
				TextColor3 = C.white,
				Text = "✓",
				Visible = selected,
				ZIndex = 17,
				Parent = card,
			}, { Theme.round() })
			self.cards[it.id] = { card = card, stroke = stroke, check = check }
		end

		card.Activated:Connect(function()
			if unlocked then
				self:choose(key, it.id)
			else
				self.ctx.askUnlock(it)
			end
		end)
	end
end

function Makeover:choose(key: string, itemId: string)
	if self.done then
		self:setDone(false)
	end
	local before = self.hearts
	local wishesBefore = self:wishesMet()
	self.look[key] = itemId
	if key == "hairStyle" or key == "hairColor" then
		self.pickedHair = true
	end
	Remotes.UpdateLook:FireServer(key, itemId)
	self:renderPortrait()
	self:refreshSelection(key)
	if key == "pose" then
		self:previewPose()
	elseif key == "costumeBack" and not Catalog.isNone(itemId) then
		-- wings and capes are on your back: turn around to show them off, then turn back
		self.spin = math.pi
		local picked = itemId
		task.delay(2.2, function()
			if self.look.costumeBack == picked then
				self.spin = 0
			end
		end)
	end
	Theme.pop(self.heartsLabel)

	local theme = self:theme()
	local it = Catalog.byId[itemId]
	if key == "nailColor" or key == "nailArt" then
		-- paint each nail with a little sparkle, one after another
		local nails = {}
		for _, n in self.portraitRoot:GetChildren() do
			if n.Name == "Nail" and n:IsA("GuiObject") then
				table.insert(nails, n)
			end
		end
		for i, n in nails do
			task.delay(i * 0.08, function()
				Effects.sparkle(self.bubbleLayer, n.Position.X.Scale, n.Position.Y.Scale, if key == "nailArt" then "💫" else "✨")
			end)
		end
	end
	if self:wishesMet() > wishesBefore then
		self:say("💌 A judge's wish came true!", 2.5)
		Effects.confetti(self.frame, 15)
	elseif self.hearts >= 5 and not self.bestShown then
		self.bestShown = true
		self:say("This is my BEST look EVER! 💖", 3)
		Effects.confetti(self.frame, 30)
	elseif Catalog.isNone(itemId) then
		self:say(pick(NONE_LINES), 2)
	elseif theme and Catalog.matchesTheme(it, theme) then
		self:say(string.format(pick(THEME_LINES), themeWord(theme)), 2.5)
	elseif self.hearts >= before then
		self:say(pick(LIKE_LINES), 2)
	end
end

-- Moves the pink "selected" outline and ✓ without rebuilding the whole grid (fast on phones).
function Makeover:refreshSelection(key: string)
	for itemId, c in self.cards or {} do
		local selected = self.look[key] == itemId
		c.card.BackgroundColor3 = if selected then C.softPink else C.white
		c.stroke.Color = if selected then C.hotPink else C.lavender
		c.stroke.Thickness = if selected then 4 else 2
		c.check.Visible = selected
	end
end

-- Re-draw locks after coins/unlocks change.
function Makeover:refreshProfile()
	if self.frame.Visible then
		if self.tab == "Wash" then
			self:refreshWash()
		else
			self:renderGrid()
		end
	end
end

------------------------------------------------------------------------------
-- Washing

function Makeover:refreshWash()
	local clean = self:cleanAmount()
	local bubbles = #self.bubbles
	if clean < 0.98 then
		self.washHint.Text = if self.tool == "soap" then "Rub the dirt off! 🧽" else "Pick the Soap to scrub! 🧽"
	elseif bubbles > 0 then
		self.washHint.Text = "Rinse off the bubbles! 🚿"
	else
		self.washHint.Text = "Sparkly clean! ✨ Now do the hair! 💇"
	end
	for id, b in self.toolButtons do
		local active = id == self.tool
		b.BackgroundColor3 = if active then C.pink else C.lavender
		b.Label.TextColor3 = if active then C.white else C.text
	end
	self.cleanFill.Size = UDim2.fromScale(math.clamp(clean, 0, 1), 1)
	self.cleanText.Text = "Clean: " .. math.floor(clean * 100 + 0.5) .. "%" .. (if bubbles > 0 then "  🫧 " .. bubbles else "")
	self:refreshChecklist()
end

function Makeover:clearBubbles()
	for _, b in self.bubbles do
		b.frame:Destroy()
	end
	table.clear(self.bubbles)
end

function Makeover:sendWash(force: boolean?)
	if force or os.clock() - self.lastSent > SEND_INTERVAL then
		self.lastSent = os.clock()
		Remotes.WashProgress:FireServer(self:cleanAmount(), #self.bubbles == 0)
	end
	local washed = self:isWashed()
	if washed and not self.wasClean then
		self:say("Ahh! I feel SO fresh! ✨", 3)
		Effects.confetti(self.frame, 20)
		self:renderPortrait()
	end
	self.wasClean = washed
end

function Makeover:addBubble(rel: Vector2)
	if #self.bubbles >= MAX_BUBBLES then
		return
	end
	local size = 0.05 + math.random() * 0.05
	local rainbow = self.ctx.profile.passes and self.ctx.profile.passes.RainbowBubbles
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(rel.X, rel.Y),
		Size = UDim2.fromScale(size, size),
		BackgroundColor3 = if rainbow then Color3.fromHSV(math.random(), 0.35, 1) else C.white,
		BackgroundTransparency = 0.25,
		ZIndex = 101,
		Parent = self.bubbleLayer,
	}, { Theme.round(), Theme.stroke(Color3.fromRGB(180, 220, 255), 2) })
	table.insert(self.bubbles, { frame = frame, pos = rel, size = size })
end

function Makeover:scrub(pos: Vector2, moved: number)
	local root = self.portraitRoot
	if not root or not self.client then
		return
	end
	local size = root.AbsoluteSize.X
	local origin = root.AbsolutePosition
	if size <= 0 then
		return
	end
	local rel = (pos - origin) / size
	if rel.X < 0 or rel.X > 1 or rel.Y < 0 or rel.Y > 1 then
		return
	end
	local brush = 0.05
	local changed = false
	local wasDirty = self:cleanAmount() < 0.98

	if self.tool == "soap" then
		Sounds.play("Scrub", 0.35)
		for i, spot in self.client.dirt do
			local h = self.dirtHealth[i]
			if h > 0 and (rel - Vector2.new(spot.x, spot.y)).Magnitude < spot.size / 2 + brush then
				self.dirtHealth[i] = math.max(0, h - moved / (size * 0.4))
				local f = self.dirtFrames[i]
				if f then
					LookRenderer.setDirtHealth(f, self.dirtHealth[i])
				end
				if self.dirtHealth[i] <= 0 then
					Effects.sparkle(self.bubbleLayer, spot.x, spot.y)
					if math.random() < 0.3 then
						self:say(pick(WASH_LINES), 1.6)
					end
				end
				changed = true
			end
		end
		self.bubbleTravel = (self.bubbleTravel or 0) + moved
		if self.bubbleTravel > size * 0.05 then
			self.bubbleTravel = 0
			self:addBubble(rel)
			changed = true
		end
		-- All the dirt is gone: wipe the last specks and switch to rinsing for the player
		if wasDirty and self:cleanAmount() >= 0.98 then
			for i, f in self.dirtFrames do
				self.dirtHealth[i] = 0
				LookRenderer.setDirtHealth(f, 0)
			end
			self.tool = "rinse"
			self.scrubbing = false
			self:say("No more dirt! Now rinse the bubbles! 🚿", 3)
			self:refreshWash()
			self:sendWash(true)
		end
	else
		if #self.bubbles > 0 then
			Sounds.play("Rinse", 1.2)
		end
		for i = #self.bubbles, 1, -1 do
			local b = self.bubbles[i]
			if (rel - b.pos).Magnitude < b.size / 2 + brush * 2 then
				b.frame:Destroy()
				table.remove(self.bubbles, i)
				changed = true
			end
		end
	end

	if changed then
		self:refreshWash()
		self:sendWash()
	end
end

------------------------------------------------------------------------------
-- The Dressing Hall: you walk around in your own avatar. Step on a station's glowing pad and its
-- menu slides in on the right while the camera frames you on the left; walk off and it closes.
-- The look itself is put on by the server, so everyone in the hall sees it.

function Makeover:is3D(): boolean
	return self.station ~= nil
end

function Makeover:character(): Model?
	return Players.LocalPlayer.Character
end

-- The guide buttons walk you over to a station: off the pad you're on, along the aisle in front
-- of the mirrors (so you don't stop at every pad on the way), then onto the one you picked.
local AISLE_Z = 48

-- Is the kid steering with the joystick or keys right now? (Then they're in charge, not the guide.)
local controls = nil
local function steering(): boolean
	if controls == nil then
		local ok, module = pcall(function()
			local playerModule = Players.LocalPlayer:FindFirstChild("PlayerScripts")
				and Players.LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
			return playerModule and require(playerModule :: any):GetControls()
		end)
		controls = if ok and module then module else false
	end
	if not controls then
		return false
	end
	local ok, move = pcall(function()
		return controls:GetMoveVector()
	end)
	return ok and typeof(move) == "Vector3" and move.Magnitude > 0.1
end

function Makeover:walkTo(station: Stations.Station)
	local character = self:character()
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then
		return
	end
	if self.station == station then
		return
	end
	if self.station then
		self:closeStation()
	end
	self.walkTarget = station
	local walkId = (self.walkId or 0) + 1
	self.walkId = walkId
	local from = root.Position
	local points = {
		Vector3.new(from.X, from.Y, AISLE_Z),
		Vector3.new(station.pad.X, from.Y, AISLE_Z),
		Vector3.new(station.pad.X, from.Y, station.pad.Z),
	}
	task.spawn(function()
		for _, point in points do
			if self.walkId ~= walkId or not root.Parent then
				return
			end
			humanoid:MoveTo(point)
			local started = os.clock()
			while os.clock() - started < 6 and self.walkId == walkId and root.Parent do
				if Vector3.new(root.Position.X - point.X, 0, root.Position.Z - point.Z).Magnitude < 1.5 then
					break
				end
				if steering() then
					self.walkId += 1
					self.walkTarget = nil
					return
				end
				task.wait(0.05)
			end
		end
		if self.walkId == walkId then
			self.walkTarget = nil
		end
	end)
end

function Makeover:openStation(station: Stations.Station)
	self.station = station
	-- the jump button sat on top of the item cards and ate taps: touch controls rest while you style
	GuiService.TouchControlsEnabled = false
	self.spin = 0
	self.stationOpenedAt = os.clock()
	self:setTab(station.tab)
	self:refreshTheme()
	self:showBotTags(false)
	self.right.Visible = true
	Theme.pop(self.right)
	Sounds.play("Pop", 0.6)
	local character = self:character()
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and root:IsA("BasePart") then
		humanoid.AutoRotate = false
		humanoid:Move(Vector3.zero)
		-- turn to face the camera
		root.CFrame = CFrame.lookAt(root.Position, root.Position + station.facing)
		self.standRotation = root.CFrame.Rotation
		self.spinShown = 0
	end
	self:previewPose()
end

-- At the Pose Stage your pose keeps playing so you can see it; anywhere else it stops.
function Makeover:previewPose()
	if self.poseTrack then
		self.poseTrack:Stop(0.3)
		self.poseTrack = nil
	end
	local me = self:character()
	if me and self.station and self.station.tab == "Show" and not Catalog.isNone(self.look.pose) then
		local track = Avatar.pose(me, self.look.pose)
		if track then
			track.Looped = true
			self.poseTrack = track
		end
	end
end

-- Style Bots' name tags float over the stations; hide them while the camera is framing you.
function Makeover:showBotTags(show: boolean)
	local world = Workspace:FindFirstChild("GlowUpWorld")
	if not world then
		return
	end
	for _, model in world:GetChildren() do
		if model:IsA("Model") and string.find(model.Name, "(Style Bot)", 1, true) then
			local head = model:FindFirstChild("Head")
			local tag = head and head:FindFirstChild("NameTag")
			if tag and tag:IsA("BillboardGui") then
				tag.Enabled = show
			end
		end
	end
end

function Makeover:closeStation()
	GuiService.TouchControlsEnabled = true
	self:showBotTags(true)
	self.station = nil
	self.spinning = false
	self.right.Visible = false
	if self.poseTrack then
		self.poseTrack:Stop(0.3)
		self.poseTrack = nil
	end
	local character = self:character()
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = true
	end
end

-- The part of the screen your avatar is framed in: between the guide and the station menu.
function Makeover:stageRect(viewport: Vector2): (Vector2, Vector2)
	-- (on phones the guide is a strip along the top, so the space starts below it instead)
	local left = if self.compact then 0 else self.guide.AbsolutePosition.X + self.guide.AbsoluteSize.X
	local right = if self.right.Visible then self.right.AbsolutePosition.X else viewport.X
	local top = if self.compact then self.guide.AbsolutePosition.Y + self.guide.AbsoluteSize.Y else 64
	local bottom = viewport.Y
	return Vector2.new(left, top), Vector2.new(math.max(right - left, 1), bottom - top)
end

-- Where the camera goes so your avatar fills the space next to the station menu.
function Makeover:cameraTarget(camera: Camera): CFrame?
	local character = self:character()
	local head = character and character:FindFirstChild("Head")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local station = self.station
	if not (station and head and root and head:IsA("BasePart") and root:IsA("BasePart")) then
		return nil
	end
	local viewport = camera.ViewportSize
	if not viewport or viewport.X <= 0 then
		return nil
	end
	local framing = FRAMING[self.tab] or FRAMING.Hair
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local feet = root.Position.Y - (if humanoid then humanoid.HipHeight + root.Size.Y / 2 else 3)
	local focus = if framing.focus == "body"
		then Vector3.new(root.Position.X, (feet + head.Position.Y + head.Size.Y) / 2 + 0.3, root.Position.Z)
		else head.Position + Vector3.new(0, 0.45, 0)
	local origin, size = self:stageRect(viewport)
	local center = origin + size / 2
	local tanV = math.tan(math.rad(camera.FieldOfView) / 2)
	local tanH = tanV * viewport.X / viewport.Y
	-- far enough back that the framing height fills most of that space
	local distance = framing.height * viewport.Y / (2 * tanV * math.min(size.Y, size.X * 1.3) * 0.9)
	local position = focus + station.facing * distance
	-- then turn the camera so you sit in that space instead of the middle of the screen
	local ndcX = center.X / viewport.X * 2 - 1
	local ndcY = 1 - center.Y / viewport.Y * 2
	return CFrame.lookAt(position, focus) * CFrame.Angles(0, math.atan(ndcX * tanH), 0) * CFrame.Angles(-math.atan(ndcY * tanV), 0, 0)
end

function Makeover:startStage()
	local controlling = false
	RunService:BindToRenderStep("GlowUpStage", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local camera = Workspace.CurrentCamera
		local character = self:character()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not self.frame.Visible then
			if self.station then
				self:closeStation()
			end
			controlling = false -- (don't hand the camera back: the show or results own it now)
			return
		end
		local here = if root and root:IsA("BasePart") then Stations.at(root.Position) else nil
		if self.walkTarget then
			if here == self.walkTarget then
				self.walkTarget = nil
				self.walkId = (self.walkId or 0) + 1
			else
				here = nil -- just passing by
			end
		end
		if here ~= self.station then
			if self.station then
				self:closeStation()
			end
			if here then
				self:openStation(here)
			end
		end
		self.spinHint.Visible = self.station ~= nil and not self.spinning and os.clock() - (self.stationOpenedAt or 0) < 4

		if not self.station then
			if controlling then
				controlling = false
				camera.CameraType = Enum.CameraType.Custom
			end
			return
		end
		-- turned however far the player spun themselves (smoothly, so turning to show a cape glides)
		self.spinShown = (self.spinShown or 0) + (self.spin - (self.spinShown or 0)) * (1 - math.exp(-dt * 6))
		if root and root:IsA("BasePart") and self.standRotation then
			root.CFrame = CFrame.new(root.Position) * self.standRotation * CFrame.Angles(0, self.spinShown, 0)
		end
		local target = self:cameraTarget(camera)
		if target then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = if controlling then camera.CFrame:Lerp(target, 1 - math.exp(-dt * 8)) else target
			controlling = true
		end
	end)
end

function Makeover:connectInput()
	local lastPos: Vector2? = nil
	local activeTouch: InputObject? = nil -- only follow the first finger

	-- Drag across the 3D client to spin them around
	UserInputService.InputBegan:Connect(function(input)
		local isPress = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		if isPress and self.frame.Visible and self:is3D() and not self.ctx.isModalOpen() then
			local pos = screenPosition(input)
			local origin, size = self:stageRect(Workspace.CurrentCamera.ViewportSize)
			if pos.X >= origin.X and pos.X <= origin.X + size.X and pos.Y >= origin.Y then
				self.spinning = true
				self.spinFrom = pos.X
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
		if self.spinning and isMove then
			local pos = screenPosition(input)
			self.spin += (pos.X - (self.spinFrom or pos.X)) * 0.012
			self.spinFrom = pos.X
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self.spinning = false
		end
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not self:rubMode() or not self.frame.Visible or self.ctx.isModalOpen() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local pos = screenPosition(input)
			if self:isOverPortrait(pos) and not self.scrubbing then
				self.scrubbing = true
				activeTouch = if input.UserInputType == Enum.UserInputType.Touch then input else nil
				lastPos = pos
				self:moveCursor(pos)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
		if not isMove or not self.frame.Visible then
			return
		end
		if input.UserInputType == Enum.UserInputType.Touch and activeTouch and input ~= activeTouch then
			return
		end
		local pos = screenPosition(input)
		self:moveCursor(pos)
		local mode = self:rubMode()
		if self.scrubbing and mode then
			local moved = if lastPos then (pos - lastPos).Magnitude else 0
			lastPos = pos
			if moved > 0 then
				if mode == "wash" then
					self:scrub(pos, moved)
				else
					self:brush(pos, moved)
				end
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if input.UserInputType == Enum.UserInputType.Touch and activeTouch and input ~= activeTouch then
				return
			end
			activeTouch = nil
			if self.scrubbing then
				self.scrubbing = false
				lastPos = nil
				self:sendWash(true)
			end
			if input.UserInputType == Enum.UserInputType.Touch then
				self.cursor.Visible = false
			end
		end
	end)
end

function Makeover:isOverPortrait(pos: Vector2): boolean
	local holder = self.portraitHolder
	local a, s = holder.AbsolutePosition, holder.AbsoluteSize
	return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end

function Makeover:moveCursor(pos: Vector2)
	local mode = self:rubMode()
	self.cursor.Visible = self:isOverPortrait(pos) and mode ~= nil and self.frame.Visible
	self.cursor.Text = if mode == "brush" then "🖌️" elseif self.tool == "soap" then "🧽" else "🚿"
	local f = self.frame.AbsolutePosition
	self.cursor.Position = UDim2.fromOffset(pos.X - f.X, pos.Y - f.Y)
end

return Makeover
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- Shows who won the fashion show, what the judges said, and the coins you earned.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local LookRenderer = require(ReplicatedStorage.Shared.LookRenderer)
local Effects = require(script.Parent.Effects)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Results = {}
Results.__index = Results

local MEDALS = { "🥇", "🥈", "🥉" }

function Results.new(gui: ScreenGui)
	local self = setmetatable({}, Results)
	self.gui = gui
	self.panel = new("Frame", {
		Name = "Results",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.55, 0),
		Size = UDim2.new(0.4, 0, 0.78, 0),
		BackgroundColor3 = C.white,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, { Theme.corner(24), Theme.stroke(C.gold, 4), Theme.padding(14), new("UISizeConstraint", { MinSize = Vector2.new(320, 0) }) })

	self.title = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 40),
		Text = "🏆 Fashion Show Results",
		TextColor3 = C.hotPink,
		ZIndex = 41,
		Parent = self.panel,
	}, { Theme.maxText(32) })
	-- Your own client, big, with what the judges said (only you see this)
	local mineCard = new("Frame", {
		Position = UDim2.new(0, 0, 0, 44),
		Size = UDim2.new(1, 0, 0, 130),
		BackgroundColor3 = C.softPink,
		ZIndex = 41,
		Parent = self.panel,
	}, { Theme.corner(14) })
	self.minePortrait = new("Frame", {
		Position = UDim2.new(0, 6, 0, 6),
		Size = UDim2.new(0, 118, 0, 118),
		BackgroundColor3 = C.white,
		ZIndex = 42,
		Parent = mineCard,
	}, { Theme.corner(12) })
	self.mine = new("TextLabel", {
		Position = UDim2.new(0, 130, 0, 0),
		Size = UDim2.new(1, -134, 1, 0),
		Text = "",
		TextWrapped = true,
		ZIndex = 42,
		Parent = mineCard,
	}, { Theme.maxText(19), Theme.padding(6) })
	self.list = new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 182),
		Size = UDim2.new(1, 0, 1, -182),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 41,
		Parent = self.panel,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	return self
end

function Results:show(results)
	local theme = Catalog.themeById[results.themeId]
	self.title.Text = "🏆 Results: " .. (theme and theme.name or "")
	for _, child in self.list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	self.mine.Text = "Watch the show, then get dressed up next round! 👀"
	local old = self.minePortrait:FindFirstChild("Portrait")
	if old then
		old:Destroy()
	end
	for _, row in results.rows do
		local isMe = row.userId == Players.LocalPlayer.UserId
		if isMe then
			-- the two most useful judge tips, short; stars only when they're good news
			local comments = table.concat(row.comments, "  ", 1, math.min(#row.comments, 2))
			local stars = if row.stars >= 3 then "  " .. Theme.stars(row.stars) else ""
			self.mine.Text = string.format(
				"%s:%s\n%s  %s  +%d 💰%s\n%s",
				row.client.name,
				stars,
				row.ribbon or "",
				row.award or "",
				row.coins,
				if row.friendBonus then "  👯 friend bonus!" else "",
				comments
			)
			LookRenderer.render(self.minePortrait, row.client, row.look, { clean = 1, mood = if row.stars >= 4 then "grin" else "smile" })
			self:celebrate(row, #results.rows)
		end

		local card = new("Frame", {
			LayoutOrder = row.rank,
			Size = UDim2.new(1, -8, 0, 76),
			BackgroundColor3 = if isMe then C.softPink else C.lavender,
			ZIndex = 42,
			Parent = self.list,
		}, { Theme.corner(14) })
		new("TextLabel", {
			Position = UDim2.new(0, 6, 0, 0),
			Size = UDim2.new(0, 44, 1, 0),
			-- top 3 get a medal; everyone else shows their award's emoji (never a "last place" number)
			Text = MEDALS[row.rank] or (string.match(row.award or "", "^(%S+)") or "💖"),
			ZIndex = 43,
			Parent = card,
		}, { Theme.maxText(34) })
		local face = new("Frame", {
			Position = UDim2.new(0, 54, 0, 4),
			Size = UDim2.new(0, 68, 0, 68),
			BackgroundColor3 = C.white,
			ZIndex = 43,
			Parent = card,
		}, { Theme.corner(12) })
		LookRenderer.render(face, row.client, row.look, { clean = 1, mood = if row.stars >= 4 then "grin" else "smile" })
		new("TextLabel", {
			Position = UDim2.new(0, 130, 0, 6),
			Size = UDim2.new(1, -136, 0, 32),
			Text = row.client.name,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
			Parent = card,
		}, { Theme.maxText(22) })
		new("TextLabel", {
			Position = UDim2.new(0, 130, 0, 40),
			Size = UDim2.new(1, -136, 0, 30),
			-- Everyone sees the award; stars only show when they're great (or it's your own look)
			Text = (row.award or "") .. (if row.stars >= 4 or isMe then "  " .. Theme.stars(row.stars) else ""),
			TextColor3 = C.goldText,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
			Parent = card,
		}, { Theme.maxText(24) })
	end

	self.panel.Visible = true
	Theme.pop(self.panel)
end

-- A big pop-up for your own result, with confetti for good scores.
function Results:celebrate(row, players: number)
	local title
	if row.ribbon then
		title = row.ribbon .. "!"
	elseif players >= 2 and row.rank == 1 then
		title = "🏆 You WON! 🏆"
	elseif players >= 2 and row.rank <= 3 then
		title = MEDALS[row.rank] .. " #" .. row.rank .. " Place!"
	elseif row.stars >= 4.5 then
		title = "😍 STUNNING!"
	elseif row.stars >= 3 then
		title = "✨ Great job!"
	else
		title = "💖 You walked the runway!"
	end
	local stars = if row.stars >= 3 then Theme.stars(row.stars) .. "   " else ""
	Effects.splash(self.gui, title, stars .. (row.award or "") .. "   +" .. row.coins .. " 💰", C.hotPink, 3, function(card)
		card.AnchorPoint = Vector2.new(0.5, 0)
		card.Position = UDim2.fromScale(0.5, 0.12)
		card.Size = UDim2.fromScale(0.5, 0.22)
	end)
	if row.stars >= 3.5 or (players >= 2 and row.rank == 1) then
		Effects.confetti(self.gui, 60)
	end
end

function Results:hide()
	self.panel.Visible = false
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- The shop: unlock looks with coins you earn, or get Robux extras.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Clients = require(ReplicatedStorage.Shared.Clients)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local LookRenderer = require(ReplicatedStorage.Shared.LookRenderer)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Shop = {}
Shop.__index = Shop

local ROBUX_ITEMS = {
	{ kind = "pass", key = "VIP", icon = "👑", title = "VIP Glam Kit", text = "The real Starlight Royal Gown and Rainbow Sequin Dress, rainbow & galaxy hair, Royal Updo, Mermaid Waves, Rainbow Wings, a crown and more!" },
	{ kind = "pass", key = "Princess", icon = "👸", title = "Princess Pack", text = "Real Pastel Summer and Enchanted Rainbow gowns, Ice Ball Gown, Rose Gown, Princess Curls, Rose Gold hair, a tiara, pink gems and a Unicorn pet!" },
	{ kind = "pass", key = "FashionWeek", icon = "👗", title = "Fashion Week Pack", text = "6 real designer outfits: Pink Ribbon, Pink Ruffle, Rainbow Heart, Snow Crystal, Pastel Dream and a Designer Puffer!" },
	{ kind = "pass", key = "PetPalace", icon = "🐢", title = "Pet Palace", text = "4 magic pets to walk the runway with you: Winged Bunny, Glitter Kitty, Baby Pegasus and Bubble Turtle!" },
	{ kind = "pass", key = "DoubleCoins", icon = "💰", title = "2x Coins", text = "Earn double coins after every fashion show, forever." },
	{ kind = "pass", key = "RunwayStar", icon = "🌟", title = "Runway Star", text = "Confetti cannons and sparkles every time you walk the runway!" },
	{ kind = "product", key = "CoinsSmall", icon = "💰", title = "500 Coins", text = "Unlock new looks a little faster." },
	{ kind = "product", key = "CoinsMedium", icon = "💰", title = "1,500 Coins", text = "Enough for a big dream dress." },
	{ kind = "product", key = "CoinsLarge", icon = "💎", title = "4,000 Coins", text = "Fill your closet!" },
}

local priceCache: { [string]: string } = {}

-- A model to show hairstyles, lashes, outfits and extras on in the shop
local SAMPLE_CLIENT = Clients.generate(Random.new(7))

function Shop.new(gui: ScreenGui, ctx)
	local self = setmetatable({}, Shop)
	self.ctx = ctx
	self.tab = "Coins"

	self.overlay = new("TextButton", {
		Name = "Shop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.shadow,
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 60,
		Parent = gui,
	})
	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromScale(0.7, 0.8),
		BackgroundColor3 = C.white,
		ZIndex = 61,
		Parent = self.overlay,
	}, { Theme.corner(26), Theme.stroke(C.purple, 5), Theme.padding(14) })
	self.panel = panel

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 40),
		Text = "🛍️ Glow Up Shop",
		TextColor3 = C.purple,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
		Parent = panel,
	}, { Theme.maxText(34) })
	local close = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 44, 0, 44),
		Text = "✕",
		Color = C.red,
		ZIndex = 62,
		Parent = panel,
	})
	close.Activated:Connect(function()
		self:close()
	end)

	local tabs = new("Frame", {
		Position = UDim2.new(0, 0, 0, 50),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		ZIndex = 62,
		Parent = panel,
	}, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) })
	self.tabButtons = {}
	for i, t in { { "Coins", "💰 Unlock" }, { "Looks", "📖 My Looks" }, { "Robux", "💎 Extras" } } do
		local b = Theme.button({ Text = t[2], LayoutOrder = i, Size = UDim2.new(1 / 3, -6, 1, 0), ZIndex = 63, Parent = tabs })
		b.Activated:Connect(function()
			self.tab = t[1]
			self:render()
		end)
		self.tabButtons[t[1]] = b
	end

	self.list = new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 104),
		Size = UDim2.new(1, 0, 1, -104),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.purple,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 62,
		Parent = panel,
	}, { Theme.padding(6) })

	self:buildConfirm(gui)
	return self
end

------------------------------------------------------------------------------
-- Buying

function Shop:promptPass(key: string)
	local id = Config.GamePasses[key]
	if not id or id == 0 then
		self.ctx.toast("Coming soon! 💖")
		return
	end
	MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
end

function Shop:promptProduct(key: string)
	local id = Config.DevProducts[key]
	if not id or id == 0 then
		self.ctx.toast("Coming soon! 💖")
		return
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
end

function Shop:buy(it: Catalog.Item)
	local called, ok, message = pcall(function()
		return Remotes.BuyItem:InvokeServer(it.id)
	end)
	if not called then
		self.ctx.toast("Oops! Try again in a moment.", C.red)
		return
	end
	self.ctx.toast(message, if ok then C.green else C.red)
end

function Shop:buildConfirm(gui: ScreenGui)
	self.confirm = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 380, 0, 190),
		BackgroundColor3 = C.white,
		Visible = false,
		ZIndex = 80,
		Parent = gui,
	}, { Theme.corner(22), Theme.stroke(C.hotPink, 5), Theme.padding(16) })
	self.confirmText = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 90),
		Text = "",
		ZIndex = 81,
		Parent = self.confirm,
	}, { Theme.maxText(26) })
	self.confirmYes = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(0.48, 0, 0, 52),
		Text = "Yes!",
		Color = C.green,
		ZIndex = 82,
		Parent = self.confirm,
	})
	local no = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0.48, 0, 0, 52),
		Text = "Not now",
		Color = C.textLight,
		ZIndex = 82,
		Parent = self.confirm,
	})
	no.Activated:Connect(function()
		self.confirm.Visible = false
	end)
	self.confirmYes.Activated:Connect(function()
		self.confirm.Visible = false
		if self.onConfirm then
			self.onConfirm()
		end
	end)
end

-- Asks before buying a Developer Product (like Super Soap), showing the Robux price.
function Shop:askProduct(key: string)
	local id = Config.DevProducts[key]
	if not id or id == 0 then
		self.ctx.toast("Coming soon! 💖")
		return
	end
	local entry
	for _, e in ROBUX_ITEMS do
		if e.key == key then
			entry = e
		end
	end
	local price = priceCache["product:" .. key]
	self.confirmText.Text = (entry and entry.icon .. " " .. entry.title or key) .. "\n" .. (entry and entry.text or "") .. (if price then "\n" .. price else "")
	self.confirmYes.Text = "Buy" .. (if price then " (" .. price .. ")" else "")
	self.onConfirm = function()
		self:promptProduct(key)
	end
	self.confirm.Visible = true
	Theme.pop(self.confirm)
	if not price and entry then
		self:fetchPrice(entry, "product:" .. key, self.confirmYes)
	end
end

-- Called when a player taps a locked item.
function Shop:askUnlock(it: Catalog.Item)
	if it.level then
		self.ctx.toast("⭐ " .. it.name .. " unlocks free at Level " .. it.level .. "! Keep styling!", C.green)
		return
	elseif it.pass then
		local packName = if it.pass == "VIP" then "👑 VIP Glam Kit"
			elseif it.pass == "Princess" then "👸 Princess Pack"
			elseif it.pass == "FashionWeek" then "👗 Fashion Week Pack"
			elseif it.pass == "PetPalace" then "🐢 Pet Palace"
			else it.pass
		-- never a Robux prompt in the middle of a round: point to the Shop for later instead
		local phase = self.ctx.state().phase
		if phase ~= "Intermission" and phase ~= "Waiting" then
			self.ctx.toast(it.name .. " comes with the " .. packName .. ". Ask a grown-up in the Shop after the show!", C.purple)
			return
		end
		self.confirmText.Text = it.name .. " comes with the " .. packName .. ". Take a look?"
		self.confirmYes.Text = "Take a look"
		self.onConfirm = function()
			self:promptPass(it.pass :: string)
		end
	else
		local coins = self.ctx.profile.coins or 0
		if coins < it.price then
			self.ctx.toast("You need " .. (it.price - coins) .. " more coins for " .. it.name .. ". Win shows to earn more!", C.purple)
			return
		end
		self.confirmText.Text = "Unlock " .. it.name .. " for 💰 " .. it.price .. "?"
		self.confirmYes.Text = "Unlock!"
		self.onConfirm = function()
			self:buy(it)
		end
	end
	self.confirm.Visible = true
	Theme.pop(self.confirm)
end

------------------------------------------------------------------------------
-- Shop window

function Shop:open(tab: string?)
	if tab then
		self.tab = tab
	end
	self.overlay.Visible = true
	Theme.pop(self.panel)
	self:render()
end

function Shop:close()
	self.overlay.Visible = false
end

function Shop:refreshProfile(lookbookChanged: boolean?)
	-- (re-drawing 24 Look Book portraits is slow, so only when the Look Book changed)
	if self.overlay.Visible and (self.tab ~= "Looks" or lookbookChanged) then
		self:render()
	end
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") or child:IsA("UIGridLayout") or child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

function Shop:render()
	for id, b in self.tabButtons do
		b.BackgroundColor3 = if id == self.tab then C.purple else C.lavender
		b.TextColor3 = if id == self.tab then C.white else C.text
	end
	clear(self.list)
	if self.tab == "Coins" then
		self:renderCoinItems()
	elseif self.tab == "Looks" then
		self:renderLookBook()
	else
		self:renderRobuxItems()
	end
end

function Shop:renderCoinItems()
	-- Cell sizes in pixels: an aspect constraint inside a grid would shrink cells to nothing
	local width = self.list.AbsoluteSize.X - 12 - self.list.ScrollBarThickness
	local cols = if width >= 700 then 5 elseif width >= 480 then 4 else 3
	local gap = 10
	local cell = math.max(60, math.floor((width - gap * (cols - 1)) / cols))
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell, math.floor(cell * 1.3)),
		CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.list,
	})

	local order = 0
	local eventId = self.ctx.eventId()
	for _, category in Catalog.Categories do
		for _, it in category.items do
			if it.pass or it.level or it.price <= 0 or not Catalog.isAvailable(it, self.ctx.profile, eventId) then
				continue
			end
			order += 1
			local owned = Catalog.isUnlocked(it, self.ctx.profile, eventId)
			local card = new("Frame", {
				LayoutOrder = if it.event then order else order + 1000, -- holiday items first
				BackgroundColor3 = if owned then C.softPink else C.white,
				ZIndex = 63,
				Parent = self.list,
			}, { Theme.corner(14), Theme.stroke(C.lavender, 2) })
			local icon = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0.06),
				Size = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = C.lavender,
				ZIndex = 64,
				Parent = card,
			}, { new("UIAspectRatioConstraint", { AspectRatio = 1 }), Theme.round() })
			if category.preview == "portrait" then
				icon.BackgroundColor3 = C.softPink
				icon.ClipsDescendants = true
				local look = Catalog.defaultLook()
				look.hairStyle = "hair_bob"
				look.hairColor = "hc_blonde"
				look.outfit = "outfit_tee"
				look[category.key] = it.id
				LookRenderer.render(icon, SAMPLE_CLIENT, look, { headOnly = category.key ~= "outfit", clean = 1, mood = "smile" })
			elseif it.color then
				LookRenderer.paint(icon, it)
			end
			new("TextLabel", {
				Position = UDim2.fromScale(0.05, 0.4),
				Size = UDim2.fromScale(0.9, 0.3),
				Text = (if it.event and Events.byId[it.event] then Events.byId[it.event].icon .. " " else "") .. category.label .. "\n" .. it.name,
				ZIndex = 64,
				Parent = card,
			}, { Theme.maxText(16) })
			local b = Theme.button({
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -6),
				Size = UDim2.new(0.9, 0, 0.2, 0),
				Text = if owned then "Owned ✓" else "💰 " .. it.price,
				Color = if owned then C.green else C.hotPink,
				ZIndex = 64,
				MaxText = 18,
				Parent = card,
			})
			if not owned then
				b.Activated:Connect(function()
					self:askUnlock(it)
				end)
			end
		end
	end
end

-- Every finished look is saved here, like a photo album.
function Shop:renderLookBook()
	local looks = self.ctx.profile.lookbook or {}
	if #looks == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 120),
			Text = "📖 Your Look Book is empty.\nFinish a fashion show and your look gets saved here!",
			ZIndex = 63,
			Parent = self.list,
		}, { Theme.maxText(26) })
		return
	end
	local width = self.list.AbsoluteSize.X - 12 - self.list.ScrollBarThickness
	local cols = if width >= 700 then 4 elseif width >= 420 then 3 else 2
	local gap = 10
	local cell = math.max(80, math.floor((width - gap * (cols - 1)) / cols))
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell, math.floor(cell * 1.3)),
		CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.list,
	})
	for i, saved in looks do
		local skin, eyes = Clients.colors(saved.skin or 1, saved.eyes or 1)
		local client = { name = saved.name, skin = skin, eyes = eyes, dirt = {} }
		local theme = Catalog.themeById[saved.theme]
		local card = new("Frame", {
			LayoutOrder = i,
			BackgroundColor3 = if theme then theme.color:Lerp(C.white, 0.7) else C.softPink,
			ZIndex = 63,
			Parent = self.list,
		}, { Theme.corner(16), Theme.stroke(C.gold, 3) })
		local pic = new("Frame", {
			Position = UDim2.fromScale(0.05, 0.04),
			Size = UDim2.fromScale(0.9, 0.7),
			BackgroundColor3 = C.white,
			ZIndex = 64,
			Parent = card,
		}, { Theme.corner(12) })
		LookRenderer.render(pic, client, saved.look, { clean = 1, mood = if (saved.stars or 0) >= 4 then "grin" else "smile" })
		new("TextLabel", {
			Position = UDim2.fromScale(0.04, 0.75),
			Size = UDim2.fromScale(0.92, 0.12),
			Text = saved.name .. "  " .. Theme.stars(saved.stars or 1),
			ZIndex = 64,
			Parent = card,
		}, { Theme.maxText(18) })
		new("TextLabel", {
			Position = UDim2.fromScale(0.04, 0.87),
			Size = UDim2.fromScale(0.92, 0.11),
			Text = theme and theme.name or "",
			TextColor3 = C.textLight,
			ZIndex = 64,
			Parent = card,
		}, { Theme.maxText(16) })
	end
end

function Shop:renderRobuxItems()
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = self.list })
	for i, entry in ROBUX_ITEMS do
		local owned = entry.kind == "pass" and self.ctx.profile.passes and self.ctx.profile.passes[entry.key]
		local card = new("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1, -8, 0, 90),
			BackgroundColor3 = if entry.kind == "pass" then C.lavender else C.softPink,
			ZIndex = 63,
			Parent = self.list,
		}, { Theme.corner(16) })
		new("TextLabel", { Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(0, 70, 1, 0), Text = entry.icon, ZIndex = 64, Parent = card }, { Theme.maxText(48) })
		new("TextLabel", {
			Position = UDim2.new(0, 84, 0, 6),
			Size = UDim2.new(1, -250, 0, 30),
			Text = entry.title,
			TextColor3 = C.purple,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 64,
			Parent = card,
		}, { Theme.maxText(26) })
		new("TextLabel", {
			Position = UDim2.new(0, 84, 0, 38),
			Size = UDim2.new(1, -250, 0, 46),
			Text = entry.text,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = C.textLight,
			ZIndex = 64,
			Parent = card,
		}, { Theme.maxText(17) })

		local key = entry.kind .. ":" .. entry.key
		local b = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 150, 0, 52),
			Text = if owned then "Owned ✓" else (priceCache[key] or "Buy"),
			Color = if owned then C.green else C.hotPink,
			ZIndex = 64,
			Parent = card,
		})
		if not owned then
			b.Activated:Connect(function()
				if entry.kind == "pass" then
					self:promptPass(entry.key)
				else
					self:promptProduct(entry.key)
				end
			end)
			if not priceCache[key] then
				self:fetchPrice(entry, key, b)
			end
		end
	end
end

function Shop:fetchPrice(entry, key: string, button: TextButton)
	local id = if entry.kind == "pass" then Config.GamePasses[entry.key] else Config.DevProducts[entry.key]
	if not id or id == 0 then
		button.Text = "Soon!"
		return
	end
	task.spawn(function()
		local infoType = if entry.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
		if ok and info and info.PriceInRobux then
			priceCache[key] = "R$ " .. info.PriceInRobux
			if button.Parent then
				button.Text = priceCache[key]
			end
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Showcase</string>
              <string name="Source"><![CDATA[-- The fashion show: points the camera at the runway, puts the look on the big screen,
-- and lets everyone else rate it with stars.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local LookRenderer = require(ReplicatedStorage.Shared.LookRenderer)
local Pets = require(ReplicatedStorage.Shared.Pets)
local Progress = require(ReplicatedStorage.Shared.Progress)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Showcase = {}
Showcase.__index = Showcase

local CHEERS = { "😍", "👏", "🔥", "✨", "💖" }

function Showcase.new(gui: ScreenGui, ctx)
	local self = setmetatable({}, Showcase)
	self.ctx = ctx
	self.current = nil

	self.panel = new("Frame", {
		Name = "Showcase",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(0.5, 0, 0, 196),
		BackgroundColor3 = C.white,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, { Theme.corner(22), Theme.stroke(C.pink, 4), Theme.padding(12), new("UISizeConstraint", { MinSize = Vector2.new(340, 0) }) })
	self.title = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 36),
		Text = "",
		TextColor3 = C.hotPink,
		ZIndex = 41,
		Parent = self.panel,
	}, { Theme.maxText(30) })
	self.prompt = new("TextLabel", {
		Position = UDim2.new(0, 0, 0, 38),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "",
		ZIndex = 41,
		Parent = self.panel,
	}, { Theme.maxText(20) })

	local row = new("Frame", {
		Position = UDim2.new(0, 0, 0, 68),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = self.panel,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
	})
	self.starRow = row
	self.voteButtons = {}
	-- Kind voting: every choice is nice. 💖 = 3 stars, 💖💖 = 4, 💖💖💖 = 5
	for i, choice in { { 3, "💖", "Cute!" }, { 4, "💖💖", "So pretty!" }, { 5, "💖💖💖", "WOW!" } } do
		local b = Theme.button({
			Text = choice[2] .. " " .. choice[3],
			Size = UDim2.new(0.3, 0, 1, 0),
			Color = C.softPink,
			TextColor3 = C.hotPink,
			ZIndex = 42,
			MaxText = 24,
			Parent = row,
		})
		b.LayoutOrder = i
		b:SetAttribute("Label", choice[2] .. " " .. choice[3])
		b.Activated:Connect(function()
			self:vote(choice[1])
		end)
		self.voteButtons[choice[1]] = b
	end

	-- Cheer buttons: everyone can tap these, and the emoji float up on every screen
	local cheers = new("Frame", {
		Name = "Cheers",
		Position = UDim2.new(0, 0, 0, 128),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = self.panel,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
		}),
	})
	self.cheerRow = cheers
	-- On your own walk the cheers turn into pose buttons: strike a pose for the photographers
	local poses = new("Frame", {
		Name = "Poses",
		Position = UDim2.new(0, 0, 0, 68),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 41,
		Parent = self.panel,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
		}),
	})
	self.poseRow = poses
	for i, pose in { { "pose_wave", "👋 Wave" }, { "pose_cheer", "🙌 Cheer" }, { "pose_dance", "💃 Dance" } } do
		local b = Theme.button({
			Text = pose[2],
			LayoutOrder = i,
			Size = UDim2.new(0.3, 0, 1, 0),
			Color = C.hotPink,
			TextColor3 = C.white,
			ZIndex = 42,
			MaxText = 26,
			Parent = poses,
		})
		b.Activated:Connect(function()
			local me = Players.LocalPlayer.Character
			if me then
				Avatar.pose(me, pose[1])
			end
			Effects.flash(self.gui)
			task.delay(0.25, function()
				Effects.flash(self.gui)
			end)
		end)
	end
	-- The cheer meter rides on top of the card: fill it and the crowd goes wild
	local meter = new("Frame", {
		Name = "CheerMeter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -8),
		Size = UDim2.new(0.9, 0, 0, 30),
		BackgroundColor3 = C.white,
		ZIndex = 41,
		Parent = self.panel,
	}, { Theme.round(), Theme.stroke(C.hotPink, 3) })
	self.meterFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.gold,
		ZIndex = 42,
		Parent = meter,
	}, { Theme.round() })
	self.meterText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "🔥 Cheer meter: tap the cheers!",
		TextColor3 = C.text,
		ZIndex = 43,
		Parent = meter,
	}, { Theme.maxText(20), Theme.padding(3) })
	for i, emoji in CHEERS do
		local b = Theme.button({
			Text = emoji,
			LayoutOrder = i,
			Size = UDim2.new(0, 60, 1, 0),
			Color = C.softPink,
			ZIndex = 42,
			MaxText = 34,
			Parent = cheers,
		})
		b.Activated:Connect(function()
			Remotes.React:FireServer(emoji)
			Effects.floatEmoji(self.gui, emoji) -- right away, even if the server skips a too-fast tap
		end)
	end
	self.gui = gui

	task.spawn(function()
		self:buildScreen()
	end)
	return self
end

------------------------------------------------------------------------------
-- Big screen behind the runway

function Showcase:buildScreen()
	-- WaitForChild in case the place streams parts in later
	local part = Workspace:WaitForChild("GlowUpWorld"):WaitForChild("Runway"):WaitForChild("Screen")
	local surface = new("SurfaceGui", {
		Name = "RunwayScreen",
		Adornee = part,
		Face = Enum.NormalId.Back,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 25,
		LightInfluence = 0,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ResetOnSpawn = false,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local bg = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(40, 20, 60),
		Parent = surface,
	}, { Theme.gradient(Color3.fromRGB(70, 30, 100), Color3.fromRGB(20, 10, 35)) })
	self.screenPortrait = new("Frame", {
		Position = UDim2.fromScale(0.04, 0.06),
		Size = UDim2.fromScale(0.45, 0.88),
		BackgroundColor3 = Color3.fromRGB(255, 235, 245),
		Parent = bg,
	}, { new("UIAspectRatioConstraint", { AspectRatio = 1 }), Theme.corner(40) })
	self.screenTitle = new("TextLabel", {
		Position = UDim2.fromScale(0.5, 0.05),
		Size = UDim2.fromScale(0.46, 0.2),
		TextColor3 = C.white,
		Text = "✨ 5 Minute Glow Up ✨",
		Parent = bg,
	})
	self.screenSub = new("TextLabel", {
		Position = UDim2.fromScale(0.5, 0.26),
		Size = UDim2.fromScale(0.46, 0.13),
		TextColor3 = C.pink,
		Text = "",
		Parent = bg,
	})
	self.screenTheme = new("TextLabel", {
		Position = UDim2.fromScale(0.5, 0.41),
		Size = UDim2.fromScale(0.46, 0.1),
		TextColor3 = C.gold,
		Text = "",
		Parent = bg,
	})
end

function Showcase:setScreen(title: string, sub: string, client, look, clean: number?)
	if not self.screenTitle then
		return
	end
	self.screenTitle.Text = title
	self.screenSub.Text = sub
	local theme = Catalog.themeById[self.ctx.state().themeId]
	self.screenTheme.Text = if theme then "Theme: " .. theme.name else ""
	if client and look then
		local holder = self.screenPortrait:FindFirstChild("Idle")
		if holder then
			holder:Destroy()
		end
		LookRenderer.render(self.screenPortrait, client, look, { clean = clean or 1, mood = "grin" })
	end
end

-- Between shows the big screen shows sparkles instead of the last client.
function Showcase:clearScreenPortrait()
	if not self.screenPortrait then
		return
	end
	local old = self.screenPortrait:FindFirstChild("Portrait")
	if old then
		old:Destroy()
	end
	if not self.screenPortrait:FindFirstChild("Idle") then
		new("TextLabel", { Name = "Idle", Size = UDim2.fromScale(1, 1), Text = "💄✨👗", Parent = self.screenPortrait }, { Theme.maxText(200) })
	end
end

------------------------------------------------------------------------------
-- Camera

function Showcase:setCamera(view: string?)
	local camera = Workspace.CurrentCamera
	local world = Workspace:FindFirstChild("GlowUpWorld")
	local marker = view and world and world:FindFirstChild("Cameras") and world.Cameras:FindFirstChild(view)
	self.view = view
	if marker then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = marker.CFrame
	else
		camera.CameraType = Enum.CameraType.Custom
	end
end

-- Each runway or podium look with a pet gets that pet trotting next to it, on this screen.
function Showcase:updatePets(world: Instance)
	local t = os.clock()
	local dt = math.min(t - (self.petClock or t), 0.1)
	self.petClock = t
	self.pets = self.pets or {}
	for owner, pet in self.pets do
		if not owner.Parent then
			pet:Destroy()
			self.pets[owner] = nil
		end
	end
	for _, m in world:GetChildren() do
		local petId = m:IsA("Model") and m:GetAttribute("Pet")
		if type(petId) == "string" and not Catalog.isNone(petId) then
			local pet = self.pets[m]
			if not pet then
				pet = Pets.build(petId)
				if not pet then
					continue
				end
				local root = m:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					pet:PivotTo(root.CFrame * CFrame.new(2.6, -3, 0.6))
				end
				pet.Parent = Workspace
				self.pets[m] = pet
			end
			Pets.follow(pet, m, dt)
		end
	end
end

-- Moves runway models smoothly on this screen, using the walk the server described in attributes.
function Showcase:updateWalkers()
	local world = Workspace:FindFirstChild("GlowUpWorld")
	if not world then
		return
	end
	self:updatePets(world)
	local now = Workspace:GetServerTimeNow()
	for _, m in world:GetChildren() do
		local from, to, start, walkTime = m:GetAttribute("WalkFrom"), m:GetAttribute("WalkTo"), m:GetAttribute("WalkStart"), m:GetAttribute("WalkTime")
		local root = m:FindFirstChild("HumanoidRootPart")
		if typeof(from) == "Vector3" and typeof(to) == "Vector3" and type(start) == "number" and type(walkTime) == "number" and root and root:IsA("BasePart") then
			local t = now - start
			local forward = Vector3.new(0, 0, 1)
			local bob, squeeze = 0, 1
			if t < walkTime then
				local pos = from:Lerp(to, math.max(t, 0) / walkTime)
				root.CFrame = CFrame.lookAt(pos, pos + forward)
				bob = 0.15 * math.abs(math.sin(t * 7)) -- a bouncy little walk
			elseif t < walkTime + 1 then
				-- twirl! (the paper doll squeezes thin and back, like turning around)
				local angle = (t - walkTime) * math.pi * 2
				root.CFrame = CFrame.lookAt(to, to + forward) * CFrame.Angles(0, angle, 0)
				squeeze = math.abs(math.cos(angle))
			else
				root.CFrame = CFrame.lookAt(to, to + forward)
			end
			local billboard = root:FindFirstChild("Doll")
			if billboard and billboard:IsA("BillboardGui") then
				local baseY = billboard:GetAttribute("BaseY")
				if type(baseY) ~= "number" then
					baseY = billboard.StudsOffset.Y
					billboard:SetAttribute("BaseY", baseY)
				end
				billboard.StudsOffset = Vector3.new(0, baseY + bob, 0)
				local doll = billboard:FindFirstChild("Doll", true)
				local aspect = doll and doll:FindFirstChildOfClass("UIAspectRatioConstraint")
				if aspect then
					aspect.AspectRatio = math.max(0.03, 0.5 * squeeze)
				end
			end
		end
	end
end

-- During the show the camera glides along next to the client walking the runway.
function Showcase:followWalker()
	if self.view ~= "Showcase" then
		return
	end
	local world = Workspace:FindFirstChild("GlowUpWorld")
	if not world then
		return
	end
	-- the player walking the runway in their own avatar (or a stand-in model if they left)
	local walker = nil
	for _, player in Players:GetPlayers() do
		if player.Character and player.Character:GetAttribute("Walking") then
			walker = player.Character
		end
	end
	for _, m in world:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("Walking") then
			walker = m
		end
	end
	local root = walker and walker:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local pos = root.Position
		-- aimed below the walker, so they're in the top of the screen above the voting card
		local goal = CFrame.lookAt(pos + Vector3.new(6, 4, 14), pos + Vector3.new(0, -2.4, 0))
		local camera = Workspace.CurrentCamera
		camera.CFrame = camera.CFrame:Lerp(goal, 0.08)
	end
end

------------------------------------------------------------------------------
-- Voting

function Showcase:showVote(stars: number)
	for value, b in self.voteButtons do
		b.BackgroundColor3 = if value == stars then C.hotPink else C.softPink
		b.TextColor3 = if value == stars then C.white else C.hotPink
		local label = b:GetAttribute("Label")
		if type(label) == "string" then
			b.Text = (if value == stars then "✓ " else "") .. label
		end
	end
end

function Showcase:vote(stars: number)
	local current = self.current
	if not current or current.userId == Players.LocalPlayer.UserId then
		return
	end
	local first = not self.voted
	self.voted = true
	self:showVote(stars)
	Remotes.Vote:FireServer(current.userId, stars)
	self.prompt.Text = "Thanks for voting! 💖 Tap to cheer!"
	if self.short then
		self.starRow.Visible = false
		self.cheerRow.Visible = true
	end
	if first then
		self.ctx.toast("+2 💰 for voting!", C.green)
	end
end

function Showcase:show(payload)
	self.current = payload
	self.voted = false
	self:setMeter(0, 1)
	self:showVote(0)
	self.panel.Visible = true
	Theme.pop(self.panel)
	self:setCamera("Showcase")

	local mine = payload.userId == Players.LocalPlayer.UserId
	self.title.Text = "💃 " .. payload.client.name .. " is on the runway! (" .. payload.index .. "/" .. payload.total .. ")"
	local level = payload.level or 1
	local stylist = "Styled by " .. payload.stylist .. "  •  Lv " .. level .. " " .. Progress.title(level)
	-- The card stays short so it doesn't hide the walk; it only grows for the vote buttons
	if mine then
		self.prompt.Text = "That's YOU! Tap a pose for the cameras! 📸"
		self.starRow.Visible = false
	else
		self.prompt.Text = "How much do you love it?"
		self.starRow.Visible = true
	end
	-- on short (phone) screens the prompt line goes, so the card stays under ~40% of the height
	local short = self.gui.AbsoluteSize.Y > 0 and self.gui.AbsoluteSize.Y < 500
	self.prompt.Visible = not short
	self.starRow.Position = UDim2.new(0, 0, 0, if short then 40 else 68)
	self.cheerRow.Position = UDim2.new(0, 0, 0, if mine then (if short then 40 else 68) else (if short then 100 else 128))
	-- your own walk: pose buttons instead of cheering for yourself
	self.cheerRow.Visible = not mine
	self.poseRow.Visible = mine
	self.poseRow.Position = UDim2.new(0, 0, 0, if short then 40 else 68)
	self.short = short
	if short and not mine then
		-- phones: one row at a time (vote first, then cheers) so the walker stays in view
		self.cheerRow.Position = UDim2.new(0, 0, 0, 40)
		self.cheerRow.Visible = false
	end
	self.panel.Size = if short
		then UDim2.new(0.5, 0, 0, 40 + 56 + 24)
		else UDim2.new(0.5, 0, 0, (if mine then 68 else 128) + 56 + 24)
	-- Camera flashes from the photographers
	task.spawn(function()
		local current = payload
		for _ = 1, 4 do
			task.wait(0.8 + math.random() * 1.2)
			if self.current ~= current then
				break
			end
			Effects.flash(self.gui)
		end
	end)
	self:setScreen(payload.client.name, stylist, payload.client, payload.look, payload.clean)
end

function Showcase:reaction(emoji: string, cheers: number?, goal: number?)
	Effects.floatEmoji(self.gui, emoji)
	if cheers and goal then
		self:setMeter(cheers, goal)
	end
end

function Showcase:setMeter(cheers: number, goal: number)
	local full = cheers >= goal
	self.meterFill.Size = UDim2.fromScale(math.clamp(cheers / goal, 0, 1), 1)
	self.meterFill.BackgroundColor3 = if full then C.hotPink else C.gold
	self.meterText.TextColor3 = if full then C.white else C.text
	self.meterText.Text = if full then "🎆 The crowd goes WILD! 🎆"
		elseif cheers > 0 then "🔥 Cheer meter " .. cheers .. "/" .. goal
		else "🔥 Cheer meter: tap the cheers!"
	if full and not self.wildShown then
		self.wildShown = true
		Effects.confetti(self.gui, 40)
		Sounds.play("Cheer", 0.7)
	elseif not full then
		self.wildShown = false
	end
end

function Showcase:hide()
	self.current = nil
	self.panel.Visible = false
end

return Showcase
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Sounds</string>
              <string name="Source"><![CDATA[-- Plays the sounds and music listed in Config.Sounds (empty ones are skipped).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local Sounds = {}

local cache: { [string]: Sound } = {}
local music: Sound? = nil
local lastPlayed: { [string]: number } = {}

local function get(name: string): Sound?
	local id = Config.Sounds[name]
	if not id or id == "" then
		return nil
	end
	local sound = cache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		sound.Volume = Config.SoundVolumes[name] or 0.6
		sound.Parent = SoundService
		cache[name] = sound
	end
	return sound
end

-- Plays a short sound effect. `gap` stops it from playing too often (e.g. while scrubbing).
function Sounds.play(name: string, gap: number?)
	local now = os.clock()
	if gap and lastPlayed[name] and now - lastPlayed[name] < gap then
		return
	end
	lastPlayed[name] = now
	local sound = get(name)
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end

-- Starts looping background music (or stops it with nil).
function Sounds.music(name: string?)
	local sound = name and get(name)
	if sound == music then
		return
	end
	if music then
		music:Stop()
	end
	music = sound
	if sound then
		sound.Looped = true
		sound.Volume = 0.35
		sound:Play()
	end
end

return Sounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Colors, fonts and little helpers for building the game's screens in code.

local TweenService = game:GetService("TweenService")

local Theme = {}

local rgb = Color3.fromRGB

Theme.Font = Enum.Font.FredokaOne

-- White text on pink, hotPink, purple and green, and dark text on everything light, all measure
-- at least 4.5:1 contrast. Gold is a background for dark text only (goldText is gold you can read).
Theme.Colors = {
	pink = rgb(212, 47, 134),
	hotPink = rgb(190, 20, 105),
	softPink = rgb(255, 228, 242),
	purple = rgb(106, 63, 181),
	lavender = rgb(235, 225, 255),
	white = rgb(255, 255, 255),
	text = rgb(31, 18, 53),
	textLight = rgb(110, 80, 130),
	gold = rgb(255, 200, 60),
	goldText = rgb(138, 90, 0),
	green = rgb(22, 120, 64),
	red = rgb(240, 70, 90),
	shadow = rgb(0, 0, 0),
}

function Theme.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	-- Instance.new layouts sort by Name in real Roblox; every list here is ordered by LayoutOrder.
	if inst:IsA("UIGridStyleLayout") then
		(inst :: UIGridStyleLayout).SortOrder = Enum.SortOrder.LayoutOrder
	end
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst.Font = Theme.Font
		inst.TextColor3 = Theme.Colors.text
		inst.TextScaled = true
		inst.BackgroundTransparency = 1
	end
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 16) })
end

function Theme.round(): UICorner
	return Theme.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function Theme.stroke(color: Color3?, thickness: number?): UIStroke
	return Theme.new("UIStroke", {
		Color = color or Theme.Colors.pink,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Theme.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Theme.maxText(size: number): UITextSizeConstraint
	return Theme.new("UITextSizeConstraint", { MaxTextSize = size, MinTextSize = math.min(14, size) })
end

function Theme.gradient(a: Color3, b: Color3, rotation: number?): UIGradient
	return Theme.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 })
end

-- A bouncy, rounded button.
function Theme.button(props: { [string]: any }): TextButton
	local color = props.Color or Theme.Colors.pink
	props.Color = nil
	local maxText = props.MaxText or 28
	props.MaxText = nil
	local merged = {
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		TextColor3 = Theme.Colors.white,
		AutoButtonColor = false,
	}
	for k, v in props do
		merged[k] = v
	end
	local button = Theme.new("TextButton", merged, {
		Theme.corner(14),
		Theme.maxText(maxText),
		Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
	local scale = Theme.new("UIScale", { Parent = button })
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.05 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, info, { Scale = 0.94 }):Play()
	end)
	button.Activated:Connect(function()
		Theme.onClick()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
	return button
end

-- Set by the sound module so every button can make a click sound.
function Theme.onClick() end

function Theme.pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale") or Theme.new("UIScale", { Parent = gui })
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function Theme.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Theme.stars(stars: number): string
	local full = math.floor(stars)
	local half = stars - full >= 0.5
	return string.rep("★", full) .. (if half then "½" else "") .. string.rep("☆", 5 - full - (if half then 1 else 0))
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>

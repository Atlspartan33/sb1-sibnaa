	{ id = "pink_party", name = "Pink Party 🎀", tags = { "pink", "sparkle", "party" }, color = rgb(255, 130, 190) },
	{ id = "candy_land", name = "Candy Land 🍭", tags = { "pastel", "bright" }, color = rgb(255, 160, 210) },
	{ id = "winter", name = "Winter Wonderland ❄️", tags = { "winter", "white", "blue" }, color = rgb(150, 200, 255) },
	{ id = "halloween", name = "Halloween Party 🎃", tags = { "spooky", "orange", "dark" }, color = rgb(245, 130, 30), event = "halloween" },
	{ id = "thanksgiving", name = "Harvest Festival 🍂", tags = { "orange", "brown" }, color = rgb(200, 110, 40), event = "thanksgiving" },
	{ id = "christmas", name = "Christmas Party 🎄", tags = { "red", "green", "winter" }, color = rgb(200, 30, 40), event = "christmas" },
} :: { Theme }

-- Day-7 prizes of the daily gift calendar, given in this order
Catalog.GiftItems = { "acc_goldbow", "acc_rainbowband", "acc_pearls" }

-- Prizes for finishing the weekly goal, given in this order
Catalog.WeeklyItems = { "acc_clover", "acc_unicorn", "acc_rainbowclip", "acc_strawberry" }

-- Lookup tables -------------------------------------------------------------

Catalog.byId = {} :: { [string]: Item }
Catalog.categoryByKey = {} :: { [string]: Category }
Catalog.themeById = {} :: { [string]: Theme }

for _, category in Catalog.Categories do
	Catalog.categoryByKey[category.key] = category
	for _, it in category.items do
		it.category = category.key
		Catalog.byId[it.id] = it
	end
end

for _, theme in Catalog.Themes do
	Catalog.themeById[theme.id] = theme
end

-- What every avatar starts with in the dressing room.
function Catalog.defaultLook(): { [string]: string }
	return {
		hairStyle = "hair_puff",
		hairColor = "hc_black",
		skin = "skin_7",
		eyeshadow = "es_none",
		lashes = "lash_none",
		blush = "bl_none",
		lipstick = "lip_none",
		outfit = "outfit_work",
		outfitColor = "oc_none",
		nailColor = "nail_none",
		nailArt = "art_none",
		outfitPattern = "pat_none",
		gems = "gem_none",
		accessory = "acc_none",
		costumeBack = "back_none",
		costumeFace = "mask_none",
		costumeWaist = "tail_none",
		costumeShoulder = "pal_none",
		pet = "pet_none",
		pose = "pose_none",
		effect = "fx_none",
	}
end

-- The skin color of a look (or the fallback when it has none).
function Catalog.skinColor(look, fallback: Color3): Color3
	local it = Catalog.byId[look and look.skin or ""]
	return if it and it.color then it.color else fallback
end

-- The skin tone item closest to a color (used to start from the player's own avatar).
function Catalog.closestSkin(color: Color3): string
	local best, bestDistance = 1, math.huge
	for i, tone in Catalog.SkinTones do
		local c = tone[2]
		local d = (c.R - color.R) ^ 2 + (c.G - color.G) ^ 2 + (c.B - color.B) ^ 2
		if d < bestDistance then
			best, bestDistance = i, d
		end
	end
	return "skin_" .. best
end

-- Can this item be shown and used right now? Holiday items show up during their event,
-- and stay forever for players who unlocked them.
local function owns(profile, itemId: string): boolean
	return profile ~= nil and profile.owned ~= nil and profile.owned[itemId] == true
end

-- Total stars earned (the client gets it as `totalStars`, the server keeps it in `stats`).
function Catalog.playerLevel(profile): number
	local stars = 0
	if profile then
		stars = profile.totalStars or (profile.stats and profile.stats.totalStars) or 0
	end
	return Progress.level(stars)
end

function Catalog.isAvailable(it: Item, profile, eventId: string?): boolean
	if it.hidden then
		return false
	end
	if it.gift then
		return owns(profile, it.id)
	end
	if it.event and it.event ~= eventId then
		return profile ~= nil and profile.owned ~= nil and profile.owned[it.id] == true
	end
	return true
end

-- Is this item usable by a player with this profile?
-- profile = { owned = { [itemId] = true }, passes = { VIP = true } }
function Catalog.isUnlocked(it: Item, profile, eventId: string?): boolean
	if not Catalog.isAvailable(it, profile, eventId) then
		return false
	end
	if it.level then
		return Catalog.playerLevel(profile) >= it.level
	end
	if it.pass then
		return profile ~= nil and profile.passes ~= nil and profile.passes[it.pass] == true
	end
	if it.price <= 0 then
		return true
	end
	return profile ~= nil and profile.owned ~= nil and profile.owned[it.id] == true
end

function Catalog.hasTag(it: Item?, tag: string): boolean
	if not it then
		return false
	end
	for _, t in it.tags do
		if t == tag then
			return true
		end
	end
	return false
end

function Catalog.matchesTheme(it: Item?, theme: Theme): boolean
	if not it then
		return false
	end
	for _, tag in theme.tags do
		if Catalog.hasTag(it, tag) then
			return true
		end
	end
	return false
end

function Catalog.isNone(itemId: string?): boolean
	return itemId == nil or string.sub(itemId, -5) == "_none" or itemId == "hair_messy" or itemId == "outfit_work"
end

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Clients</string>
          <string name="Source"><![CDATA[-- Makes the customers who walk into the salon: who they are, where they've been,
-- and how dirty their face is.

local Clients = {}

export type DirtSpot = {
	x: number, -- 0..1 across the portrait
	y: number, -- 0..1 down the portrait
	size: number, -- 0..1 of the portrait width
	color: Color3,
}

export type Client = {
	name: string,
	story: string,
	skin: Color3,
	eyes: Color3,
	skinIndex: number,
	eyesIndex: number,
	visits: number, -- how many times this stylist has styled them (1 = first time)
	wishes: { Wish },
	dirt: { DirtSpot },
}

-- Something the client asks for ("💗 hair!"). Each one can be done with free items.
export type Wish = { key: string, tag: string, text: string }

local WISHES = {
	{ key = "hairColor", tag = "pink", text = "💗 hair" },
	{ key = "hairColor", tag = "blue", text = "💙 hair" },
	{ key = "hairColor", tag = "gold", text = "💛 hair" },
	{ key = "eyeshadow", tag = "purple", text = "💜 eyes" },
	{ key = "eyeshadow", tag = "blue", text = "💙 eyes" },
	{ key = "lipstick", tag = "red", text = "❤️ lips" },
	{ key = "lipstick", tag = "pink", text = "💗 lips" },
	{ key = "nailColor", tag = "any", text = "💅 nails" },
	{ key = "nailColor", tag = "pink", text = "💗 nails" },
	{ key = "outfit", tag = "dress", text = "👗 a dress" },
	{ key = "accessory", tag = "any", text = "🎀 a hair clip" },
	{ key = "gems", tag = "any", text = "⭐ stickers" },
	{ key = "outfitPattern", tag = "any", text = "🔵 a pattern" },
}

local function pickWishes(r: Random): { Wish }
	local first = WISHES[r:NextInteger(1, #WISHES)]
	local second = first
	while second.key == first.key do
		second = WISHES[r:NextInteger(1, #WISHES)]
	end
	return { first, second }
end

-- What a stylist remembers about a regular client (saved, so no Color3s)
export type Friend = { visits: number, skin: number, eyes: number }

local rgb = Color3.fromRGB

local NAMES = {
	"Jasmine", "Mia", "Zoe", "Aaliyah", "Sofia", "Kayla", "Nia", "Lily", "Maya", "Chloe",
	"Ava", "Destiny", "Riley", "Jordan", "Grace", "Imani", "Bella", "Harper", "Luna", "Ruby",
	"Kai", "Leo", "Amara", "Skye", "Isla", "Nova", "Ellie", "Jada", "Rosa", "Mila",
}

local SKIN_TONES = {
	rgb(255, 224, 196),
	rgb(250, 205, 175),
	rgb(241, 194, 160),
	rgb(224, 172, 128),
	rgb(198, 134, 94),
	rgb(161, 102, 66),
	rgb(124, 78, 50),
	rgb(92, 57, 38),
}

local EYE_COLORS = {
	rgb(101, 67, 33),
	rgb(60, 40, 25),
	rgb(142, 118, 40),
	rgb(60, 140, 80),
	rgb(70, 130, 200),
	rgb(115, 125, 140),
}

-- Where the client is coming from, and what's all over their face.
local STORIES = {
	{ text = "I fixed cars at the auto shop all day. I'm SO greasy! 😫", colors = { rgb(55, 55, 58), rgb(35, 32, 30) } },
	{ text = "I fixed bikes at the bike shop. Oil got everywhere! 🚲", colors = { rgb(45, 40, 35), rgb(80, 70, 55) } },
	{ text = "We had a frosting fight at the bakery shop! 🧁", colors = { rgb(255, 180, 210), rgb(90, 50, 30), rgb(255, 250, 240) } },
	{ text = "I cleaned the chimney at the hardware shop. Soot! 🧹", colors = { rgb(35, 35, 38), rgb(70, 70, 75) } },
	{ text = "Oops! I spilled paint at the paint shop! 🎨", colors = { rgb(235, 80, 80), rgb(80, 140, 235), rgb(250, 205, 60) } },
	{ text = "I fell in the mud at the garden shop! 🌻", colors = { rgb(110, 75, 40), rgb(90, 140, 60) } },
	{ text = "The blender exploded at the smoothie shop! 🍓", colors = { rgb(200, 60, 120), rgb(120, 200, 80), rgb(255, 170, 60) } },
	{ text = "I made pizza at the pizza shop. Sauce everywhere! 🍕", colors = { rgb(200, 50, 40), rgb(250, 210, 90) } },
	{ text = "Slime exploded at the toy shop! So sticky! 🟢", colors = { rgb(120, 220, 90), rgb(90, 200, 160), rgb(200, 120, 255) } },
}

-- Extra stories during holiday events (about half the clients use one).
local EVENT_STORIES = {
	halloween = {
		{ text = "I carved pumpkins at the pumpkin shop. Pumpkin goo! 🎃", colors = { rgb(245, 130, 30), rgb(250, 190, 70) } },
		{ text = "I tried ALL the face paint at the costume shop! 🧛", colors = { rgb(120, 220, 90), rgb(150, 80, 220), rgb(30, 30, 30) } },
		{ text = "I made caramel apples at the candy shop! 🍎", colors = { rgb(170, 100, 40), rgb(210, 40, 40) } },
	},
	thanksgiving = {
		{ text = "I baked pies at the pie shop. Flour everywhere! 🥧", colors = { rgb(250, 245, 235), rgb(220, 140, 60) } },
		{ text = "I jumped in a leaf pile at the garden shop! 🍂", colors = { rgb(200, 90, 30), rgb(150, 90, 40), rgb(230, 170, 50) } },
		{ text = "I made cranberry sauce at the diner! 🍒", colors = { rgb(170, 20, 50), rgb(210, 60, 80) } },
	},
	christmas = {
		{ text = "I baked gingerbread at the cookie shop! 🍪", colors = { rgb(170, 100, 50), rgb(255, 255, 255) } },
		{ text = "I wrapped presents at the toy shop. Glitter everywhere! 🎁", colors = { rgb(240, 200, 60), rgb(200, 210, 230), rgb(230, 50, 60) } },
		{ text = "I made hot cocoa at the cafe. Chocolate mustache! ☕", colors = { rgb(90, 50, 30), rgb(255, 250, 245) } },
	},
}

-- Face area (matches LookRenderer's face oval) so dirt lands on the face.
local FACE_MIN_X, FACE_MAX_X = 0.31, 0.69
local FACE_MIN_Y, FACE_MAX_Y = 0.24, 0.7

function Clients.generate(rng: Random?, eventId: string?, avoidNames: { [string]: any }?): Client
	local r = rng or Random.new()
	local story = STORIES[r:NextInteger(1, #STORIES)]
	local special = eventId and EVENT_STORIES[eventId]
	if special and r:NextNumber() < 0.5 then
		story = special[r:NextInteger(1, #special)]
	end

	local dirt = {}
	for _ = 1, r:NextInteger(9, 13) do
		table.insert(dirt, {
			x = r:NextNumber(FACE_MIN_X, FACE_MAX_X),
			y = r:NextNumber(FACE_MIN_Y, FACE_MAX_Y),
			size = r:NextNumber(0.05, 0.11),
			color = story.colors[r:NextInteger(1, #story.colors)],
		})
	end

	local skinIndex = r:NextInteger(1, #SKIN_TONES)
	local eyesIndex = r:NextInteger(1, #EYE_COLORS)
	return {
		name = (function()
			local name = NAMES[r:NextInteger(1, #NAMES)]
			for _ = 1, 20 do
				if not (avoidNames and avoidNames[name]) then
					break
				end
				name = NAMES[r:NextInteger(1, #NAMES)]
			end
			return name
		end)(),
		story = story.text,
		skin = SKIN_TONES[skinIndex],
		eyes = EYE_COLORS[eyesIndex],
		skinIndex = skinIndex,
		eyesIndex = eyesIndex,
		visits = 1,
		wishes = pickWishes(r),
		dirt = dirt,
	}
end

-- A regular coming back: same name and face, new mess.
function Clients.returning(name: string, friend: Friend, rng: Random?, eventId: string?): Client
	local client = Clients.generate(rng, eventId)
	client.name = name
	client.skinIndex = math.clamp(friend.skin, 1, #SKIN_TONES)
	client.eyesIndex = math.clamp(friend.eyes, 1, #EYE_COLORS)
	client.skin = SKIN_TONES[client.skinIndex]
	client.eyes = EYE_COLORS[client.eyesIndex]
	client.visits = friend.visits + 1
	return client
end

-- You! The avatar a player dresses up is themselves: their name, their skin tone, no mess.
function Clients.forPlayer(name: string, skinIndex: number): Client
	local skin = math.clamp(skinIndex, 1, #SKIN_TONES)
	return {
		name = name,
		story = "",
		skin = SKIN_TONES[skin],
		eyes = EYE_COLORS[2],
		skinIndex = skin,
		eyesIndex = 2,
		visits = 1,
		wishes = {},
		dirt = {},
	}
end

-- Rebuilds a client's face colors from saved indices (for the Look Book).
function Clients.colors(skinIndex: number, eyesIndex: number): (Color3, Color3)
	return SKIN_TONES[math.clamp(skinIndex, 1, #SKIN_TONES)], EYE_COLORS[math.clamp(eyesIndex, 1, #EYE_COLORS)]
end

return Clients
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Game settings. Change numbers here to tune the game without touching the rest of the code.

local Config = {}

-- Round timing (seconds)
Config.MAKEOVER_SECONDS = 5 * 60 -- Tori's rule: 5 minutes to do everything!
Config.INTERMISSION_SECONDS = 20
Config.SHOWCASE_SECONDS_PER_LOOK = 9
Config.RESULTS_SECONDS = 15
Config.MIN_PLAYERS = 1

-- Coins
Config.STARTING_COINS = 100
Config.COINS_PARTICIPATION = 20
Config.COINS_PER_STAR = 10
Config.COINS_SPOTLESS_BONUS = 10
Config.COINS_PER_VOTE = 2
Config.COINS_PER_WISH = 10 -- each of the client's wishes you make come true
Config.COINS_PLACEMENT = { 50, 30, 15 } -- 1st, 2nd, 3rd (only when 2+ stylists played)
-- Daily gift calendar: coins on days 1-6, a special accessory on day 7 (missing a day just pauses it)
Config.CALENDAR_COINS = { 30, 40, 50, 60, 70, 80 }
Config.CALENDAR_DAY7_COINS = 200 -- once every day-7 accessory has been collected
Config.RETURNING_CLIENT_CHANCE = 0.35 -- how often a client you styled before comes back
Config.BEST_FRIEND_VISITS = { 3, 5, 10 } -- visits that earn a best-friend bonus
Config.BEST_FRIEND_COINS = 25
Config.LOOKBOOK_SIZE = 24 -- looks saved in the Look Book
Config.WEEKLY_GOAL_SHOWS = 5 -- shows to play each week for the weekly prize
Config.WEEKLY_GOAL_COINS = 150 -- weekly prize once every weekly clip is collected

-- Robux monetization.
-- Create these on the Creator Dashboard (create.roblox.com) after publishing,
-- then paste the IDs here. While an ID is 0 the store shows "Coming soon".
Config.GamePasses = {
	VIP = 0, -- "VIP Glam Kit": exclusive hair, makeup and gowns + VIP badge on the runway
	Princess = 0, -- "Princess Pack": 2 gowns, Princess Curls, Rose Gold hair, tiara, pink gems
	DoubleCoins = 0, -- "2x Coins": earn double coins every show
	RunwayStar = 0, -- "Runway Star": sparkles and confetti when your client walks the runway
	RainbowBubbles = 0, -- "Rainbow Bubbles": washing makes rainbow bubbles (just for looks)
}

Config.DevProducts = {
	CoinsSmall = 0, -- 500 coins
}

Config.CoinPackAmounts = {
	CoinsSmall = 500,
}

-- Sounds and music. The filled-in ones are free sounds from Roblox's own audio tutorials.
-- Add more in Studio: Toolbox -> Audio (or the Creator Store), right-click one ->
-- "Copy Asset ID", and paste it here like "rbxassetid://1234567". Empty ones are skipped.
Config.Sounds = {
	Click = "", -- tapping a button or item
	Pop = "rbxassetid://4110925712", -- pop-ups and speech bubbles (the same gentle chime)
	Scrub = "", -- rubbing with soap or brushing hair
	Rinse = "rbxasset://sounds/impact_water.mp3", -- rinsing the bubbles (a water splash built into Roblox)
	Sparkle = "rbxassetid://4110925712", -- a dirt spot comes off (Roblox tutorial "simple chime")
	Cheer = "rbxassetid://3422389728", -- results, level up, daily gift (Roblox tutorial "retro jingle")
	Camera = "", -- camera flash on the runway
	MakeoverMusic = "rbxassetid://1841461968", -- loops during the makeover (Roblox tutorial "upbeat" track)
	RunwayMusic = "rbxassetid://1846248593", -- loops during the fashion show (Roblox tutorial "cheerful, celebratory" track)
}

-- Volume for each sound (0-1). Sounds not listed play at 0.6.
Config.SoundVolumes = {
	Rinse = 0.25,
} :: { [string]: number }

-- Particle pictures from Roblox's own particle tutorial
Config.Textures = {
	Star = "rbxassetid://6772783963",
	Heart = "rbxassetid://5857851618",
	Circle = "rbxassetid://6711256324",
	Spark = "rbxassetid://5833323391",
}

-- Holiday events (Halloween, Harvest Festival, Christmas) turn on by date - see Shared/Events.
-- To preview one in Studio, set this to "halloween", "thanksgiving" or "christmas".
Config.FORCE_EVENT = nil :: string?
Config.EVENT_THEME_CHANCE = 0.5 -- during an event, how often the show uses the holiday theme

-- Studio testing: pretend you own every Game Pass while testing in Roblox Studio.
-- This never applies in the live game.
Config.STUDIO_OWNS_ALL_PASSES = true

-- Saving. Changing the name starts everyone over with fresh data.
Config.DATASTORE_NAME = "GlowUpSalon_v1"
Config.AUTOSAVE_SECONDS = 120

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[-- Holiday events: limited-time themes, items, client stories and decorations.
-- Dates are in UTC. Set Config.FORCE_EVENT to preview an event in Studio (it's ignored in the live game).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Events = {}

export type Event = {
	id: string,
	name: string,
	icon: string,
	theme: string, -- the special fashion show theme
	from: { number }, -- { month, day }
	to: { number }, -- { month, day } (inclusive)
	endsText: string,
}

Events.List = {
	{ id = "halloween", name = "Halloween", icon = "🎃", theme = "halloween", from = { 10, 10 }, to = { 11, 2 }, endsText = "until Nov 2" },
	{ id = "thanksgiving", name = "Harvest Festival", icon = "🍂", theme = "thanksgiving", from = { 11, 3 }, to = { 11, 30 }, endsText = "until Nov 30" },
	{ id = "christmas", name = "Christmas", icon = "🎄", theme = "christmas", from = { 12, 1 }, to = { 12, 31 }, endsText = "until Dec 31" },
} :: { Event }

Events.byId = {} :: { [string]: Event }
for _, e in Events.List do
	Events.byId[e.id] = e
end

local function dayNumber(month: number, day: number): number
	return month * 100 + day
end

-- The event happening at `timestamp` (seconds since 1970, UTC), or nil.
function Events.current(timestamp: number): Event?
	if Config.FORCE_EVENT and RunService:IsStudio() then
		local forced = Events.byId[Config.FORCE_EVENT]
		if not forced then
			warn("[GlowUp] Config.FORCE_EVENT is not a known event:", Config.FORCE_EVENT)
		end
		return forced
	end
	local date = os.date("!*t", math.floor(timestamp))
	local today = dayNumber(date.month, date.day)
	for _, e in Events.List do
		if today >= dayNumber(e.from[1], e.from[2]) and today <= dayNumber(e.to[1], e.to[2]) then
			return e
		end
	end
	return nil
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">LookRenderer</string>
          <string name="Source"><![CDATA[-- Draws a client's face (and shoulders) out of UI shapes, so the game needs no uploaded images.
-- The same drawing is used in the makeover screen, the item previews, the runway screen,
-- and the face of the client walking the runway.
--
-- Everything is placed in a square, using 0..1 coordinates (0.5, 0.5 is the middle).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)

local LookRenderer = {}

export type Options = {
	headOnly: boolean?, -- skip neck and outfit (used for the runway head)
	dirtHealth: { number }?, -- per-spot dirt left (1 = dirty, 0 = clean); used while washing
	clean: number?, -- 0..1 overall cleanliness, used when dirtHealth isn't given
	mood: string?, -- "sad", "neutral", "smile" (default) or "grin"
	brushed: boolean?, -- messy hair with the tangles brushed out
	tangle: number?, -- 0..1 how tangled messy hair still is (while brushing)
	zoom: number?, -- >1 zooms in on the face (the container should clip)
	faceOnly: boolean?, -- just the features and makeup, for the face on a 3D head (no skin, hair or accessory)
}

-- Layers, back to front
local Z = {
	hairBack = 1,
	neck = 2,
	outfit = 3,
	ears = 4,
	face = 5,
	makeup = 6,
	eyes = 7,
	details = 8,
	gems = 9,
	hairFront = 10,
	accessory = 11,
	dirt = 12,
}

local WHITE = Color3.new(1, 1, 1)
local LASH = Color3.fromRGB(30, 25, 30)
local TIE = Color3.fromRGB(255, 110, 170)

local SPARKLE_SPOTS = { { 0.25, 0.3 }, { 0.7, 0.22 }, { 0.5, 0.65 }, { 0.3, 0.8 }, { 0.8, 0.7 } }

local function darken(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local function shape(
	parent: Instance,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color3,
	z: number,
	radius: number?,
	transparency: number?,
	rotation: number?
): Frame
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency or 0
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Rotation = rotation or 0
	if radius and radius > 0 then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(radius, 0)
		corner.Parent = f
	end
	f.Parent = parent
	return f
end

local function glyph(parent: Instance, text: string, x: number, y: number, size: number, color: Color3, z: number): TextLabel
	local t = Instance.new("TextLabel")
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(x, y)
	t.Size = UDim2.fromScale(size, size)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.ZIndex = z
	t.Parent = parent
	return t
end

-- Colors a shape with an item's color, gradient and sparkles.
local function paint(f: Frame, it: Catalog.Item?, fallback: Color3?)
	if not it then
		if fallback then
			f.BackgroundColor3 = fallback
		end
		return
	end
	f.BackgroundColor3 = it.color or fallback or WHITE
	if it.gradient then
		local keypoints = {}
		local n = #it.gradient
		for i, c in it.gradient do
			table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / math.max(n - 1, 1), c))
		end
		f.BackgroundColor3 = WHITE
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new(keypoints)
		g.Rotation = 90
		g.Parent = f
	end
	if it.sparkle then
		for _, spot in SPARKLE_SPOTS do
			local dot = shape(f, spot[1], spot[2], 0.12, 0.12, WHITE, f.ZIndex, 0.5, 0.15)
			local aspect = Instance.new("UIAspectRatioConstraint")
			aspect.AspectRatio = 1
			aspect.Parent = dot
		end
	end
end

------------------------------------------------------------------------------
-- Hair

local function drawHair(root: Frame, look, hairItem: Catalog.Item?, options: Options?)
	local hc = hairItem and hairItem.color or Color3.fromRGB(105, 66, 40)
	local function hair(x, y, w, h, z, r, rot): Frame
		local f = shape(root, x, y, w, h, hc, z, r, 0, rot)
		paint(f, hairItem, hc)
		return f
	end
	local function cap()
		hair(0.5, 0.215, 0.5, 0.16, Z.hairFront, 0.5)
	end
	local function fringe()
		hair(0.42, 0.265, 0.24, 0.07, Z.hairFront, 0.5, -14)
	end

	local styleItem = Catalog.byId[look.hairStyle]
	local style = if styleItem and styleItem.draw then styleItem.draw else look.hairStyle
	if style == "hair_messy" then
		hair(0.5, 0.3, 0.56, 0.36, Z.hairBack, 0.5)
		cap()
		if not (options and options.brushed) then
			-- tangles and frizz (they fade away while the stylist brushes)
			local tangle = if options and options.tangle then options.tangle else 1
			local tufts = { { 0.27, 0.17, 30 }, { 0.36, 0.11, -20 }, { 0.49, 0.09, 10 }, { 0.62, 0.11, 35 }, { 0.73, 0.18, -30 }, { 0.76, 0.3, 15 }, { 0.24, 0.31, -10 } }
			local bits = {}
			for _, t in tufts do
				table.insert(bits, hair(t[1], t[2], 0.1, 0.07, Z.hairFront, 0.4, t[3]))
			end
			table.insert(bits, hair(0.3, 0.06, 0.02, 0.09, Z.hairFront, 0.5, -30))
			table.insert(bits, hair(0.68, 0.05, 0.02, 0.1, Z.hairFront, 0.5, 25))
			table.insert(bits, hair(0.45, 0.29, 0.14, 0.05, Z.hairFront, 0.5, 25))
			table.insert(bits, hair(0.58, 0.28, 0.12, 0.045, Z.hairFront, 0.5, -30))
			for _, b in bits do
				b.Name = "Tuft"
				b.BackgroundTransparency = 1 - tangle
			end
		end
	elseif style == "hair_long" then
		hair(0.5, 0.52, 0.62, 0.72, Z.hairBack, 0.25)
		cap()
		fringe()
	elseif style == "hair_bob" then
		hair(0.5, 0.43, 0.6, 0.5, Z.hairBack, 0.35)
		cap()
		fringe()
		hair(0.285, 0.45, 0.075, 0.38, Z.hairFront, 0.5)
		hair(0.715, 0.45, 0.075, 0.38, Z.hairFront, 0.5)
	elseif style == "hair_pixie" then
		hair(0.5, 0.3, 0.52, 0.3, Z.hairBack, 0.5)
		hair(0.5, 0.2, 0.48, 0.13, Z.hairFront, 0.5)
		hair(0.4, 0.25, 0.26, 0.07, Z.hairFront, 0.5, -22)
		hair(0.28, 0.36, 0.05, 0.12, Z.hairFront, 0.5)
		hair(0.72, 0.36, 0.05, 0.12, Z.hairFront, 0.5)
	elseif style == "hair_puff" then
		hair(0.5, 0.08, 0.32, 0.32, Z.hairBack, 0.5)
		hair(0.5, 0.21, 0.48, 0.13, Z.hairFront, 0.5)
		shape(root, 0.5, 0.17, 0.12, 0.03, TIE, Z.hairFront, 0.5)
	elseif style == "hair_curls" then
		hair(0.5, 0.4, 0.8, 0.8, Z.hairBack, 0.5)
		for i = 0, 6 do
			hair(0.29 + i * 0.07, 0.17 + (i % 2) * 0.03, 0.11, 0.11, Z.hairFront, 0.5)
		end
		for _, p in { { 0.2, 0.3 }, { 0.8, 0.35 }, { 0.17, 0.55 }, { 0.83, 0.58 }, { 0.3, 0.1 }, { 0.7, 0.1 } } do
			local curl = hair(p[1], p[2], 0.08, 0.08, Z.hairBack, 0.5)
			curl.BackgroundTransparency = 0.6
			curl.BackgroundColor3 = darken(hc, 0.6)
		end
	elseif style == "hair_pigtails" then
		hair(0.5, 0.35, 0.54, 0.42, Z.hairBack, 0.5)
		hair(0.19, 0.56, 0.2, 0.2, Z.hairBack, 0.5)
		hair(0.81, 0.56, 0.2, 0.2, Z.hairBack, 0.5)
		hair(0.19, 0.74, 0.14, 0.18, Z.hairBack, 0.5)
		hair(0.81, 0.74, 0.14, 0.18, Z.hairBack, 0.5)
		cap()
		fringe()
		shape(root, 0.24, 0.45, 0.05, 0.05, TIE, Z.hairFront, 0.5)
		shape(root, 0.76, 0.45, 0.05, 0.05, TIE, Z.hairFront, 0.5)
	elseif style == "hair_buns" then
		hair(0.5, 0.38, 0.56, 0.46, Z.hairBack, 0.4)
		hair(0.3, 0.11, 0.2, 0.2, Z.hairBack, 0.5)
		hair(0.7, 0.11, 0.2, 0.2, Z.hairBack, 0.5)
		cap()
		fringe()
	elseif style == "hair_braid" then
		hair(0.5, 0.38, 0.58, 0.44, Z.hairBack, 0.4)
		cap()
		hair(0.56, 0.26, 0.3, 0.07, Z.hairFront, 0.5, 14)
		for i = 0, 5 do
			local s = 0.11 - i * 0.008
			hair(0.73 + (i % 2) * 0.015, 0.5 + i * 0.075, s, s, Z.hairFront, 0.5)
		end
		shape(root, 0.74, 0.9, 0.05, 0.03, TIE, Z.hairFront, 0.5)
	elseif style == "hair_updo" then
		hair(0.5, 0.07, 0.28, 0.26, Z.hairBack, 0.5)
		hair(0.5, 0.21, 0.5, 0.14, Z.hairFront, 0.5)
		hair(0.275, 0.42, 0.02, 0.18, Z.hairFront, 0.5, 8)
		hair(0.725, 0.42, 0.02, 0.18, Z.hairFront, 0.5, -8)
		glyph(root, "✦", 0.38, 0.12, 0.06, Color3.fromRGB(255, 240, 170), Z.hairFront)
		glyph(root, "✦", 0.62, 0.12, 0.05, Color3.fromRGB(255, 240, 170), Z.hairFront)
	elseif style == "hair_mermaid" then
		hair(0.5, 0.55, 0.7, 0.8, Z.hairBack, 0.3)
		for i = 0, 4 do
			hair(0.155, 0.3 + i * 0.13, 0.13, 0.13, Z.hairBack, 0.5)
			hair(0.845, 0.3 + i * 0.13, 0.13, 0.13, Z.hairBack, 0.5)
		end
		cap()
		fringe()
		glyph(root, "🐚", 0.68, 0.16, 0.08, WHITE, Z.hairFront)
	end
end

------------------------------------------------------------------------------
-- Face

local function drawEyes(root: Frame, client, look, hairItem: Catalog.Item?)
	local shadow = Catalog.byId[look.eyeshadow]
	local lashes = look.lashes
	local browColor = darken(hairItem and hairItem.color or Color3.fromRGB(80, 50, 30), 0.7)

	for side = -1, 1, 2 do
		local x = 0.5 + side * 0.09

		if shadow and shadow.color then
			local s = shape(root, x, 0.405, 0.115, 0.07, shadow.color, Z.makeup, 0.5, 0.1)
			paint(s, shadow)
		end

		local eye = shape(root, x, 0.42, 0.085, 0.055, WHITE, Z.eyes, 0.5)
		eye.Name = "Eye"
		local iris = shape(eye, 0.5, 0.5, 0.5, 0.85, client.eyes, Z.eyes, 0.5)
		shape(iris, 0.5, 0.5, 0.5, 0.5, Color3.fromRGB(20, 15, 20), Z.eyes, 0.5)
		shape(iris, 0.68, 0.3, 0.3, 0.3, WHITE, Z.eyes, 0.5)

		shape(root, x, 0.355, 0.085, 0.016, browColor, Z.details, 0.5, 0, side * 8)

		if lashes == "lash_natural" or lashes == "lash_star" then
			shape(root, x, 0.395, 0.09, 0.012, LASH, Z.details, 0.5)
		elseif lashes == "lash_glam" then
			shape(root, x, 0.395, 0.095, 0.018, LASH, Z.details, 0.5)
			shape(root, x + side * 0.05, 0.385, 0.035, 0.013, LASH, Z.details, 0.5, -side * 28)
		end
		if lashes == "lash_star" then
			glyph(root, "★", x + side * 0.055, 0.38, 0.035, Color3.fromRGB(255, 215, 80), Z.details)
		end
	end
end

-- Half of an ellipse, cut off by a clipping frame: the lower half makes a smile, the upper half a frown.
local function halfMouth(root: Frame, y: number, w: number, h: number, lower: boolean): Frame
	local clip = Instance.new("Frame")
	clip.Name = "Mouth"
	clip.AnchorPoint = Vector2.new(0.5, 0.5)
	clip.Position = UDim2.fromScale(0.5, y)
	clip.Size = UDim2.fromScale(w, h)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.ZIndex = Z.details
	clip.Parent = root
	return clip
end

local function drawMouth(root: Frame, client, mood: string, lipColor: Color3, glossy: boolean)
	if mood == "smile" or mood == "grin" then
		local big = mood == "grin"
		local clip = halfMouth(root, if big then 0.605 else 0.6, if big then 0.15 else 0.12, if big then 0.07 else 0.05, true)
		shape(clip, 0.5, 0, 1, 2, lipColor, 1, 0.5)
		shape(clip, 0.5, 0, 0.8, 1.5, Color3.fromRGB(110, 30, 50), 2, 0.5)
		shape(clip, 0.5, 0.13, 0.62, 0.24, WHITE, 3, 0.3)
		if big then
			shape(clip, 0.5, 0.78, 0.38, 0.4, Color3.fromRGB(255, 120, 140), 3, 0.5)
		end
		if glossy then
			shape(clip, 0.62, 0.8, 0.18, 0.12, WHITE, 4, 0.5, 0.3)
		end
	elseif mood == "sad" then
		local clip = halfMouth(root, 0.615, 0.1, 0.035, false)
		shape(clip, 0.5, 1, 1, 2, lipColor, 1, 0.5)
		shape(clip, 0.5, 1.3, 0.72, 2, client.skin, 2, 0.5)
	else
		local lips = shape(root, 0.5, 0.6, 0.11, 0.042, lipColor, Z.details, 0.5)
		shape(root, 0.5, 0.598, 0.08, 0.005, darken(lips.BackgroundColor3, 0.6), Z.gems, 0.5)
		if glossy then
			shape(root, 0.52, 0.612, 0.03, 0.009, WHITE, Z.gems, 0.5, 0.3)
		end
	end
end

local function drawCheeksAndLips(root: Frame, client, look, mood: string?)
	local blush = Catalog.byId[look.blush]
	if blush and blush.color then
		for side = -1, 1, 2 do
			local b = shape(root, 0.5 + side * 0.14, 0.53, 0.08, 0.05, blush.color, Z.makeup, 0.5, 0.45)
			paint(b, blush)
		end
	end

	shape(root, 0.5, 0.5, 0.035, 0.045, darken(client.skin, 0.88), Z.makeup, 0.5)

	local lipstick = Catalog.byId[look.lipstick]
	local natural = client.skin:Lerp(Color3.fromRGB(190, 80, 85), 0.4)
	local lipColor = if lipstick and lipstick.color then lipstick.color else natural
	drawMouth(root, client, mood or "smile", lipColor, lipstick ~= nil and lipstick.sparkle == true)
end

local function drawGems(root: Frame, client, look)
	local it = Catalog.byId[look.gems]
	local gems = if it and it.draw then it.draw else look.gems
	if gems == "gem_freckles" then
		local c = darken(client.skin, 0.72)
		for _, p in { { 0.42, 0.49 }, { 0.445, 0.51 }, { 0.41, 0.515 }, { 0.58, 0.49 }, { 0.555, 0.51 }, { 0.59, 0.515 } } do
			shape(root, p[1], p[2], 0.012, 0.012, c, Z.gems, 0.5)
		end
	elseif gems == "gem_hearts" and it then
		glyph(root, "♥", 0.345, 0.47, 0.06, it.color or WHITE, Z.gems)
		glyph(root, "♥", 0.655, 0.47, 0.06, it.color or WHITE, Z.gems)
	elseif gems == "gem_stars" and it then
		glyph(root, "★", 0.335, 0.41, 0.06, it.color or WHITE, Z.gems)
		glyph(root, "★", 0.665, 0.41, 0.06, it.color or WHITE, Z.gems)
		glyph(root, "★", 0.355, 0.47, 0.035, it.color or WHITE, Z.gems)
	elseif gems == "gem_bats" then
		glyph(root, "🦇", 0.34, 0.47, 0.07, WHITE, Z.gems)
		glyph(root, "🦇", 0.67, 0.4, 0.05, WHITE, Z.gems)
	elseif gems == "gem_web" then
		glyph(root, "🕸️", 0.65, 0.48, 0.09, WHITE, Z.gems)
	elseif gems == "gem_leaves" then
		glyph(root, "🍁", 0.34, 0.48, 0.06, WHITE, Z.gems)
		glyph(root, "🍂", 0.66, 0.48, 0.06, WHITE, Z.gems)
	elseif gems == "gem_snowflakes" then
		glyph(root, "❄️", 0.34, 0.47, 0.06, WHITE, Z.gems)
		glyph(root, "❄️", 0.665, 0.41, 0.045, WHITE, Z.gems)
		glyph(root, "❄️", 0.68, 0.5, 0.035, WHITE, Z.gems)
	elseif gems == "gem_rhinestones" and it then
		for side = -1, 1, 2 do
			for i = 0, 3 do
				shape(root, 0.5 + side * (0.06 + i * 0.022), 0.46 + i * 0.006, 0.016, 0.016, it.color or WHITE, Z.gems, 0.5)
			end
		end
	end
end

local function drawAccessory(root: Frame, look)
	local it = Catalog.byId[look.accessory]
	local acc = if it and it.draw then it.draw else look.accessory
	local c = it and it.color or WHITE
	-- paints a shape with the item's color, or its rainbow gradient
	local function tint(f: Frame): Frame
		if it and it.gradient then
			paint(f, it)
		end
		return f
	end
	if acc == "acc_bow" then
		shape(root, 0.32, 0.14, 0.09, 0.07, c, Z.accessory, 0.4, 0, -20)
		shape(root, 0.42, 0.14, 0.09, 0.07, c, Z.accessory, 0.4, 0, 20)
		shape(root, 0.37, 0.14, 0.035, 0.035, darken(c, 0.8), Z.accessory, 0.5)
	elseif acc == "acc_headband" then
		tint(shape(root, 0.5, 0.2, 0.52, 0.035, c, Z.accessory, 0.5))
	elseif acc == "acc_flower" then
		glyph(root, "✿", 0.68, 0.18, 0.13, c, Z.accessory)
		shape(root, 0.68, 0.185, 0.025, 0.025, Color3.fromRGB(255, 220, 80), Z.accessory, 0.5)
	elseif acc == "acc_earrings" then
		shape(root, 0.275, 0.55, 0.03, 0.03, c, Z.accessory, 0.5)
		shape(root, 0.725, 0.55, 0.03, 0.03, c, Z.accessory, 0.5)
	elseif acc == "acc_catears" then
		for side = -1, 1, 2 do
			shape(root, 0.5 + side * 0.17, 0.12, 0.09, 0.09, c, Z.accessory, 0.15, 0, 45)
			shape(root, 0.5 + side * 0.17, 0.125, 0.045, 0.045, Color3.fromRGB(255, 160, 190), Z.accessory, 0.15, 0, 45)
		end
	elseif acc == "acc_crown" then
		glyph(root, "👑", 0.5, 0.09, 0.18, c, Z.accessory)
	elseif it and it.icon then
		-- a cute hair clip
		glyph(root, it.icon, 0.69, 0.17, 0.12, WHITE, Z.accessory)
	elseif acc == "acc_butterfly" then
		glyph(root, "🦋", 0.68, 0.17, 0.12, WHITE, Z.accessory)
	elseif acc == "acc_halo" then
		local ring = shape(root, 0.5, 0.06, 0.4, 0.06, c, Z.accessory, 0.5)
		shape(ring, 0.5, 0.5, 0.8, 0.45, Color3.fromRGB(255, 250, 225), Z.accessory, 0.5)
		for i = 0, 4 do
			glyph(root, "✦", 0.34 + i * 0.08, 0.06, 0.04, Color3.fromRGB(255, 240, 150), Z.accessory)
		end
	elseif acc == "acc_tiara" then
		shape(root, 0.5, 0.17, 0.36, 0.025, c, Z.accessory, 0.5)
		for i = -2, 2 do
			local h = if i == 0 then 0.07 else (if math.abs(i) == 1 then 0.05 else 0.035)
			shape(root, 0.5 + i * 0.07, 0.165 - h / 2, 0.025, h, c, Z.accessory, 0.5)
		end
		shape(root, 0.5, 0.12, 0.035, 0.035, Color3.fromRGB(255, 120, 190), Z.accessory, 0.5)
		shape(root, 0.43, 0.135, 0.022, 0.022, Color3.fromRGB(140, 200, 255), Z.accessory, 0.5)
		shape(root, 0.57, 0.135, 0.022, 0.022, Color3.fromRGB(140, 200, 255), Z.accessory, 0.5)
	elseif acc == "acc_witchhat" then
		local band = it and it.accent or Color3.fromRGB(150, 80, 220)
		shape(root, 0.5, 0.165, 0.66, 0.05, c, Z.accessory, 0.5)
		shape(root, 0.5, 0.115, 0.34, 0.07, c, Z.accessory, 0.3)
		shape(root, 0.51, 0.065, 0.25, 0.06, c, Z.accessory, 0.3, 0, 4)
		shape(root, 0.53, 0.025, 0.16, 0.05, c, Z.accessory, 0.3, 0, 10)
		shape(root, 0.57, 0.0, 0.08, 0.04, c, Z.accessory, 0.5, 0, 25)
		shape(root, 0.5, 0.14, 0.35, 0.022, band, Z.accessory, 0.2)
		glyph(root, "⭐", 0.6, 0.11, 0.04, WHITE, Z.accessory)
	elseif acc == "acc_pumpkin" then
		glyph(root, "🎃", 0.69, 0.17, 0.12, WHITE, Z.accessory)
	elseif acc == "acc_leafcrown" then
		for i, p in { { 0.31, 0.19, "🍂" }, { 0.39, 0.14, "🍁" }, { 0.5, 0.12, "🍂" }, { 0.61, 0.14, "🍁" }, { 0.69, 0.19, "🍂" } } do
			glyph(root, p[3], p[1], p[2], if i == 3 then 0.1 else 0.08, WHITE, Z.accessory)
		end
	elseif acc == "acc_santahat" then
		shape(root, 0.5, 0.135, 0.5, 0.11, c, Z.accessory, 0.45)
		shape(root, 0.61, 0.075, 0.3, 0.08, c, Z.accessory, 0.45, 0, 22)
		shape(root, 0.72, 0.06, 0.12, 0.06, c, Z.accessory, 0.45, 0, 50)
		shape(root, 0.5, 0.185, 0.56, 0.055, WHITE, Z.accessory, 0.5)
		shape(root, 0.79, 0.09, 0.075, 0.075, WHITE, Z.accessory, 0.5)
	elseif acc == "acc_antlers" then
		for side = -1, 1, 2 do
			shape(root, 0.5 + side * 0.17, 0.09, 0.03, 0.15, c, Z.accessory, 0.5, 0, side * 18)
			shape(root, 0.5 + side * 0.215, 0.07, 0.025, 0.08, c, Z.accessory, 0.5, 0, side * 55)
			shape(root, 0.5 + side * 0.14, 0.04, 0.022, 0.07, c, Z.accessory, 0.5, 0, -side * 25)
		end
		shape(root, 0.5, 0.505, 0.055, 0.05, Color3.fromRGB(230, 30, 40), Z.accessory, 0.5)
		shape(root, 0.49, 0.495, 0.015, 0.013, WHITE, Z.accessory, 0.5, 0.2)
	elseif acc == "acc_earmuffs" then
		local band = it and it.accent or Color3.fromRGB(110, 170, 255)
		shape(root, 0.5, 0.15, 0.56, 0.03, band, Z.accessory, 0.5)
		for side = -1, 1, 2 do
			shape(root, 0.5 + side * 0.24, 0.45, 0.11, 0.13, c, Z.accessory, 0.5)
			shape(root, 0.5 + side * 0.24, 0.45, 0.06, 0.07, Color3.fromRGB(230, 240, 255), Z.accessory, 0.5)
		end
	end
end

-- Dots, stripes, hearts... drawn on top of the outfit
local PATTERN_SPOTS = { { 0.14, 0.2 }, { 0.32, 0.36 }, { 0.5, 0.18 }, { 0.68, 0.36 }, { 0.86, 0.2 }, { 0.23, 0.52 }, { 0.77, 0.52 }, { 0.5, 0.5 } }

local function drawPattern(body: Frame, patternId: string?, color: Color3)
	if patternId == "pat_dots" then
		for _, p in PATTERN_SPOTS do
			local dot = shape(body, p[1], p[2], 0.05, 0.13, color, body.ZIndex, 0.5, 0.1)
			dot.Name = "Pattern"
		end
	elseif patternId == "pat_stripes" then
		for i = 0, 3 do
			local stripe = shape(body, 0.5, 0.14 + i * 0.15, 0.86, 0.055, color, body.ZIndex, 0.5, 0.15)
			stripe.Name = "Pattern"
		end
	else
		local symbol = ({ pat_hearts = "♥", pat_stars = "★", pat_flowers = "✿" })[patternId or ""]
		if symbol then
			for _, p in PATTERN_SPOTS do
				local t = glyph(body, symbol, p[1], p[2], 0.12, color, body.ZIndex)
				t.Size = UDim2.fromScale(0.09, 0.22)
				t.Name = "Pattern"
			end
		end
	end
end

local function drawOutfit(root: Frame, client, look)
	local outfit = Catalog.byId[look.outfit]
	shape(root, 0.5, 0.77, 0.15, 0.14, client.skin, Z.neck, 0.3)
	local body = shape(root, 0.5, 0.97, 0.78, 0.3, Color3.new(), Z.outfit, 0.35)
	-- A custom color from the 🎨 palette replaces the outfit's own colors
	local custom = Catalog.byId[look.outfitColor or ""]
	if custom and custom.color then
		body.BackgroundColor3 = custom.color
	else
		paint(body, outfit, Color3.fromRGB(110, 120, 135))
	end
	local patternColor = if outfit and outfit.accent then outfit.accent else WHITE
	if custom and custom.color then
		local _, _, v = custom.color:ToHSV()
		patternColor = if v > 0.8 then Color3.fromRGB(255, 120, 190) else WHITE
	end
	drawPattern(body, look.outfitPattern, patternColor)
	shape(root, 0.5, 0.83, 0.14, 0.06, client.skin, Z.ears, 0.5)
	local accent = outfit and outfit.accent or WHITE
	shape(root, 0.43, 0.86, 0.06, 0.02, accent, Z.ears, 0.5, 0, 25)
	shape(root, 0.57, 0.86, 0.06, 0.02, accent, Z.ears, 0.5, 0, -25)
	if look.outfit == "outfit_work" then
		-- overall straps
		shape(root, 0.38, 0.92, 0.05, 0.12, accent, Z.ears, 0.2)
		shape(root, 0.62, 0.92, 0.05, 0.12, accent, Z.ears, 0.2)
	end
end

local function drawDirt(root: Frame, client, options: Options?)
	local health = options and options.dirtHealth
	local n = #client.dirt
	local cleanedCount = math.floor(((options and options.clean) or 0) * n + 0.5)
	for i, spot in client.dirt do
		local h = if health then health[i] or 0 else (if i <= cleanedCount then 0 else 1)
		-- A splat: one big blob and two little ones
		local f = shape(root, spot.x, spot.y, spot.size * 1.3, spot.size * 1.1, spot.color, Z.dirt, 0, 1, (i * 47) % 180)
		f.Name = "Dirt" .. i
		shape(f, 0.45, 0.5, 0.75, 0.75, spot.color, Z.dirt, 0.5)
		shape(f, 0.82, 0.22, 0.3, 0.3, spot.color, Z.dirt, 0.5)
		shape(f, 0.18, 0.85, 0.24, 0.24, darken(spot.color, 0.85), Z.dirt, 0.5)
		LookRenderer.setDirtHealth(f, h)
	end
end

------------------------------------------------------------------------------

-- The look's skin tone (if it picked one) replaces the client's own.
local function withSkin(client, look)
	if look and look.skin and Catalog.byId[look.skin] then
		local c = table.clone(client)
		c.skin = Catalog.skinColor(look, client.skin)
		return c
	end
	return client
end
LookRenderer.withSkin = withSkin

-- The whole client, head to toe, for the runway and podium (a "paper doll").
-- `container` should be twice as tall as it is wide.
function LookRenderer.renderBody(container: GuiObject, client, look, options: Options?): Frame
	client = withSkin(client, look)
	local old = container:FindFirstChild("Doll")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Frame")
	root.Name = "Doll"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.ZIndex = container.ZIndex
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 0.5
	aspect.Parent = root

	local skin = client.skin
	local outfit = Catalog.byId[look.outfit]
	local custom = Catalog.byId[look.outfitColor or ""]
	local dress = outfit ~= nil and outfit.dress == true
	local accent = if outfit and outfit.accent then outfit.accent else WHITE
	local function clothes(f: Frame)
		if custom and custom.color then
			f.BackgroundColor3 = custom.color
		else
			paint(f, outfit, Color3.fromRGB(110, 120, 135))
		end
		drawPattern(f, look.outfitPattern, if custom and custom.color then WHITE else accent)
	end

	-- legs and shoes (y is 0..1 down a body that's twice as tall as wide)
	for side = -1, 1, 2 do
		local leg = shape(root, 0.5 + side * 0.08, 0.8, 0.13, 0.26, if dress then skin else accent, 1, 0.5)
		if not dress then
			leg.BackgroundColor3 = if custom and custom.color then darken(custom.color, 0.7) else accent
		end
		shape(root, 0.5 + side * 0.095, 0.94, 0.17, 0.045, if dress then accent else Color3.fromRGB(250, 250, 255), 2, 0.5)
	end
	-- arms with sleeves and hands
	for side = -1, 1, 2 do
		local arm = shape(root, 0.5 + side * 0.29, 0.51, 0.11, 0.2, skin, 2, 0.5, 0, side * -10)
		arm.Name = "Arm"
		local sleeve = shape(root, 0.5 + side * 0.28, 0.45, 0.13, 0.09, Color3.new(), 3, 0.5, 0, side * -10)
		clothes(sleeve)
		shape(root, 0.5 + side * 0.31, 0.61, 0.11, 0.055, skin, 3, 0.5)
	end
	shape(root, 0.5, 0.385, 0.14, 0.05, skin, 3, 0.4) -- neck
	local top = shape(root, 0.5, 0.48, 0.5, 0.16, Color3.new(), 4, 0.3)
	clothes(top)
	shape(root, 0.5, 0.41, 0.16, 0.025, skin, 5, 0.5) -- neckline
	if dress then
		local skirt = shape(root, 0.5, 0.64, 0.8, 0.2, Color3.new(), 4, 0.35)
		clothes(skirt)
		shape(root, 0.5, 0.735, 0.78, 0.018, accent, 5, 0.5) -- hem trim
	else
		local pants = if custom and custom.color then darken(custom.color, 0.7) else accent
		shape(root, 0.5, 0.62, 0.32, 0.11, pants, 2, 0.25) -- hips
		local belt = shape(root, 0.5, 0.565, 0.5, 0.03, darken(top.BackgroundColor3, 0.75), 5, 0.3)
		belt.Name = "Belt"
	end

	-- the head is the same drawing as the makeover portrait
	local head = Instance.new("Frame")
	head.Name = "Head"
	head.AnchorPoint = Vector2.new(0.5, 0)
	head.Position = UDim2.fromScale(0.5, -0.05)
	head.Size = UDim2.fromScale(1.05, 0.525)
	head.BackgroundTransparency = 1
	head.ZIndex = 6
	head.Parent = root
	LookRenderer.render(head, client, look, {
		headOnly = true,
		clean = if options and options.clean then options.clean else 1,
		mood = if options and options.mood then options.mood else "smile",
	})
	local headRoot = head:FindFirstChild("Portrait")
	if headRoot and headRoot:IsA("GuiObject") then
		headRoot.ClipsDescendants = false
	end

	root.Parent = container
	return root
end

-- The nail station: a close-up of the client's hand.
local FINGERS = { { 0.335, 0.27 }, { 0.445, 0.17 }, { 0.555, 0.2 }, { 0.665, 0.28 } } -- x, fingertip y

function LookRenderer.renderHand(container: GuiObject, client, look): Frame
	client = withSkin(client, look)
	local old = container:FindFirstChild("Portrait")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Frame")
	root.Name = "Portrait"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.ClipsDescendants = true
	root.ZIndex = container.ZIndex
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.Parent = root

	local skin = client.skin
	local polish = Catalog.byId[look.nailColor]
	local art = Catalog.byId[look.nailArt]
	local natural = skin:Lerp(Color3.fromRGB(255, 220, 225), 0.55)

	local outfit = Catalog.byId[look.outfit]
	local sleeve = shape(root, 0.5, 1.02, 0.46, 0.16, Color3.new(), 1, 0.3)
	paint(sleeve, outfit, Color3.fromRGB(110, 120, 135))
	shape(root, 0.5, 0.92, 0.34, 0.2, skin, 2, 0.3)
	shape(root, 0.5, 0.72, 0.46, 0.38, skin, 3, 0.3)

	local nails = {}
	for _, f in FINGERS do
		local x, top = f[1], f[2]
		local h = 0.62 - top
		shape(root, x, top + h / 2, 0.1, h, skin, 3, 0.5)
		table.insert(nails, { x = x, y = top + 0.055, rot = 0 })
	end
	shape(root, 0.255, 0.6, 0.1, 0.28, skin, 3, 0.5, 0, -38)
	table.insert(nails, { x = 0.185, y = 0.505, rot = -38 })
	-- little knuckle lines
	for _, f in FINGERS do
		shape(root, f[1], 0.47, 0.05, 0.008, darken(skin, 0.85), 4, 0.5)
	end

	for _, n in nails do
		local nail = shape(root, n.x, n.y, 0.074, 0.09, natural, 5, 0.45, 0, n.rot)
		nail.Name = "Nail"
		if polish and polish.color then
			paint(nail, polish)
		end
		shape(nail, 0.3, 0.3, 0.2, 0.35, WHITE, 6, 0.5, 0.45)
		if art and art.icon then
			local dark = polish and polish.color and select(3, polish.color:ToHSV()) > 0.75
			local t = glyph(nail, art.icon, 0.5, 0.55, 0.9, if dark then Color3.fromRGB(80, 40, 100) else WHITE, 7)
			t.Size = UDim2.fromScale(0.9, 0.7)
		end
	end
	root.Parent = container
	return root
end

-- Colors any UI frame like an item (used for the color swatches in the menus).
LookRenderer.paint = paint
-- Dots, stripes, hearts... on any frame (used on the 3D client's shirt and skirt).
LookRenderer.drawPattern = drawPattern

function LookRenderer.setDirtHealth(f: GuiObject, health: number)
	local t = 1 - 0.92 * math.clamp(health, 0, 1)
	for _, blob in f:GetChildren() do
		if blob:IsA("GuiObject") then
			blob.BackgroundTransparency = t
		end
	end
	f.Visible = health > 0.02
end

-- Draws the client into `container`, replacing any older drawing. Returns the square root frame.
function LookRenderer.render(container: GuiObject, client, look, options: Options?): Frame
	client = withSkin(client, look)
	local old = container:FindFirstChild("Portrait")
	if old then
		old:Destroy()
	end

	local root = Instance.new("Frame")
	root.Name = "Portrait"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	local zoom = options and options.zoom or 1
	-- keep the middle of the face (0.5, 0.42) in the middle of the container
	root.Position = UDim2.fromScale(0.5, 0.5 + 0.08 * (zoom - 1))
	root.Size = UDim2.fromScale(zoom, zoom)
	root.BackgroundTransparency = 1
	root.ClipsDescendants = true
	root.ZIndex = container.ZIndex
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.Parent = root

	local hairItem = Catalog.byId[look.hairColor]

	local faceOnly = options and options.faceOnly
	if not faceOnly then
		drawHair(root, look, hairItem, options)
		if not (options and options.headOnly) then
			drawOutfit(root, client, look)
		end
		for side = -1, 1, 2 do
			local ear = shape(root, 0.5 + side * 0.22, 0.47, 0.06, 0.09, client.skin, Z.ears, 0.5)
			shape(ear, 0.5, 0.5, 0.45, 0.55, darken(client.skin, 0.85), Z.ears, 0.5)
		end
		shape(root, 0.5, 0.46, 0.44, 0.56, client.skin, Z.face, 0.5)
	end
	drawEyes(root, client, look, hairItem)
	drawCheeksAndLips(root, client, look, options and options.mood)
	drawGems(root, client, look)
	if not faceOnly then
		drawAccessory(root, look)
	end
	if (options and options.dirtHealth) or ((options and options.clean) or 0) < 1 then
		drawDirt(root, client, options)
	end

	root.Parent = container
	return root
end

return LookRenderer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Pets</string>
          <string name="Source"><![CDATA[-- Runway buddies, built from simple shapes: Bean the Boston terrier, a kitty, a bunny, a baby
-- dragon, a unicorn and a dino. Each pet is a small model whose pivot sits on the ground under it,
-- facing forward (-Z), so it can trot along next to its owner.

local Pets = {}

local rgb = Color3.fromRGB
local BLACK = rgb(28, 26, 30)
local WHITE = rgb(250, 250, 252)
local PINK = rgb(255, 150, 185)
local GOLD = rgb(250, 200, 70)

local function part(model: Model, name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Parent = model
	return p
end

local function ball(model, name, size: Vector3, pos: Vector3, color, material: Enum.Material?)
	return part(model, name, size, CFrame.new(pos), color, Enum.PartType.Ball, material)
end

-- Eyes with a shine, looking forward (-Z)
local function eyes(model, at: Vector3, spread: number, size: number)
	for side = -1, 1, 2 do
		ball(model, "Eye", Vector3.one * size, at + Vector3.new(side * spread, 0, 0), BLACK)
		ball(model, "Shine", Vector3.one * size * 0.35, at + Vector3.new(side * spread + 0.04, size * 0.2, -size * 0.4), WHITE, Enum.Material.Neon)
	end
end

local function legs(model, color: Color3, paw: Color3, width: number, length: number, height: number)
	for _, x in { -width, width } do
		for _, z in { -length, length } do
			part(model, "Leg", Vector3.new(height, 0.28, 0.28), CFrame.new(x, height / 2, z) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.PartType.Cylinder)
			ball(model, "Paw", Vector3.new(0.32, 0.2, 0.36), Vector3.new(x, 0.1, z - 0.04), paw)
		end
	end
end

local BUILDERS = {}

-- Bean: Tori's Boston terrier. Black with a white blaze, white chest and white paws, tall bat ears.
function BUILDERS.pet_bean(m: Model)
	legs(m, BLACK, WHITE, 0.32, 0.45, 0.55)
	ball(m, "Body", Vector3.new(1.05, 0.85, 1.5), Vector3.new(0, 0.95, 0), BLACK)
	ball(m, "Chest", Vector3.new(0.7, 0.7, 0.5), Vector3.new(0, 0.95, -0.55), WHITE)
	ball(m, "Head", Vector3.new(0.95, 0.85, 0.85), Vector3.new(0, 1.6, -0.75), BLACK)
	part(m, "Blaze", Vector3.new(0.18, 0.55, 0.12), CFrame.new(0, 1.72, -1.15), WHITE)
	ball(m, "Muzzle", Vector3.new(0.5, 0.38, 0.35), Vector3.new(0, 1.42, -1.13), WHITE)
	ball(m, "Nose", Vector3.new(0.16, 0.12, 0.12), Vector3.new(0, 1.5, -1.3), BLACK)
	eyes(m, Vector3.new(0, 1.72, -1.12), 0.24, 0.16)
	for side = -1, 1, 2 do
		part(m, "Ear", Vector3.new(0.12, 0.55, 0.32), CFrame.new(side * 0.3, 2.12, -0.72) * CFrame.Angles(0, 0, math.rad(-side * 18)), BLACK)
		part(m, "EarInside", Vector3.new(0.13, 0.38, 0.18), CFrame.new(side * 0.3, 2.08, -0.75) * CFrame.Angles(0, 0, math.rad(-side * 18)), PINK)
	end
	ball(m, "Tail", Vector3.new(0.18, 0.18, 0.25), Vector3.new(0, 1.15, 0.78), BLACK)
end

function BUILDERS.pet_kitty(m: Model)
	local orange, cream = rgb(245, 150, 60), rgb(255, 230, 200)
	legs(m, orange, cream, 0.28, 0.45, 0.5)
	ball(m, "Body", Vector3.new(0.9, 0.8, 1.45), Vector3.new(0, 0.9, 0), orange)
	ball(m, "Head", Vector3.new(0.95, 0.85, 0.85), Vector3.new(0, 1.55, -0.72), orange)
	ball(m, "Muzzle", Vector3.new(0.45, 0.3, 0.3), Vector3.new(0, 1.42, -1.1), cream)
	ball(m, "Nose", Vector3.new(0.12, 0.09, 0.09), Vector3.new(0, 1.5, -1.24), PINK)
	eyes(m, Vector3.new(0, 1.67, -1.08), 0.22, 0.17)
	for side = -1, 1, 2 do
		part(m, "Ear", Vector3.new(0.1, 0.4, 0.4), CFrame.new(side * 0.3, 2.0, -0.7) * CFrame.Angles(math.rad(45), 0, math.rad(-side * 10)), orange)
	end
	for i = 0, 4 do
		ball(m, "Tail", Vector3.one * 0.24, Vector3.new(0, 1.0 + i * 0.22, 0.75 + math.sin(i * 0.6) * 0.15), if i == 4 then cream else orange)
	end
end

function BUILDERS.pet_bunny(m: Model)
	legs(m, WHITE, WHITE, 0.26, 0.38, 0.4)
	ball(m, "Body", Vector3.new(0.95, 0.9, 1.2), Vector3.new(0, 0.85, 0), WHITE)
	ball(m, "Head", Vector3.new(0.85, 0.8, 0.8), Vector3.new(0, 1.5, -0.55), WHITE)
	ball(m, "Nose", Vector3.new(0.12, 0.09, 0.09), Vector3.new(0, 1.42, -0.95), PINK)
	eyes(m, Vector3.new(0, 1.6, -0.9), 0.2, 0.15)
	for side = -1, 1, 2 do
		ball(m, "Ear", Vector3.new(0.24, 0.85, 0.14), Vector3.new(side * 0.18, 2.25, -0.5), WHITE)
		ball(m, "EarInside", Vector3.new(0.13, 0.6, 0.1), Vector3.new(side * 0.18, 2.25, -0.54), PINK)
	end
	ball(m, "Tail", Vector3.one * 0.35, Vector3.new(0, 0.95, 0.62), WHITE)
end

function BUILDERS.pet_dragon(m: Model)
	local purple, belly = rgb(140, 80, 220), rgb(255, 210, 120)
	legs(m, purple, purple, 0.3, 0.42, 0.5)
	ball(m, "Body", Vector3.new(1, 0.9, 1.4), Vector3.new(0, 0.95, 0), purple)
	ball(m, "Belly", Vector3.new(0.6, 0.6, 0.6), Vector3.new(0, 0.85, -0.45), belly)
	ball(m, "Head", Vector3.new(0.9, 0.8, 0.95), Vector3.new(0, 1.62, -0.8), purple)
	ball(m, "Snout", Vector3.new(0.55, 0.4, 0.5), Vector3.new(0, 1.48, -1.2), purple)
	eyes(m, Vector3.new(0, 1.78, -1.15), 0.22, 0.17)
	for side = -1, 1, 2 do
		part(m, "Horn", Vector3.new(0.12, 0.4, 0.12), CFrame.new(side * 0.22, 2.1, -0.7) * CFrame.Angles(math.rad(-20), 0, 0), belly)
		local wing = part(m, "Wing", Vector3.new(1.0, 0.06, 0.7), CFrame.new(side * 0.85, 1.45, 0.05) * CFrame.Angles(0, 0, math.rad(side * 30)), rgb(200, 150, 255))
		wing.Transparency = 0.1
	end
	for i = 0, 3 do
		ball(m, "Tail", Vector3.one * (0.34 - i * 0.05), Vector3.new(0, 0.85 - i * 0.08, 0.75 + i * 0.25), purple)
	end
end

function BUILDERS.pet_unicorn(m: Model)
	legs(m, WHITE, rgb(220, 200, 255), 0.32, 0.5, 0.7)
	ball(m, "Body", Vector3.new(1, 0.95, 1.6), Vector3.new(0, 1.15, 0), WHITE)
	part(m, "Neck", Vector3.new(0.5, 0.75, 0.5), CFrame.new(0, 1.7, -0.6) * CFrame.Angles(math.rad(-25), 0, 0), WHITE)
	ball(m, "Head", Vector3.new(0.7, 0.7, 0.95), Vector3.new(0, 2.12, -0.9), WHITE)
	eyes(m, Vector3.new(0, 2.22, -1.22), 0.22, 0.14)
	part(m, "Horn", Vector3.new(0.13, 0.55, 0.13), CFrame.new(0, 2.6, -1.0) * CFrame.Angles(math.rad(-15), 0, 0), GOLD, nil, Enum.Material.Neon)
	local mane = { rgb(255, 120, 170), rgb(255, 200, 90), rgb(120, 210, 255), rgb(190, 130, 255) }
	for i, c in mane do
		ball(m, "Mane", Vector3.one * 0.32, Vector3.new(0, 2.35 - i * 0.18, -0.65 + i * 0.12), c)
		ball(m, "Tail", Vector3.one * 0.3, Vector3.new(0, 1.3 - i * 0.15, 0.85 + i * 0.05), c)
	end
end

function BUILDERS.pet_dino(m: Model)
	local green, belly = rgb(90, 190, 90), rgb(240, 230, 140)
	for side = -1, 1, 2 do
		part(m, "Leg", Vector3.new(0.35, 0.6, 0.4), CFrame.new(side * 0.3, 0.3, 0.1), green)
	end
	ball(m, "Body", Vector3.new(1, 1.1, 1.3), Vector3.new(0, 1.0, 0), green)
	ball(m, "Belly", Vector3.new(0.6, 0.75, 0.4), Vector3.new(0, 0.95, -0.45), belly)
	ball(m, "Head", Vector3.new(0.85, 0.75, 1.0), Vector3.new(0, 1.8, -0.55), green)
	eyes(m, Vector3.new(0, 1.95, -0.95), 0.24, 0.16)
	for i = 0, 3 do
		part(m, "Spike", Vector3.new(0.08, 0.3, 0.3), CFrame.new(0, 2.15 - i * 0.28, -0.25 + i * 0.33) * CFrame.Angles(math.rad(45), 0, 0), rgb(255, 150, 60))
	end
	for i = 0, 3 do
		ball(m, "Tail", Vector3.one * (0.45 - i * 0.08), Vector3.new(0, 0.75 - i * 0.12, 0.65 + i * 0.3), green)
	end
	for side = -1, 1, 2 do
		ball(m, "Arm", Vector3.new(0.18, 0.18, 0.3), Vector3.new(side * 0.35, 1.25, -0.55), green)
	end
end

-- A fresh pet model, or nil for "no pet".
function Pets.build(petId: string?): Model?
	local builder = petId and BUILDERS[petId]
	if not builder then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "Pet"
	builder(model)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root
	return model
end

-- Trots `pet` beside `owner` (any model with a HumanoidRootPart), a little hop in each step.
-- Call every frame; dt is the frame time.
function Pets.follow(pet: Model, owner: Model, dt: number, side: number?)
	local root = owner:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) or not pet.PrimaryPart then
		return
	end
	local humanoid = owner:FindFirstChildOfClass("Humanoid")
	local feet = root.Position.Y - (if humanoid then humanoid.HipHeight + root.Size.Y / 2 else 3)
	local spot = root.CFrame * CFrame.new((side or 1) * 2.6, 0, 0.6)
	local goal = Vector3.new(spot.Position.X, feet, spot.Position.Z)
	local current = pet:GetPivot()
	local pos = current.Position:Lerp(goal, 1 - math.exp(-dt * 6))
	local moving = (goal - current.Position).Magnitude > 0.2
	local hop = if moving then math.abs(math.sin(os.clock() * 10)) * 0.35 else math.abs(math.sin(os.clock() * 2)) * 0.06
	local facing = root.CFrame.LookVector
	pet:PivotTo(CFrame.lookAt(Vector3.new(pos.X, feet + hop, pos.Z), Vector3.new(pos.X, feet + hop, pos.Z) + Vector3.new(facing.X, 0, facing.Z)))
end

return Pets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Progress</string>
          <string name="Source"><![CDATA[-- Stylist levels: stars earned in shows add up. Each level needs a few more stars than the last,
-- so there's always something to work toward.

local Progress = {}

local TITLES = {
	{ level = 1, title = "Newbie Stylist" },
	{ level = 3, title = "Rising Star" },
	{ level = 5, title = "Pro Stylist" },
	{ level = 8, title = "Glam Queen" },
	{ level = 12, title = "Superstar Stylist" },
	{ level = 20, title = "Legendary Stylist" },
}

-- Total stars needed to reach a level: Lv2 = 6, Lv3 = 14, Lv5 = 36, Lv10 = 126, Lv20 = 456
function Progress.starsFor(level: number): number
	return (level - 1) * (level + 4)
end

function Progress.level(totalStars: number): number
	local level = 1
	while Progress.starsFor(level + 1) <= (totalStars or 0) do
		level += 1
	end
	return level
end

function Progress.title(level: number): string
	local title = TITLES[1].title
	for _, t in TITLES do
		if level >= t.level then
			title = t.title
		end
	end
	return title
end

-- 0..1 progress toward the next level
function Progress.fraction(totalStars: number): number
	local level = Progress.level(totalStars)
	local from, to = Progress.starsFor(level), Progress.starsFor(level + 1)
	return ((totalStars or 0) - from) / (to - from)
end

return Progress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- All the messages the server and players send each other.
-- The server creates them; players wait for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"State", -- server -> all: round phase, timer, theme
	"AssignClient", -- server -> player: your new customer for this round
	"UpdateLook", -- player -> server: (lookKey, itemId)
	"WashProgress", -- player -> server: (clean 0..1, rinsed)
	"Done", -- player -> server: (isDone)
	"Showcase", -- server -> all: who is on the runway now
	"Vote", -- player -> server: (targetUserId, stars)
	"Results", -- server -> all: fashion show results
	"Profile", -- server -> player: coins, unlocked items, passes
	"Notify", -- server -> player: a little message
	"React", -- player -> server: cheer emoji during the fashion show
	"Reaction", -- server -> all: someone cheered (emoji)
	"Celebrate", -- server -> player: daily gift, level up
}

local FUNCTIONS = {
	"Hello", -- player -> server: returns everything a newly joined player needs
	"BuyItem", -- player -> server: unlock an item with coins
}

local Remotes = {}

local folder: Instance
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
	end
	for _, name in FUNCTIONS do
		local f = Instance.new("RemoteFunction")
		f.Name = name
		f.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in EVENTS do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end
for _, name in FUNCTIONS do
	Remotes[name] = folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Scoring</string>
          <string name="Source"><![CDATA[-- The judges! Gives a look 1-5 stars, says what they liked (or what to fix next time),
-- and finds an award for every look.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)

local Scoring = {}

export type Wish = { key: string, tag: string, text: string }

export type Entry = {
	look: { [string]: string },
	clean: number,
	rinsed: boolean,
	client: any, -- the client (for their wishes)
}

local MAKEUP_KEYS = { "eyeshadow", "lashes", "blush", "lipstick" }
-- Things that can match the theme. 4 matches = full theme points.
local THEME_SLOTS = {
	"hairStyle", "hairColor", "eyeshadow", "blush", "lipstick", "outfit", "accessory", "gems",
	"costumeBack", "costumeFace", "costumeWaist", "costumeShoulder", "pet", "pose", "effect",
}
-- The fun stuff that makes a runway walk a show
local SHOW_KEYS = { "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder", "pet", "pose", "effect" }
local THEME_MATCHES_NEEDED = 4

function Scoring.roundToHalf(stars: number): number
	return math.clamp(math.floor(stars * 2 + 0.5) / 2, 1, 5)
end

-- "Pink Party 🎀" -> "Pink Party"
function Scoring.themeWord(theme: Catalog.Theme): string
	return (string.gsub(theme.name, "%s*[^%w%s']+$", ""))
end

local function slotMatches(look, key: string, theme: Catalog.Theme): boolean
	if key == "outfit" then
		if Catalog.isNone(look.outfit) then
			return false -- work overalls never match, even recolored
		end
		-- a 🎨 custom color counts for the outfit too
		return Catalog.matchesTheme(Catalog.byId[look.outfit], theme) or Catalog.matchesTheme(Catalog.byId[look.outfitColor or ""], theme)
	end
	return Catalog.matchesTheme(Catalog.byId[look[key] or ""], theme)
end

-- How many parts of the look match the theme.
function Scoring.themeMatches(look, theme: Catalog.Theme): number
	local n = 0
	for _, key in THEME_SLOTS do
		if slotMatches(look, key, theme) then
			n += 1
		end
	end
	return n
end

function Scoring.wishMet(wish: Wish, look): boolean
	local it = Catalog.byId[look[wish.key] or ""]
	if not it or Catalog.isNone(it.id) then
		return false
	end
	if wish.tag == "any" then
		return true
	elseif wish.tag == "dress" then
		return it.dress == true
	end
	return Catalog.hasTag(it, wish.tag)
end

local function wishesMet(entry: Entry): (number, number)
	local wishes = entry.client and entry.client.wishes or {}
	local met = 0
	for _, w in wishes do
		if Scoring.wishMet(w, entry.look) then
			met += 1
		end
	end
	return met, #wishes
end

-- Returns stars (1..5, in half steps) and a list of judge comments.
function Scoring.judge(entry: Entry, theme: Catalog.Theme): (number, { string })
	local look = entry.look
	local points = 0
	local comments = {}

	-- The show (1 point): costume pieces, a pet, a pose, an effect
	local show = 0
	for _, key in SHOW_KEYS do
		if not Catalog.isNone(look[key]) then
			show += 1
		end
	end
	points += math.min(show, 4) / 4
	if show == 0 then
		table.insert(comments, "Add a costume, a pet or a pose to WOW the crowd! 🐶💃")
	elseif show >= 4 then
		table.insert(comments, "What a show! 🔥")
	end

	-- Hair, makeup, outfit (1.75 points for doing each part)
	if Catalog.isNone(look.hairStyle) then
		table.insert(comments, "Pick a hairstyle! 💇")
	else
		points += 0.5
	end
	local applied = 0
	for _, key in MAKEUP_KEYS do
		if not Catalog.isNone(look[key]) then
			applied += 1
		end
	end
	points += 0.75 * applied / #MAKEUP_KEYS
	if applied == 0 then
		table.insert(comments, "Don't forget the makeup! 💄")
	end
	if Catalog.isNone(look.outfit) then
		table.insert(comments, "Pick an outfit! 👗")
	else
		points += 0.5
	end

	-- Matching the theme (2.25 points): the more ⭐ items, the better
	local matches = Scoring.themeMatches(look, theme)
	points += 2.25 * math.min(matches, THEME_MATCHES_NEEDED) / THEME_MATCHES_NEEDED
	local word = Scoring.themeWord(theme)
	if matches >= THEME_MATCHES_NEEDED then
		table.insert(comments, "That's SO " .. word .. "! ⭐")
	elseif matches >= 2 then
		table.insert(comments, "Pretty! Pick more ⭐ " .. word .. " things!")
	else
		table.insert(comments, "Look for the ⭐ items to match " .. word .. "!")
	end

	-- The client's wishes (bonus)
	local met, total = wishesMet(entry)
	points += 0.25 * met
	if total > 0 and met == total then
		table.insert(comments, "You made their wishes come true! 💌")
	end

	-- Little extras (bonus)
	if not Catalog.isNone(look.gems) then
		points += 0.1
	end
	if not Catalog.isNone(look.accessory) then
		points += 0.1
	end

	local stars = Scoring.roundToHalf(points)
	if stars >= 4.5 then
		table.insert(comments, 1, "ABSOLUTELY STUNNING! 😍")
	elseif stars >= 3.5 then
		table.insert(comments, 1, "Looking great!")
	end
	return stars, comments
end

-- How the client feels about their look (used to draw their mouth).
function Scoring.mood(stars: number, clean: number): string
	if clean < 0.5 then
		return "sad"
	elseif stars < 2.5 then
		return "neutral"
	elseif stars < 4 then
		return "smile"
	end
	return "grin"
end

-- Mixes the judges' stars with the other players' votes (half and half).
function Scoring.final(judgeStars: number, votes: { number }): number
	if #votes == 0 then
		return judgeStars
	end
	local total = 0
	for _, v in votes do
		total += v
	end
	return (judgeStars + total / #votes) / 2
end

------------------------------------------------------------------------------
-- Awards: every look gets one, so every kid wins something

Scoring.AWARDS = {
	{ id = "theme", emoji = "⭐" }, -- named "Most <theme>"
	{ id = "costume", name = "Best Costume", emoji = "🎭" },
	{ id = "pet", name = "Best Buddy", emoji = "🐶" },
	{ id = "show", name = "Showstopper", emoji = "🔥" },
	{ id = "hair", name = "Best Hair", emoji = "💇" },
	{ id = "makeup", name = "Makeup Star", emoji = "💄" },
	{ id = "sparkle", name = "Sparkliest", emoji = "✨" },
	{ id = "colorful", name = "Most Colorful", emoji = "🌈" },
	{ id = "extras", name = "Cutest Extras", emoji = "🎀" },
}
Scoring.FALLBACK_AWARD = { id = "star", name = "Super Stylist", emoji = "💖" }

function Scoring.awardName(awardId: string, theme: Catalog.Theme): string
	for _, a in Scoring.AWARDS do
		if a.id == awardId then
			return a.emoji .. " " .. (a.name or ("Most " .. Scoring.themeWord(theme)))
		end
	end
	return Scoring.FALLBACK_AWARD.emoji .. " " .. Scoring.FALLBACK_AWARD.name
end

-- How strongly this look deserves each award (0 = not at all).
function Scoring.awardScores(entry: Entry, theme: Catalog.Theme): { [string]: number }
	local look = entry.look
	local function has(key)
		return not Catalog.isNone(look[key])
	end
	local sparkles, distinct = 0, 0
	for _, key in THEME_SLOTS do
		local it = Catalog.byId[look[key] or ""]
		if it and not Catalog.isNone(it.id) then
			distinct += 1
			if it.sparkle or Catalog.hasTag(it, "sparkle") then
				sparkles += 1
			end
		end
	end
	local applied = 0
	for _, key in MAKEUP_KEYS do
		if has(key) then
			applied += 1
		end
	end
	local costume = 0
	for _, key in { "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder" } do
		if has(key) then
			costume += 1
		end
	end
	return {
		theme = Scoring.themeMatches(look, theme) / THEME_MATCHES_NEEDED,
		costume = math.min(costume / 2, 1),
		pet = if has("pet") then 0.8 else 0,
		show = (if has("pose") then 0.4 else 0) + (if has("effect") then 0.4 else 0),
		hair = (if has("hairStyle") then 0.5 else 0) + (if slotMatches(look, "hairColor", theme) then 0.3 else 0) + (if has("accessory") then 0.1 else 0),
		makeup = applied / #MAKEUP_KEYS,
		sparkle = math.min(sparkles / 3, 1),
		colorful = distinct / #THEME_SLOTS,
		extras = (if has("accessory") then 0.5 else 0) + (if has("gems") then 0.4 else 0),
	}
end

return Scoring
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Saves each player's coins, unlocked items and Super Soaps between visits.

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = {}

export type Profile = {
	coins: number,
	owned: { [string]: boolean },
	stats: { shows: number, wins: number, bestStars: number, totalStars: number },
	lastDay: number, -- last day a daily gift was given (days since 1970)
	streak: number, -- days played in total (the gift calendar never resets)
	giftsGiven: number, -- day-7 accessories collected
	friends: { [string]: { visits: number, skin: number, eyes: number } }, -- regular clients
	lookbook: { any }, -- saved finished looks, newest first
	week: number, -- which week the weekly goal counts (weeks since 1970)
	weekShows: number,
	weekClaimed: boolean,
	weeklyGiven: number, -- weekly prizes collected
	lookbookChanged: boolean?, -- not saved: send the Look Book with the next push
	lookbookSent: boolean?, -- not saved: the player has the Look Book already
	receipts: { string },
	passes: { [string]: boolean }, -- not saved; checked with Roblox every visit
	canSave: boolean, -- false if loading failed, so we never overwrite good data with an empty profile
}

local profiles: { [Player]: Profile } = {}

-- While a server has a player's data open it stamps it with its JobId, so a second server
-- (e.g. the player quickly hopped servers) waits instead of loading old coins.
local LOCK_SECONDS = Config.AUTOSAVE_SECONDS + 60

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[GlowUp] Saving is off (turn on 'Enable Studio Access to API Services' to test it):", result)
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function newProfile(saved): Profile
	saved = saved or {}
	local stats = saved.stats or {}
	return {
		coins = tonumber(saved.coins) or Config.STARTING_COINS,
		owned = saved.owned or {},
		stats = {
			shows = stats.shows or 0,
			wins = stats.wins or 0,
			bestStars = stats.bestStars or 0,
			totalStars = stats.totalStars or 0,
		},
		lastDay = tonumber(saved.lastDay) or 0,
		streak = tonumber(saved.streak) or 0,
		giftsGiven = tonumber(saved.giftsGiven) or 0,
		friends = saved.friends or {},
		lookbook = saved.lookbook or {},
		week = tonumber(saved.week) or 0,
		weekShows = tonumber(saved.weekShows) or 0,
		weekClaimed = saved.weekClaimed == true,
		weeklyGiven = tonumber(saved.weeklyGiven) or 0,
		receipts = saved.receipts or {},
		passes = {},
		canSave = true,
	}
end

local function checkPasses(player: Player, profile: Profile)
	for name, id in Config.GamePasses do
		if RunService:IsStudio() and Config.STUDIO_OWNS_ALL_PASSES then
			profile.passes[name] = true
		elseif id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			profile.passes[name] = ok and owns == true
		end
	end
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

-- Waits (a little) for a player's data to finish loading.
function DataService.waitFor(player: Player): Profile?
	local deadline = os.clock() + 15
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Sends the player's latest coins/unlocks to their screen.
function DataService.push(player: Player)
	local p = profiles[player]
	if p then
		Remotes.Profile:FireClient(player, {
			coins = p.coins,
			owned = p.owned,
			passes = p.passes,
			totalStars = p.stats.totalStars,
			calendarDay = p.streak,
			-- the Look Book is only sent when it changed (it's the biggest part)
			lookbook = if p.lookbookChanged or not p.lookbookSent then p.lookbook else nil,
			weekShows = if p.week == DataService.weekNumber() then p.weekShows else 0,
			weekClaimed = p.week == DataService.weekNumber() and p.weekClaimed,
			weeklyNext = Catalog.WeeklyItems[p.weeklyGiven + 1],
		})
		p.lookbookChanged = false
		p.lookbookSent = true
	end
end

function DataService.addCoins(player: Player, amount: number)
	local p = profiles[player]
	if amount ~= amount or math.abs(amount) == math.huge then
		return
	end
	if p then
		p.coins = math.max(0, p.coins + math.floor(amount))
		DataService.push(player)
	end
end

-- True when coins and unlocks are really being saved (false in Studio without API access).
function DataService.savingEnabled(): boolean
	return store ~= nil
end

local function lockedByOtherServer(old): boolean
	return old ~= nil and old.session ~= nil and old.session ~= game.JobId and os.time() - (old.lockTime or 0) < LOCK_SECONDS
end

-- Saves a player's data. `release` clears this server's lock (when the player leaves).
function DataService.save(player: Player, release: boolean?): boolean
	local p = profiles[player]
	if not p or not p.canSave or not store then
		return false
	end
	for attempt = 1, 3 do
		local wrote = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOtherServer(old) then
					return nil -- another server has newer data; don't overwrite it
				end
				wrote = true
				-- Built here (not before the loop) so a retry always saves the newest values
				return {
					coins = p.coins,
					owned = p.owned,
							stats = p.stats,
					receipts = p.receipts,
					lastDay = p.lastDay,
					streak = p.streak,
					giftsGiven = p.giftsGiven,
					friends = p.friends,
					lookbook = p.lookbook,
					week = p.week,
					weekShows = p.weekShows,
					weekClaimed = p.weekClaimed,
					weeklyGiven = p.weeklyGiven,
					session = if release then nil else game.JobId,
					lockTime = os.time(),
				}
			end)
		end)
		if ok then
			if not wrote then
				warn("[GlowUp] Not saving " .. player.Name .. ": their data is open on another server")
			end
			return wrote
		end
		warn("[GlowUp] Save failed (try " .. attempt .. "):", err)
		task.wait(attempt)
	end
	return false
end

-- Days and weeks change at 05:00 UTC (midnight in New York, 9pm in Los Angeles) so most kids
-- in the US get a new day in the morning. Weeks start on Monday.
local DAY_OFFSET = 5 * 3600
function DataService.dayNumber(): number
	return (os.time() - DAY_OFFSET) // 86400
end
function DataService.weekNumber(): number
	return (os.time() - DAY_OFFSET + 3 * 86400) // 604800
end

-- The daily gift calendar: a prize for each new day played. Missing a day just pauses it.
local function giveDailyGift(player: Player, profile: Profile)
	local today = DataService.dayNumber()
	if profile.lastDay >= today then
		return
	end
	profile.lastDay = today
	profile.streak += 1
	local day = (profile.streak - 1) % 7 + 1
	local info = { kind = "daily", day = day, coins = 0, item = nil :: string? }
	if day < 7 then
		info.coins = Config.CALENDAR_COINS[day]
	else
		local giftId = Catalog.GiftItems[profile.giftsGiven + 1]
		if giftId then
			profile.giftsGiven += 1
			profile.owned[giftId] = true
			info.item = Catalog.byId[giftId].name
		else
			info.coins = Config.CALENDAR_DAY7_COINS
		end
	end
	profile.coins += info.coins
	task.delay(3, function()
		if player.Parent then
			Remotes.Celebrate:FireClient(player, info)
			DataService.push(player)
		end
	end)
end

-- Called at the start of each round for players who stayed past midnight.
function DataService.checkDaily(player: Player)
	local profile = profiles[player]
	if profile then
		giveDailyGift(player, profile)
	end
end

local function load(player: Player)
	local saved = nil
	local loaded = store == nil -- no store (e.g. Studio without API access): play with a fresh profile
	if store then
		for attempt = 1, 8 do
			local claimed = false
			local ok, result = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					-- After ~20 seconds of waiting, take over a lock that was never released
					if lockedByOtherServer(old) and attempt < 8 then
						saved = old
						return nil
					end
					claimed = true
					saved = old
					local new = old or {}
					new.session = game.JobId
					new.lockTime = os.time()
					return new
				end)
			end)
			if ok and claimed then
				loaded = true
				break
			end
			if not ok and RunService:IsStudio() then
				-- Usually "Enable Studio Access to API Services" is off. Play without saving.
				warn("[GlowUp] Saving is off in Studio:", result)
				store = nil
				loaded = true
				saved = nil
				break
			end
			if not ok then
				warn("[GlowUp] Load failed (try " .. attempt .. "):", result)
			end
			task.wait(3)
		end
	end
	if not player.Parent then
		return
	end

	local profile = newProfile(saved)
	profile.canSave = loaded and store ~= nil
	if not loaded then
		Remotes.Notify:FireClient(player, "Couldn't load your saved coins. Progress this visit won't be saved.")
	end
	checkPasses(player, profile)
	giveDailyGift(player, profile)
	profiles[player] = profile
	DataService.push(player)
end

function DataService.init()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player, true)
		profiles[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Starts the game on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local RoundService = require(script.Parent.RoundService)
local ShopService = require(script.Parent.ShopService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local world = WorldBuilder.build()
task.spawn(Avatar.preload) -- the clients' bodies and hair, for the makeover, runway and podium

DataService.init()
ShopService.init()
RoundService.init(world)

Remotes.Hello.OnServerInvoke = function(player: Player)
	local snapshot = RoundService.snapshot(player)
	DataService.push(player)
	return snapshot
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- Runs the game loop that everyone in the server plays together:
--   Intermission -> Makeover (5 minutes) -> Fashion Show -> Results -> repeat

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Clients = require(ReplicatedStorage.Shared.Clients)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Progress = require(ReplicatedStorage.Shared.Progress)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Scoring = require(ReplicatedStorage.Shared.Scoring)

local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local RoundService = {}

type Entry = {
	player: Player,
	client: Clients.Client,
	look: { [string]: string },
	clean: number,
	rinsed: boolean,
	done: boolean,
	votes: { [number]: number }, -- voter UserId -> stars
	assignedAt: number,
}

local world: WorldBuilder.World
local rng = Random.new()

local state = {
	phase = "Waiting",
	endsAt = 0,
	themeId = Catalog.Themes[1].id,
	eventId = nil :: string?,
}
local entries: { [number]: Entry } = {} -- by UserId
local showcase = nil -- payload of the look currently on the runway
local results = nil -- payload of the last results
local spawnedModels: { Model } = {}
local resultsFor, sendResults -- defined below
local decorated = false

local WALK_ANIMATION = "rbxassetid://507777826" -- Roblox's default R15 walk
local REACTIONS = { ["😍"] = true, ["👏"] = true, ["🔥"] = true, ["✨"] = true, ["💖"] = true }
local lastReaction: { [Player]: number } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function setState(phase: string, seconds: number)
	state.phase = phase
	state.endsAt = now() + seconds
	Remotes.State:FireAllClients(state)
end

local function theme(): Catalog.Theme
	return Catalog.themeById[state.themeId]
end

local function entryPayload(entry: Entry)
	return {
		client = entry.client,
		look = entry.look,
		clean = entry.clean,
		rinsed = entry.rinsed,
		done = entry.done,
	}
end

local function hasPass(player: Player, pass: string): boolean
	local profile = DataService.get(player)
	return profile ~= nil and profile.passes[pass] == true
end

------------------------------------------------------------------------------
-- Makeover

-- Each player dresses up themselves: their name, and the skin tone closest to their own avatar.
local function assignClient(player: Player)
	local skinId = "skin_7"
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		skinId = Catalog.closestSkin(head.Color)
	end
	local look = Catalog.defaultLook()
	look.skin = skinId
	local entry: Entry = {
		player = player,
		client = Clients.forPlayer(player.DisplayName, tonumber(string.match(skinId, "%d+")) or 7),
		look = look,
		clean = 1, -- no washing: you come in fresh
		rinsed = true,
		done = false,
		votes = {},
		assignedAt = now(),
	}
	entries[player.UserId] = entry
	Remotes.AssignClient:FireClient(player, entryPayload(entry))
end

local function activeEntry(player: Player): Entry?
	if state.phase ~= "Makeover" then
		return nil
	end
	return entries[player.UserId]
end

local function allDone(): boolean
	local any = false
	for _, entry in entries do
		if entry.player.Parent then
			any = true
			if not entry.done then
				return false
			end
		end
	end
	return any
end

local function onUpdateLook(player: Player, key: unknown, itemId: unknown)
	local entry = activeEntry(player)
	if not entry or type(key) ~= "string" or type(itemId) ~= "string" then
		return
	end
	local it = Catalog.byId[itemId]
	if not it or it.category ~= key then
		return
	end
	if not Catalog.isUnlocked(it, DataService.get(player), state.eventId) then
		Remotes.Notify:FireClient(player, "Unlock " .. it.name .. " in the shop first!")
		return
	end
	entry.look[key] = itemId
	-- Holiday items you used during the event are yours to keep afterwards
	if it.event then
		local profile = DataService.get(player)
		if profile and not profile.owned[it.id] then
			profile.owned[it.id] = true
		end
	end
end

local function onWashProgress(player: Player, clean: unknown, rinsed: unknown)
	local entry = activeEntry(player)
	if not entry or type(clean) ~= "number" or clean ~= clean then
		return
	end
	-- Nobody can really wash a face in under 4 seconds, so don't trust faster claims
	local possible = (now() - entry.assignedAt) / 4
	entry.clean = math.max(entry.clean, math.min(math.clamp(clean, 0, 1), possible))
	entry.rinsed = rinsed == true
end

local function onDone(player: Player, isDone: unknown)
	local entry = activeEntry(player)
	if entry then
		entry.done = isDone == true
	end
end

------------------------------------------------------------------------------
-- Runway models

local function buildBlockModel(skin: Color3, top: Color3, bottom: Color3): Model
	local model = Instance.new("Model")
	local function block(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.CanCollide = false
		p.CFrame = CFrame.new(offset)
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), top)
	root.Transparency = 1
	local parts = {
		block("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), top),
		block("LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), bottom),
		block("RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), bottom),
		block("LeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), skin),
		block("RightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), skin),
		block("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), skin),
	}
	for _, p in parts do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
	end
	model.PrimaryPart = root
	return model
end

local function rootHeight(model: Model): number
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return 3
end

-- Makes the 3D client wearing the look the stylist designed: a real Roblox character with
-- their hair, makeup face, outfit and accessory.
local function buildClientModel(entry: Entry): Model
	local stars = Scoring.judge(entry, theme())
	local model = Avatar.new(entry.client)
	if model then
		-- everyone sees the client washed and happy; the judges' tips stay private
		Avatar.dress(model, entry.client, entry.look, {
			clean = 1,
			mood = if stars >= 4 then "grin" else "smile",
			brushed = entry.look.hairStyle ~= "hair_messy",
		})
	else
		local outfit = Catalog.byId[entry.look.outfit]
		local top = if outfit and outfit.color then outfit.color else Color3.new(0.5, 0.5, 0.5)
		model = buildBlockModel(entry.client.skin, top, outfit and outfit.accent or top)
	end
	model.Name = entry.client.name
	model:SetAttribute("Pet", entry.look.pet) -- each screen walks the pet alongside (Showcase)

	-- a little trail of stars behind every look, and the player's name over their head
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local tag = Instance.new("BillboardGui")
		tag.Name = "NameTag"
		tag.Size = UDim2.fromScale(6, 1)
		tag.StudsOffset = Vector3.new(0, 3.2, 0)
		tag.LightInfluence = 0
		tag.MaxDistance = 120
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.Text = entry.client.name
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(176, 18, 91)
		label.TextStrokeColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.Parent = tag
		tag.Parent = head
	end
	if root then
		local trail = Instance.new("ParticleEmitter")
		trail.Name = "StarTrail"
		trail.Texture = Config.Textures.Star
		trail.Rate = 8
		trail.Lifetime = NumberRange.new(1, 1.6)
		trail.Speed = NumberRange.new(1, 2)
		trail.SpreadAngle = Vector2.new(180, 180)
		trail.Size = NumberSequence.new(0.5, 0)
		trail.LightEmission = 0.6
		trail.Color = ColorSequence.new(theme().color, Color3.new(1, 1, 1))
		trail.Parent = root
	end

	if root and hasPass(entry.player, "RunwayStar") then
		Instance.new("Sparkles").Parent = root
	end

	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
		end
	end
	model.Parent = world.folder
	table.insert(spawnedModels, model)
	return model
end


local function placeModel(model: Model, groundPosition: Vector3, facing: Vector3): BasePart
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	local pos = groundPosition + Vector3.new(0, rootHeight(model), 0)
	root.CFrame = CFrame.lookAt(pos, pos + facing)
	return root
end

local function playWalk(model: Model): AnimationTrack?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = WALK_ANIMATION
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track:Play()
		return track
	end
	return nil
end

local function clearModels()
	for _, m in spawnedModels do
		m:Destroy()
	end
	table.clear(spawnedModels)
end

local function walkRunway(entry: Entry)
	local model = buildClientModel(entry)
	model:SetAttribute("Walking", true) -- the runway camera follows this model
	local root = placeModel(model, world.runwayStart, Vector3.new(0, 0, 1))
	local walk = playWalk(model)

	if hasPass(entry.player, "RunwayStar") then
		for _, emitter in world.confetti do
			emitter:Emit(80)
		end
	end

	-- Each player's screen moves the model smoothly from these attributes (moving an anchored
	-- part from the server looks jerky). See Showcase:updateWalkers on the client.
	local walkTime = Config.SHOWCASE_SECONDS_PER_LOOK * 0.6
	local target = world.runwayEnd + Vector3.new(0, rootHeight(model), 0)
	model:SetAttribute("WalkFrom", root.Position)
	model:SetAttribute("WalkTo", target)
	model:SetAttribute("WalkStart", now())
	model:SetAttribute("WalkTime", walkTime)
	task.wait(walkTime)
	if walk then
		walk:Stop()
	end
	task.wait(1) -- the twirl at the end of the runway
	if root.Parent then
		root.CFrame = CFrame.lookAt(target, target + Vector3.new(0, 0, 1))
		Avatar.pose(model, entry.look.pose) -- then strike their pose
	end
end

------------------------------------------------------------------------------
-- Voting

local function onVote(player: Player, targetUserId: unknown, stars: unknown)
	if state.phase ~= "Showcase" or not showcase or showcase.userId ~= targetUserId then
		return
	end
	-- Votes are kind: only 3, 4 or 5 stars (this also rejects NaN, which would break scores and coins)
	if player.UserId == targetUserId or type(stars) ~= "number" or not (stars >= 3 and stars <= 5) or stars % 1 ~= 0 then
		return
	end
	local entry = entries[targetUserId :: number]
	if not entry then
		return
	end
	local firstVote = entry.votes[player.UserId] == nil
	entry.votes[player.UserId] = stars
	if firstVote then
		DataService.addCoins(player, Config.COINS_PER_VOTE)
	end
end

local function onReact(player: Player, emoji: unknown)
	if state.phase ~= "Showcase" and state.phase ~= "Results" then
		return
	end
	if type(emoji) ~= "string" or not REACTIONS[emoji] then
		return
	end
	local t = os.clock()
	if lastReaction[player] and t - lastReaction[player] < 0.35 then
		return
	end
	lastReaction[player] = t
	Remotes.Reaction:FireAllClients(emoji)
end

------------------------------------------------------------------------------
-- Results

local function scoreAll()
	local rows = {}
	local count = 0
	for userId, entry in entries do
		if entry.player.Parent then
			count += 1
			local judgeStars, comments = Scoring.judge(entry, theme())
			local votes = {}
			for _, v in entry.votes do
				table.insert(votes, v)
			end
			local final = Scoring.final(judgeStars, votes)
			table.insert(rows, {
				userId = userId,
				stylist = entry.player.DisplayName,
				client = entry.client,
				look = entry.look,
				clean = entry.clean,
				judgeStars = judgeStars,
				voteCount = #votes,
				score = final,
				stars = Scoring.roundToHalf(final),
				comments = comments,
				coins = 0,
				spotless = entry.clean >= 0.98 and entry.rinsed,
			})
		end
	end
	table.sort(rows, function(a, b)
		return a.score > b.score
	end)

	-- Everyone gets a different award (best scorers pick first)
	local taken = {}
	for _, row in rows do
		local entry = entries[row.userId]
		local scores = Scoring.awardScores(entry, theme())
		local best, bestScore = nil, 0.2
		for _, award in Scoring.AWARDS do
			local score = scores[award.id] or 0
			if not taken[award.id] and score > bestScore then
				best, bestScore = award.id, score
			end
		end
		if best then
			taken[best] = true
		end
		row.award = Scoring.awardName(best or Scoring.FALLBACK_AWARD.id, theme())
	end

	for rank, row in rows do
		row.rank = rank
		local player = entries[row.userId].player
		local coins = Config.COINS_PARTICIPATION + math.floor(row.score * Config.COINS_PER_STAR)
		if row.spotless then
			coins += Config.COINS_SPOTLESS_BONUS
		end
		-- coins for each wish the client got
		for _, w in entries[row.userId].client.wishes do
			if Scoring.wishMet(w, entries[row.userId].look) then
				coins += Config.COINS_PER_WISH
			end
		end
		if count >= 2 and Config.COINS_PLACEMENT[rank] then
			coins += Config.COINS_PLACEMENT[rank]
		end
		if hasPass(player, "DoubleCoins") then
			coins *= 2
		end
		row.coins = coins
		DataService.addCoins(player, coins)

		local profile = DataService.get(player)
		if profile then
			local oldLevel = Progress.level(profile.stats.totalStars)
			profile.stats.shows += 1
			profile.stats.totalStars += row.stars
			profile.stats.bestStars = math.max(profile.stats.bestStars, row.stars)
			if rank == 1 and count >= 2 then
				profile.stats.wins += 1
			end
			local newLevel = Progress.level(profile.stats.totalStars)
			row.level = newLevel

			local entry = entries[row.userId]
			local client = entry.client

			-- Idle players (nothing changed) don't fill the Look Book or the weekly goal
			local default = Catalog.defaultLook()
			local touched = false
			for k, v in entry.look do
				if default[k] ~= v then
					touched = true
				end
			end

			-- Weekly goal: play a few shows this week for a prize
			local week = DataService.weekNumber()
			if profile.week ~= week then
				profile.week, profile.weekShows, profile.weekClaimed = week, 0, false
			end
			if touched then
				profile.weekShows += 1
			end
			if profile.weekShows >= Config.WEEKLY_GOAL_SHOWS and not profile.weekClaimed then
				profile.weekClaimed = true
				local prizeId = Catalog.WeeklyItems[profile.weeklyGiven + 1]
				local info = { kind = "weekly", coins = 0, item = nil :: string? }
				if prizeId then
					profile.weeklyGiven += 1
					profile.owned[prizeId] = true
					info.item = Catalog.byId[prizeId].name
				else
					info.coins = Config.WEEKLY_GOAL_COINS
					profile.coins += info.coins
				end
				task.delay(8, function()
					if player.Parent then
						Remotes.Celebrate:FireClient(player, info)
					end
				end)
			end

			-- Save the look in the Look Book (newest first)
			table.insert(profile.lookbook, if touched then 1 else #profile.lookbook + 1, {
				name = client.name,
				skin = client.skinIndex,
				eyes = client.eyesIndex,
				look = table.clone(entry.look),
				theme = state.themeId,
				stars = row.stars,
				award = row.award,
			})
			if not touched then
				table.remove(profile.lookbook) -- don't keep untouched looks
			end
			while #profile.lookbook > Config.LOOKBOOK_SIZE do
				table.remove(profile.lookbook)
			end
			profile.lookbookChanged = true
			if newLevel > oldLevel then
				task.delay(4, function()
					if player.Parent then
						Remotes.Celebrate:FireClient(player, { kind = "level", level = newLevel, title = Progress.title(newLevel) })
					end
				end)
			end
			DataService.push(player)
		end
	end
	return rows
end

-- Each player gets the results with only their OWN judge tips (the others' stay private).
function resultsFor(player: Player, all)
	local rows = {}
	for _, row in all.rows do
		local copy = table.clone(row)
		if row.userId ~= player.UserId then
			copy.comments = {}
		end
		table.insert(rows, copy)
	end
	return { themeId = all.themeId, rows = rows }
end

function sendResults()
	for _, player in Players:GetPlayers() do
		Remotes.Results:FireClient(player, resultsFor(player, results))
	end
end

------------------------------------------------------------------------------
-- Main loop

local function runRound()
	-- Intermission
	results = nil
	showcase = nil
	table.clear(entries)
	while #Players:GetPlayers() < Config.MIN_PLAYERS do
		setState("Waiting", 0)
		task.wait(2)
	end
	-- A new day may have started for players who stayed in the game
	for _, player in Players:GetPlayers() do
		DataService.checkDaily(player)
	end

	-- Holiday events: switch decorations, and use the holiday theme about half the time
	local event = Events.current(now())
	local eventId = event and event.id or nil
	if eventId ~= state.eventId or not decorated then
		state.eventId = eventId
		decorated = true
		WorldBuilder.setDecor(eventId)
	end
	if event and rng:NextNumber() < Config.EVENT_THEME_CHANCE then
		state.themeId = event.theme
	else
		local everyday = {}
		for _, t in Catalog.Themes do
			if not t.event then
				table.insert(everyday, t.id)
			end
		end
		state.themeId = everyday[rng:NextInteger(1, #everyday)]
	end
	setState("Intermission", Config.INTERMISSION_SECONDS)
	task.wait(Config.INTERMISSION_SECONDS)

	-- Makeover: 5 minutes!
	for _, player in Players:GetPlayers() do
		assignClient(player)
	end
	setState("Makeover", Config.MAKEOVER_SECONDS)
	while now() < state.endsAt do
		task.wait(0.5)
		if allDone() then
			break
		end
	end

	-- Fashion show
	local order = {}
	for _, entry in entries do
		table.insert(order, entry)
	end
	rng:Shuffle(order)
	local index = 0
	for _, entry in order do
		if entry.player.Parent then
			index += 1
			local total = 0
			for _, e in order do
				if e.player.Parent then
					total += 1
				end
			end
			showcase = {
				userId = entry.player.UserId,
				stylist = entry.player.DisplayName,
				vip = hasPass(entry.player, "VIP"),
				level = Progress.level((DataService.get(entry.player) or { stats = { totalStars = 0 } }).stats.totalStars),
				client = entry.client,
				look = entry.look,
				clean = 1, -- shown tidy on the big screen
				index = index,
				total = math.max(total, index),
			}
			setState("Showcase", Config.SHOWCASE_SECONDS_PER_LOOK)
			Remotes.Showcase:FireAllClients(showcase)
			local started = os.clock()
			walkRunway(entry)
			task.wait(math.max(0, Config.SHOWCASE_SECONDS_PER_LOOK - (os.clock() - started)))
			clearModels()
		end
	end
	showcase = nil

	-- Results
	local rows = scoreAll()
	if #rows > 0 then
		results = { themeId = state.themeId, rows = rows }
		sendResults()
		setState("Results", Config.RESULTS_SECONDS)
		for place = 1, math.min(3, #rows) do
			local entry = entries[rows[place].userId]
			if entry then
				local model = buildClientModel(entry)
				placeModel(model, world.podium[place], Vector3.new(0, 0, 1))
				Avatar.idle(model)
			end
		end
		task.wait(Config.RESULTS_SECONDS)
		clearModels()
	end
end

-- Everything a player needs when they join or their screen restarts.
function RoundService.snapshot(player: Player)
	local entry = entries[player.UserId]
	return {
		state = state,
		entry = if entry and state.phase == "Makeover" then entryPayload(entry) else nil,
		showcase = if state.phase == "Showcase" then showcase else nil,
		results = if state.phase == "Results" and results then resultsFor(player, results) else nil,
	}
end

function RoundService.init(builtWorld: WorldBuilder.World)
	world = builtWorld

	Remotes.UpdateLook.OnServerEvent:Connect(onUpdateLook)
	Remotes.WashProgress.OnServerEvent:Connect(onWashProgress)
	Remotes.Done.OnServerEvent:Connect(onDone)
	Remotes.Vote.OnServerEvent:Connect(onVote)
	Remotes.React.OnServerEvent:Connect(onReact)

	-- Late joiners still get a client if a makeover is running
	Players.PlayerAdded:Connect(function(player)
		if state.phase == "Makeover" and not entries[player.UserId] then
			DataService.waitFor(player)
			if state.phase == "Makeover" and player.Parent then
				assignClient(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		entries[player.UserId] = nil
		lastReaction[player] = nil
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(runRound)
			if not ok then
				warn("[GlowUp] Round error:", err)
				clearModels()
				task.wait(3)
			end
		end
	end)
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Unlocking items with coins, plus Robux Game Passes and Developer Products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

local MAX_RECEIPTS = 50

local function buyItem(player: Player, itemId: unknown): (boolean, string)
	if type(itemId) ~= "string" then
		return false, "That item doesn't exist."
	end
	local profile = DataService.get(player)
	local it = Catalog.byId[itemId]
	if not profile or not it or it.hidden or it.pass or it.price <= 0 then
		return false, "That item can't be bought with coins."
	end
	if profile.owned[it.id] then
		return true, "You already have " .. it.name .. "!"
	end
	local event = Events.current(Workspace:GetServerTimeNow())
	if not Catalog.isAvailable(it, profile, event and event.id) then
		return false, it.name .. " is only here during its holiday event."
	end
	if profile.coins < it.price then
		return false, "You need " .. (it.price - profile.coins) .. " more coins."
	end
	profile.coins -= it.price
	profile.owned[it.id] = true
	DataService.push(player)
	return true, "Unlocked " .. it.name .. "! ✨"
end

local function productName(productId: number): string?
	for name, id in Config.DevProducts do
		if id ~= 0 and id == productId then
			return name
		end
	end
	return nil
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local profile = player and DataService.get(player)
	if not player or not profile then
		-- They left or their data isn't loaded yet; Roblox will try again next time they join.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(profile.receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if not profile.canSave and DataService.savingEnabled() then
		-- Their saved data didn't load, so we couldn't keep this purchase. Roblox will retry next visit.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local name = productName(receipt.ProductId)
	if name and Config.CoinPackAmounts[name] then
		profile.coins += Config.CoinPackAmounts[name]
		Remotes.Notify:FireClient(player, "+" .. Config.CoinPackAmounts[name] .. " coins! 💰")
	else
		warn("[GlowUp] Unknown product purchased:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(profile.receipts, receipt.PurchaseId)
	while #profile.receipts > MAX_RECEIPTS do
		table.remove(profile.receipts, 1)
	end
	DataService.push(player)

	-- Only confirm the purchase once it's safely saved (or saving is off in Studio).
	if profile.canSave and not DataService.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.init()
	Remotes.BuyItem.OnServerInvoke = buyItem
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local profile = DataService.get(player)
		if not profile then
			return
		end
		for name, id in Config.GamePasses do
			if id == passId then
				profile.passes[name] = true
				Remotes.Notify:FireClient(player, "Thank you! Your Game Pass is ready to use! 💖")
			end
		end
		DataService.push(player)
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- Builds the salon, runway, big screen, audience seats and winners' podium when the game starts.
-- Building with code means the place works straight away; you can still decorate around it in Studio.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}

export type World = {
	folder: Folder,
	screen: BasePart,
	runwayStart: Vector3, -- runway floor height where clients start walking
	runwayEnd: Vector3,
	podium: { Vector3 }, -- top of 1st, 2nd, 3rd place blocks
	confetti: { ParticleEmitter },
}

local rgb = Color3.fromRGB
local PINK = rgb(255, 120, 190)
local PURPLE = rgb(150, 90, 220)
local GOLD = rgb(245, 200, 70)

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function sign(p: BasePart, face: Enum.NormalId, text: string, textColor: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = textColor
	label.Parent = gui
	gui.Parent = p
end

local function ball(parent: Instance, name: string, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): Part
	local p = part(parent, name, Vector3.new(diameter, diameter, diameter), CFrame.new(position), color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

local function plant(parent: Instance, position: Vector3)
	local pot = part(parent, "Pot", Vector3.new(2.4, 2.6, 2.6), CFrame.new(position + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 255, 255))
	pot.Shape = Enum.PartType.Cylinder
	ball(parent, "Leaves", 4, position + Vector3.new(0, 4, 0), rgb(110, 200, 120), Enum.Material.Grass)
	ball(parent, "Flower", 1, position + Vector3.new(0.8, 5.6, 0.6), rgb(255, 120, 180))
	ball(parent, "Flower", 0.9, position + Vector3.new(-1, 5.2, -0.4), rgb(255, 220, 90))
end

-- Lighting for everyday and for each holiday event
local LOOKS = {
	everyday = { clock = 14.5, tint = rgb(255, 245, 252), air = rgb(255, 214, 236), decay = rgb(200, 170, 255), strip = PINK },
	halloween = { clock = 18.4, tint = rgb(250, 230, 255), air = rgb(200, 150, 255), decay = rgb(255, 140, 60), strip = rgb(255, 130, 30) },
	thanksgiving = { clock = 16.8, tint = rgb(255, 238, 220), air = rgb(255, 210, 160), decay = rgb(230, 140, 80), strip = rgb(255, 160, 50) },
	christmas = { clock = 15.5, tint = rgb(245, 250, 255), air = rgb(225, 240, 255), decay = rgb(180, 210, 255), strip = rgb(230, 40, 50) },
}

-- Soft, glowy, pastel look for the whole game
local function setupLighting(look)
	for _, effect in Lighting:GetChildren() do
		if effect.Name == "GlowUp" then
			effect:Destroy()
		end
	end
	Lighting.ClockTime = look.clock
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GlowUp"
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "GlowUp"
	color.Saturation = 0.15
	color.Brightness = 0.03
	color.Contrast = 0.05
	color.TintColor = look.tint
	color.Parent = Lighting
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "GlowUp"
	atmosphere.Density = 0.28
	atmosphere.Color = look.air
	atmosphere.Decay = look.decay
	atmosphere.Haze = 1.2
	atmosphere.Glare = 0.4
	atmosphere.Parent = Lighting
end

-- An emoji floating in the air (bats, ghosts, leaves, snowflakes)
local function floater(parent: Instance, emoji: string, position: Vector3, size: number)
	local anchor = part(parent, "Floater", Vector3.new(0.2, 0.2, 0.2), CFrame.new(position), rgb(255, 255, 255))
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(size, size)
	gui.LightInfluence = 0
	gui.MaxDistance = 300
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = emoji
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = anchor
end

local function pumpkin(parent: Instance, position: Vector3, size: number)
	local body = ball(parent, "Pumpkin", size, position + Vector3.new(0, size / 2, 0), rgb(245, 130, 30))
	local stem = part(parent, "Stem", Vector3.new(size * 0.25, size * 0.12, size * 0.12), CFrame.new(position + Vector3.new(0, size * 1.02, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(70, 130, 50))
	stem.Shape = Enum.PartType.Cylinder
	local face = Instance.new("SurfaceGui")
	face.Face = Enum.NormalId.Back
	face.LightInfluence = 0
	face.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	face.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "▲ ▲\n◡◡◡"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = rgb(60, 25, 10)
	label.Parent = face
	face.Parent = body
end

local function christmasTree(parent: Instance, position: Vector3, height: number)
	local trunk = part(parent, "Trunk", Vector3.new(height * 0.15, height * 0.12, height * 0.12), CFrame.new(position + Vector3.new(0, height * 0.075, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 70, 40))
	trunk.Shape = Enum.PartType.Cylinder
	local layers = 8
	for i = 0, layers - 1 do
		local w = height * (0.66 - i * 0.075)
		local y = height * (0.2 + i * 0.09)
		local green = if i % 2 == 0 then rgb(40, 140, 70) else rgb(55, 165, 85)
		local layer = part(parent, "Branches", Vector3.new(height * 0.1, w, w), CFrame.new(position + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)), green)
		layer.Shape = Enum.PartType.Cylinder
		local colors = { rgb(230, 40, 50), GOLD, rgb(90, 170, 255), PINK }
		for j = 0, (if i % 2 == 0 then 4 else -1) do
			local a = math.rad(j * 72 + i * 25)
			ball(parent, "Ornament", height * 0.05, position + Vector3.new(math.cos(a) * w * 0.47, y - height * 0.05, math.sin(a) * w * 0.47), colors[(i + j) % #colors + 1], Enum.Material.Neon)
		end
	end
	ball(parent, "TreeStar", height * 0.1, position + Vector3.new(0, height * 0.95, 0), GOLD, Enum.Material.Neon)
end

local function present(parent: Instance, position: Vector3, size: number, color: Color3)
	part(parent, "Present", Vector3.new(size, size * 0.8, size), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), color)
	part(parent, "Ribbon", Vector3.new(size * 1.02, size * 0.82, size * 0.18), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), rgb(255, 255, 255))
	part(parent, "Ribbon", Vector3.new(size * 0.18, size * 0.82, size * 1.02), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), rgb(255, 255, 255))
end

local function autumnTree(parent: Instance, position: Vector3)
	local trunk = part(parent, "Trunk", Vector3.new(7, 1.4, 1.4), CFrame.new(position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 70, 40))
	trunk.Shape = Enum.PartType.Cylinder
	ball(parent, "Leaves", 7, position + Vector3.new(0, 9, 0), rgb(230, 110, 30), Enum.Material.Grass)
	ball(parent, "Leaves", 5, position + Vector3.new(1.8, 10.5, 1), rgb(200, 60, 30), Enum.Material.Grass)
	ball(parent, "Leaves", 4.5, position + Vector3.new(-2, 10, -1), rgb(240, 180, 40), Enum.Material.Grass)
end

-- Spots around the salon, runway and podium where decorations go
local DECOR_SPOTS = {
	Vector3.new(-42, 0, 38), Vector3.new(42, 0, 38), Vector3.new(-42, 0, 62), Vector3.new(42, 0, 62),
	Vector3.new(-18, 0, -30), Vector3.new(18, 0, -30), Vector3.new(-22, 0, -50), Vector3.new(22, 0, -50),
	Vector3.new(-52, 0, -8), Vector3.new(-16, 0, 6), Vector3.new(10, 0, 20), Vector3.new(-10, 0, 20),
}

local built = nil

-- Swaps in the decorations and lighting for a holiday event (or nil for everyday).
function WorldBuilder.setDecor(eventId: string?)
	if not built then
		return
	end
	local old = built.folder:FindFirstChild("Decor")
	if old then
		old:Destroy()
	end
	local look = LOOKS[eventId or "everyday"] or LOOKS.everyday
	setupLighting(look)
	for _, p in built.folder:GetDescendants() do
		if p:IsA("BasePart") and p.Name == "LightStrip" then
			p.Color = look.strip
			local light = p:FindFirstChildOfClass("PointLight")
			if light then
				light.Color = look.strip
			end
		end
	end
	if not eventId then
		return
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	if eventId == "halloween" then
		for i, spot in DECOR_SPOTS do
			pumpkin(decor, spot, if i % 3 == 0 then 3.2 else 2.4)
			pumpkin(decor, spot + Vector3.new(2.6, 0, 1), 1.6)
		end
		for i = 1, 10 do
			floater(decor, if i % 3 == 0 then "👻" else "🦇", Vector3.new(-16 + (i % 5) * 8, 16 + (i % 3) * 3, -50 + i * 6), 3)
		end
		for i = 1, 6 do
			floater(decor, "🦇", Vector3.new(-20 + i * 6, 14 + (i % 2) * 3, 50), 2.5)
		end
	elseif eventId == "thanksgiving" then
		for i, spot in DECOR_SPOTS do
			if i % 2 == 0 then
				autumnTree(decor, spot)
			else
				part(decor, "HayBale", Vector3.new(4, 2.4, 2.6), CFrame.new(spot + Vector3.new(0, 1.2, 0)), rgb(230, 200, 110), Enum.Material.Sand)
				pumpkin(decor, spot + Vector3.new(0, 2.4, 0), 1.6)
			end
			for j = 0, 4 do
				ball(decor, "Leaf", 0.9, spot + Vector3.new(3 + (j % 3) * 0.8, 0.2, -1 + j * 0.5), ({ rgb(220, 90, 30), rgb(200, 50, 30), rgb(240, 180, 40) })[j % 3 + 1])
			end
		end
		for i = 1, 12 do
			floater(decor, if i % 2 == 0 then "🍂" else "🍁", Vector3.new(-18 + (i % 6) * 7, 12 + (i % 4) * 3, -52 + i * 8), 2.2)
		end
	elseif eventId == "christmas" then
		for i, spot in DECOR_SPOTS do
			if i % 2 == 1 then
				christmasTree(decor, spot, if i <= 4 then 16 else 12)
			end
			local colors = { rgb(230, 40, 50), rgb(40, 150, 70), GOLD, PURPLE }
			present(decor, spot + Vector3.new(3, 0, 2), 1.8, colors[i % #colors + 1])
			present(decor, spot + Vector3.new(-2.5, 0, 2.5), 1.3, colors[(i + 1) % #colors + 1])
			part(decor, "Snow", Vector3.new(10, 0.25, 8), CFrame.new(spot + Vector3.new(0, 0.12, 0)), rgb(250, 252, 255), Enum.Material.Snow)
		end
		local cloud = part(decor, "SnowCloud", Vector3.new(160, 1, 190), CFrame.new(0, 60, 10), rgb(255, 255, 255))
		cloud.Transparency = 1
		cloud.CanCollide = false
		cloud.CanQuery = false
		local snow = Instance.new("ParticleEmitter")
		snow.Rate = 120
		snow.Lifetime = NumberRange.new(10, 14)
		snow.Speed = NumberRange.new(4, 7)
		snow.Size = NumberSequence.new(0.35)
		snow.EmissionDirection = Enum.NormalId.Bottom
		snow.SpreadAngle = Vector2.new(15, 15)
		snow.LightEmission = 0.3
		snow.Texture = Config.Textures.Circle
		snow.Parent = cloud
		for i = 1, 8 do
			floater(decor, "❄️", Vector3.new(-16 + (i % 4) * 10, 15 + (i % 3) * 3, -50 + i * 8), 2.4)
		end
	end
	decor.Parent = built.folder
end

local function cameraMarker(parent: Instance, name: string, from: Vector3, to: Vector3)
	local p = part(parent, name, Vector3.new(1, 1, 1), CFrame.lookAt(from, to), Color3.new(1, 1, 1))
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
end

function WorldBuilder.build(): World
	local old = Workspace:FindFirstChild("GlowUpWorld")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GlowUpWorld"

	-- Floor
	part(folder, "Floor", Vector3.new(160, 1, 190), CFrame.new(0, -0.5, 15), rgb(255, 225, 238))

	-- Salon (where everyone spawns)
	local salon = Instance.new("Folder")
	salon.Name = "Salon"
	salon.Parent = folder
	-- Checkerboard salon floor
	local tile = 5
	for ix = 0, 13 do
		for iz = 0, 7 do
			local color = if (ix + iz) % 2 == 0 then rgb(255, 255, 255) else rgb(255, 205, 228)
			part(salon, "Tile", Vector3.new(tile, 0.2, tile), CFrame.new(-32.5 + ix * tile, 0.1, 32.5 + iz * tile), color, Enum.Material.SmoothPlastic)
		end
	end
	part(salon, "BackWall", Vector3.new(72, 22, 1), CFrame.new(0, 11, 70), rgb(235, 220, 255))
	for _, x in { -34, 34 } do
		plant(salon, Vector3.new(x, 0, 66))
		plant(salon, Vector3.new(x, 0, 34))
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 42)
	spawn.Color = PINK
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = salon

	for i = -2, 2 do
		local x = i * 13
		part(salon, "Mirror", Vector3.new(6, 8, 0.4), CFrame.new(x, 6, 66), rgb(200, 230, 255), Enum.Material.Glass).Reflectance = 0.35
		part(salon, "MirrorFrame", Vector3.new(7, 9, 0.3), CFrame.new(x, 6, 66.4), PINK, Enum.Material.Neon)
		part(salon, "Counter", Vector3.new(8, 3, 2.5), CFrame.new(x, 1.5, 64.5), rgb(255, 255, 255))
		local seat = Instance.new("Seat")
		seat.Name = "SalonChair"
		seat.Anchored = true
		seat.Size = Vector3.new(3, 1, 3)
		seat.CFrame = CFrame.new(x, 2, 59) * CFrame.Angles(0, math.pi, 0)
		seat.Color = PURPLE
		seat.Parent = salon
		part(salon, "ChairBack", Vector3.new(3, 3, 0.6), CFrame.new(x, 3.5, 60.3), PURPLE)
		part(salon, "ChairBase", Vector3.new(1, 1.5, 1), CFrame.new(x, 0.75, 59), rgb(200, 200, 210), Enum.Material.Metal)
	end
	local salonSign = part(salon, "SalonSign", Vector3.new(36, 7, 1), CFrame.new(0, 15, 67), rgb(255, 255, 255))
	sign(salonSign, Enum.NormalId.Front, "✨ 5 Minute Glow Up Salon ✨", PINK)

	-- Runway
	local runway = Instance.new("Folder")
	runway.Name = "Runway"
	runway.Parent = folder
	local runwayTopY = 2
	local runwayStartZ, runwayEndZ = -50, -12
	local length = math.abs(runwayEndZ - runwayStartZ) + 6
	local midZ = (runwayStartZ + runwayEndZ) / 2
	part(runway, "Catwalk", Vector3.new(8, runwayTopY, length), CFrame.new(0, runwayTopY / 2, midZ), rgb(255, 255, 255), Enum.Material.Marble)
	part(runway, "Carpet", Vector3.new(4, 0.1, length), CFrame.new(0, runwayTopY + 0.05, midZ), rgb(255, 90, 170), Enum.Material.Fabric)
	for side = -1, 1, 2 do
		local strip = part(runway, "LightStrip", Vector3.new(0.4, 0.3, length), CFrame.new(side * 4.2, runwayTopY + 0.15, midZ), PINK, Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Color = PINK
		light.Range = 12
		light.Brightness = 1.5
		light.Parent = strip
	end

	-- Big screen behind the runway
	local screen = part(runway, "Screen", Vector3.new(44, 24, 1), CFrame.new(0, 14, -57), rgb(25, 18, 35))
	part(runway, "ScreenFrame", Vector3.new(46, 26, 0.8), CFrame.new(0, 14, -57.6), PURPLE, Enum.Material.Neon)
	for side = -1, 1, 2 do
		part(runway, "Pillar", Vector3.new(4, 28, 4), CFrame.new(side * 25, 14, -56), PURPLE)
		local cap = part(runway, "PillarLight", Vector3.new(4.4, 1, 4.4), CFrame.new(side * 25, 28.5, -56), GOLD, Enum.Material.Neon)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 60
		spot.Range = 60
		spot.Brightness = 3
		spot.Color = rgb(255, 230, 245)
		spot.Parent = cap
	end

	-- Balloon arch where clients come out
	local balloonColors = { PINK, rgb(255, 255, 255), PURPLE, GOLD, rgb(140, 210, 255) }
	for i = 0, 22 do
		local a = math.rad(i * (180 / 22))
		local pos = Vector3.new(math.cos(a) * 9, runwayTopY + math.sin(a) * 11, runwayStartZ - 1)
		ball(runway, "Balloon", 2.8, pos, balloonColors[i % #balloonColors + 1]).Reflectance = 0.15
		ball(runway, "Balloon", 2, pos + Vector3.new(0, 0, 1.6), balloonColors[(i + 2) % #balloonColors + 1]).Reflectance = 0.15
	end
	for side = -1, 1, 2 do
		plant(runway, Vector3.new(side * 18, 0, -50))
		plant(runway, Vector3.new(side * 18, 0, -12))
	end

	-- Confetti cannons for Runway Star pass holders
	local confetti = {}
	for side = -1, 1, 2 do
		local cannon = part(runway, "ConfettiCannon", Vector3.new(1.5, 1.5, 1.5), CFrame.new(side * 6, 1, runwayEndZ), GOLD, Enum.Material.Neon)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(2, 3)
		emitter.Speed = NumberRange.new(25, 40)
		emitter.SpreadAngle = Vector2.new(30, 30)
		emitter.Acceleration = Vector3.new(0, -20, 0)
		emitter.Size = NumberSequence.new(0.5)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-200, 200)
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 100, 170)),
			ColorSequenceKeypoint.new(0.33, rgb(255, 220, 80)),
			ColorSequenceKeypoint.new(0.66, rgb(100, 200, 255)),
			ColorSequenceKeypoint.new(1, rgb(180, 120, 255)),
		})
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Texture = Config.Textures.Star
		emitter.Parent = cannon
		table.insert(confetti, emitter)
	end

	-- Audience seats along both sides of the runway
	for _, x in { -9, -13, 9, 13 } do
		for z = runwayStartZ + 4, runwayEndZ - 2, 6 do
			local seat = Instance.new("Seat")
			seat.Name = "AudienceSeat"
			seat.Anchored = true
			seat.Size = Vector3.new(3, 1, 3)
			seat.CFrame = CFrame.new(x, 0.5, z) * CFrame.Angles(0, if x < 0 then -math.pi / 2 else math.pi / 2, 0)
			seat.Color = if math.abs(x) == 9 then PINK else PURPLE
			seat.Parent = runway
		end
	end

	-- Winners' podium, off to the side so it never blocks the runway
	local podiumFolder = Instance.new("Folder")
	podiumFolder.Name = "Podium"
	podiumFolder.Parent = folder
	local podiumX, podiumZ = -32, -8
	local blocks = {
		{ x = podiumX, h = 5, color = GOLD, label = "1" },
		{ x = podiumX - 7, h = 3.5, color = rgb(200, 205, 215), label = "2" },
		{ x = podiumX + 7, h = 2.5, color = rgb(215, 140, 80), label = "3" },
	}
	local podium = {}
	for _, b in blocks do
		local block = part(podiumFolder, "Place" .. b.label, Vector3.new(6, b.h, 6), CFrame.new(b.x, b.h / 2, podiumZ), b.color)
		sign(block, Enum.NormalId.Back, b.label, rgb(255, 255, 255))
		table.insert(podium, Vector3.new(b.x, b.h, podiumZ))
	end

	-- Where the camera goes during the show and the results
	local cameras = Instance.new("Folder")
	cameras.Name = "Cameras"
	cameras.Parent = folder
	cameraMarker(cameras, "Showcase", Vector3.new(0, 9, 14), Vector3.new(0, 6, -36))
	cameraMarker(cameras, "Results", Vector3.new(podiumX + 7, 9, podiumZ + 19), Vector3.new(podiumX + 7, 5.5, podiumZ))
	part(podiumFolder, "PodiumStage", Vector3.new(26, 0.4, 12), CFrame.new(podiumX, 0.2, podiumZ), rgb(255, 235, 245), Enum.Material.Marble)
	for i = 0, 24 do
		local a = math.rad(i * (180 / 24))
		local pos = Vector3.new(podiumX + math.cos(a) * 12, 0.5 + math.sin(a) * 11, podiumZ - 4)
		ball(podiumFolder, "Balloon", 2.6, pos, balloonColors[i % #balloonColors + 1]).Reflectance = 0.15
		ball(podiumFolder, "Balloon", 1.9, pos + Vector3.new(0, 0, 1.4), balloonColors[(i + 2) % #balloonColors + 1]).Reflectance = 0.15
	end

	folder.Parent = Workspace
	setupLighting(LOOKS.everyday)

	built = {
		folder = folder,
		screen = screen,
		runwayStart = Vector3.new(0, runwayTopY, runwayStartZ),
		runwayEnd = Vector3.new(0, runwayTopY, runwayEndZ),
		podium = podium,
		confetti = confetti,
	}
	return built
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="23">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Starts the game on each player's screen and connects it to the server.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local UI = script.Parent:WaitForChild("UI")
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Effects = require(UI.Effects)
local HUD = require(UI.HUD)
local Makeover = require(UI.Makeover)
local Results = require(UI.Results)
local Shop = require(UI.Shop)
local Showcase = require(UI.Showcase)
local Sounds = require(UI.Sounds)
local Theme = require(UI.Theme)

local gui = Instance.new("ScreenGui")
gui.Name = "GlowUpUI"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

local state = { phase = "Waiting", endsAt = 0, themeId = "", eventId = nil :: string? }
local hud, shop

-- Shared helpers every screen can use
local ctx = {
	profile = { coins = 0, owned = {}, passes = {}, totalStars = 0, lookbook = {} } :: any,
	state = function()
		return state
	end,
	toast = function(message: string, color: Color3?)
		hud:toast(message, color)
	end,
	askUnlock = function(item)
		shop:askUnlock(item)
	end,
	promptProduct = function(key: string)
		shop:askProduct(key)
	end,
	-- the server decides the event when a round starts, so use that (not this device's clock)
	eventId = function(): string?
		return state.eventId
	end,
	isModalOpen = function(): boolean
		return shop.overlay.Visible or shop.confirm.Visible
	end,
}

hud = HUD.new(gui, function()
	shop:open()
end, function()
	shop:open("Looks")
end)
shop = Shop.new(gui, ctx)
local makeover = Makeover.new(gui, ctx)
local showcase = Showcase.new(gui, ctx)
local results = Results.new(gui)

Theme.onClick = function()
	Sounds.play("Click")
end

-- While styling, touching the screen should only wash and style, not walk the character around.
local function setCharacterControls(enabled: boolean)
	pcall(function()
		local module = Players.LocalPlayer:WaitForChild("PlayerScripts"):FindFirstChild("PlayerModule")
		if module then
			local controls = (require :: any)(module):GetControls()
			if enabled then
				controls:Enable()
			else
				controls:Disable()
			end
		end
	end)
	pcall(function()
		GuiService.TouchControlsEnabled = enabled
	end)
end

local function applyState(newState)
	local oldPhase = state.phase
	state = newState
	hud:setState(state)
	if state.phase ~= oldPhase and (state.phase == "Makeover" or oldPhase == "Makeover") then
		setCharacterControls(state.phase ~= "Makeover")
	end
	Sounds.music(if state.phase == "Makeover" then "MakeoverMusic" elseif state.phase == "Showcase" then "RunwayMusic" else nil)

	makeover:setVisible(state.phase == "Makeover")
	if state.phase ~= "Showcase" then
		showcase:hide()
	end
	if state.phase ~= "Results" then
		results:hide()
	end
	if state.phase == "Results" then
		showcase:setCamera("Results")
	elseif state.phase ~= "Showcase" then
		showcase:setCamera(nil)
	end
	if state.phase == "Intermission" and oldPhase ~= "Intermission" then
		showcase:setScreen("✨ 5 Minute Glow Up ✨", "Next show starting soon!", nil, nil)
		showcase:clearScreenPortrait()
	end
	if state.phase == "Makeover" and oldPhase ~= "Makeover" then
		local theme = Catalog.themeById[state.themeId]
		Effects.splash(gui, "5 minutes! GO! 💨", theme and ("Theme: " .. theme.name) or nil, Theme.Colors.purple, 2.2)
	end
end

Remotes.State.OnClientEvent:Connect(applyState)

Remotes.AssignClient.OnClientEvent:Connect(function(payload)
	makeover:assign(payload)
	makeover:setVisible(state.phase == "Makeover")
end)

Remotes.Showcase.OnClientEvent:Connect(function(payload)
	showcase:show(payload)
end)

Remotes.Results.OnClientEvent:Connect(function(payload)
	results:show(payload)
	local winner = payload.rows[1]
	if winner then
		-- Shown to everyone: always the happy, washed look and an award (never low stars)
		showcase:setScreen("🏆 " .. winner.stylist .. " wins!", winner.client.name .. "  " .. (winner.award or ""), winner.client, winner.look, 1)
	end
end)

Remotes.Profile.OnClientEvent:Connect(function(profile)
	local lookbookChanged = profile.lookbook ~= nil
	if not lookbookChanged then
		profile.lookbook = ctx.profile.lookbook -- unchanged, so it wasn't sent again
	end
	ctx.profile = profile
	hud:setCoins(profile.coins)
	hud:setLevel(profile.totalStars or 0)
	hud:setWeekly(profile)
	makeover:refreshProfile()
	shop:refreshProfile(lookbookChanged)
end)

Remotes.Reaction.OnClientEvent:Connect(function(emoji)
	showcase:reaction(emoji)
end)

Remotes.Celebrate.OnClientEvent:Connect(function(info)
	if info.kind == "daily" then
		local title = if info.item then "🎁 Day 7: " .. info.item .. "!" else "🎁 Day " .. info.day .. " Gift! +" .. info.coins .. " 💰"
		-- The 7-day calendar row
		Effects.splash(gui, title, " ", Theme.Colors.gold, 4, function(card)
			local row = Theme.new("Frame", {
				Position = UDim2.fromScale(0, 0.62),
				Size = UDim2.fromScale(1, 0.36),
				BackgroundTransparency = 1,
				ZIndex = 262,
				Parent = card,
			}, {
				Theme.new("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					Padding = UDim.new(0.015, 0),
				}),
			})
			for d = 1, 7 do
				local past, today = d < info.day, d == info.day
				Theme.new("TextLabel", {
					LayoutOrder = d,
					Size = UDim2.fromScale(0.125, 1),
					BackgroundTransparency = 0,
					BackgroundColor3 = if today then Theme.Colors.gold elseif past then Theme.Colors.green else Theme.Colors.lavender,
					TextColor3 = if today or past then Theme.Colors.white else Theme.Colors.text,
					Text = if past then "✓" elseif d == 7 then "🎁" else tostring(d),
					ZIndex = 263,
					Parent = row,
				}, { Theme.corner(10), Theme.maxText(30) })
			end
		end)
		Effects.confetti(gui, 40)
	elseif info.kind == "weekly" then
		Effects.splash(gui, "🎯 Weekly goal done!", if info.item then "You got the " .. info.item .. "! 🎁" else "+" .. info.coins .. " 💰", Theme.Colors.purple, 4)
		Effects.confetti(gui, 60)
	elseif info.kind == "friend" then
		Effects.splash(gui, "💞 " .. info.name .. " is your BEST friend!", "Visit #" .. info.visits .. "  +" .. info.coins .. " 💰", Theme.Colors.hotPink, 3.5)
		Effects.confetti(gui, 40)
	elseif info.kind == "level" then
		Effects.splash(gui, "⭐ Level " .. info.level .. "! ⭐", "You're a " .. info.title .. "!", Theme.Colors.purple, 3.5)
		Effects.confetti(gui, 60)
	end
end)

Remotes.Notify.OnClientEvent:Connect(function(message)
	hud:toast(message)
end)

-- Catch up on whatever is happening right now
task.spawn(function()
	local snapshot = Remotes.Hello:InvokeServer()
	if snapshot.entry then
		makeover:assign(snapshot.entry)
	end
	applyState(snapshot.state)
	if snapshot.showcase then
		showcase:show(snapshot.showcase)
	end
	if snapshot.results then
		results:show(snapshot.results)
	end
end)

RunService.RenderStepped:Connect(function()
	hud:update()
	showcase:updateWalkers()
	showcase:followWalker()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="24">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Fun screen effects: confetti, floating emoji, camera flashes, sparkles and big pop-up cards.

local TweenService = game:GetService("TweenService")

local Sounds = require(script.Parent.Sounds)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Effects = {}

local CONFETTI_COLORS = { C.pink, C.gold, C.purple, Color3.fromRGB(110, 200, 255), C.green, C.white }

local function fadeAndDestroy(gui: GuiObject, delay: number, time: number)
	task.delay(delay, function()
		if not gui.Parent then
			return
		end
		local props = { BackgroundTransparency = 1 }
		if gui:IsA("TextLabel") or gui:IsA("TextButton") then
			props.TextTransparency = 1
		end
		TweenService:Create(gui, TweenInfo.new(time), props):Play()
		task.wait(time)
		gui:Destroy()
	end)
end

-- Colorful paper pieces falling from the top of the screen.
function Effects.confetti(gui: GuiObject, count: number?)
	Sounds.play("Cheer", 1)
	for _ = 1, count or 40 do
		local x = math.random()
		local size = math.random(8, 16)
		local piece = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0, -20),
			Size = UDim2.fromOffset(size, size * 0.6),
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Rotation = math.random(0, 360),
			ZIndex = 300,
			Parent = gui,
		})
		local fall = 1.8 + math.random() * 1.6
		TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(x + (math.random() - 0.5) * 0.25, 0, 1, 30),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		task.delay(fall, function()
			piece:Destroy()
		end)
	end
end

-- An emoji that floats up from the bottom of the screen and fades away.
function Effects.floatEmoji(gui: GuiObject, emoji: string)
	local x = 0.1 + math.random() * 0.8
	local label = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(x, 0, 1, -40),
		Size = UDim2.fromOffset(56, 56),
		Text = emoji,
		ZIndex = 250,
		Parent = gui,
	})
	TweenService:Create(label, TweenInfo.new(2.2, Enum.EasingStyle.Sine), {
		Position = UDim2.new(x + (math.random() - 0.5) * 0.1, 0, 0.35, 0),
		Rotation = math.random(-25, 25),
	}):Play()
	fadeAndDestroy(label, 1.4, 0.8)
end

-- A quick white camera flash.
function Effects.flash(gui: GuiObject)
	Sounds.play("Camera")
	local flash = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.35,
		ZIndex = 280,
		Parent = gui,
	})
	fadeAndDestroy(flash, 0, 0.3)
end

-- A little "✨" (or another emoji) that pops at a spot inside `parent` (0..1 position).
function Effects.sparkle(parent: GuiObject, x: number, y: number, emoji: string?)
	Sounds.play("Sparkle", 0.15)
	local s = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(0.14, 0.14),
		Text = emoji or "✨",
		ZIndex = 120,
		Parent = parent,
	}, { new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	Theme.pop(s)
	fadeAndDestroy(s, 0.4, 0.4)
end

local splashFreeAt = 0

-- A big card in the middle of the screen. Cards wait their turn so they never pile up.
-- `build` can add extra things to the card.
function Effects.splash(gui: GuiObject, title: string, subtitle: string?, color: Color3?, seconds: number?, build: ((Frame) -> ())?)
	local now = os.clock()
	local waitFor = math.max(0, splashFreeAt - now)
	splashFreeAt = now + waitFor + (seconds or 2.5) + 0.4
	task.delay(waitFor, function()
		local card = Effects.showSplash(gui, title, subtitle, color, seconds)
		if build then
			build(card)
		end
	end)
end

function Effects.showSplash(gui: GuiObject, title: string, subtitle: string?, color: Color3?, seconds: number?): Frame
	Sounds.play("Pop")
	local card = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.5, 0.34),
		BackgroundColor3 = C.white,
		ZIndex = 260,
		Parent = gui,
	}, {
		Theme.corner(28),
		Theme.stroke(color or C.hotPink, 6),
		Theme.padding(14),
		new("UISizeConstraint", { MinSize = Vector2.new(300, 150), MaxSize = Vector2.new(620, 300) }),
	})
	new("TextLabel", {
		Size = UDim2.fromScale(1, if subtitle then 0.58 else 1),
		Text = title,
		TextColor3 = color or C.hotPink,
		ZIndex = 261,
		Parent = card,
	}, { Theme.maxText(64) })
	if subtitle then
		new("TextLabel", {
			Position = UDim2.fromScale(0, 0.6),
			Size = UDim2.fromScale(1, 0.4),
			Text = subtitle,
			TextColor3 = C.text,
			ZIndex = 261,
			Parent = card,
		}, { Theme.maxText(30) })
	end
	Theme.pop(card)
	task.delay(seconds or 2.5, function()
		if card.Parent then
			for _, d in card:GetDescendants() do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			end
			TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.35)
			card:Destroy()
		end
	end)
	return card
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- The always-on parts of the screen: round timer, coins, shop button, pop-up messages,
-- and the "next show" card between rounds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Progress = require(ReplicatedStorage.Shared.Progress)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local HUD = {}
HUD.__index = HUD

local PHASE_LABELS = {
	Waiting = "⏳ Waiting for stylists",
	Intermission = "🌟 Next show in",
	Makeover = "💄 Makeover time!",
	Showcase = "📸 Fashion Show",
	Results = "🏆 Results",
}

function HUD.new(gui: ScreenGui, onShop: () -> (), onLookBook: () -> ())
	local self = setmetatable({}, HUD)
	self.state = { phase = "Waiting", endsAt = 0, themeId = Catalog.Themes[1].id }

	self.pill = new("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.3, 0, 0, 46),
		BackgroundColor3 = C.white,
		ZIndex = 50,
		Parent = gui,
	}, { Theme.round(), Theme.stroke(C.pink, 3), new("UISizeConstraint", { MinSize = Vector2.new(220, 0) }) })
	self.pillText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 51,
		Parent = self.pill,
	}, { Theme.maxText(26), Theme.padding(6) })

	-- Coins and shop sit in the top bar, just right of the timer
	local right = new("Frame", {
		Position = UDim2.new(0.65, 8, 0, 10),
		Size = UDim2.new(0, 206, 0, 42),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), FillDirection = Enum.FillDirection.Horizontal }) })
	local coinPill = new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(0, 100, 1, 0),
		BackgroundColor3 = C.white,
		ZIndex = 50,
		Parent = right,
	}, { Theme.round(), Theme.stroke(C.gold, 3) })
	self.coinText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "💰 0",
		ZIndex = 51,
		Parent = coinPill,
	}, { Theme.maxText(24), Theme.padding(6) })
	local shop = Theme.button({
		Text = "🛍️ Shop",
		LayoutOrder = 2,
		Size = UDim2.new(0, 98, 1, 0),
		Color = C.purple,
		ZIndex = 50,
		Parent = right,
	})
	shop.Activated:Connect(onShop)
	self.shopButton = shop

	-- Stylist level, just left of the timer
	local levelPill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.35, -8, 0, 10),
		Size = UDim2.new(0, 104, 0, 42),
		BackgroundColor3 = C.white,
		ZIndex = 50,
		Parent = gui,
	}, { Theme.round(), Theme.stroke(C.purple, 3) })
	self.levelFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.lavender,
		ZIndex = 50,
		Parent = levelPill,
	}, { Theme.round() })
	self.levelText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		Text = "⭐ Lv 1",
		ZIndex = 51,
		Parent = levelPill,
	}, { Theme.maxText(22), Theme.padding(6) })

	-- Little messages pop up near the bottom of the screen
	self.toasts = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.new(0.5, 0, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 90,
		Parent = gui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Top,
		}),
	})

	-- Between rounds
	self.lobby = new("Frame", {
		Name = "Lobby",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.new(0.5, 0, 0, 262),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, {
		Theme.corner(22),
		Theme.stroke(C.pink, 4),
		Theme.padding(14),
		new("UISizeConstraint", { MinSize = Vector2.new(320, 0) }),
	})
	-- The rows stack in their own frame, so the corner "My Looks" button isn't pulled into the list.
	local rows = new("Frame", {
		Name = "Rows",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = self.lobby,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local book = Theme.button({
		-- Sits on the card's top edge, clear of the event bar.
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 0, -6),
		Size = UDim2.new(0, 120, 0, 36),
		Text = "📖 My Looks",
		Color = C.purple,
		ZIndex = 45,
		MaxText = 20,
		Parent = self.lobby,
	})
	book.Activated:Connect(onLookBook)
	self.lobbyEvent = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.gold,
		TextColor3 = C.white,
		Text = "",
		Visible = false,
		LayoutOrder = 1,
		ZIndex = 41,
		Parent = rows,
	}, { Theme.round(), Theme.maxText(22), Theme.padding(4) })
	self.lobbyWeekly = new("TextLabel", {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.lavender,
		Text = "",
		ZIndex = 41,
		Parent = rows,
	}, { Theme.round(), Theme.maxText(20), Theme.padding(4) })
	self.lobbyTheme = new("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 44),
		Text = "",
		TextColor3 = C.hotPink,
		ZIndex = 41,
		Parent = rows,
	}, { Theme.maxText(40) })
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 104),
		LayoutOrder = 4,
		Name = "Steps",
		Text = "1. 💇 Do your hair   2. 💄 Your face\n3. 👗 An outfit + 🦸 costume that fit the theme\n4. 🐶 Bring a pet   💃 Pick a pose\n5. 📸 Walk the runway - you only get 5 minutes!",
		TextColor3 = C.text,
		ZIndex = 41,
		Parent = rows,
	}, { Theme.maxText(20) })

	return self
end

function HUD:setState(state)
	self.state = state
	local theme = Catalog.themeById[state.themeId]
	local showLobby = state.phase == "Intermission" or state.phase == "Waiting"
	if showLobby and not self.lobby.Visible then
		Theme.pop(self.lobby)
	end
	self.lobby.Visible = showLobby
	-- On short phone screens, skip the how-to steps so the card doesn't cover everything
	local compact = self.lobby.Parent and (self.lobby.Parent :: GuiObject).AbsoluteSize.Y < 500
	(self.lobby.Rows :: any).Steps.Visible = not compact
	self.lobby.Size = UDim2.new(0.5, 0, 0, if compact then 150 else 262)
	-- No shopping while the 5-minute timer runs (items can still be unlocked from the menus)
	self.shopButton.Visible = state.phase ~= "Makeover"
	self.lobbyTheme.Text = "Next theme: " .. (theme and theme.name or "")
	local event = state.eventId and Events.byId[state.eventId]
	self.lobbyEvent.Visible = event ~= nil
	if event then
		self.lobbyEvent.Text = event.icon .. " " .. event.name .. " event! New looks " .. event.endsText .. " " .. event.icon
	end
end

-- "🎯 Weekly goal: 2/5 shows → 🍀 Lucky Clover"
function HUD:setWeekly(profile)
	local goal = Config.WEEKLY_GOAL_SHOWS
	local done = math.min(profile.weekShows or 0, goal)
	if profile.weekClaimed then
		self.lobbyWeekly.Text = "🎯 Weekly goal done! New prize next week 🎁"
	else
		local prize = profile.weeklyNext and Catalog.byId[profile.weeklyNext]
		local prizeText = if prize then (prize.icon or "🎁") .. " " .. prize.name else Config.WEEKLY_GOAL_COINS .. " 💰"
		self.lobbyWeekly.Text = "🎯 Weekly goal: " .. done .. "/" .. goal .. " shows → " .. prizeText
	end
end

function HUD:setCoins(coins: number)
	self.coinText.Text = "💰 " .. tostring(coins)
end

function HUD:setLevel(totalStars: number)
	self.levelText.Text = "⭐ Lv " .. Progress.level(totalStars)
	self.levelFill.Size = UDim2.fromScale(Progress.fraction(totalStars), 1)
end

function HUD:toast(message: string, color: Color3?)
	local toast = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = color or C.hotPink,
		BackgroundTransparency = 0,
		TextColor3 = C.white,
		Text = message,
		ZIndex = 91,
		Parent = self.toasts,
	}, { Theme.round(), Theme.maxText(22), Theme.padding(6) })
	Theme.pop(toast)
	task.delay(3, function()
		local fade = TweenInfo.new(0.4)
		TweenService:Create(toast, fade, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		task.wait(0.45)
		toast:Destroy()
	end)
end

function HUD:secondsLeft(): number
	return self.state.endsAt - Workspace:GetServerTimeNow()
end

-- Called every frame to tick the timer.
function HUD:update()
	local phase = self.state.phase
	local left = self:secondsLeft()
	local label = PHASE_LABELS[phase] or phase
	if phase == "Waiting" or phase == "Showcase" or phase == "Results" then
		self.pillText.Text = label
	else
		self.pillText.Text = label .. "  " .. Theme.formatTime(left)
	end
	local hurry = phase == "Makeover" and left <= 30
	self.pillText.TextColor3 = if hurry then C.red else C.text
	if hurry then
		local pulse = 1 + 0.04 * math.sin(os.clock() * 10)
		self.pill.Size = UDim2.new(0.3 * pulse, 0, 0, 46)
	else
		self.pill.Size = UDim2.new(0.3, 0, 0, 46)
	end
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Makeover</string>
              <string name="Source"><![CDATA[-- The dressing room: style your own avatar for the theme. Hair, face, outfit, costume pieces,
-- a pet to walk with you, and your runway pose and effect. Your avatar reacts as you go: it talks,
-- smiles more, and fills up its happy hearts.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Avatar = require(ReplicatedStorage.Shared.Avatar)
local Pets = require(ReplicatedStorage.Shared.Pets)
local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Events = require(ReplicatedStorage.Shared.Events)
local LookRenderer = require(ReplicatedStorage.Shared.LookRenderer)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Scoring = require(ReplicatedStorage.Shared.Scoring)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local new = Theme.new

local Makeover = {}
Makeover.__index = Makeover

local STEPS = { { "Hair", "💇" }, { "Face", "💄" }, { "Outfit", "👗" }, { "Costume", "🦸" } }
local COSTUME_KEYS = { "costumeBack", "costumeFace", "costumeWaist", "costumeShoulder", "accessory" }
local MAKEUP_KEYS = { "eyeshadow", "lashes", "blush", "lipstick" }
local MAX_BUBBLES = 24
local SEND_INTERVAL = 0.25

-- The 3D client stands in front of the middle styling chair, facing the camera.
local STAND = Vector3.new(0, 0.2, 55.5)
local FACING = Vector3.new(0, 0, -1)
-- How much of the character fills the window on each tab (studs tall) and where to look.
local FRAMING = {
	Face = { height = 2.9, focus = "face" },
	Hair = { height = 4, focus = "hair" },
	Outfit = { height = 8.6, focus = "body" },
	Costume = { height = 8.6, focus = "body" },
	Pet = { height = 9.5, focus = "body" },
	Show = { height = 8.6, focus = "body" },
}

local WASH_LINES = { "That tickles! 😆", "Scrub scrub! 🧽", "Ooh, bubbles!", "Keep going! 💪", "I can see my face again!" }
local LIKE_LINES = { "Ooh, cute! 💕", "I like it!", "So pretty! ✨", "Ooh la la!", "Wow!" }
local THEME_LINES = { "Perfect for %s! 😍", "So %s! I love it!", "That's so %s! 💖" }
local PERFUME_LINES = { "Hee hee! 🌸", "Ooh, I smell like flowers!", "Achoo! 😆", "Mmm, so fancy! 💕", "Again! Again!" }
local NONE_LINES = { "Hmm, okay!", "Plain is nice too!", "Let's try something else!" }

local function pick(list: { string }): string
	return list[math.random(1, #list)]
end

local function screenPosition(input: InputObject): Vector2
	local inset = GuiService:GetGuiInset()
	return Vector2.new(input.Position.X, input.Position.Y) + inset
end

local function themeWord(theme: Catalog.Theme): string
	-- "Pink Party 🎀" -> "Pink Party"
	return (string.gsub(theme.name, "%s*[^%w%s']+$", ""))
end

function Makeover.new(gui: ScreenGui, ctx)
	local self = setmetatable({}, Makeover)
	self.ctx = ctx
	self.client = nil
	self.look = Catalog.defaultLook()
	self.dirtHealth = {}
	self.bubbles = {}
	self.tool = "soap"
	self.tab = "Wash"
	self.subcategory = {} -- tab id -> selected category key
	self.done = false
	self.scrubbing = false
	self.lastSent = 0
	self.wasClean = false
	self.hearts = 0
	self.bestShown = false

	self.frame = new("Frame", {
		Name = "Makeover",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 1, -- the salon shows around the panels, with the client in it
		Active = true, -- touches here are for styling, not for moving the character
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	self.spin = 0

	self:buildLeft()
	self:buildRight()
	self.frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:layoutForScreen()
	end)
	self:connectInput()
	self:startAnimations()
	self:startStage()
	return self
end

------------------------------------------------------------------------------
-- Layout (all in scale so it fits phones, tablets and computers)

function Makeover:buildLeft()
	local left = new("Frame", {
		Position = UDim2.new(0.015, 0, 0, 62),
		Size = UDim2.new(0.43, 0, 1, -70),
		BackgroundColor3 = C.white,
		ZIndex = 11,
		Parent = self.frame,
	}, { Theme.corner(24), Theme.stroke(C.pink, 4), Theme.padding(10) })
	self.left = left

	self.portraitHolder = new("Frame", {
		Name = "PortraitHolder",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneSpecResponse",
  "description": "Structured output for the Scene Spec Generator prompt. Mirrors SceneSpec and MythVsReality in src/types.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "mythsVsReality"],
  "properties": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "culture",
        "region",
        "period",
        "subject",
        "setting",
        "composition",
        "lighting",
        "appearance",
        "attire",
        "environment",
        "avoid",
        "aspectRatio"
      ],
      "properties": {
        "culture": { "type": "string" },
        "region": { "type": "string" },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "description": "Year; negative is BCE." },
            "end": { "type": "integer", "description": "Year; negative is BCE." }
          }
        },
        "subject": { "type": "string" },
        "setting": { "type": "string" },
        "composition": { "type": "string" },
        "lighting": { "type": "string" },
        "appearance": { "type": "array", "items": { "$ref": "#/$defs/evidencedDetail" } },
        "attire": { "type": "array", "items": { "$ref": "#/$defs/evidencedDetail" } },
        "environment": { "type": "array", "items": { "$ref": "#/$defs/evidencedDetail" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "aspectRatio": { "type": "string", "enum": ["1:1", "3:2", "2:3", "16:9"] }
      }
    },
    "mythsVsReality": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["myth", "reality", "sourceIds"],
        "properties": {
          "myth": { "type": "string" },
          "reality": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "evidencedDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detail", "confidence", "sourceIds"],
      "properties": {
        "detail": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "sourceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
